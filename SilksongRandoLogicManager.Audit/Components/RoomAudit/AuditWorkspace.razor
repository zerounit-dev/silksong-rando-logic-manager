@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<AuditWorkspace> Logger
@inject NavigationManager Navigation
@using System.Text.Json
@using Microsoft.JSInterop
@using Silksong_Rando_Logic_Manager.Components.RoomAudit

<PageTitle>@(snapshot is not null && snapshot.RoomId == RoomId && !loading && failure is null ? $"{snapshot.Name} | Audit | Silksong Logic Manager" : "Room audit | Silksong Logic Manager")</PageTitle>
<article @ref="pageRoot" class="room-audit" data-audit-page-owner="@generation" aria-label="Read-only room audit" inert="@(Host.Blocked ? "" : null)">
    <header>
        <h1>@(snapshot is null ? "Room audit" : $"{snapshot.Name} — room audit")</h1>
        <a class="audit-action" href="@Host.RoomUrl(RoomId)" @onclick:preventDefault="Host.Blocked"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @Host.BackLabel</a>
        <AuditRoomSearch RoomId="RoomId" Selected="ChooseRoom" />
        @if (Host.ReloadAvailable) { <button class="audit-action" type="button" disabled="@(loading || Host.Blocked)" @onclick="ReloadAsync">Reload</button> }
        <button @key="@((generation, "help-launcher"))" @ref="helpLauncher" type="button" command="show-modal" commandfor="audit-help-dialog" aria-haspopup="dialog">Help</button>
    </header>
    <dialog @key="@((generation, "help"))" @ref="helpDialog" id="audit-help-dialog" class="audit-help-dialog" data-audit-modal aria-labelledby="audit-help-title">
        <header><h2 id="audit-help-title">Room audit help</h2><form method="dialog"><button type="submit" autofocus>Close</button></form></header>
        <div class="audit-help-body">
        <section><h3>Room audit</h3>
            <p>Use the audit tool to test scenarios and check whether the requirements you have written work as expected. Toggle movement abilities, difficulty settings, and other criteria to see how they affect access through the room.</p>
        </section>
        <section><h3>Basic and Advanced</h3>
            <p>Switch between Basic and Advanced to control which scenario inputs are shown.</p>
            <p>Advanced exposes additional difficulty and technique controls, including Crest-specific difficulty settings and stalls. Switching back to Basic keeps the values you selected.</p>
        </section>
        <section><h3>Reachability and routes</h3>
            <p>There are three modes:</p>
            <h4>Origin reachability</h4>
            <p>Choose an origin to see which elements of the room are accessible from that point.</p>
            <p>Select an origin in the table or left-click a point on the map, with Destination set to None. Left-click the same point again to clear the origin.</p>
            <h4>Destination reachability</h4>
            <p>Choose a destination to see which points can reach it.</p>
            <p>Select a destination in the table or right-click a point on the map, with Origin set to None. Right-click the same point again to clear the destination.</p>
            <h4>Route exploration</h4>
            <p>Choose both an origin and a destination to explore routes through the room.</p>
            <p>Hover over a route in the list to preview its arrows on the map. Select it to see the individual traversals and inspect their requirements. Full requirements shows the requirements for the whole route.</p>
        </section>
        <section><h3>Auto Collect</h3>
            <p>Auto Collect defaults to Off, so you can toggle internal states yourself when checking switches, breakables, and other requirements.</p>
            <p>Turn Auto Collect On to activate internal states automatically when their locations are reachable and their own requirements are met.</p>
            <p>The audit covers only the current room. External prerequisites must be toggled manually.</p>
        </section>
        </div>
    </dialog>
    <dialog @key="@((generation, "requirements"))" @ref="requirementsDialog" id="audit-requirements-dialog" class="audit-requirements-dialog" data-audit-modal
        data-requirements-request="@(requirements?.Request ?? 0)" aria-labelledby="audit-requirements-title">
        <header><h2 id="audit-requirements-title">Requirements: @requirements?.Label</h2><form method="dialog"><button type="submit" autofocus>Close</button></form></header>
        @if (requirements is { } inspection && RequirementsCurrent(inspection))
        {
            var scope = new AuditOriginScope(scenario.Start, false);
            var ownAccess = access!.Scope == scope ? access! : inspection.Evaluator.EvaluateAccess(scenario, scope, requirementsContext);
            <div class="audit-requirements-analysis">
                <AuditGateFocus @key="inspection.Request" Row="inspection.Row" Evaluator="inspection.Evaluator" Evaluation="ownAccess.ForOrigin(scenario.Start)" Comparisons="AuditComparisons.For(inspection.Evaluator, ownAccess)" />
            </div>
            <h3>Authored requirements</h3>
            <pre class="audit-requirements-source">@inspection.Row.Requirement.Source</pre>
        }
    </dialog>
    <div class="audit-page-status">
    @if (loading) { <p role="status">Loading fresh room data…</p> }
    else if (failure is not null)
    {
        <p role="alert">@failure</p>
        <button class="audit-action" type="button" @onclick="ReloadAsync">retry</button>
    }
    else if (snapshot is null) { <p role="status">Room unavailable: it is missing or archived.</p> }
    @if (notice is not null) { <p class="audit-notice" role="status">@notice</p> }
    @if (modeNotice is not null) { <p class="audit-notice" role="status">@modeNotice</p> }
    </div>
    @if (!loading && failure is null && snapshot is not null && evaluator is not null && access is not null)
    {
        var scenarioOwner = generation;
        <div @key="generation" class="audit-workspace">
            <section class="audit-controls" aria-label="Scenario inputs">
                <fieldset disabled="@restoring" aria-labelledby="audit-scenario-title">
                    <legend id="audit-scenario-title">Scenario inputs</legend>
                    <div class="audit-scenario-row">
                    <fieldset class="audit-radio audit-button-radios"><legend>Requirements mode</legend>
                        <div class="audit-mode-options">
                        @foreach (var mode in new[] { AuditRequirementsMode.Basic, AuditRequirementsMode.Advanced })
                        {
                            <label title="@mode.ToString()"><input type="radio" name="audit-requirements-mode" value="@mode.ToString()" checked="@(requirementsContext.Mode == mode)" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => RequirementsModeChangedAsync(mode)))" /><span><span class="audit-toggle-text">@mode</span></span></label>
                        }
                        </div>
                    </fieldset>
                    <div class="audit-scenario-actions">
                        <button type="button" disabled="@restoring" @onclick="@(() => OwnedInputAsync(scenarioOwner, EnableAllAsync))">Enable all</button>
                        <button type="button" disabled="@restoring" @onclick="@(() => OwnedInputAsync(scenarioOwner, ResetAsync))">Reset</button>
                    </div>
                    </div>
                    <section class="audit-scenario-section" aria-label="Movement">
                    <div class="audit-movement-heading"><h2>Movement <small>@SelectedSummary("Movement")</small></h2>
                        <button type="button" class="audit-toggle" aria-label="Full movement" title="Full movement" aria-pressed="@FullMovementPressed" disabled="@restoring" @onclick="@(() => OwnedInputAsync(scenarioOwner, FullMovementChangedAsync))"><span class="audit-toggle-text">Full movement @FullMovementState</span></button>
                    </div>
                    <table class="audit-movement">
                        <thead><tr><th scope="col">Capability</th><th scope="col">Available</th></tr></thead>
                        <tbody>
                            @foreach (var movement in RoomAuditEvaluator.Movement)
                            {
                                <tr><th scope="row">@movement.Label</th><td>
                                    @if (movement.Directions.Length == 0)
                                    {
                                        var key = $"move:{movement.Key}";
                                        <div class="audit-movement-single"><button id="@AuditControlIds.ControlId(key)" type="button" class="audit-toggle" aria-label="@movement.Label" title="@movement.Label" aria-pressed="@Pressed(scenario.Has(key))" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(key, !scenario.Has(key))))"><span class="audit-toggle-text">@(scenario.Has(key) ? "On" : "Off")</span></button></div>
                                    }
                                    @if (movement.Directions.Length > 0)
                                    {
                                        var all = movement.Directions.All(d => scenario.Has($"move:{movement.Key}:{d}"));
                                        var some = movement.Directions.Any(d => scenario.Has($"move:{movement.Key}:{d}"));
                                        <div class="audit-movement-cluster" aria-label="@movement.Label">
                                        <button type="button" class="audit-toggle audit-direction-all" aria-label="@($"All {movement.Label} inputs")" title="@($"All {movement.Label} inputs")" aria-pressed="@(all ? "true" : some ? "mixed" : "false")" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => AllChangedAsync(movement.Key, movement.Directions)))"><span class="audit-toggle-text">All</span></button>
                                    @foreach (var direction in movement.Directions)
                                    {
                                        var key = $"move:{movement.Key}:{direction}";
                                        var name = $"{movement.Label} {RoomAuditEvaluator.Friendly(direction)}";
                                        <button id="@AuditControlIds.ControlId(key)" type="button" class="@($"audit-toggle audit-direction-{direction}")" aria-label="@name" title="@name" aria-pressed="@Pressed(scenario.Has(key))" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(key, !scenario.Has(key))))"><span class="audit-toggle-text">@(direction == "run" ? "Run" : direction[..1].ToUpperInvariant())</span></button>
                                    }
                                        @if (movement.Key == "dash")
                                        {
                                            <button type="button" class="audit-toggle audit-direction-down" disabled aria-pressed="@Pressed(scenario.Has("move:dash:run") && scenario.Has("move:dash:left") && scenario.Has("move:dash:right"))" aria-label="Swift Step Dash Down — derived availability: requires Run, Left and Right" title="Dash Down — derived from Run, Left and Right"><span class="audit-toggle-text">D</span></button>
                                        }
                                        </div>
                                    }
                                </td></tr>
                                @if (movement.Key == "swim")
                                {
                                    @foreach (var control in AdditionalMovementControls)
                                    {
                                        <tr @key="control.Key"><th scope="row">@control.Label</th><td>
                                            <div class="audit-movement-single"><button id="@AuditControlIds.ControlId(control.Key)" type="button" class="audit-toggle" aria-label="@control.Label" title="@control.Label" aria-pressed="@Pressed(scenario.Has(control.Key))" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, !scenario.Has(control.Key))))"><span class="audit-toggle-text">@(scenario.Has(control.Key) ? "On" : "Off")</span></button></div>
                                        </td></tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                    </section>
                    <section class="audit-scenario-section" aria-label="Crests"><h2>Crests <small>@SelectedSummary("Crests")</small></h2>
                    <table class="audit-crests"><colgroup><col class="audit-crest-name" />@if (requirementsContext.Advanced) { <col /> }</colgroup><thead><tr><th scope="col">Owned</th>@if (requirementsContext.Advanced) { <th scope="col">Shared difficulty</th> }</tr></thead><tbody>
                        @foreach (var crest in snapshot.Crests)
                        {
                            var owned = RoomAuditEvaluator.ValueKey("crest", crest);
                            var level = RoomAuditEvaluator.ValueKey("crest-level", crest);
                            <tr><td><button id="@AuditControlIds.ControlId(owned)" class="audit-toggle audit-fact" type="button" title="@crest.Name" aria-label="@crest.Name" aria-pressed="@Pressed(scenario.Has(owned))" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(owned, !scenario.Has(owned))))"><span class="audit-toggle-label">@crest.Name</span></button></td>
                                @if (requirementsContext.Advanced) { <td><AuditDifficultyInput LevelKey="@level" Label="@($"{crest.Name} shared difficulty")" ShowLabel="false" Value="@scenario.Level(level)" ValueChanged="@(value => OwnedInputAsync(scenarioOwner, () => LevelChangedAsync(level, value)))" /></td> }</tr>
                        }
                    </tbody></table></section>
                    @foreach (var groupName in new[] { "Tools / spells / kit", "Technique difficulty", "World and settings", "Souls", "Prerequisites" })
                    {
                        var group = (groupName == "Prerequisites" ? PrerequisiteControls : evaluator.Controls.Where(x => x.Group == groupName && ControlVisible(x))).ToArray();
                        @if (group.Length == 0 && groupName is not "Souls" and not "World and settings" and not "Prerequisites") { continue; }
                        <section class="audit-scenario-section" aria-label="@groupName"><h2>@groupName <small>@SelectedSummary(groupName)</small></h2>
                            @if (groupName == "Prerequisites")
                            {
                                <button type="button" class="audit-toggle" aria-label="Auto Collect" title="Auto Collect checks and enemies with accessible sources and passing requirements" aria-pressed="@Pressed(scenario.AutoCollect)" disabled="@restoring" @onclick="@(() => OwnedInputAsync(scenarioOwner, AutoCollectChangedAsync))"><span class="audit-toggle-text">Auto Collect @(scenario.AutoCollect ? "On" : "Off")</span></button>
                            }
                            @if (groupName == "World and settings")
                            {
                                <fieldset id="@AuditControlIds.ControlId("act")" class="audit-radio audit-button-radios"><legend>Act</legend>
                                    <div class="audit-mode-options audit-mode-options-act">
                                    @foreach (var act in new[] { 1, 2, 3 })
                                    {
                                        <label title="@($"Act {new[] { "I", "II", "III" }[act - 1]}")"><input type="radio" name="audit-act" value="@act" aria-label="@($"Act {new[] { "I", "II", "III" }[act - 1]}")" checked="@(scenario.Act == act)" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => ActChangedAsync(act)))" /><span><span class="audit-toggle-text">@(new[] { "I", "II", "III" }[act - 1])</span></span></label>
                                    }
                                    </div>
                                </fieldset>
                                @foreach (var control in evaluator.Controls.Where(x => x.Group == "Settings"))
                                {
                                    var label = $"{control.Label}: {(scenario.Has(control.Key) ? "On" : "Off")}";
                                    <button id="@AuditControlIds.ControlId(control.Key)" class="audit-toggle audit-control audit-fact" type="button" title="@label" aria-pressed="@Pressed(scenario.Has(control.Key))" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, !scenario.Has(control.Key))))"><span class="audit-toggle-label">@label</span></button>
                                }
                            }
                            @if (groupName == "Souls")
                            {
                                <fieldset id="@AuditControlIds.ControlId("soul-mode")" class="audit-radio audit-button-radios"><legend>Soul Randomizer</legend>
                                    <div class="audit-mode-options">
                                    <label title="Soul Randomizer Off"><input type="radio" name="audit-souls" checked="@(!scenario.SoulRandomizer)" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SoulModeChangedAsync(false)))" /><span><span class="audit-toggle-text">Off</span></span></label>
                                    <label title="Soul Randomizer On"><input type="radio" name="audit-souls" checked="@scenario.SoulRandomizer" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SoulModeChangedAsync(true)))" /><span><span class="audit-toggle-text">On</span></span></label>
                                    </div>
                                </fieldset>
                                @if (group.Length == 0) { <p class="audit-help">No named Souls required in this room.</p> }
                            }
                            @foreach (var subgroup in group.GroupBy(x => groupName == "Prerequisites" ? PrerequisiteGroup(x) : x.Group)
                                .OrderBy(x => groupName == "Prerequisites" ? x.Key switch { "Internal" => 0, "External" => 1, _ => 2 } : 0))
                            {
                            @if (groupName == "Prerequisites") { <h3 class="audit-prerequisite-divider">@subgroup.Key</h3> }
                            @foreach (var control in subgroup)
                            {
                                if (control.Difficulty)
                                {
                                    <AuditDifficultyInput LevelKey="@control.Key" Label="@control.Label" Value="@scenario.Level(control.Key)" ValueChanged="@(value => OwnedInputAsync(scenarioOwner, () => LevelChangedAsync(control.Key, value)))" />
                                }
                                else if (control.LocalCheckId is { } local)
                                {
                                    var activation = LocalActivationState(local);
                                    var controlId = PrerequisiteControlId(control.Key);
                                    <button id="@controlId" class="audit-control audit-toggle audit-fact" type="button" aria-labelledby="@(controlId + "-label")" aria-describedby="@(activation.Automatic is null ? null : controlId + "-automatic")" title="@(activation.Automatic is null ? control.Label : $"{control.Label} — {activation.Automatic}")" aria-pressed="@Pressed(activation.On)" disabled="@(restoring || activation.Automatic is not null)" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, !scenario.Has(control.Key))))"><span id="@(controlId + "-label")" class="audit-toggle-label">@control.Label</span></button>
                                    @if (activation.Automatic is not null) { <span id="@(controlId + "-automatic")" class="audit-sr-only">@activation.Automatic</span> }
                                }
                                else
                                {
                                    <button id="@AuditControlIds.ControlId(control.Key)" class="audit-control audit-toggle audit-fact" type="button" title="@control.Label" aria-pressed="@Pressed(scenario.Has(control.Key))" disabled="@(groupName == "Souls" && !scenario.SoulRandomizer)" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, !scenario.Has(control.Key))))"><span class="audit-toggle-label">@control.Label</span></button>
                                }
                            }
                            }
                        </section>
                    }
                </fieldset>
            </section>
            <section class="audit-output" aria-label="Room reachability and authored results">
                <AuditScene @key="@(("scene", generation))" Snapshot="snapshot" Evaluator="evaluator" Evaluation="SceneEvaluation" Access="access" Reverse="reverseAccess" Scenario="scenario" Owner="generation" Origin="@scenario.Start" OriginLabel="@(evaluator.Starts.FirstOrDefault(x => x.Key == scenario.Start)?.Label ?? "None")" DestinationLabel="@(selectedTarget is { } destination ? TargetName(destination) : "None")" Mode="@ModeLabel" DestinationStatus="@(endpointMode == AuditEndpointMode.Routes && selectedTarget is { } goal ? evaluator.TargetStatus(goal, access) : null)" Selected="selectedTarget" Route="routeHighlight" Hovered="@(hoverTarget ?? focusTarget)" Intent="SceneIntentAsync" />
                <div class="audit-inspection-scroll" aria-label="Room points and route details">
                <AuditTargetInspector @key="@(("inspector", generation))" Target="selectedTarget" Selection="targetSelection" Scenario="scenario" Evaluator="evaluator" Access="access" EndpointMode="endpointMode" Reverse="reverseAccess" HighlightChanged="@(highlight => SetHighlight(scenarioOwner, highlight))" SceneStep="sceneStep" SceneStepSelection="sceneStepSelection">
                <Workspace>
                <AuditRoomWarnings Result="roomWarnings" />
                <section class="audit-room-state" aria-label="Room points">
                    <h2 id="audit-room-points-title" tabindex="-1">Room points</h2>
                    <div class="audit-point-tabs" role="tablist" aria-label="Point categories">
                        @for (var i = 0; i < VisibleCategories.Length; i++)
                        {
                            var category = VisibleCategories[i];
                            var tabIndex = i;
                            <button @ref="categoryButtons[tabIndex]" type="button" role="tab" id="@TabId(category)" aria-controls="audit-point-panel" aria-selected="@(activeCategory == category ? "true" : "false")" tabindex="@(activeCategory == category ? 0 : -1)" @onclick="@(() => SelectCategory(scenarioOwner, category))" @onkeydown="@(e => CategoryKeyDown(scenarioOwner, category, e))">@category</button>
                        }
                    </div>
                    <div id="audit-point-panel" role="tabpanel" aria-labelledby="@TabId(activeCategory)" tabindex="0">
                    <div class="audit-endpoint-none">
                        <label><input type="radio" name="audit-origin" checked="@(scenario.Start == "")" disabled="@restoring" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SelectOriginAsync("")))" /> Origin: None</label>
                        <label><input type="radio" name="audit-destination" checked="@(selectedTarget is null)" @onchange="@(() => SelectTarget(scenarioOwner, null))" /> Destination: None</label>
                    </div>
                    <label>Find point <input type="search" value="@targetSearch" @oninput="SearchTargets" /></label>
                    <table class="audit-endpoint-table">
                        <caption class="audit-sr-only">@activeCategory</caption>
                        <colgroup><col class="audit-col-point" /><col class="audit-col-subroom" /><col class="audit-col-access" /><col class="audit-col-origin" /><col class="audit-col-destination" /><col class="audit-col-activation" /><col class="audit-col-requirements" /></colgroup>
                        <thead><tr><th scope="col">Point</th><th scope="col">Subroom</th><th scope="col">Accessibility</th><th scope="col" aria-label="Origin" title="Origin">O</th><th scope="col" aria-label="Destination" title="Destination">D</th><th scope="col" aria-label="State and automatic collection" title="State and automatic collection">A</th><th scope="col" aria-label="Requirements" title="Requirements"><i class="fa-solid fa-book" aria-hidden="true"></i><span class="audit-sr-only">Requirements</span></th></tr></thead>
                            <tbody>
                            @foreach (var item in CategoryTargets())
                            {
                                var row = snapshot.Rows.FirstOrDefault(x => x.Kind == item.Target.Kind && x.Id == item.Target.Id);
                                var control = item.Target.Kind == "check" ? evaluator.Controls.FirstOrDefault(x => x.LocalCheckId == item.Target.Id) : null;
                                var start = evaluator.StartFor(item.Target);
                                var activation = item.Target.Kind == "check" ? LocalActivationState(item.Target.Id) : default;
                                var automatic = activation.Automatic;
                                var stateOn = control is not null && activation.On;
                                <tr @key="item.Target" id="@PointId(item.Target)" tabindex="-1" data-audit-point="@TargetKey(item.Target)" class="@(selectedTarget == item.Target ? "audit-target-selected" : "")"
                                    @onmouseenter="@(() => PreviewPoint(scenarioOwner, item.Target, false))" @onmouseleave="@(() => PreviewPoint(scenarioOwner, null, false))" @onfocusin="@(() => PreviewPoint(scenarioOwner, item.Target, true))" @onfocusout="@(() => PreviewPoint(scenarioOwner, null, true))">
                                    <th scope="row">@if (item.Target.Kind == "exit") {
                                        var alias = string.IsNullOrWhiteSpace(row?.Alias) ? "—" : row.Alias;
                                        <span class="audit-exit-point"><span class="audit-source-name audit-exit-alias" tabindex="0" title="@($"Exit alias: {alias}")"><span class="audit-sr-only">Exit alias: </span><span class="audit-source-short">@alias</span><span class="audit-source-full" aria-hidden="true">@alias</span></span><span class="audit-exit-name" title="@item.Name">@item.Name</span></span>
                                    } else if (control is not null) {
                                        <label id="@PointLabelId(item.Target)" class="audit-point-label" for="@AuditControlIds.ControlId(control.Key)" title="@(automatic ?? item.Name)">@item.Name</label>
                                    } else { @item.Name }</th>
                                    <td>@if (row is not null) {
                                        var sourceName = evaluator.NodeName(evaluator.SourceNode(row));
                                        <span class="audit-source-name" tabindex="0" title="@sourceName"><span class="audit-source-short">@sourceName</span><span class="audit-source-full" aria-hidden="true">@sourceName</span></span>
                                    } else { <span>—</span> }</td>
                                    <td><AuditPointState Target="item.Target" Evaluator="evaluator" Access="access" Reverse="reverseAccess" Evaluation="access.Unstarted" Compact="true" ShowActivation="false" /></td>
                                    <td><label><input type="radio" name="audit-origin" aria-label="@($"Origin: {item.Name}")" title="@(start is null ? "Unresolved source assignment" : $"Start at {item.Name}")" disabled="@(restoring || start is null)" checked="@(start is not null && scenario.Start == start)" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SelectOriginAsync(start ?? "")))" /><span class="audit-sr-only">Origin: @item.Name</span></label></td>
                                    <td><label><input type="radio" name="audit-destination" aria-label="@($"Destination: {item.Name}")" checked="@(selectedTarget == item.Target)" @onchange="@(() => SelectTarget(scenarioOwner, item.Target))" /><span class="audit-sr-only">Destination: @item.Name</span></label></td>
                                    <td>@if (control is not null) {
                                            <span role="@(automatic is null ? null : "group")" tabindex="@(automatic is null ? (int?)null : 0)" aria-labelledby="@(automatic is null ? null : PointLabelId(item.Target))" aria-describedby="@(automatic is null ? null : AutomaticReasonId(item.Target))" title="@automatic">
                                            <button id="@AuditControlIds.ControlId(control.Key)" class="audit-activation audit-toggle" type="button" aria-labelledby="@PointLabelId(item.Target)" aria-describedby="@(automatic is null ? null : AutomaticReasonId(item.Target))" title="@(automatic ?? item.Name)" aria-pressed="@Pressed(stateOn)" disabled="@(restoring || automatic is not null)" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, !scenario.Has(control.Key))))">@if (automatic is not null) { <i class="fa-solid fa-bolt" aria-hidden="true"></i> } else { <span class="audit-toggle-text">@(stateOn ? "On" : "Off")</span> }</button>
                                            @if (automatic is not null) { <span id="@AutomaticReasonId(item.Target)" class="audit-sr-only">@automatic</span> }
                                            </span>
                                        } else if (automatic is not null) {
                                            <span class="audit-automatic-state" role="img" tabindex="0" aria-label="@($"{item.Name}: {automatic}")" title="@automatic"><i class="fa-solid fa-bolt" aria-hidden="true"></i></span>
                                        } else { <span>—</span> }</td>
                                    <td>@if (row is not null && row.Kind is "exit" or "check") {
                                        var requirementEvaluator = evaluator;
                                        var requirementLauncher = default(ElementReference);
                                        var requirementLabel = $"Show requirements for {item.Name}";
