            }
            catch (JSException) { if (owner == generation && !disposed) notice = "Scenario storage is unavailable; inputs last only while this page stays open."; }
        }
        finally { await warnings; }
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true; generation++; requirements = null; loadCancellation?.Cancel(); loadCancellation?.Dispose();
        RetireWarnings();
        await DisposeDialogHandlesAsync(); dialogCallback?.Dispose();
        if (dialogModule is not null) try { await dialogModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        if (storage is not null) try { await storage.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    private sealed record StorageRead(string? Value, string? Notice);
}
