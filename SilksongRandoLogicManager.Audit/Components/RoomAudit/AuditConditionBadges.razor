@if (Conditions.Count > 0)
{
    @Badges(Context)
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AuditCondition> Conditions { get; set; } = null!;
    [Parameter, EditorRequired] public AuditFactContext Context { get; set; } = null!;

    private RenderFragment Badges(AuditFactContext facts) => @<span class="audit-condition-badges" aria-label="Scenario requirements">
    @foreach (var condition in Conditions)
    {
        var met = condition.Matches(facts);
        @if (Conditions.ToList().IndexOf(condition) > 0) { <span aria-hidden="true">+</span> }
        <span class="audit-condition-badge @AuditRequirementGroups.ConditionClass(condition, facts)" title="@((condition with { Manual = false }).Summary)">
            <span class="audit-sr-only">@(met ? "Met: " : "Missing / not matched: ")</span>
            <span class="audit-condition-label">@((condition with { Manual = false }).Summary)</span>
        </span>
    }
    </span>;
}
