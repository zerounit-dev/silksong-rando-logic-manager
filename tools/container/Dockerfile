# syntax=docker/dockerfile:1
# The context is generated by PackageContainerRelease.ps1, NOT the source tree.
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-noble
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
ARG RELEASE_VERSION
LABEL org.opencontainers.image.title="Silksong Rando Logic Manager" \
      org.opencontainers.image.version=$RELEASE_VERSION
WORKDIR /app
COPY app/ /app/
COPY seed/ /opt/logic-manager-seed/
COPY config/ /config/
COPY LICENSE /app/LICENSE
COPY --chmod=755 entrypoint.sh /usr/local/bin/logic-manager-entrypoint
RUN chmod 755 /app/Silksong_Rando_Logic_Manager \
    && mkdir -p /data \
    && chown -R app:app /config /data
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:8080 \
    LogicManager__ConfigDirectory=/config \
    Storage__DataRoot=/data
USER app
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/logic-manager-entrypoint"]
