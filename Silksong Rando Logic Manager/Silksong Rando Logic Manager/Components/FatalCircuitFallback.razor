<div id="blazor-error-ui" class="fatal-circuit-fallback" data-nosnippet data-fatal-circuit-fallback="true" aria-hidden="true">
    <section class="fatal-circuit-modal" role="alertdialog" aria-modal="true" aria-labelledby="fatal-circuit-title" aria-describedby="fatal-circuit-message fatal-circuit-details">
        <header class="fatal-circuit-header">
            <h2 id="fatal-circuit-title">Circuit terminated</h2>
        </header>
        <p id="fatal-circuit-message">The browser connection to this application ended. Reload to start a new connection.</p>
        <label class="fatal-circuit-details-label" for="fatal-circuit-details">Browser-available details</label>
        <textarea id="fatal-circuit-details" class="fatal-circuit-details" readonly spellcheck="false" aria-label="Browser-available circuit details"></textarea>
        <p class="fatal-circuit-copy-hint">If copying is unavailable, select the details and copy them with your browser.</p>
        <footer class="fatal-circuit-actions">
            <button id="fatal-circuit-copy" class="fatal-circuit-button" type="button"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy details</button>
            <button id="fatal-circuit-reload" class="fatal-circuit-button" type="button"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Reload</button>
            <span id="fatal-circuit-copy-status" class="fatal-circuit-copy-status" aria-live="polite"></span>
        </footer>
    </section>
</div>
