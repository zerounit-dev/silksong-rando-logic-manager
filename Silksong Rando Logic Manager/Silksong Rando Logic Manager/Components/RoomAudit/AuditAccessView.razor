@if (NodeId is not { } node)
{ <p class="audit-unresolved">Unresolved subroom assignment</p> }
else
{
    <p>Approaches to @Evaluator.NodeName(node)</p>
    @if (!Evaluation.HasOrigin) { <p>Select origin… Source access is not evaluated.</p> }
    else if (Evaluation.NodeProofs.TryGetValue(node, out var proof) && proof.Via is null)
    { <p>Chosen origin — no incoming traversal needed.</p> }
    var incoming = Evaluator.Snapshot.Rows.Where(x => x.Kind == "connection" && x.DestinationId == node).ToArray();
    @if (incoming.Length == 0) { <p>No incoming directed approaches.</p> }
    else
    {
        <p class="audit-help">Alternatives — choose one, not all.</p>
        @foreach (var edge in incoming)
        {
            var result = Evaluation.Rows[(edge.Kind, edge.Id)];
            <button type="button" class="audit-approach-choice" aria-pressed="@(Chosen == edge.Id)" @onclick="@(() => ApproachSelected.InvokeAsync(new("connection", edge.Id)))">
                @Evaluator.RowName(edge)<br />Source: @result.Access · Gate: @(result.Leaves.Values.Any(x => x.Unresolved) || edge.Requirement.Expression is null ? "unresolved" : result.GatePassed ? "passed" : "unmet")
            </button>
        }
        @if (incoming.FirstOrDefault(x => x.Id == Chosen) is { } selected)
        {
            <section class="audit-approach-detail">
                <h4>Directed gate to @Evaluator.NodeName(selected.DestinationId)</h4>
                <AuditRequirementView @key="(selected.Id, Evaluation)" Expanded="true" Row="selected" Result="Evaluation.Rows[(selected.Kind, selected.Id)]" Evaluator="Evaluator" Evaluation="Evaluation" InspectCheck="InspectCheck" />
                @if (Evaluator.SourceNode(selected) is { } source)
                { <button type="button" class="audit-action" @onclick="@(() => SourceSelected.InvokeAsync(source))">Follow source: @Evaluator.NodeName(source)</button> }
                else { <p class="audit-unresolved">Unresolved source assignment</p> }
            </section>
        }
    }
}
@code {
    [Parameter] public Guid? NodeId { get; set; }
    [Parameter] public Guid? Chosen { get; set; }
    [Parameter, EditorRequired] public RoomAuditEvaluator Evaluator { get; set; } = null!;
    [Parameter, EditorRequired] public AuditEvaluation Evaluation { get; set; } = null!;
    [Parameter] public EventCallback<AuditTarget> ApproachSelected { get; set; }
    [Parameter] public EventCallback<Guid> SourceSelected { get; set; }
    [Parameter] public EventCallback<Guid> InspectCheck { get; set; }
}
