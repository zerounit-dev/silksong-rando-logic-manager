<section class="audit-inspector" aria-label="Destination inspection">
    <h2>Selected destination: @Name(Target)</h2>
    @if (StartHere.HasDelegate && Evaluator.StartFor(Target) is { } start)
    { <button type="button" class="audit-action" @onclick="@(() => StartHere.InvokeAsync(start))">Start here</button> }
    @if (Row(Target) is { Kind: "connection" } selectedRow)
    {
        var directions = Evaluator.Snapshot.Rows.Where(x => x.Kind == "connection" && string.Equals(x.Alias?.Trim(), selectedRow.Alias?.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
        @if (directions.Length > 1)
        {
            <div aria-label="Directed connection">
                @foreach (var direction in directions)
                { <button type="button" class="audit-approach-choice" aria-pressed="@(direction.Id == Target.Id)" @onclick="@(() => TargetSelected.InvokeAsync(new("connection", direction.Id)))">@Evaluator.RowName(direction)</button> }
            </div>
        }
    }
    <div class="audit-modes" role="group" aria-label="Inspection mode">
        <button type="button" aria-pressed="@(!Current.Approaches)" @onclick="@(() => SetMode(false))">Route</button>
        <button type="button" aria-pressed="@Current.Approaches" @onclick="@(() => SetMode(true))">Approaches</button>
    </div>
    <nav class="audit-breadcrumbs" aria-label="Inspection breadcrumbs">
        <button type="button" disabled="@(history.Count == 1)" @onclick="@(() => ReturnTo(history.Count - 2))">Back</button>
        @for (var i = 0; i < history.Count; i++)
        {
            var index = i;
            <span aria-hidden="true"> / </span><button type="button" aria-current="@(i == history.Count - 1 ? "location" : null)" @onclick="@(() => ReturnTo(index))">@Name(history[i].Target)</button>
        }
    </nav>
    @if (Current.Cycle)
    { <p>Repeated reference: @Name(Current.Target). Cycle/reference — not a successful route. Use Back to return.</p> }
    else
    {
        var focus = Current.Target;
        var row = Row(focus);
        var node = row is null ? focus.Id : Evaluator.SourceNode(row);
        <h3>@Name(focus)</h3>
        <p>@Status(focus, row)</p>
        @if (Current.Approaches)
        {
            <AuditAccessView NodeId="node" Chosen="Current.Edge" Evaluator="Evaluator" Evaluation="Evaluation" ApproachSelected="ChooseApproach" SourceSelected="FollowSource" InspectCheck="InspectCheck" />
        }
        else if (!Evaluation.HasOrigin)
        { <p>Select origin…</p> }
        else if (!Available(focus, row))
        {
            <p>No route with this scenario</p>
            <button type="button" class="audit-action" @onclick="@(() => SetMode(true))">View approaches</button>
        }
        else if (node is { } source && Evaluation.NodeProofs.TryGetValue(source, out var proof))
        {
            <h4>@(row is null ? "Route" : "Route to source")</h4>
            <AuditProofView Proof="proof" Evaluator="Evaluator" Evaluation="Evaluation" OriginLabel="OriginLabel" InspectCheck="InspectCheck" />
        }
        @if (row is not null)
        {
            <section class="audit-target-gate">
                <h3>@(row.Kind == "connection" ? $"Own directed gate to {Evaluator.NodeName(row.DestinationId)}" : "Own requirement")</h3>
                <AuditRequirementView @key="(row.Id, Evaluation)" Row="row" Result="OwnResult(row)" Evaluator="Evaluator" Evaluation="Evaluation" InspectCheck="InspectCheck" />
            </section>
        }
    }
</section>
@code {
    [Parameter, EditorRequired] public AuditTarget Target { get; set; } = null!;
    [Parameter] public long Selection { get; set; }
    [Parameter, EditorRequired] public RoomAuditEvaluator Evaluator { get; set; } = null!;
    [Parameter, EditorRequired] public AuditEvaluation Evaluation { get; set; } = null!;
    [Parameter] public string OriginLabel { get; set; } = "Origin";
    [Parameter] public EventCallback<string> StartHere { get; set; }
    [Parameter] public EventCallback<AuditTarget> TargetSelected { get; set; }
    [Parameter] public EventCallback<AuditTarget?> ApproachSelected { get; set; }
    private sealed record Context(AuditTarget Target, bool Approaches, Guid? Edge = null, bool Cycle = false);
    private readonly List<Context> history = [];
    private long selection = -1;
    private Context Current => history[^1];
    protected override void OnParametersSet()
    {
        if (history.Count > 0 && selection == Selection && history[0].Target == Target) return;
        var mode = history.Count > 0 && Current.Approaches;
        history.Clear(); history.Add(new(Target, mode)); selection = Selection;
    }
    private AuditRow? Row(AuditTarget target) => Evaluator.Snapshot.Rows.FirstOrDefault(x => x.Kind == target.Kind && x.Id == target.Id);
    private string Name(AuditTarget target) => Row(target) is { } row ? Evaluator.RowName(row) : Evaluator.NodeName(target.Id);
    private bool Available(AuditTarget target, AuditRow? row) => row is null ? Evaluation.Reached.Contains(target.Id) : Evaluation.Rows[(row.Kind, row.Id)].Available;
    private AuditRowResult OwnResult(AuditRow row)
    {
        var result = Evaluation.Rows[(row.Kind, row.Id)];
        if (row.Kind != "check" || !Evaluation.CheckProofs.TryGetValue(row.Id, out var proof)) return result;
        // Keep current gate subresults/grouping, marking the retained completion's actual prerequisite choice.
        return result with { Leaves = result.Leaves.ToDictionary(x => x.Key, x => x.Value with
            { WitnessUsed = proof.Leaves.TryGetValue(x.Key, out var witness) && witness.WitnessUsed }) };
    }
    private string Status(AuditTarget target, AuditRow? row) => !Evaluation.HasOrigin ? "Not evaluated — select origin…" : row is not null && Evaluation.Rows[(row.Kind, row.Id)].Access == "Unresolved subroom assignment" ? "Unresolved subroom assignment" : Available(target, row) ? "Reached / available" : "Blocked";
    private Task SetMode(bool approaches)
    { history[^1] = Current with { Approaches = approaches }; return Highlight(); }
    private Task ChooseApproach(AuditTarget edge)
    { history[^1] = Current with { Edge = edge.Id }; return Highlight(); }
    private Task FollowSource(Guid node) => Navigate(new(Evaluator.Snapshot.Subrooms.Count == 0 ? "room" : "subroom", node), true);
    private Task InspectCheck(Guid check) => Navigate(new("check", check), Current.Approaches);
    private Task Navigate(AuditTarget target, bool approaches)
    {
        var cycle = history.Any(x => x.Target == target);
        history.Add(new(target, approaches, Cycle: cycle));
        return Highlight();
    }
    private Task ReturnTo(int index)
    {
        if (index < 0 || index >= history.Count) return Task.CompletedTask;
        history.RemoveRange(index + 1, history.Count - index - 1);
        return Highlight();
    }
    private Task Highlight() => ApproachSelected.InvokeAsync(Current.Approaches && !Current.Cycle && Current.Edge is { } edge ? new AuditTarget("connection", edge) : null);
}
