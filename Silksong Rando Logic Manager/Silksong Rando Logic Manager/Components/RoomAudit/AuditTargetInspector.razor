@implements IDisposable
@inject ILogger<AuditTargetInspector> Logger

@Workspace
@if (direct.Count > 0 || CanAnalyze && (discovering || discoveryFailure is not null || routes is { } found && (found.Paths.Length > 0 || found.Unresolved.Length > 0)))
{
<section class="audit-details" aria-label="Details">
    <h2>Details</h2>
@if (direct.Count > 0)
{
    var row = direct[^1];
    <section class="audit-inspector" aria-label="Own requirements">
        <button type="button" @onclick="BackAsync">Back</button>
        <h3>Requirements: @RouteIdentity(row, Evaluator.RowName(row))</h3>
        <AuditPointState Target="new(row.Kind, row.Id)" Evaluator="Evaluator" Evaluation="Evaluation" Access="Access" Reverse="Reverse" />
        <AuditGateFocus @key="row" Row="row" Evaluator="Evaluator" Evaluation="Evaluation" Comparisons="DirectComparisons" />
    </section>
}
@if (CanAnalyze)
{
    <section class="audit-routes" aria-label="Routes" hidden="@(direct.Count > 0)">
        <h2>Routes</h2>
        @RouteSelector
@if (ChosenRoute is { } chosen)
{
    <section class="audit-inspector audit-route-detail" aria-label="Selected route details">
        <h3>Route @(chosen.DiscoveryOrdinal + 1): @RouteChain(chosen)</h3>
        <div class="audit-route-tabs" role="tablist" aria-label="Selected route details">
            <button @ref="detailButtons[0]" type="button" role="tab" id="audit-route-traversal-tab" aria-controls="audit-route-traversal" aria-selected="@(traversal ? "true" : "false")" tabindex="@(traversal ? 0 : -1)" @onclick="@(() => SelectDetail(true))" @onkeydown="@(e => DetailKeyDown(true, e))">Traversal</button>
            <button @ref="detailButtons[1]" type="button" role="tab" id="audit-route-full-tab" aria-controls="audit-route-full" aria-selected="@(!traversal ? "true" : "false")" tabindex="@(!traversal ? 0 : -1)" @onclick="@(() => SelectDetail(false))" @onkeydown="@(e => DetailKeyDown(false, e))">Full requirements
                @if (analyzing)
                { <span class="audit-route-load" role="status"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i><span class="audit-sr-only">Loading full requirements</span></span> }
                else if (analysis && preparation is not null && preparation.Requirements == Requirements)
                { <span class="audit-route-load" role="status"><i class="fa-solid fa-check" aria-hidden="true"></i><span class="audit-sr-only">Full requirements loaded</span></span> }
            </button>
        </div>
        <div id="audit-route-full" role="tabpanel" aria-labelledby="audit-route-full-tab" tabindex="0" hidden="@traversal">
        @if (analyzing)
        { <p role="status">Analyzing alternatives…</p><button type="button" @onclick="CancelDetail">Cancel</button> }
        else if (detailFailure is not null)
        { <p role="status">@detailFailure</p><button type="button" @onclick="AnalyzeSelectedAsync">Retry</button> }
        else if (analysis && hasAlternatives && preparation is not null && preparation.Requirements == Requirements)
        {
            <AuditSemanticRequirements View="preparation" Context="Evaluation.Facts" />
        }
        </div>
        <div id="audit-route-traversal" role="tabpanel" aria-labelledby="audit-route-traversal-tab" tabindex="0" hidden="@(!traversal)">
        <ol @key="chosen.Identity" class="audit-route-strip" aria-label="Selected route traversal">
            <li>From: @RouteIdentity(OriginRow(chosen), chosen.Origin.Label)</li>
            @for (var i = 0; i < chosen.Steps.Length; i++)
            {
                var step = chosen.Steps[i];
                <li @key="step">
                    <button type="button" class="@(focusedStep == step.Id ? "audit-step-focus" : "")" aria-pressed="@(focusedStep == step.Id ? "true" : "false")" @onclick="@(() => FocusStepAsync(step.Id))">@GateIcon(step) @(i + 1). @RouteIdentity(step, Evaluator.RowName(step))</button>
                    <div class="audit-contribution"><AuditGateFocus Row="step" Evaluator="Evaluator" Evaluation="Evaluation" ShowCurrentStatus="false" /></div>
                </li>
            }
            <li>
                <button type="button" aria-pressed="@(focusedStep is null ? "true" : "false")" @onclick="@(() => FocusStepAsync(null))">@if (chosen.OwnGate is { } gate) { @GateIcon(gate) } Destination: @RouteIdentity(chosen.OwnGate, Name(chosen.Target))</button>
                @if (chosen.OwnGate is { } own)
                {
                    <div class="audit-contribution"><AuditGateFocus Row="own" Evaluator="Evaluator" Evaluation="Evaluation" ShowCurrentStatus="false" /></div>
                }
            </li>
        </ol>
        </div>
    </section>
}
    </section>
}
</section>
}

@code {
    [Parameter, EditorRequired] public RenderFragment Workspace { get; set; } = null!;
    [Parameter] public AuditTarget? Target { get; set; }
    [Parameter] public long Selection { get; set; }
    [Parameter, EditorRequired] public RoomAuditEvaluator Evaluator { get; set; } = null!;
    [Parameter, EditorRequired] public AuditCurrentAccess Access { get; set; } = null!;
    [Parameter, EditorRequired] public AuditEndpointMode EndpointMode { get; set; }
    [Parameter] public AuditReverseAccess? Reverse { get; set; }
    [Parameter, EditorRequired] public AuditScenario Scenario { get; set; } = null!;
    [Parameter] public EventCallback<AuditRouteHighlight> HighlightChanged { get; set; }
    [Parameter] public AuditTarget? SceneStep { get; set; }
    [Parameter] public long SceneStepSelection { get; set; }
    private RoomAuditEvaluator? owner;
    private AuditTarget? endpoint;
    private long selection = -1, revision, sceneSelection = -1;
    private long detailRevision;
    private AuditRequirementsContext requirements;
    private AuditRequirementsContext Requirements => Access.Unstarted.Facts.Requirements;
    private string origin = "";
    private AuditEndpointMode endpointMode;
    private bool discovering, analyzing, disposed, traversal;
    private readonly ElementReference[] detailButtons = new ElementReference[2];
    private int? detailFocus;
    private bool CanAnalyze => EndpointMode == AuditEndpointMode.Routes && Scenario.Start.Length > 0 && Target is not null;
    private CancellationTokenSource? cancellation;
    private CancellationTokenSource? detailCancellation;
    private AuditPhysicalRoutes? routes;
    private AuditPhysicalRoute? selectedRoute, hoveredRoute, focusedRoute;
    private Guid? focusedStep;
    private bool analysis;
    private bool hasAlternatives;
    private PreparedAuditRequirementView? preparation;
    private string? discoveryFailure, detailFailure;
    private readonly List<AuditRow> direct = [];
    private AuditPhysicalRoute? ChosenRoute => CanAnalyze ? selectedRoute : null;
    private AuditEvaluation Evaluation => Access.ForOrigin(ChosenRoute?.Origin.Key ?? Scenario.Start);
    private IReadOnlyList<AuditOriginComparison> DirectComparisons => AuditComparisons.For(Evaluator, Access);
    private AuditRouteHighlight publishedHighlight = new([], null);

    private RenderFragment RouteSelector => @<div class="audit-route-choices" aria-label="Routes">
        @if (discovering)
        { <p role="status">Finding routes…</p><button type="button" @onclick="CancelDiscovery">Cancel</button> }
        else if (discoveryFailure is not null)
        { <p role="status">@discoveryFailure</p><button type="button" @onclick="DiscoverAsync">Retry</button> }
        else if (routes is { } found)
        {
            @foreach (var route in found.Paths)
            {
                <button @key="route.Identity" type="button" aria-pressed="@(ReferenceEquals(selectedRoute, route) ? "true" : "false")"
                    @onmouseenter="@(() => PreviewAsync(route, false))" @onmouseleave="@(() => EndPreviewAsync(route, false))"
                    @onfocus="@(() => PreviewAsync(route, true))" @onblur="@(() => EndPreviewAsync(route, true))"
                    @onclick="@(() => ChooseRouteAsync(route))">Route @(route.DiscoveryOrdinal + 1): @RouteChain(route)</button>
            }
            @if (found.Unresolved.Length > 0)
            {
                <details><summary>Unresolved branches (@found.Unresolved.Length)</summary>
                    @foreach (var issue in found.Unresolved)
                    { <p>@Evaluator.RowName(issue.Row): @issue.Reason</p> }
                </details>
            }
        }
    </div>;

    protected override async Task OnParametersSetAsync()
    {
        if (disposed) return;
        if (owner != Evaluator || selection != Selection || endpoint != Target || endpointMode != EndpointMode || origin != Scenario.Start)
        {
            Stop(); owner = Evaluator; selection = Selection; endpoint = Target; endpointMode = EndpointMode; origin = Scenario.Start; requirements = Requirements;
            routes = null; selectedRoute = null; analysis = false; preparation = null; direct.Clear();
            hoveredRoute = null; focusedRoute = null; focusedStep = null; discoveryFailure = null; detailFailure = null;
            if (CanAnalyze) await DiscoverAsync(); else await PublishHighlight();
        }
        else if (requirements != Requirements)
        {
            requirements = Requirements;
            StopDetail(); analysis = false; preparation = null; hasAlternatives = false; detailFailure = null;
            if (ChosenRoute is not null && direct.Count == 0) await AnalyzeSelectedAsync();
        }
        if (sceneSelection != SceneStepSelection)
        {
            sceneSelection = SceneStepSelection;
            if (SceneStep is { } step && Row(step) is { } row)
            {
                if (ChosenRoute is { } path && path.Steps.Any(candidate => candidate.Id == row.Id)) await FocusStepAsync(row.Id);
                else if (ChosenRoute?.OwnGate?.Id == row.Id) await FocusStepAsync(null);
                else await InspectDirectAsync(row);
            }
        }
    }

    private async Task DiscoverAsync()
    {
        if (disposed || !CanAnalyze) return;
        Stop(); routes = null; selectedRoute = null; analysis = false; preparation = null;
        hoveredRoute = null; focusedRoute = null; discoveryFailure = null; detailFailure = null;
        var version = revision; var evaluator = Evaluator; var target = Target!; var scope = new AuditOriginScope(Scenario.Start, false);
        cancellation = new(); var token = cancellation.Token; discovering = true;
        await PublishHighlight();
        if (!Current(version, evaluator)) return;
        try
        {
            var result = await Task.Run(() => evaluator.DiscoverRoutes(scope, target, token), token);
            if (Current(version, evaluator) && !token.IsCancellationRequested) routes = result;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Room audit physical route discovery failed");
            if (Current(version, evaluator)) discoveryFailure = "Routes could not be found. Retry.";
        }
        finally { if (Current(version, evaluator)) discovering = false; }
    }

    private async Task ChooseRouteAsync(AuditPhysicalRoute route)
    {
        if (disposed || !CanAnalyze || routes?.Paths.Any(candidate => ReferenceEquals(candidate, route)) != true) return;
        if (ReferenceEquals(selectedRoute, route) && direct.Count == 0) return;
        if (!ReferenceEquals(selectedRoute, route)) traversal = true;
        detailFocus = null;
        selectedRoute = route; direct.Clear(); focusedStep = null;
        await AnalyzeSelectedAsync();
    }
    private async Task AnalyzeSelectedAsync()
    {
        if (disposed || ChosenRoute is not { } route) return;
        StopDetail(); analysis = false; preparation = null; detailFailure = null;
        var version = revision; var detailVersion = detailRevision; var evaluator = Evaluator; var mode = Requirements;
        detailCancellation = new(); var token = detailCancellation.Token; analyzing = true;
        await PublishHighlight();
        if (!DetailCurrent()) return;
        try
        {
            var result = await Task.Run(() =>
            {
                var prepared = evaluator.PrepareRouteRequirements(route, mode, token);
                token.ThrowIfCancellationRequested(); return (View: prepared, HasAlternatives: !prepared.Empty);
            }, token);
            if (DetailCurrent())
            { analysis = true; preparation = result.View; hasAlternatives = result.HasAlternatives; }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Room audit selected route analysis failed");
            if (DetailCurrent()) detailFailure = "Alternatives could not be analyzed. Retry.";
        }
        finally { if (DetailCurrent()) analyzing = false; }
        bool DetailCurrent() => Current(version, evaluator) && detailVersion == detailRevision && !token.IsCancellationRequested &&
            mode == Requirements && requirements == mode && ReferenceEquals(selectedRoute, route);
    }
    private bool Current(long version, RoomAuditEvaluator evaluator) => !disposed && CanAnalyze && version == revision && owner == evaluator;
    private void StopDetail() { detailRevision++; detailCancellation?.Cancel(); detailCancellation?.Dispose(); detailCancellation = null; analyzing = false; }
    private void Stop() { revision++; cancellation?.Cancel(); cancellation?.Dispose(); cancellation = null; discovering = false; StopDetail(); }
    private Task CancelDiscovery() { Stop(); routes = null; discoveryFailure = "Analysis canceled. No route conclusion was made."; return PublishHighlight(); }
    private void CancelDetail() { StopDetail(); analysis = false; preparation = null; detailFailure = "Analysis canceled. No route conclusion was made."; }
    private AuditRow? Row(AuditTarget target) => Evaluator.Snapshot.Rows.FirstOrDefault(row => row.Kind == target.Kind && row.Id == target.Id);
    private string Name(AuditTarget target) => Row(target) is { } row ? Evaluator.RowName(row) : Evaluator.NodeName(target.Id);
    private AuditRow? OriginRow(AuditPhysicalRoute route) => Evaluator.Snapshot.Rows.FirstOrDefault(row => $"{row.Kind}:{row.Id}" == route.Origin.Key);
    private RenderFragment RouteChain(AuditPhysicalRoute route) => @<span>@RouteIdentity(OriginRow(route), route.Origin.Label)@foreach (var step in route.Steps) { <text> → </text>@RouteIdentity(step, Evaluator.RowName(step)) }<text> → </text>@RouteIdentity(route.OwnGate, Name(route.Target))</span>;
    private RenderFragment RouteIdentity(AuditRow? row, string label)
    {
        var kind = row?.Kind == "connection" ? "Connection" : "Exit";
        var badged = row is { Kind: "connection" or "exit" };
        var alias = string.IsNullOrWhiteSpace(row?.Alias) ? "—" : row.Alias;
        var title = badged ? $"{kind} alias: {alias}; {label}" : label;
        return @<span class="audit-route-identity" title="@title">@if (badged)
            { <span class="@($"audit-route-alias audit-route-alias-{row!.Kind}")" title="@title"><span class="audit-sr-only">@kind alias: </span><span class="audit-route-alias-text">@alias</span></span><text> </text> }@label</span>;
    }
    private Task PreviewAsync(AuditPhysicalRoute route, bool focus)
    {
        if (disposed || !CanAnalyze || routes?.Paths.Any(candidate => ReferenceEquals(candidate, route)) != true) return Task.CompletedTask;
        if (focus) focusedRoute = route; else hoveredRoute = route;
        return PublishHighlight();
    }
    private Task EndPreviewAsync(AuditPhysicalRoute route, bool focus)
    {
        if (focus && ReferenceEquals(focusedRoute, route)) focusedRoute = null;
        if (!focus && ReferenceEquals(hoveredRoute, route)) hoveredRoute = null;
        return PublishHighlight();
    }
    private Task PublishHighlight()
    {
        if (disposed) return Task.CompletedTask;
        var route = hoveredRoute ?? focusedRoute ?? ChosenRoute;
        var connections = route?.Steps.Select(row => row.Id).Concat(route.OwnGate is { Kind: "connection" } own ? [own.Id] : []).ToArray() ?? [];
        var focus = direct.LastOrDefault() is { Kind: "connection" } inspected ? inspected.Id :
            ReferenceEquals(route, ChosenRoute) ? focusedStep : null;
        var nodes = route is null ? [] : route.Steps.SelectMany(row => new[] { row.SourceId, row.DestinationId })
            .Concat([route.Origin.NodeId, route.OwnGate is { } target ? Evaluator.SourceNode(target) : route.Target.Id, route.OwnGate?.DestinationId])
            .Where(id => id.HasValue).Select(id => id!.Value).Distinct().ToArray();
        if (publishedHighlight.OriginKey == route?.Origin.Key && publishedHighlight.Step == focus && publishedHighlight.Connections.SequenceEqual(connections) && (publishedHighlight.Nodes ?? []).SequenceEqual(nodes)) return Task.CompletedTask;
        publishedHighlight = new(connections, focus, nodes, route?.Origin.Key);
        return HighlightChanged.InvokeAsync(publishedHighlight);
    }
    private Task FocusStepAsync(Guid? step) { if (disposed || !CanAnalyze) return Task.CompletedTask; focusedStep = step; return PublishHighlight(); }
    private RenderFragment GateIcon(AuditRow row)
    {
        var status = RoomAuditEvaluator.GateStatusPresentation(row, Evaluation.Rows[(row.Kind, row.Id)]);
        var icon = status.Symbol switch { "✓" => "fa-circle-check", "✕" => "fa-circle-xmark", _ => "fa-circle-question" };
        return @<span class="@status.CssClass" title="@status.Text"><i class="fa-solid @icon fa-fw" aria-hidden="true"></i><span class="audit-sr-only">@status.Text</span></span>;
    }
    private void SelectDetail(bool showTraversal)
    {
        if (disposed || ChosenRoute is null || direct.Count > 0) return;
        traversal = showTraversal; detailFocus = null;
    }
    private void DetailKeyDown(bool fromTraversal, KeyboardEventArgs e)
    {
        var next = e.Key switch { "Home" => 0, "End" => 1, "ArrowLeft" or "ArrowRight" => fromTraversal ? 1 : 0, _ => -1 };
        if (next < 0 || disposed || ChosenRoute is null || direct.Count > 0) return;
        SelectDetail(next == 0); detailFocus = next;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (detailFocus is not { } index || disposed || ChosenRoute is null || direct.Count > 0) return;
        detailFocus = null;
        try { await detailButtons[index].FocusAsync(); }
        catch (Microsoft.JSInterop.JSException exception) { Logger.LogDebug(exception, "Room audit detail tab focus unavailable"); }
    }
    private async Task InspectDirectAsync(AuditRow row)
    {
        if (disposed || direct.LastOrDefault() == row) return;
        if (analyzing) { StopDetail(); analysis = false; preparation = null; }
        direct.Add(row); hoveredRoute = null; focusedRoute = null;
        await PublishHighlight();
    }
    private Task BackAsync()
    {
        if (disposed || direct.Count == 0) return Task.CompletedTask;
        direct.RemoveAt(direct.Count - 1);
        return direct.Count == 0 && ChosenRoute is not null && !analysis && detailFailure is null
            ? AnalyzeSelectedAsync() : PublishHighlight();
    }
    public void Dispose() { disposed = true; Stop(); }
}
