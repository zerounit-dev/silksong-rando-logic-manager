@if (Compact && Evidence.Passed && !Evidence.Unresolved)
{
    <li class="audit-help">@(Evidence.Children.Count > 0 ? $"({(Evidence.Alternatives ? "OR" : "AND")} group satisfied)" : "(prerequisite satisfied)")</li>
}
else
{
<li class="@(Evidence.Unresolved ? "audit-unresolved" : Evidence.Passed ? "audit-passed" : "audit-unmet")">
    <span>@Evidence.Label - @(Evidence.Unresolved ? "unresolved" : Evidence.Passed ? "passed" : "unmet")</span>
    @if (Evidence.ControlKey is { } key) { <button type="button" @onclick="@(() => ControlRequested.InvokeAsync(key))">Scenario control</button> }
    @if (Evidence.Children.Count > 0)
    {
        <strong>@(Evidence.Alternatives ? "OR — one alternative" : "AND — all prerequisites")</strong>
        <ul aria-label="@(Evidence.Alternatives ? "OR alternatives" : "AND prerequisites")">
            @foreach (var child in Evidence.Children) { <AuditPrerequisiteView Compact="Compact" Evidence="child" ControlRequested="ControlRequested" /> }
        </ul>
    }
</li>
}
@code {
    [Parameter, EditorRequired] public AuditPrerequisite Evidence { get; set; } = null!;
    [Parameter] public EventCallback<string> ControlRequested { get; set; }
    [Parameter] public bool Compact { get; set; }
}
