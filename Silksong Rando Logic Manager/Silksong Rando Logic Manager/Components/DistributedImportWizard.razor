@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject DistributedImportPackageParser Parser
@inject DistributedImportApplicationService Importer
@inject SceneImageCaptureService SceneImages
@inject WorkspaceChangeNotifier WorkspaceChanges
@inject DiagnosticState Diagnostics

<InputFile @key="inputVersion" id="distributed-import-input" class="distributed-import-input" OnChange="ReadPackageAsync" accept="application/json,.json" multiple disabled="@(busy || view?.Started == true || view?.State?.HasStarted == true)" />

@if (view is not null)
{
    <div class="confirmation-backdrop distributed-import-backdrop" @onclick="RequestClose">
        <section class="confirmation-modal distributed-import-modal" role="dialog" aria-modal="true" aria-labelledby="distributed-import-title" @onclick:stopPropagation="true">
            <h2 id="distributed-import-title">distributed import</h2>
            @if (view.ParseErrors.Count > 0)
            {
                <div class="distributed-import-summary danger"><strong>package validation failed</strong></div>
            }
            else if (view.Summary is { } summary)
            {
                var package = view.Package!;
                <div class="distributed-import-summary">
                    <span>@(view.FileNames.Count == 1 ? view.FileNames[0] : $"{view.FileNames.Count} selected files") · exchange version @summary.ExportVersion · @(view.FileNames.Count > 1 ? "combined partial room batch" : summary.IsPartialRoomDump == true ? "partial room package" : summary.IsPartialRoomDump == false ? "complete room catalogue" : "snapshot package")</span>
                    <span>maps: @summary.MapCount · groups: @summary.GroupCount · rooms: @summary.RoomCount · subrooms: @summary.SubroomCount · transitions: @summary.TransitionCount · connections: @summary.ConnectionCount · checks: @summary.CheckCount</span>
                    @if (!view.Started)
                    {
                        <div class="distributed-import-options">
                            @if (package.AreaMap is not null) { <label><input type="checkbox" disabled="@busy" @bind="view.ApplyAreaMap" /> apply area map</label> }
                            @if (package.RoomGroupings is not null && package.IsPartialRoomDump != true) { <label><input type="checkbox" disabled="@busy" @bind="view.ApplyGroups" /> apply room groups</label> }
                            @if (package.RoomGroupings is not null && package.IsPartialRoomDump == true) { <span>room-group context is informational and will not be applied.</span> }
                        </div>
                        <p class="warning">Starting commits selected map and group stages, accepted rooms, and any final sweep independently. They cannot be rolled back as one package. Copy the database first where appropriate; import creates no automatic backup.</p>
                    }
                    @if (view.Failure is { } failure) { <p class="danger">@failure.Stage failed: @failure.Message</p> }
                    @if (view.State is { } state)
                    {
                        <div class="distributed-import-stage"><strong>@state.Progress.Stage: @state.Progress.Completed / @state.Progress.Total</strong><span>@state.Progress.Detail</span></div>
                        <div class="distributed-import-stage"><span>area map: @(state.AreaMapOutcome.Applied ? "applied" : "skipped")</span><span>room groups: @(state.RoomGroupingOutcome.Applied ? "applied" : "skipped")</span></div>
                    }
                    @if (CurrentRoomStatus is { } roomStatus)
                    {
                        <p class="danger">@roomStatus.Error</p>
                        @if (roomStatus.Warning is not null) { <p class="warning">@roomStatus.Warning</p> }
                    }
                </div>
            }
            @if (HasVisibleNewOrChangedComparison && !view.CloseWarning)
            {
                <div class="distributed-import-review-utility">
                    <button type="button" disabled="@busy" @onclick="RequestClose">close</button>
                </div>
            }
            <footer class="distributed-import-footer">
                <div>
                    @if (view.Started && !view.Completed && !view.CloseWarning)
                    {
                        <button type="button" disabled="@(!CanGoPrevious)" @onclick="PreviousAsync">previous</button>
                        <button type="button" disabled="@(!CanGoNext)" @onclick="NextAsync">next</button>
                        <button type="button" disabled="@(!CanKeepMaster)" @onclick="(() => DecideAsync(new KeepMasterRoom(view.CurrentComparison!.RoomId)))">keep master room</button>
                        <button type="button" disabled="@(!CanSkipRoom)" @onclick="(() => DecideAsync(new SkipIncomingRoom(view.CurrentComparison!.RoomId)))">skip room</button>
                        <button type="button" disabled="@(!CanKeepOmittedRooms)" @onclick="(() => DecideSweepAsync(false))">keep omitted rooms</button>
                    }
                </div>
                <div>
                    @if (view.CloseWarning) { <span class="warning">Completed operations remain committed.</span><button type="button" disabled="@busy" @onclick="CloseConfirmed">close anyway</button> }
                    else if (view.Completed)
                    {
                        <button type="button" disabled="@(!CanGenerateSceneImages)" @onclick="(() => GenerateSceneImagesAsync(SceneImageRebuildMode.MissingOrStale))">Generate missing or stale images</button>
                        <button type="button" disabled="@(!CanGenerateSceneImages)" @onclick="(() => GenerateSceneImagesAsync(SceneImageRebuildMode.AllUploaded))">Regenerate all uploaded room images</button>
                        <button type="button" disabled="@busy" @onclick="RequestClose">Close</button>
                    }
                    else if (!HasVisibleNewOrChangedComparison) { <button type="button" disabled="@busy" @onclick="RequestClose">@(view.Started ? "close" : "cancel")</button> }
                    @if (!view.Started && view.ParseErrors.Count == 0) { <button type="button" disabled="@busy" @onclick="StartAsync">start import</button> }
                    @if (view.Failure is not null) { <button type="button" disabled="@busy" @onclick="RetryAsync">retry</button> }
                    @if (view.Started && !view.Completed && !view.CloseWarning)
                    {
                        <button type="button" disabled="@(!CanImportRoom)" @onclick="ImportRoomAsync">import room</button>
                        <button type="button" disabled="@(!CanArchiveOmittedRooms)" @onclick="(() => DecideSweepAsync(true))">archive omitted rooms</button>
                    }
                </div>
            </footer>
            <div class="distributed-import-scroll-viewport">
                @if (view.FileNames.Count > 1)
                {
                    <div class="distributed-import-summary"><strong>selected files</strong><ul>@foreach (var fileName in view.FileNames) { <li>@fileName</li> }</ul></div>
                }
                @if (view.ParseErrors.Count > 0)
                {
                    <div class="distributed-import-summary danger"><ul>@foreach (var error in view.ParseErrors) { <li>@error</li> }</ul></div>
                }
                @if (view.Started && view.CurrentComparison is { } comparison)
                {
                    <div class="distributed-import-stage"><strong>room @(view.RoomIndex + 1) / @view.RoomIds.Count</strong><span>@comparison.Kind</span>@foreach (var warning in comparison.Warnings) { <span class="warning">@warning.Message</span> }</div>
                    @if (comparison.Kind is DistributedRoomComparisonKind.New or DistributedRoomComparisonKind.Changed)
                    {
                        <div class="distributed-import-comparison">
                            @if (comparison.Summary is { } summary)
                            {
                                <strong class="distributed-import-comparison-summary">incoming updated: <span class="@UpdatedUtcClass(summary.UpdatedUtc)">@summary.UpdatedUtc.ToString().ToLowerInvariant()</span> · <span class="@(summary.HeaderFieldChanges > 0 ? "distributed-import-summary-count" : null)">header fields: @summary.HeaderFieldChanges</span> · <span class="@(summary.SubroomChanges > 0 ? "distributed-import-summary-count" : null)">subrooms: @summary.SubroomChanges</span> · <span class="@(summary.TransitionChanges > 0 ? "distributed-import-summary-count" : null)">transitions: @summary.TransitionChanges</span> · <span class="@(summary.ConnectionChanges > 0 ? "distributed-import-summary-count" : null)">connections: @summary.ConnectionChanges</span> · <span class="@(summary.CheckChanges > 0 ? "distributed-import-summary-count" : null)">checks: @summary.CheckChanges</span></strong>
                            }
                        <h3>room fields</h3>
                        @foreach (var name in DistributedEvidencePresentation.RoomProse)
                        {
                            <div><span>@DistributedEvidencePresentation.Heading(name): </span><DistributedEvidenceValue Name="@name" Fields="comparison.TopLevelFields" IsRoomProse="true" />
                                @if (DistributedEvidencePresentation.Evidence(name, comparison.TopLevelFields) == DistributedComparisonEvidence.Changed)
                                {
                                    <span> </span><DistributedEvidenceValue Name="@name" Fields="comparison.TopLevelFields" Delta="true" IsRoomProse="true" />
                                }
                            </div>
                        }
                            <RoomFieldEvidenceTable Fields="DistributedEvidencePresentation.RoomScalars.Select(name => comparison.TopLevelFields.Single(item => item.FieldName == name)).ToArray()" />
                            @if (RequiresOriginalChoice(comparison))
                            {
                                <fieldset disabled="@ChildChoicesDisabled"><legend>Uploaded original differs</legend>
                                    <label><input type="radio" name="room-original-choice" checked="@(OriginalChoice(comparison.RoomId) == DistributedOriginalChoice.Keep)" @onchange="(() => ChooseOriginal(comparison.RoomId, DistributedOriginalChoice.Keep))" /> Keep local original</label>
                                    <label><input type="radio" name="room-original-choice" checked="@(OriginalChoice(comparison.RoomId) == DistributedOriginalChoice.Remove)" @onchange="(() => ChooseOriginal(comparison.RoomId, DistributedOriginalChoice.Remove))" /> Remove local original</label>
                                </fieldset>
                            }
                            <div class="distributed-import-view-mode"><span>view mode</span><button type="button" class="@(!ShowFullChildDetail ? "selected" : null)" aria-pressed="@(!ShowFullChildDetail)" @onclick="(() => SetFullChildDetail(false))">diff</button><button type="button" class="@(ShowFullChildDetail ? "selected" : null)" aria-pressed="@ShowFullChildDetail" @onclick="(() => SetFullChildDetail(true))">full detail</button></div>
                            @if (VisibleChildRows(comparison.Subrooms) is { Count: > 0 } subrooms) { <h3>subrooms</h3><ChildEvidenceTable Rows="subrooms" Fields="DistributedChildComparisonColumns.Subrooms" Category="DistributedChildCategory.Subroom" Choices="@CurrentChoices" ChoicesDisabled="@ChildChoicesDisabled" ChoiceChanged="ChildChoiceChanged" /> }
                            @if (VisibleChildRows(comparison.Transitions) is { Count: > 0 } transitions) { <h3>transitions</h3><ChildEvidenceTable Rows="transitions" Fields="DistributedChildComparisonColumns.Transitions" Category="DistributedChildCategory.Transition" Choices="@CurrentChoices" ChoicesDisabled="@ChildChoicesDisabled" ChoiceChanged="ChildChoiceChanged" /> }
                            @if (VisibleChildRows(comparison.Connections) is { Count: > 0 } connections) { <h3>connections</h3><ChildEvidenceTable Rows="connections" Fields="DistributedChildComparisonColumns.Connections" Category="DistributedChildCategory.Connection" Choices="@CurrentChoices" ChoicesDisabled="@ChildChoicesDisabled" ChoiceChanged="ChildChoiceChanged" /> }
                            @if (VisibleChildRows(comparison.Checks) is { Count: > 0 } checks) { <h3>checks</h3><ChildEvidenceTable Rows="checks" Fields="DistributedChildComparisonColumns.Checks" Category="DistributedChildCategory.Check" Choices="@CurrentChoices" ChoicesDisabled="@ChildChoicesDisabled" ChoiceChanged="ChildChoiceChanged" /> }
                        </div>
                    }
                }
                @if (view.Sweep is { } sweep)
                {
                    <div class="distributed-import-stage"><strong>final omitted-room review</strong><ul>@foreach (var room in sweep.Rooms) { <li>@room.FriendlyName</li> }</ul></div>
                }
                @if (view.Completed)
                {
                    <div class="distributed-import-stage"><strong>import complete</strong><span>applied: @view.Applied · skipped/kept: @view.Skipped · failed: @view.Failed</span></div>
                    @if (view.SceneImageError is { } imageError) { <p class="danger">@imageError</p> }
                    @if (view.SceneImageResult is { } imageResult)
                    {
                        <div class="distributed-import-stage"><strong>scene images: @imageResult.Items.Count(item => item.Status == SceneImageRebuildItemStatus.Generated) generated · @imageResult.Items.Count(item => item.Status == SceneImageRebuildItemStatus.Skipped) skipped · @imageResult.Items.Count(item => item.Status == SceneImageRebuildItemStatus.Failed) failed</strong>@foreach (var item in imageResult.Items.Where(item => item.Status != SceneImageRebuildItemStatus.Generated)) { <span>@item.RoomId: @item.Detail</span> }</div>
                    }
                }
            </div>
        </section>
    </div>
}

@code {
    private WizardView? view;
    private bool busy;
    private int inputVersion;
    private const long MaxUploadBytes = 128L * 1024 * 1024;

    private async Task ReadPackageAsync(InputFileChangeEventArgs args)
    {
        if (busy || args.FileCount == 0 || view?.Started == true || view?.State?.HasStarted == true) return;
        busy = true;
        view = null;
        var files = args.GetMultipleFiles(args.FileCount);
        var names = files.Select(file => file.Name).ToArray();
        try
        {
            long total = 0;
            foreach (var file in files)
            {
                if (file.Size > MaxUploadBytes - total)
                {
                    view = new(names, null, null, [$"{string.Join(", ", names)}: total selected file size exceeds 128 MiB (134217728 bytes)."]);
                    return;
                }
                total += file.Size;
            }
            var parsed = new List<DistributedImportFilePackage>();
            var errors = new List<string>();
            long bytesRead = 0;
            foreach (var file in files)
            {
                try
                {
                    await using var stream = file.OpenReadStream(MaxUploadBytes);
                    using var memory = new MemoryStream();
                    var buffer = new byte[81920];
                    int count;
                    while ((count = await stream.ReadAsync(buffer)) != 0)
                    {
                        if (count > MaxUploadBytes - bytesRead)
                        {
                            view = new(names, null, null, [$"{string.Join(", ", names)}: total selected content exceeds 128 MiB (134217728 bytes)."]);
                            return;
                        }
                        bytesRead += count;
                        memory.Write(buffer, 0, count);
                    }
                    var result = Parser.Parse(memory.ToArray());
                    if (result is DistributedImportPackageValidated valid) parsed.Add(new(file.Name, valid.Package));
                    else if (result is DistributedImportPackageRejected rejected) errors.AddRange(rejected.Errors.Select(error => $"{file.Name}: {error}"));
                    else throw new InvalidOperationException("Package parsing returned an unknown outcome.");
                }
                catch (IOException) { errors.Add($"{file.Name}: the selected file could not be read. Close and reselect the files to retry."); }
            }
            if (errors.Count != 0) { view = new(names, null, null, errors); return; }
            var composed = Parser.ComposePartialSelection(parsed);
            if (composed is DistributedImportPackageRejected batchRejected) { view = new(names, null, null, batchRejected.Errors); return; }
            var combined = (DistributedImportPackageValidated)composed;
            var admission = await Importer.PrepareAsync(combined.Package);
            view = admission is DistributedImportRejected rejectedAdmission
                ? new(names, null, null, rejectedAdmission.Errors.Select(error => names.Length == 1 ? $"{names[0]}: {error}" : error).ToArray())
                : new(names, combined.Package, combined.Summary, []);
        }
        catch (Exception exception) { view = new(names, null, null, [$"{string.Join(", ", names)}: selection validation could not finish because of an unexpected error. Consult the diagnostic details and server logs, then close and reselect to retry."]); Diagnostics.Show(exception.ToString()); }
        finally { busy = false; }
    }

    private async Task StartAsync() { if (busy || view?.Package is null || view.Started || view.ParseErrors.Count != 0) return; await StartAttemptAsync(view.State); }
    private async Task RetryAsync()
    {
        if (busy) return;
        if (view?.RetryIntent is { } retry && view.State is not null && view.CurrentComparison is not null) await DecideAsync(retry);
        else if (view?.RetrySweepArchive is { } archive) await DecideSweepAsync(archive);
        else if (view is { Started: true, State: not null })
        {
            busy = true;
            try { view.Failure = null; await LoadCurrentAsync(view.AdvanceIdentical); }
            catch (Exception exception) { RecordUnexpectedFailure("read preparation", exception); }
            finally { busy = false; }
        }
        else if (view?.Package is not null) await StartAttemptAsync(view.State);
    }
    private async Task StartAttemptAsync(DistributedImportOrchestrationState? prior)
    {
        busy = true;
        try
        {
            var current = view!;
            var outcome = await Importer.StartAsync(new(current.Package!, current.ApplyAreaMap, current.ApplyGroups), prior);
            if (outcome is DistributedImportStarted started) { current.State = started.State; current.Started = true; current.Failure = null; WorkspaceChanges.NotifyChanged(); await LoadCurrentAsync(); }
            else if (outcome is DistributedImportFailed failed) { current.Failure = failed; current.State = failed.State; current.Failed++; }
            else if (outcome is DistributedImportRejected rejected) current.ParseErrors = rejected.Errors.ToList();
        }
        catch (DistributedImportInterruptedException exception) { view!.State = exception.State; RecordUnexpectedFailure("start import", exception); }
        catch (Exception exception) { RecordUnexpectedFailure(view?.Started == true ? "read preparation" : "start import", exception); }
        finally { busy = false; }
    }
    private async Task LoadCurrentAsync(bool advanceIdentical = true)
    {
        if (view is null || view.State is null) return;
        view.AdvanceIdentical = advanceIdentical;
        if (view.State.ReviewRoomIds is null)
        {
            var preparation = await Importer.PrepareRoomsAsync(view.State);
            if (preparation is DistributedImportStarted prepared)
            {
                view.State = prepared.State;
                view.RoomIds = prepared.State.ReviewRoomIds!.ToList();
                view.Skipped = prepared.State.DecidedRoomIds.Count;
            }
            else if (preparation is DistributedImportRejected rejected) { view.ParseErrors = rejected.Errors.ToList(); return; }
            else if (preparation is DistributedImportFailed failed) { view.Failure = failed; view.Failed++; return; }
        }
        while (view.RoomIndex < view.RoomIds.Count)
        {
            if (view.Reviews.TryGetValue(view.RoomIndex, out var reviewed))
            {
                if (advanceIdentical && view.DecidedRoomIndexes.Contains(view.RoomIndex)) { view.CurrentComparison = null; view.RoomIndex++; continue; }
                view.CurrentComparison = reviewed;
                return;
            }
            var outcome = await Importer.PrepareRoomAsync(view.State, view.RoomIds[view.RoomIndex]);
            if (outcome is DistributedImportRoomSkipped skipped)
            {
                view.State = skipped.State;
                if (view.DecidedRoomIndexes.Add(view.RoomIndex)) view.Skipped++;
                SetCurrentComparison(skipped.Comparison!);
                if (!advanceIdentical) return;
                view.CurrentComparison = null;
                view.RoomIndex++;
                continue;
            }
            if (outcome is DistributedImportRoomPrepared prepared) { SetCurrentComparison(prepared.Comparison); return; }
            if (outcome is DistributedImportFailed failed) { view.Failure = failed; view.Failed++; return; }
            if (outcome is DistributedImportRejected rejected) { view.ParseErrors = rejected.Errors.ToList(); return; }
        }
        if (view.State.PendingRoomIds.Count > 0)
        {
            // Navigation may have left earlier rooms undecided. Never complete a
            // package (or sweep) merely because the visible index reached its end.
            view.RoomIndex = view.RoomIds.FindIndex(view.State.PendingRoomIds.Contains);
            await LoadCurrentAsync(advanceIdentical);
            return;
        }
        view.CurrentComparison = null;
        var sweep = await Importer.PrepareSweepAsync(view.State);
        if (sweep is DistributedImportSweepPrepared preparedSweep && preparedSweep.Rooms.Count > 0) view.Sweep = preparedSweep;
        else if (sweep is DistributedImportSweepPrepared) view.Completed = true;
        else if (sweep is DistributedImportRejected rejected) view.ParseErrors = rejected.Errors.ToList();
        else if (sweep is DistributedImportFailed failed) { view.Failure = failed; view.Failed++; }
    }
    private async Task DecideAsync(DistributedRoomDecisionIntent intent)
    {
        if (busy || view?.State is null || view.CurrentComparison is null || !HasCurrentUndecidedComparison) return; busy = true;
        try
        {
            view.RoomStatuses.Remove(intent.RoomId);
            view.RetryIntent = intent;
            var outcome = await Importer.DecideRoomAsync(view.State, intent, view.CurrentComparison);
            if (outcome is DistributedImportComparisonRefreshed fresh)
            {
                view.Failure = null;
                view.RetryIntent = null;
                view.CurrentComparison = fresh.Comparison;
                view.Reviews[view.RoomIndex] = fresh.Comparison;
                ResetChildPlan(fresh.Comparison);
                view.RoomStatuses[fresh.Comparison.RoomId] = new("Room import was not applied.", "The room changed after this comparison was loaded. The comparison was refreshed and this room's child choices were reset to incoming defaults.");
                fullDetailRoomId = null;
                return;
            }
            if (outcome is DistributedImportRoomBecameIdentical identical)
            {
                view.Failure = null;
                view.RetryIntent = null;
                view.RoomStatuses.Remove(identical.RoomId);
                view.State = identical.State;
                view.Reviews[view.RoomIndex] = identical.Comparison;
                if (view.DecidedRoomIndexes.Add(view.RoomIndex)) view.Skipped++;
                view.CurrentComparison = null;
                view.RoomIndex++;
                await LoadCurrentAsync();
                return;
            }
            if (outcome is DistributedImportRoomApplied applied) { view.State = applied.State; if (view.DecidedRoomIndexes.Add(view.RoomIndex)) view.Applied++; }
            if (outcome is DistributedImportRoomSkipped skipped) { view.State = skipped.State; if (view.DecidedRoomIndexes.Add(view.RoomIndex)) view.Skipped++; }
            if (outcome is DistributedImportRoomKept kept) { view.State = kept.State; if (view.DecidedRoomIndexes.Add(view.RoomIndex)) view.Skipped++; }
            if (outcome is DistributedImportFailed failed) { view.Failure = failed; view.RetryIntent = intent; view.Failed++; return; }
            if (outcome is DistributedImportRejected rejected)
            {
                view.Failure = null;
                view.RetryIntent = null;
                view.RoomStatuses[intent.RoomId] = new($"Room decision was not accepted. {string.Join(" ", rejected.Errors)}", null);
                return;
            }
            if (outcome is not (DistributedImportRoomApplied or DistributedImportRoomSkipped or DistributedImportRoomKept))
                throw new InvalidOperationException("Room application returned an unknown outcome.");
            view.Failure = null; view.RetryIntent = null;
            view.RoomStatuses.Remove(intent.RoomId);
            view.DecidedRoomIndexes.Add(view.RoomIndex);
            view.CurrentComparison = null; view.RoomIndex++;
            view.AdvanceIdentical = true;
            // All committed bookkeeping is durable in this wizard before cleanup
            // diagnostics, workspace notification, or any next-room read can fail.
            if (outcome is DistributedImportRoomApplied committed)
            {
                if (committed.CleanupException is { } cleanup) Diagnostics.Show(cleanup.ToString());
                WorkspaceChanges.NotifyChanged();
            }
            await LoadCurrentAsync();
        }
        catch (Exception exception) { RecordUnexpectedFailure(view?.RetryIntent is null ? "read preparation" : "room", exception); }
        finally { busy = false; }
    }
    private Task ImportRoomAsync()
    {
        if (view?.CurrentComparison is not { } comparison) return Task.CompletedTask;
        if (comparison.Kind == DistributedRoomComparisonKind.New)
            return DecideAsync(new ImportIncomingRoom(comparison.RoomId));
        if (comparison.Kind == DistributedRoomComparisonKind.Changed && view.ChildPlans.TryGetValue(comparison.RoomId, out var choices))
        {
            var decisions = ChildDifferences(comparison)
                .Select(item => new DistributedChildDecision(item.Key.Category, item.Key.EntityId, item.Evidence, choices[item.Key]))
                .ToArray();
            return DecideAsync(new ImportChangedRoom(comparison.RoomId, new(comparison.RoomId, decisions), OriginalChoice(comparison.RoomId)));
        }
        return Task.CompletedTask;
    }
    private async Task DecideSweepAsync(bool archive)
    {
        if (busy || view?.State is null || view.Sweep is null) return; busy = true;
        try
        {
            view.RetrySweepArchive = archive;
            var result = await Importer.DecideSweepAsync(view.State, view.Sweep.Review, archive);
            if (result is DistributedImportFailed failed) { view.Failure = failed; view.Failed++; return; }
            if (result is DistributedImportRejected rejected) { view.RetrySweepArchive = null; view.ParseErrors = rejected.Errors.ToList(); return; }
            if (result is DistributedImportSweepCompleted completed)
            {
                if (completed.Archived) view.Applied++; else view.Skipped++;
                view.Sweep = null; view.Completed = true; view.Failure = null; view.RetrySweepArchive = null;
                if (completed.Archived) WorkspaceChanges.NotifyChanged();
            }
        }
        catch (Exception exception) { RecordUnexpectedFailure("final-sweep", exception); }
        finally { busy = false; }
    }
    private async Task GenerateSceneImagesAsync(SceneImageRebuildMode mode)
    {
        if (busy || view is not { Completed: true, State: not null }) return;
        busy = true;
        view.SceneImageResult = null;
        view.SceneImageError = null;
        try
        {
            view.SceneImageResult = await SceneImages.RebuildPackageRoomsAsync(new(view.State.Package.Rooms.Select(room => room.Id).ToArray(), mode));
            ShowImageCleanupDiagnostics(view.SceneImageResult);
        }
        catch (SceneImageRebuildInterruptedException exception)
        {
            view.SceneImageResult = exception.Result;
            view.SceneImageError = "Image generation stopped unexpectedly. Earlier results remain committed; consult diagnostics and server logs.";
            ShowImageCleanupDiagnostics(exception.Result);
            Diagnostics.Show(exception.ToString());
        }
        catch (Exception exception) { view.SceneImageError = "Image generation failed unexpectedly; consult diagnostics and server logs."; Diagnostics.Show(exception.ToString()); }
        finally { busy = false; }
    }
    private void ShowImageCleanupDiagnostics(SceneImageRebuildResult result)
    {
        if (result.CleanupExceptions.Count == 0) return;
        const string message = "Images were committed, but postcommit cleanup failed; consult diagnostics and server logs.";
        view!.SceneImageError = view.SceneImageError is { } previous ? $"{previous} {message}" : message;
        Diagnostics.Show(new AggregateException(result.CleanupExceptions).ToString());
    }
    private async Task PreviousAsync()
    {
        if (!CanGoPrevious) return;
        busy = true;
        try { view!.RoomIndex--; view.CurrentComparison = null; await LoadCurrentAsync(false); }
        catch (Exception exception) { RecordUnexpectedFailure("read preparation", exception); }
        finally { busy = false; }
    }
    private async Task NextAsync()
    {
        if (!CanGoNext) return;
        busy = true;
        try { view!.RoomIndex++; view.CurrentComparison = null; await LoadCurrentAsync(false); }
        catch (Exception exception) { RecordUnexpectedFailure("read preparation", exception); }
        finally { busy = false; }
    }
    private void RecordUnexpectedFailure(string stage, Exception exception)
    {
        if (view is not null)
        {
            view.Failure = new(stage, "An unexpected error has occurred. Consult the diagnostic details and server logs.", view.State);
            view.Failed++;
        }
        Diagnostics.Show(exception.ToString());
    }
    private void RequestClose() { if (busy) return; if (view is { Completed: false } current && (current.Started || current.State?.HasStarted == true)) { current.CloseWarning = true; } else ClearView(); }
    private void CloseConfirmed() { if (!busy) ClearView(); }
    private void ClearView() { view = null; fullDetailRoomId = null; inputVersion++; }
    private bool HasCurrentUndecidedComparison => view?.CurrentComparison is { } comparison && view.State?.PendingRoomIds.Contains(comparison.RoomId) == true && !view.DecidedRoomIndexes.Contains(view.RoomIndex);
    private bool HasVisibleNewOrChangedComparison => view?.CurrentComparison?.Kind is DistributedRoomComparisonKind.New or DistributedRoomComparisonKind.Changed;
    private bool CanGoPrevious => view is not null && !busy && view.Failure is null && view.Started && !view.Completed && view.RoomIndex > 0;
    private bool CanGoNext => view is not null && !busy && view.Failure is null && view.Started && !view.Completed && view.RoomIndex + 1 < view.RoomIds.Count;
    private bool CanKeepMaster => !busy && view?.Failure is null && HasCurrentUndecidedComparison && view!.CurrentComparison!.Kind == DistributedRoomComparisonKind.Changed;
    private bool CanSkipRoom => !busy && view?.Failure is null && HasCurrentUndecidedComparison && view!.CurrentComparison!.Kind == DistributedRoomComparisonKind.New;
    private bool CanImportRoom => !busy && view?.Failure is null && HasCurrentUndecidedComparison && view!.CurrentComparison!.Kind is DistributedRoomComparisonKind.New or DistributedRoomComparisonKind.Changed;
    private bool CanKeepOmittedRooms => !busy && view?.Failure is null && view?.Sweep is not null;
    private bool CanArchiveOmittedRooms => CanKeepOmittedRooms;
    private bool CanGenerateSceneImages => !busy && view is { Completed: true, State: not null };
    private static string? UpdatedUtcClass(DistributedUpdatedUtcComparison comparison) => comparison switch { DistributedUpdatedUtcComparison.Newer => "distributed-import-newer", DistributedUpdatedUtcComparison.Older => "distributed-import-older", _ => null };
    private Guid? fullDetailRoomId;
    private bool ShowFullChildDetail => view?.CurrentComparison is { } comparison && fullDetailRoomId == comparison.RoomId;
    private void SetFullChildDetail(bool full) => fullDetailRoomId = full ? view?.CurrentComparison?.RoomId : null;
    private IReadOnlyList<DistributedChildComparison<T>> VisibleChildRows<T>(IReadOnlyList<DistributedChildComparison<T>> rows) => ShowFullChildDetail ? rows : rows.Where(x => x.Evidence != DistributedComparisonEvidence.Neutral).ToArray();
    private IReadOnlyDictionary<DistributedChildDecisionKey, DistributedChildChoice>? CurrentChoices => view?.CurrentComparison is { Kind: DistributedRoomComparisonKind.Changed } comparison && view.ChildPlans.TryGetValue(comparison.RoomId, out var choices) ? choices : null;
    private bool ChildChoicesDisabled => busy || view?.Failure is not null || view?.DecidedRoomIndexes.Contains(view.RoomIndex) == true;
    private RoomStatus? CurrentRoomStatus => view?.CurrentComparison is { } comparison ? view.RoomStatuses.GetValueOrDefault(comparison.RoomId) : null;

    private void ChildChoiceChanged(DistributedChildChoiceChanged changed)
    {
        if (ChildChoicesDisabled || view?.CurrentComparison is not { Kind: DistributedRoomComparisonKind.Changed } comparison) return;
        if (view.ChildPlans.TryGetValue(comparison.RoomId, out var choices) && choices.ContainsKey(changed.Key)) choices[changed.Key] = changed.Choice;
    }

    private void SetCurrentComparison(DistributedRoomComparison comparison)
    {
        view!.CurrentComparison = comparison;
        view.Reviews[view.RoomIndex] = comparison;
        EnsureChildPlan(comparison);
    }

    private void EnsureChildPlan(DistributedRoomComparison comparison)
    {
        if (comparison.Kind != DistributedRoomComparisonKind.Changed || view!.ChildPlans.ContainsKey(comparison.RoomId)) return;
        ResetChildPlan(comparison);
    }

    private void ResetChildPlan(DistributedRoomComparison comparison)
    {
        originalChoices.Remove(comparison.RoomId);
        view!.ChildPlans[comparison.RoomId] = ChildDifferences(comparison).ToDictionary(x => x.Key, _ => DistributedChildChoice.Incoming);
    }
    private readonly Dictionary<Guid, DistributedOriginalChoice> originalChoices = [];
    private DistributedOriginalChoice? OriginalChoice(Guid roomId) => originalChoices.TryGetValue(roomId, out var choice) ? choice : null;
    private static bool RequiresOriginalChoice(DistributedRoomComparison comparison) => comparison.Kind == DistributedRoomComparisonKind.Changed && comparison.TopLevelFields.Any(x => x.FieldName == "sceneImageOriginalHash" && x.Evidence != DistributedComparisonEvidence.Neutral);
    private void ChooseOriginal(Guid roomId, DistributedOriginalChoice choice) { if (!ChildChoicesDisabled) originalChoices[roomId] = choice; }

    private static IEnumerable<(DistributedChildDecisionKey Key, DistributedComparisonEvidence Evidence)> ChildDifferences(DistributedRoomComparison comparison)
    {
        foreach (var row in comparison.Subrooms.Where(x => x.Evidence != DistributedComparisonEvidence.Neutral)) yield return (new(DistributedChildCategory.Subroom, row.EntityId), row.Evidence);
        foreach (var row in comparison.Transitions.Where(x => x.Evidence != DistributedComparisonEvidence.Neutral)) yield return (new(DistributedChildCategory.Transition, row.EntityId), row.Evidence);
        foreach (var row in comparison.Connections.Where(x => x.Evidence != DistributedComparisonEvidence.Neutral)) yield return (new(DistributedChildCategory.Connection, row.EntityId), row.Evidence);
        foreach (var row in comparison.Checks.Where(x => x.Evidence != DistributedComparisonEvidence.Neutral)) yield return (new(DistributedChildCategory.Check, row.EntityId), row.Evidence);
    }

    private sealed record RoomStatus(string Error, string? Warning);
    private sealed class WizardView(IReadOnlyList<string> fileNames, DistributedImportPackage? package, DistributedImportPackageSummary? summary, IReadOnlyList<string> errors)
    {
        public IReadOnlyList<string> FileNames { get; } = fileNames;
        public DistributedImportPackage? Package { get; } = package;
        public DistributedImportPackageSummary? Summary { get; } = summary;
        public List<string> ParseErrors { get; set; } = errors.ToList();
        public bool ApplyAreaMap { get; set; } = true;
        public bool ApplyGroups { get; set; }
        public bool Started { get; set; }
        public bool Completed { get; set; }
        public bool CloseWarning { get; set; }
        public int RoomIndex { get; set; }
        public int Applied { get; set; }
        public int Skipped { get; set; }
        public int Failed { get; set; }
        public bool AdvanceIdentical { get; set; } = true;
        public bool? RetrySweepArchive { get; set; }
        public DistributedImportOrchestrationState? State { get; set; }
        public DistributedImportFailed? Failure { get; set; }
        public DistributedRoomDecisionIntent? RetryIntent { get; set; }
        public DistributedRoomComparison? CurrentComparison { get; set; }
        public DistributedImportSweepPrepared? Sweep { get; set; }
        public SceneImageRebuildResult? SceneImageResult { get; set; }
        public string? SceneImageError { get; set; }
        public List<Guid> RoomIds { get; set; } = [];
        public Dictionary<int, DistributedRoomComparison> Reviews { get; } = [];
        public HashSet<int> DecidedRoomIndexes { get; } = [];
        public Dictionary<Guid, Dictionary<DistributedChildDecisionKey, DistributedChildChoice>> ChildPlans { get; } = [];
        public Dictionary<Guid, RoomStatus> RoomStatuses { get; } = [];
    }
}
