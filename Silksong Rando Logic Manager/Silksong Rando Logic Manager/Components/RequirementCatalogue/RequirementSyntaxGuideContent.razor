@using Microsoft.AspNetCore.Components.Rendering
@using Silksong_Rando_Logic_Manager.Services

<section class="requirement-syntax-guide" aria-label="Requirement syntax guide">
    <h2 id="v2-page-modal-title">syntax guide</h2>
    <div class="requirement-syntax-guide-tabs" role="tablist" aria-label="Syntax guide section">
        <button id="requirement-syntax-guide-tab-how-to-write" type="button" role="tab" aria-selected="@(tab == GuideTab.HowToWrite)" aria-controls="requirement-syntax-guide-content" class="@(tab == GuideTab.HowToWrite ? "selected" : null)" @onclick="() => tab = GuideTab.HowToWrite">How to write</button>
        <button id="requirement-syntax-guide-tab-location-types" type="button" role="tab" aria-selected="@(tab == GuideTab.LocationTypes)" aria-controls="requirement-syntax-guide-content" class="@(tab == GuideTab.LocationTypes ? "selected" : null)" @onclick="() => tab = GuideTab.LocationTypes">Location types</button>
        <button id="requirement-syntax-guide-tab-requirement-types" type="button" role="tab" aria-selected="@(tab == GuideTab.RequirementTypes)" aria-controls="requirement-syntax-guide-content" class="@(tab == GuideTab.RequirementTypes ? "selected" : null)" @onclick="() => tab = GuideTab.RequirementTypes">Requirement types</button>
        <button id="requirement-syntax-guide-tab-crests" type="button" role="tab" aria-selected="@(tab == GuideTab.Crests)" aria-controls="requirement-syntax-guide-content" class="@(tab == GuideTab.Crests ? "selected" : null)" @onclick="() => tab = GuideTab.Crests">Crests</button>
        <button id="requirement-syntax-guide-tab-methods" type="button" role="tab" aria-selected="@(tab == GuideTab.Methods)" aria-controls="requirement-syntax-guide-content" class="@(tab == GuideTab.Methods ? "selected" : null)" @onclick="() => tab = GuideTab.Methods">Methods</button>
        <button id="requirement-syntax-guide-tab-items" type="button" role="tab" aria-selected="@(tab == GuideTab.Items)" aria-controls="requirement-syntax-guide-content" class="@(tab == GuideTab.Items ? "selected" : null)" @onclick="() => tab = GuideTab.Items">Items</button>
        <button id="requirement-syntax-guide-tab-countables" type="button" role="tab" aria-selected="@(tab == GuideTab.Countables)" aria-controls="requirement-syntax-guide-content" class="@(tab == GuideTab.Countables ? "selected" : null)" @onclick="() => tab = GuideTab.Countables">Countables</button>
        <button id="requirement-syntax-guide-tab-souls" type="button" role="tab" aria-selected="@(tab == GuideTab.Souls)" aria-controls="requirement-syntax-guide-content" class="@(tab == GuideTab.Souls ? "selected" : null)" @onclick="() => tab = GuideTab.Souls">Souls</button>
    </div>
    <div id="requirement-syntax-guide-content" class="requirement-syntax-guide-content" role="tabpanel" aria-labelledby="@ActiveTabId">
        @if (tab == GuideTab.HowToWrite)
        {
            <div class="requirement-syntax-guide-prose">
                <section>
                    <h3>Write a requirement</h3>
                    <p>A requirement is a recognized phrase such as <code><span class="guide-token-requirement">dash</span></code>, <code><span class="guide-token-requirement">break vines</span> <span class="guide-token-direction">left</span></code>, or <code><span class="guide-token-difficulty">hard</span> <span class="guide-token-requirement">spike pogo</span></code>.</p>
                    <p>The Requirement types view shows each accepted pattern. Words in braces are replaced with the described value, and <code>?</code> marks an optional value. Requirement types, Crests, Methods, Items, Countables, and Souls are the current accepted vocabulary.</p>
                    <p>Use <code><span class="guide-token-requirement">none</span></code> when nothing is required. Use <code><span class="guide-token-requirement">invalid</span></code> when the requirement can never be met.</p>
                </section>
                <section>
                    <h3>Combine requirements</h3>
                    <p>Use uppercase <code class="guide-token-fixed">AND</code> or <code class="guide-token-fixed">OR</code> throughout one chain: <code><span class="guide-token-requirement">dash</span> <span class="guide-token-fixed">AND</span> <span class="guide-token-requirement">clawline</span> <span class="guide-token-fixed">AND</span> <span class="guide-token-requirement">silk soar</span></code> or <code><span class="guide-token-requirement">dash</span> <span class="guide-token-fixed">OR</span> <span class="guide-token-requirement">clawline</span></code>. When mixing them, use parentheses to make the grouping explicit: <code><span class="guide-token-requirement">dash</span> <span class="guide-token-fixed">AND</span> (<span class="guide-token-requirement">clawline</span> <span class="guide-token-fixed">OR</span> <span class="guide-token-requirement">silk soar</span>)</code>.</p>
                </section>
                <section>
                    <h3>Choose between values</h3>
                    <p>Where a pattern shows square brackets, use commas to list alternatives: <code><span class="guide-token-requirement">break vines</span> [<span class="guide-token-direction">left</span>, <span class="guide-token-direction">right</span>]</code> means break vines left or right. For one value, brackets are optional: <code><span class="guide-token-requirement">break vines</span> <span class="guide-token-direction">left</span></code> or <code><span class="guide-token-requirement">break vines</span> [<span class="guide-token-direction">left</span>]</code>.</p>
                </section>
                <section>
                    <h3>Add a difficulty</h3>
                    <p>The only <span class="guide-token-difficulty">difficulty</span> values are <code class="guide-token-difficulty">easy</code>, <code class="guide-token-difficulty">medium</code>, <code class="guide-token-difficulty">hard</code>, <code class="guide-token-difficulty">cbt</code>, and <code class="guide-token-difficulty">intended</code>. A required <span class="guide-token-difficulty">difficulty</span> appears before its requirement type: <code><span class="guide-token-difficulty">{difficulty}</span> <span class="guide-token-requirement">heal stall</span></code>, for example <code><span class="guide-token-difficulty">medium</span> <span class="guide-token-requirement">heal stall</span></code>.</p>
                    <p>An optional <span class="guide-token-difficulty">difficulty</span> uses <code><span class="guide-token-difficulty">{difficulty?}</span> <span class="guide-token-requirement">scuttlebrace</span></code>. Write <code><span class="guide-token-requirement">scuttlebrace</span></code> or add a <span class="guide-token-difficulty">difficulty</span>, as in <code><span class="guide-token-difficulty">hard</span> <span class="guide-token-requirement">scuttlebrace</span></code>.</p>
                </section>
                <section>
                    <h3>Add a direction</h3>
                    <p>The only <span class="guide-token-direction">direction</span> values are <code class="guide-token-direction">left</code>, <code class="guide-token-direction">right</code>, <code class="guide-token-direction">up</code>, <code class="guide-token-direction">down</code>, <code class="guide-token-direction">both</code>, <code class="guide-token-direction">either</code>, <code class="guide-token-direction">any</code>, and <code class="guide-token-direction">all</code>. A <span class="guide-token-direction">direction</span> follows the requirement type: <code><span class="guide-token-requirement">break vines</span> [<span class="guide-token-direction">{direction}</span>]</code>. Examples are <code><span class="guide-token-requirement">break vines</span> <span class="guide-token-direction">left</span></code> and <code><span class="guide-token-requirement">open airlock</span> <span class="guide-token-direction">right</span></code>.</p>
                    <p>Each value is kept literally, not expanded into other directions. Logic Manager does not restrict which value fits a requirement; the downstream consumer decides what it means.</p>
                    <p>A requirement type showing <code>[<span class="guide-token-direction">{direction?}</span>]</code> lets you omit the <span class="guide-token-direction">direction</span>; <code>[<span class="guide-token-direction">{direction}</span>]</code> still requires one. Check Requirement types to see which form is accepted.</p>
                </section>
                <section>
                    <h3>Require an amount</h3>
                    <p>Some requirements take a number directly, such as <code><span class="guide-token-requirement">clawline x</span> <span class="guide-token-amount">2</span></code>, <code><span class="guide-token-requirement">sharpdart x</span> <span class="guide-token-amount">3</span></code>, or <code><span class="guide-token-requirement">silkhearts x</span> <span class="guide-token-amount">2</span></code>.</p>
                </section>
                <section>
                    <h3>Use a crest</h3>
                    <p>Use a <span class="guide-token-crest">crest name</span> for <code class="guide-token-crest">{crest}</code>: <code><span class="guide-token-crest">shaman</span> <span class="guide-token-requirement">attack</span> <span class="guide-token-direction">up</span></code>, <code><span class="guide-token-difficulty">easy</span> <span class="guide-token-crest">shaman</span> <span class="guide-token-requirement">pogo</span></code>, or <code><span class="guide-token-difficulty">easy</span> <span class="guide-token-crest">shaman</span> <span class="guide-token-requirement">charge</span></code>.</p>
                    <p>With <code class="guide-token-crest">{crest?}</code>, the <span class="guide-token-crest">crest</span> is optional: <code><span class="guide-token-requirement">attack</span> <span class="guide-token-direction">up</span></code> or <code><span class="guide-token-difficulty">easy</span> <span class="guide-token-requirement">charge</span></code>.</p>
                </section>
                <section>
                    <h3>Use a method</h3>
                    <p>Use a <span class="guide-token-method">method name</span> for <code class="guide-token-method">{method}</code>: <code><span class="guide-token-difficulty">easy</span> <span class="guide-token-method">heal</span> <span class="guide-token-requirement">stall</span></code> or <code><span class="guide-token-difficulty">easy</span> <span class="guide-token-method">flintslate</span> <span class="guide-token-requirement">stall</span></code>.</p>
                    <p>Use commas to list alternatives: <code><span class="guide-token-difficulty">easy</span> [<span class="guide-token-method">heal</span>, <span class="guide-token-method">flintslate</span>, <span class="guide-token-method">voltvessels</span>] <span class="guide-token-requirement">stall</span></code> means any one of those <span class="guide-token-method">methods</span> at <span class="guide-token-difficulty">easy</span> difficulty.</p>
                    <h3>Require an item</h3>
                    <p>Use <code><span class="guide-token-requirement">have</span> <span class="guide-token-item">{item}</span></code> for <span class="guide-token-item">item</span> ownership, for example <code><span class="guide-token-requirement">have</span> <span class="guide-token-item">curveclaw</span></code>.</p>
                    <p><code><span class="guide-token-requirement">scuttlebrace</span></code> means the player can perform the movement technique: owning <span class="guide-token-item">Scuttlebrace</span>, having <span class="guide-token-requirement">Dash</span>, and having an available <span class="guide-token-item">yellow tool slot</span> to equip it. <code><span class="guide-token-requirement">have</span> <span class="guide-token-item">scuttlebrace</span></code> means ownership only; it does not by itself require Dash, an available slot, or the ability to use the technique.</p>
                </section>
                <section>
                    <h3>Require a countable</h3>
                    <p>Use an amount with a <span class="guide-token-countable">countable name</span>, for example <code><span class="guide-token-requirement">get</span> <span class="guide-token-amount">5</span> <span class="guide-token-countable">mossberries</span></code>, <code><span class="guide-token-requirement">at least</span> <span class="guide-token-amount">2</span> <span class="guide-token-countable">tool slots unlocked</span></code>, or <code><span class="guide-token-requirement">spend</span> <span class="guide-token-amount">20</span> <span class="guide-token-countable">rosaries</span></code>.</p>
                </section>
                <section>
                    <h3>Require a soul</h3>
                    <p>Replace <code class="guide-token-soul">{soul}</code> with a <span class="guide-token-soul">soul name</span>, such as <code class="guide-token-soul">Mossgrub</code>. Souls encompass enemies, bosses, and NPCs.</p>
                </section>
                <section>
                    <h3>Refer to another check</h3>
                    <table class="requirement-syntax-guide-table requirement-syntax-guide-checks">
                        <thead><tr><th>Where to search</th><th>Syntax</th><th>Example</th></tr></thead>
                        <tbody>
                            <tr><td>This room</td><td><code><span class="guide-token-requirement">complete</span> <span class="guide-token-check-local">&lt;check name&gt;</span></code></td><td><code><span class="guide-token-requirement">complete</span> <span class="guide-token-check-local">bellway pay gate</span></code></td></tr>
                            <tr><td>One named room</td><td><code><span class="guide-token-requirement">complete</span> <span class="guide-token-check-in">&lt;check name&gt;</span> <span class="guide-token-fixed">IN</span> <span class="guide-token-room-in">&lt;room reference&gt;</span></code></td><td><code><span class="guide-token-requirement">complete</span> <span class="guide-token-check-in">bell beast boss fight</span> <span class="guide-token-fixed">IN</span> <span class="guide-token-room-in">the marrow bellway</span></code></td></tr>
                            <tr><td>Full catalogue</td><td><code><span class="guide-token-requirement">complete</span> <span class="guide-token-fixed">THE</span> <span class="guide-token-check-the">&lt;check name&gt;</span></code></td><td><code><span class="guide-token-requirement">complete</span> <span class="guide-token-fixed">THE</span> <span class="guide-token-check-the">lace 1 boss fight</span></code></td></tr>
                        </tbody>
                    </table>
                    <p><code class="guide-token-fixed">IN</code> and <code class="guide-token-fixed">THE</code> must be uppercase. A <span class="guide-token-room-in">room reference</span> selects the named room, and each form requires exactly one complete active <span class="guide-token-check-local">check name</span> match. Each form searches only the place shown and never falls back elsewhere. Other check requirement types use the same forms.</p>
                </section>
                <section>
                    <h3>Add a note</h3>
                    <p>Put one plain, nonnested <span class="guide-token-note">note</span> immediately after one requirement: <code><span class="guide-token-requirement">break wall</span> <span class="guide-token-direction">right</span> <span class="guide-token-note">(shortcut)</span></code> or <code><span class="guide-token-requirement">none</span> <span class="guide-token-note">(stand on pressure plate)</span></code>. A <span class="guide-token-note">note</span> cannot contain another pair of parentheses. It adds context, not another requirement. Parentheses around requirements instead group <code class="guide-token-fixed">AND</code>/<code class="guide-token-fixed">OR</code>.</p>
                </section>
                <section>
                    <h3>What the highlighting means</h3>
                    <p>Unrecognized or incorrectly written text is <span class="guide-diagnostic-danger">red</span>. Missing required content, or a room or check that cannot be found uniquely, is <span class="guide-diagnostic-warning">orange</span>.</p>
                    <p>Highlighting is guidance only. The text remains savable exactly as written.</p>
                </section>
            </div>
        }
        else if (tab == GuideTab.LocationTypes)
        {
            <table class="requirement-syntax-guide-table requirement-syntax-guide-reference requirement-syntax-guide-location-types"><thead><tr><th>Name</th><th>Description</th><th>Examples</th></tr></thead><tbody>
            @foreach (var group in Reference.LocationTypes.GroupBy(type => type.Group, StringComparer.Ordinal))
            {
                <tr class="requirement-syntax-guide-category"><th colspan="3">@group.Key</th></tr>
                @foreach (var type in group)
                {
                    <tr class="requirement-syntax-guide-reference-row"><td class="requirement-syntax-guide-location-name">@type.Name</td><td>@type.Description</td><td>@type.Examples</td></tr>
                }
            }
            </tbody></table>
        }
        else if (tab == GuideTab.RequirementTypes)
        {
            <label class="requirement-syntax-guide-search">search <input aria-label="Search requirement types" @bind="predicateSearch" @bind:event="oninput" /></label>
            <table class="requirement-syntax-guide-table requirement-syntax-guide-reference requirement-syntax-guide-notes-reference"><colgroup><col /><col /><col class="requirement-syntax-guide-notes-column" /></colgroup><thead><tr><th class="requirement-syntax-guide-requirement-type-pattern">How to write it</th><th>Other accepted names</th><th>Notes</th></tr></thead><tbody>
            @foreach (var group in PredicateGroups)
            {
                @if (group.Category is not null) { <tr class="requirement-syntax-guide-category"><th colspan="3">@group.Category</th></tr> }
                @foreach (var predicate in group.Rows)
                {
                    var aliases = predicate.ParsedAliases;
                    <tr class="requirement-syntax-guide-reference-row"><td class="catalogue-monospace requirement-syntax-guide-requirement-type-pattern">@TokenizedPattern(predicate.InputSyntax.Replace("{predicate}", aliases[0], StringComparison.Ordinal))</td><td>@string.Join(", ", aliases.Skip(1))</td><td class="guide-token-note">@predicate.Notes</td></tr>
                }
            }
            </tbody></table>
        }
        else if (tab == GuideTab.Crests)
        {
            <label class="requirement-syntax-guide-search">search <input aria-label="Search crests" @bind="crestSearch" @bind:event="oninput" /></label>
            <table class="requirement-syntax-guide-table requirement-syntax-guide-reference requirement-syntax-guide-notes-reference"><colgroup><col /><col /><col class="requirement-syntax-guide-notes-column" /></colgroup><thead><tr><th>Crest name</th><th>Other accepted names</th><th>Notes</th></tr></thead><tbody>
            @foreach (var group in CrestGroups)
            {
                @if (group.Category is not null) { <tr class="requirement-syntax-guide-category"><th colspan="3">@group.Category</th></tr> }
                @foreach (var crest in group.Rows)
                {
                    var aliases = crest.ParsedAliases;
                    <tr class="requirement-syntax-guide-reference-row"><td class="guide-token-crest">@aliases[0]</td><td class="guide-token-crest">@string.Join(", ", aliases.Skip(1))</td><td class="guide-token-note">@crest.Notes</td></tr>
                }
            }
            </tbody></table>
        }
        else if (tab == GuideTab.Items)
        {
            <label class="requirement-syntax-guide-search">search <input aria-label="Search items" @bind="itemSearch" @bind:event="oninput" /></label>
            <table class="requirement-syntax-guide-table requirement-syntax-guide-reference requirement-syntax-guide-notes-reference"><colgroup><col /><col /><col class="requirement-syntax-guide-notes-column" /></colgroup><thead><tr><th>Item name</th><th>Other accepted names</th><th>Notes</th></tr></thead><tbody>
            @foreach (var group in ItemGroups)
            {
                @if (group.Category is not null) { <tr class="requirement-syntax-guide-category"><th colspan="3">@group.Category</th></tr> }
                @foreach (var item in group.Rows)
                {
                    var aliases = item.ParsedAliases;
                    <tr class="requirement-syntax-guide-reference-row"><td class="guide-token-item">@aliases[0]</td><td class="guide-token-item">@string.Join(", ", aliases.Skip(1))</td><td class="guide-token-note">@item.Notes</td></tr>
                }
            }
            </tbody></table>
        }
        else if (tab == GuideTab.Methods)
        {
            <label class="requirement-syntax-guide-search">search <input aria-label="Search methods" @bind="methodSearch" @bind:event="oninput" /></label>
            <table class="requirement-syntax-guide-table requirement-syntax-guide-reference requirement-syntax-guide-notes-reference"><colgroup><col /><col /><col class="requirement-syntax-guide-notes-column" /></colgroup><thead><tr><th>Method name</th><th>Other accepted names</th><th>Notes</th></tr></thead><tbody>
            @foreach (var group in MethodGroups)
            {
                @if (group.Category is not null) { <tr class="requirement-syntax-guide-category"><th colspan="3">@group.Category</th></tr> }
                @foreach (var method in group.Rows)
                {
                    var aliases = method.ParsedAliases;
                    <tr class="requirement-syntax-guide-reference-row"><td class="guide-token-method">@aliases[0]</td><td class="guide-token-method">@string.Join(", ", aliases.Skip(1))</td><td class="guide-token-note">@method.Notes</td></tr>
                }
            }
            </tbody></table>
        }
        else if (tab == GuideTab.Countables)
        {
            <label class="requirement-syntax-guide-search">search <input aria-label="Search countables" @bind="countableSearch" @bind:event="oninput" /></label>
            <table class="requirement-syntax-guide-table requirement-syntax-guide-reference requirement-syntax-guide-notes-reference"><colgroup><col /><col /><col class="requirement-syntax-guide-notes-column" /></colgroup><thead><tr><th>Countable name</th><th>Other accepted names</th><th>Notes</th></tr></thead><tbody>
            @foreach (var group in CountableGroups)
            {
                @if (group.Category is not null) { <tr class="requirement-syntax-guide-category"><th colspan="3">@group.Category</th></tr> }
                @foreach (var countable in group.Rows)
                {
                    var aliases = countable.ParsedAliases;
                    <tr class="requirement-syntax-guide-reference-row"><td class="guide-token-countable">@aliases[0]</td><td class="guide-token-countable">@string.Join(", ", aliases.Skip(1))</td><td class="guide-token-note">@countable.Notes</td></tr>
                }
            }
            </tbody></table>
        }
        else if (tab == GuideTab.Souls)
        {
            <label class="requirement-syntax-guide-search">search <input aria-label="Search souls" @bind="soulSearch" @bind:event="oninput" /></label>
            <table class="requirement-syntax-guide-table requirement-syntax-guide-reference requirement-syntax-guide-notes-reference"><colgroup><col /><col /><col class="requirement-syntax-guide-notes-column" /></colgroup><thead><tr><th>Soul name</th><th>Other accepted names</th><th>Notes</th></tr></thead><tbody>
            @foreach (var group in SoulGroups)
            {
                @if (group.Category is not null) { <tr class="requirement-syntax-guide-category"><th colspan="3">@group.Category</th></tr> }
                @foreach (var soul in group.Rows)
                {
                    var aliases = soul.ParsedAliases;
                    <tr class="requirement-syntax-guide-reference-row"><td class="guide-token-soul">@aliases[0]</td><td class="guide-token-soul">@string.Join(", ", aliases.Skip(1))</td><td class="guide-token-note">@soul.Notes</td></tr>
                }
            }
            </tbody></table>
        }
    </div>
    <div class="requirement-catalogue-modal-footer requirement-syntax-guide-footer"><div class="requirement-catalogue-modal-alternatives"><button type="button" class="catalogue-modal-action catalogue-modal-alternative" @onclick="Manage">manage requirement catalogue</button></div><div class="requirement-catalogue-modal-commit-group"><button type="button" class="catalogue-modal-action catalogue-modal-close" @onclick="Close">close</button></div></div>
</section>

@code {
    private enum GuideTab { HowToWrite, LocationTypes, RequirementTypes, Crests, Methods, Items, Countables, Souls }
    private sealed record PredicateGroup(string? Category, IReadOnlyList<RequirementPredicateReferenceView> Rows);
    private sealed record CrestGroup(string? Category, IReadOnlyList<RequirementCrestReferenceView> Rows);
    private sealed record MethodGroup(string? Category, IReadOnlyList<RequirementMethodReferenceView> Rows);
    private sealed record ItemGroup(string? Category, IReadOnlyList<RequirementItemReferenceView> Rows);
    private sealed record CountableGroup(string? Category, IReadOnlyList<RequirementCountableReferenceView> Rows);
    private sealed record SoulGroup(string? Category, IReadOnlyList<RequirementSoulReferenceView> Rows);

    [Parameter, EditorRequired] public RequirementCatalogueReferenceView Reference { get; set; } = null!;
    [Parameter] public EventCallback Manage { get; set; }
    [Parameter] public EventCallback Close { get; set; }

    private GuideTab tab;
    private string predicateSearch = "", crestSearch = "", methodSearch = "", itemSearch = "", countableSearch = "", soulSearch = "";
    private string ActiveTabId => tab switch
    {
        GuideTab.HowToWrite => "requirement-syntax-guide-tab-how-to-write",
        GuideTab.LocationTypes => "requirement-syntax-guide-tab-location-types",
        GuideTab.RequirementTypes => "requirement-syntax-guide-tab-requirement-types",
        GuideTab.Crests => "requirement-syntax-guide-tab-crests",
        GuideTab.Methods => "requirement-syntax-guide-tab-methods",
        GuideTab.Items => "requirement-syntax-guide-tab-items",
        GuideTab.Countables => "requirement-syntax-guide-tab-countables",
        _ => "requirement-syntax-guide-tab-souls"
    };

    private IReadOnlyList<PredicateGroup> PredicateGroups => GroupPredicates(Reference.Predicates, predicateSearch);
    private IReadOnlyList<CrestGroup> CrestGroups => GroupCrests(Reference.Crests, crestSearch);
    private IReadOnlyList<MethodGroup> MethodGroups => GroupMethods(Reference.Methods, methodSearch);
    private IReadOnlyList<ItemGroup> ItemGroups => GroupItems(Reference.Items, itemSearch);
    private IReadOnlyList<CountableGroup> CountableGroups => GroupCountables(Reference.Countables, countableSearch);
    private IReadOnlyList<SoulGroup> SoulGroups => GroupSouls(Reference.Souls, soulSearch);

    private static IReadOnlyList<PredicateGroup> GroupPredicates(IReadOnlyList<RequirementPredicateReferenceView> rows, string search)
    {
        var groups = new List<PredicateGroup>();
        AddPredicateGroup(groups, null, rows.Where(x => string.IsNullOrWhiteSpace(x.Category)), search);
        foreach (var category in rows.Where(x => !string.IsNullOrWhiteSpace(x.Category)).Select(x => x.Category!).Distinct(StringComparer.Ordinal))
            AddPredicateGroup(groups, category, rows.Where(x => string.Equals(x.Category, category, StringComparison.Ordinal)), search);
        return groups;
    }

    private static void AddPredicateGroup(List<PredicateGroup> groups, string? category, IEnumerable<RequirementPredicateReferenceView> candidates, string search)
    {
        var matches = candidates.Where(x => Matches(search, x.Name, x.Category, x.Aliases)).ToArray();
        if (matches.Length > 0)
