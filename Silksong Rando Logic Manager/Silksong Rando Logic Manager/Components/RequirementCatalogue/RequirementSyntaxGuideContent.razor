    private static RenderFragment TokenizedPattern(string pattern) => builder =>
    {
        var sequence = 0;
        var cursor = 0;
        while (cursor < pattern.Length)
        {
            var opening = pattern.IndexOf('{', cursor);
            if (opening < 0)
            {
                builder.AddContent(sequence++, pattern[cursor..]);
                break;
            }

            if (opening > cursor)
                builder.AddContent(sequence++, pattern[cursor..opening]);
            var closing = pattern.IndexOf('}', opening);
            if (closing < 0)
            {
                builder.AddContent(sequence++, pattern[opening..]);
                break;
            }

            var placeholder = pattern[opening..(closing + 1)];
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", placeholder switch
            {
                "{difficulty}" or "{difficulty?}" => "guide-token-difficulty",
                "{direction}" or "{direction?}" => "guide-token-direction",
                "{crest}" or "{crest?}" => "guide-token-crest",
                "{method}" => "guide-token-method",
                "{item}" => "guide-token-item",
                "{countable}" => "guide-token-countable",
                "{soul}" => "guide-token-soul",
                "{quantity}" => "guide-token-amount",
                "{check}" => "guide-token-check-local",
                _ => "guide-token-requirement"
            });
            builder.AddContent(sequence++, placeholder);
            builder.CloseElement();
            cursor = closing + 1;
        }
    };

    private static bool Matches(string search, string name, string? category, string aliases) =>
        string.IsNullOrWhiteSpace(search) || new[] { name, category ?? "", aliases }.Any(x => x.Contains(search, StringComparison.OrdinalIgnoreCase));
}
