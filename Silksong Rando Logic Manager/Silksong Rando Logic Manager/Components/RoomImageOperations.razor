@implements IDisposable
@inject RoomImageOperationsService Operations
@inject DiagnosticState Diagnostics

<div class="room-image-operations">
    <div class="room-image-actions tool-actions">
        <button type="button" disabled="@Unavailable" @onclick="CheckFiles">check image files</button>
        <button type="button" disabled="@Unavailable" @onclick="(() => Regenerate(SceneImageRebuildMode.MissingOrStale))">regenerate stale images</button>
        <button type="button" disabled="@Unavailable" @onclick="(() => Regenerate(SceneImageRebuildMode.AllUploaded))">regenerate all images</button>
        <button type="button" disabled="@(Unavailable || scan?.Complete != true || scan.Candidates.Count == 0)" @onclick="ConfirmCleanup">delete unused images</button>
    </div>
    <p class="@(statusError && !checking ? "tool-error" : "tool-progress")" role="status" aria-live="polite">@(checking ? "Checking image files" : status)</p>
    @if (!checking && scan is { } current) { <p>@current.Candidates.Count unused files · @Size(current.Bytes)@if (!current.Complete) { <span class="tool-warning"> · Check incomplete. Deletion is unavailable.</span> }</p> }
    @if (confirm && scan is { } confirmed)
    {
        <p>Delete @confirmed.Candidates.Count unused image files (@Size(confirmed.Bytes))?</p>
        <div class="confirmation-actions tool-actions"><button type="button" disabled="@Unavailable" @onclick="CancelCleanup">cancel deletion</button><button type="button" disabled="@Unavailable" @onclick="Delete">delete unused files</button></div>
    }
    @foreach (var blocker in blockers) { <p class="danger"><strong>@blocker.FriendlyName</strong>: @blocker.Instruction</p> }
</div>

@code {
    [CascadingParameter] public Silksong_Rando_Logic_Manager.Authentication.ExecutionIdentity? Identity { get; set; }
    private bool CanAuthor => Identity?.CanAuthor == true;
    private bool Unavailable => !CanAuthor || busy || checking || disposed;
    private bool busy, generating, checking, confirm, disposed;
    private RoomImageScan? scan;
    private string status = "Ready";
    private bool statusError;
    private IReadOnlyList<RoomImageBlocker> blockers = [];
    private long lifetime;
    private bool IsCurrent(long owner) => !disposed && owner == lifetime;

    private async Task CheckFiles()
    {
        if (Unavailable) return;
        var owner = ++lifetime;
        scan = null; confirm = false; blockers = []; status = "Ready"; statusError = false;
        await RefreshScan(owner);
    }
    private async Task RefreshScan(long owner)
    {
        if (!IsCurrent(owner)) return;
        checking = true;
        string? historyWarning = null;
        try { var result = await Task.Run(Operations.ScanAsync); if (IsCurrent(owner)) { scan = result; historyWarning = result.HistoryWarning; } }
        catch (Exception ex) { if (IsCurrent(owner)) { scan = new([], false); Diagnostics.Show(ex.ToString()); } }
        finally { if (IsCurrent(owner)) { checking = false; ShowHistoryWarning(historyWarning); } }
    }
    private async Task Regenerate(SceneImageRebuildMode mode)
    {
        if (Unavailable) return;
        var owner = ++lifetime;
        busy = true; generating = true; confirm = false; blockers = []; status = "Rebuilding images 0 of 0"; statusError = false;
        var completed = false;
        string? historyWarning = null;
        var progress = new ImageProgress(value => _ = PublishProgress(owner, value));
        try
        {
            var result = await Task.Run(() => Operations.RegenerateAsync(mode, progress));
            if (!IsCurrent(owner)) return;
            historyWarning = result.HistoryWarning;
            generating = false;
            status = result.Generated == 0 && result.Failed == 0 && result.Blockers.Count == 0 && !result.Interrupted ? "No images need rebuilding" : $"Rebuilt {result.Generated} images";
            blockers = result.Blockers;
            statusError = result.Interrupted || result.Failed != 0 || result.Diagnostics.Count != 0;
            if (result.Interrupted) status += "; rebuilding stopped unexpectedly.";
            else if (result.Failed != 0) status += $"; {result.Failed} images could not be rebuilt.";
            if (result.Diagnostics.Count != 0) { status += " See error details."; Diagnostics.Show(new AggregateException(result.Diagnostics).ToString()); }
            completed = true;
        }
        catch (Exception ex) { if (IsCurrent(owner)) { generating = false; statusError = true; status = "Image rebuilding stopped unexpectedly. Some images may already have been rebuilt; those changes were not undone. See error details."; Diagnostics.Show(ex.ToString()); } }
        finally { try { if (completed && IsCurrent(owner)) await RefreshScan(owner); } finally { if (IsCurrent(owner)) { busy = false; ShowHistoryWarning(historyWarning); } } }
    }
    private async Task PublishProgress(long owner, SceneImageRebuildProgress value)
    {
        if (!IsCurrent(owner)) return;
        try
        {
            await InvokeAsync(() =>
            {
                if (!IsCurrent(owner) || !generating) return;
                status = $"Rebuilding images {value.Completed} of {value.Total}";
                StateHasChanged();
            });
        }
        catch (Exception) when (!IsCurrent(owner)) { }
    }
    private void ConfirmCleanup() { if (!Unavailable && scan is { Complete: true, Candidates.Count: > 0 }) confirm = true; }
    private void CancelCleanup() { if (!Unavailable) confirm = false; }
    private async Task Delete()
    {
        if (Unavailable || !confirm || scan is not { Complete: true, Candidates.Count: > 0 } confirmed) return;
        var owner = ++lifetime;
        busy = true; confirm = false; blockers = []; statusError = false;
        var completed = false;
        string? historyWarning = null;
        try
        {
            var result = await Task.Run(() => Operations.DeleteUnusedAsync(confirmed));
            if (!IsCurrent(owner)) return;
            historyWarning = result.HistoryWarning;
            status = $"Deleted {result.Deleted} unused files / freed {Size(result.Bytes)}";
            statusError = result.Failures.Count != 0;
            if (result.Failures.Count != 0) { status += "; some files could not be removed. See error details."; Diagnostics.Show(new AggregateException(result.Failures).ToString()); }
            completed = true;
        }
        catch (Exception ex) { if (IsCurrent(owner)) { statusError = true; status = "Image cleanup stopped unexpectedly. Some files may already have been deleted. See error details."; Diagnostics.Show(ex.ToString()); } }
        finally { try { if (completed && IsCurrent(owner)) await RefreshScan(owner); } finally { if (IsCurrent(owner)) { busy = false; ShowHistoryWarning(historyWarning); } } }
    }
    private void ShowHistoryWarning(string? warning)
    {
        if (warning is null) return;
        var existing = Diagnostics.ErrorDetails;
        if (existing?.Contains(warning, StringComparison.Ordinal) == true) return;
        Diagnostics.Show(existing is null ? warning : existing + Environment.NewLine + warning);
    }
    public void Dispose() { disposed = true; lifetime++; }
    private static string Size(long bytes) => $"{bytes / 1048576d:0.##} MiB";
    private sealed class ImageProgress(Action<SceneImageRebuildProgress> report) : IProgress<SceneImageRebuildProgress> { public void Report(SceneImageRebuildProgress value) => report(value); }
}
