@rendermode InteractiveServer
@implements IAsyncDisposable
@inject SceneDumpParser Parser
@inject SceneClassificationService Classification
@inject SceneImportService Importer
@inject TransitionInverseSetupState InverseSetupState
@inject SceneReviewProjectionService ReviewProjection
@inject WorkspaceChangeNotifier WorkspaceChanges
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DiagnosticState Diagnostics
@inject ILogger<SceneReview> Logger

<div class="scene-review-root">
    <InputFile id="scene-upload-input" class="scene-upload-input" OnChange="ParseSceneAsync" accept="application/json,.json" disabled="@UploadUnavailable" />
    @if (parseError is not null)
    {
        <span class="scene-upload-error" role="alert">@parseError</span>
    }
</div>

@if (isParsing)
{
    <div class="scene-parsing-backdrop" role="status" aria-live="assertive">
        <section class="scene-parsing-state"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> parsing scene dump</section>
    </div>
}

@if (review is not null && preview is not null)
{
    <div class="scene-review-backdrop">
        <section class="scene-review-modal" role="dialog" aria-modal="true" aria-labelledby="scene-review-title">
            <header class="scene-review-header">
                <div>
                    <h2 id="scene-review-title">scene review: @review.SceneName</h2>
                    @if (preview.MatchingRooms.Count == 0)
                    {
                        <p><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i> a new ungrouped room will be created on import.</p>
                    }
                    else if (preview.MatchingRooms.Count == 1)
                    {
                        <p><i class="fa-solid fa-circle-check" aria-hidden="true"></i> matched: @preview.MatchingRooms[0].FriendlyName</p>
                    }
                    else
                    {
                        <fieldset class="scene-room-choice">
                            <legend>select matching room</legend>
                            @foreach (var room in preview.MatchingRooms)
                            {
                                <label><input type="radio" name="scene-target-room" checked="@(targetRoomId == room.Id)" @onchange="(() => SelectTargetRoom(room.Id))" /> @room.FriendlyName <span>@room.ReferenceId</span></label>
                            }
                        </fieldset>
                    }
                    @if (review.SceneUnitSize is { } parsedDimensions)
                    {
                        <p class="scene-dimensions">scene dimensions: parsed @Dimensions(parsedDimensions); current @Dimensions(CurrentDimensions)</p>
                        @if (ShowReplacementDimensions)
                        {
                            <div class="scene-dimension-draft">
                                <span>replace current dimensions</span>
                                <label>width <input type="number" step="any" @bind="replacementWidth" /></label>
                                <label>height <input type="number" step="any" @bind="replacementHeight" /></label>
                            </div>
                        }
                    }
                </div>
                <div class="scene-review-summary">
                    <span class="scene-conflicts">@ConflictSummary()</span>
                    @if (review.Warnings.Count > 0)
                    {
                        <span class="scene-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> @review.Warnings.Count parse warning@(review.Warnings.Count == 1 ? string.Empty : "s")</span>
                    }
                </div>
            </header>

            <div @ref="previewElement" class="scene-preview" aria-label="Read-only scene position preview">
                <svg viewBox="@PreviewViewBox" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Visible scene object positions">
                    @foreach (var point in SpatialPreview.Points)
                    {
                        <circle class="scene-preview-point scene-preview-@ClassificationText(point.Classification)" cx="@point.X" cy="@point.Y" r="@PreviewPointRadius" />
                    }
                    @if (SpatialPreview.HoveredPoint is { } hovered)
                    {
                        <circle class="scene-preview-hover" cx="@hovered.X" cy="@hovered.Y" r="@PreviewHoverRadius" />
                    }
                </svg>
                <div class="scene-preview-resize-edge" data-scene-preview-resize-edge aria-hidden="true"></div>
            </div>

            <div class="scene-review-tools">
                <input class="scene-search" placeholder="search object names" value="@search" @oninput="SetSearch" autocomplete="off" aria-label="Search scene object names" />
                <div class="scene-review-filters" aria-label="Filter scene classifications">
                    @foreach (var option in Enum.GetValues<SceneReviewFilter>())
                    {
                        <button type="button" class="@(filter == option ? "active" : null)" aria-pressed="@(filter == option)" @onclick="(() => SetFilter(option))">@option.ToString().ToLowerInvariant()</button>
                    }
                </div>
                <label class="scene-show-filler"><input type="checkbox" checked="@showFiller" @onchange="SetShowFiller" /> show filler</label>
                <div class="scene-review-actions">
                    <button class="scene-enemies-import-button" type="button" disabled="@(!CanImportEnemiesOnly)" @onclick="ImportEnemiesOnlyAsync"><i class="fa-solid fa-skull" aria-hidden="true"></i> import enemies only</button>
                    <button class="scene-import-button" type="button" disabled="@(!CanImport)" @onclick="ImportAsync"><i class="fa-solid fa-file-import" aria-hidden="true"></i> import</button>
                    <button class="scene-cancel-button" type="button" @onclick="Cancel">cancel</button>
                </div>
            </div>
            @if (importError is not null)
            {
                <p class="scene-upload-error" role="alert">@importError</p>
            }

            <div class="scene-review-scroll">
                <table class="scene-review-table">
                    <thead><tr><th>name</th><th>world</th><th>local</th><th>persistence</th><th class="scene-candidate-heading"></th><th>classification</th><th>record</th><th>friendly name</th><th>show</th></tr></thead>
                    <tbody>
                        <Virtualize TItem="SceneDumpObject" Items="@VisibleRows" Context="node" SpacerElement="tr">
                            <tr @key="node.Id" class="@RowClass(node)" @onmouseenter="(() => SetHoveredObject(node.Id))" @onmouseleave="(() => SetHoveredObject(null))">
                                <td><span class="scene-tree-name" style="padding-left: @(node.Depth * 1.15)rem"><button class="scene-expand" type="button" disabled="@(node.Children.Count == 0)" title="@(expanded.Contains(node.Id) ? "Collapse" : "Expand")" @onclick="(() => ToggleExpansion(node.Id))"><i class="fa-solid @(node.Children.Count == 0 ? "fa-minus" : expanded.Contains(node.Id) ? "fa-chevron-down" : "fa-chevron-right")" aria-hidden="true"></i></button>@node.Name @if (node.ShowAct3Indication) { <span class="scene-act3">Act 3</span> }</span></td>
                                 <td>@Position(node.WorldPosition)</td>
                                 <td>@Position(node.LocalPosition)</td>
                                 <td>@Persistence(node)</td>
                                 <td class="scene-candidate-cell">@if (node.CandidateReasons.Count > 0) { <i class="fa-solid fa-circle-info" title="@string.Join("; ", node.CandidateReasons)" aria-label="Candidate evidence: @string.Join("; ", node.CandidateReasons)"></i> }</td>
                                   <td class="scene-classification">
                                      @if (MatchedClassification(node) is { } matched) { <i class="fa-solid fa-circle-check" title="Matches an existing @ClassificationText(matched) record" aria-hidden="true"></i> }
                                      @if (HasCrossTypeMatches(node)) { <i class="fa-solid fa-circle-info" title="Matches existing transition and check records" aria-hidden="true"></i> }
                                      <select value="@node.Classification" @onchange="(args => SetClassification(node, args.Value?.ToString()))"><option value="@SceneDumpClassification.Exit">exit</option><option value="@SceneDumpClassification.Check">check</option><option value="@SceneDumpClassification.Enemy">enemy</option><option value="@SceneDumpClassification.Other">other</option></select>
                                   </td>
                                   @if (SceneDumpIdentity.IsImportable(node.Classification))
                                   {
                                       var draft = Draft(node);
                                       <td><select value="@draft.ExistingRecordId" @onchange="(args => SetExistingRecord(node, args.Value?.ToString()))"><option value="">Create new</option>@foreach (var record in SelectableRecords(node)) { <option value="@record.Id">@record.FriendlyName (@(record.InGameId ?? "no ID"))</option> }</select></td>
                                       <td><input value="@draft.FriendlyName" disabled="@(draft.Mode == SceneImportMode.Update)" @oninput="(args => SetFriendlyName(node, args.Value?.ToString()))" autocomplete="off" /></td>
                                   }
                                   else
                                   {
                                       <td></td><td></td>
                                  }
                                  <td class="scene-show-cell"><input type="checkbox" checked="@visibleObjectIds.Contains(node.Id)" @onchange="(() => ToggleVisible(node.Id))" aria-label="Show @node.Name in preview" /></td>
                            </tr>
                        </Virtualize>
                    </tbody>
                </table>
            </div>

        </section>
    </div>
}

@code {
    private SceneDumpReview? review;
    private SceneImportPreview? preview;
    private readonly HashSet<Guid> expanded = [];
    private string search = string.Empty;
    private SceneReviewFilter filter;
    private bool showFiller;
    private ElementReference previewElement;
    private IJSObjectReference? resizeOwner;
    private bool mountingResizeOwner, disposed;
    private string? parseError;
    private string? importError;
    private Guid? targetRoomId;
    private bool isParsing;
    private double? replacementWidth;
    private double? replacementHeight;
    private readonly HashSet<Guid> visibleObjectIds = [];
    private readonly Dictionary<Guid, SceneReviewImportDraft> drafts = [];
    private Guid? hoveredObjectId;
    private List<SceneDumpObject> visibleRows = [];
    private IReadOnlyList<SceneReviewPoint> allPreviewPoints = [];
    private SceneReviewSpatialProjection spatialPreview = new([], null, new SceneReviewBounds(-1, -1, 2, 2));

    private bool UploadUnavailable => isParsing || review is not null;
    private bool CanImport => preview is not null && (preview.MatchingRooms.Count != 0 || !string.IsNullOrWhiteSpace(review?.SceneName)) && (preview.MatchingRooms.Count < 2 || targetRoomId is not null);
    private bool CanImportEnemiesOnly => CanImport && review is not null && Flatten(review.RootObjects).Any(node => node.Classification == SceneDumpClassification.Enemy);
    private List<SceneDumpObject> VisibleRows => visibleRows;
    private SceneImportRoom? EffectiveTargetRoom => targetRoomId is { } id ? preview?.MatchingRooms.SingleOrDefault(room => room.Id == id) : preview?.MatchingRooms.Count == 1 ? preview.MatchingRooms[0] : null;
    private SceneUnitSize? CurrentDimensions => EffectiveTargetRoom is { SceneUnitWidth: { } width, SceneUnitHeight: { } height } ? new SceneUnitSize(width, height) : null;
    private bool ShowReplacementDimensions => review?.SceneUnitSize is { } parsed && CurrentDimensions is { } current && (current.Width != parsed.Width || current.Height != parsed.Height);
    private SceneUnitSize? ReplacementDimensions => ShowReplacementDimensions && replacementWidth is { } width && replacementHeight is { } height ? new SceneUnitSize(width, height) : null;
    private SceneReviewSpatialProjection SpatialPreview => spatialPreview;
    private string PreviewViewBox => $"{SpatialPreview.Bounds.X.ToString(System.Globalization.CultureInfo.InvariantCulture)} {SpatialPreview.Bounds.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)} {SpatialPreview.Bounds.Width.ToString(System.Globalization.CultureInfo.InvariantCulture)} {SpatialPreview.Bounds.Height.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
    private double PreviewPointRadius => Math.Max(SpatialPreview.Bounds.Width, SpatialPreview.Bounds.Height) * .008;
    private double PreviewHoverRadius => Math.Max(SpatialPreview.Bounds.Width, SpatialPreview.Bounds.Height) * .015;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("registerSceneDropTarget", "scene-upload-input");
        }
        if (review is not null && resizeOwner is null && !mountingResizeOwner && !disposed)
        {
            var mountedReview = review;
            mountingResizeOwner = true;
            try
            {
                var owner = await JS.InvokeAsync<IJSObjectReference>("createSceneReviewPreviewResizeOwner", previewElement);
                if (disposed || review != mountedReview) await DisposeResizeOwnerAsync(owner);
                else resizeOwner = owner;
            }
            finally
            {
                mountingResizeOwner = false;
                if (!disposed && review is not null && review != mountedReview && resizeOwner is null) await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ParseSceneAsync(InputFileChangeEventArgs args)
    {
        if (UploadUnavailable)
        {
            return;
        }

        parseError = null;
        importError = null;
        isParsing = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await using var stream = args.File.OpenReadStream(SceneDumpParser.MaximumBytes);
            var parsed = await Parser.ParseAsync(stream);
            Classification.Apply(parsed);
            SceneFillerVisibility.Apply(parsed);
            var parsedPreview = await Importer.PreviewAsync(parsed);
            if (disposed) return;
            review = parsed;
            showFiller = false;
            preview = parsedPreview;
            targetRoomId = parsedPreview.MatchingRooms.Count == 1 ? parsedPreview.MatchingRooms[0].Id : null;
            InitializeDrafts(parsed);
            ResetReplacementDimensions();
            InitializeExpansion(parsed.RootObjects);
            allPreviewPoints = ReviewProjection.CreatePoints(parsed.RootObjects);
            RebuildVisibleRows();
            RebuildSpatialPreview();
        }
        catch (Exception exception) when (exception is SceneDumpParseException or SceneDumpTooLargeException or IOException)
        {
            parseError = $"Could not parse scene dump: {exception.Message}";
        }
        catch (Exception exception)
        {
            parseError = "Could not parse scene dump. Details are available in the diagnostic modal.";
            Diagnostics.Show(exception.ToString());
        }
        finally
        {
            isParsing = false;
        }
    }

    private void InitializeExpansion(IEnumerable<SceneDumpObject> nodes)
    {
        expanded.Clear();
        InitializeExpansion(nodes, []);
    }

    private void InitializeExpansion(IEnumerable<SceneDumpObject> nodes, IReadOnlyCollection<Guid> ancestors)
    {
        foreach (var node in nodes)
        {
            if (IsPromoted(node))
            {
                expanded.UnionWith(ancestors);
            }

            InitializeExpansion(node.Children, ancestors.Append(node.Id).ToArray());
        }
    }

    private SceneDumpObject? FindNode(Guid id) => review is null ? null : FindNode(review.RootObjects, id);
    private static SceneDumpObject? FindNode(IEnumerable<SceneDumpObject> nodes, Guid id) => nodes.SelectMany(node => new[] { node }.Concat(Flatten(node.Children))).FirstOrDefault(node => node.Id == id);
    private static IEnumerable<SceneDumpObject> Flatten(IEnumerable<SceneDumpObject> nodes) => nodes.SelectMany(node => new[] { node }.Concat(Flatten(node.Children)));

    private IEnumerable<SceneDumpObject> BuildVisibleRows(IEnumerable<SceneDumpObject> nodes)
    {
        foreach (var node in nodes.OrderBy(SortPriority).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
        {
            if (!MatchesTree(node)) continue;
            yield return node;
            if (TreeFiltered || expanded.Contains(node.Id))
            {
                foreach (var child in BuildVisibleRows(node.Children)) yield return child;
            }
        }
    }

    private bool TreeFiltered => filter != SceneReviewFilter.All || !string.IsNullOrWhiteSpace(search);
    private bool MatchesTree(SceneDumpObject node) =>
        ((showFiller || !node.IsFiller) && (!TreeFiltered || MatchesFilter(node)) &&
         (string.IsNullOrWhiteSpace(search) || node.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))) ||
        ((showFiller || node.HasKeptDescendant) && node.Children.Any(MatchesTree));
    private bool MatchesFilter(SceneDumpObject node) => filter switch
    {
        SceneReviewFilter.Unclassified => node.Classification == SceneDumpClassification.Other,
        SceneReviewFilter.Classified => SceneDumpIdentity.IsImportable(node.Classification),
        SceneReviewFilter.Exits => node.Classification == SceneDumpClassification.Exit,
        SceneReviewFilter.Checks => node.Classification == SceneDumpClassification.Check,
        SceneReviewFilter.Enemies => node.Classification == SceneDumpClassification.Enemy,
        _ => true
    };
    private static int SortPriority(SceneDumpObject node) => Math.Min(
        node.Classification switch
        {
            SceneDumpClassification.Exit => 0,
            SceneDumpClassification.Check => 1,
            SceneDumpClassification.Enemy => 2,
            _ when node.CandidateReasons.Count > 0 => 3,
            _ => 4
        },
        node.Children.Select(SortPriority).DefaultIfEmpty(4).Min());

    private static bool IsPromoted(SceneDumpObject node) =>
        node.Classification != SceneDumpClassification.Other || node.CandidateReasons.Count > 0;
    private void ToggleExpansion(Guid id)
    {
        if (!expanded.Add(id)) expanded.Remove(id);
        RebuildVisibleRows();
    }
    private void SetClassification(SceneDumpObject node, string? value)
    {
        if (Enum.TryParse<SceneDumpClassification>(value, out var classification) && Enum.IsDefined(classification))
        {
            node.Classification = classification;
            SceneFillerVisibility.Apply(review!);
            preview = preview! with { ObjectMatches = preview!.ObjectMatches.Select(match => match.ObjectId == node.Id
                ? SceneImportService.MatchObject(node, preview.Transitions, preview.Checks) : match).ToArray() };
            ReconcileDrafts(node.Id);
            AllocateNames();
            importError = null;
            allPreviewPoints = ReviewProjection.CreatePoints(review!.RootObjects);
            RebuildVisibleRows();
            RebuildSpatialPreview();
        }
    }
    private void SelectTargetRoom(Guid roomId)
    {
        targetRoomId = roomId;
        ReconcileDrafts();
        AllocateNames();
        ResetReplacementDimensions();
        RebuildSpatialPreview();
    }
    private void ResetReplacementDimensions()
    {
        replacementWidth = review?.SceneUnitSize?.Width;
        replacementHeight = review?.SceneUnitSize?.Height;
    }

    private SceneImportObjectMatch? Match(SceneDumpObject node) => preview?.ObjectMatches.FirstOrDefault(match => match.ObjectId == node.Id);
    private SceneDumpClassification? MatchedClassification(SceneDumpObject node)
    {
        var types = Match(node)?.Matches.Select(x => x.Classification).Distinct().ToArray() ?? [];
        return types.Length == 1 ? types[0] : null;
    }

    private bool HasCrossTypeMatches(SceneDumpObject node) => (Match(node)?.Matches.Select(x => x.Classification).Distinct().Count() ?? 0) > 1;
    private Guid? EffectiveTargetRoomId => targetRoomId ?? (preview?.MatchingRooms.Count == 1 ? preview.MatchingRooms[0].Id : null);
    private string ConflictSummary()
    {
        var target = EffectiveTargetRoomId;
        var matches = preview!.ObjectMatches;
        var selected = matches.Sum(x => x.Matches.Count(match => match.RoomId == target));
        var elsewhere = matches.Sum(x => x.Matches.Count(match => match.RoomId != target));
        return $"matches: {selected} selected room, {elsewhere} other room";
    }

    private static string ClassificationText(SceneDumpClassification classification) => classification switch { SceneDumpClassification.Exit => "exit", SceneDumpClassification.Check => "check", SceneDumpClassification.Enemy => "enemy", _ => "other" };
    private static string Position(ScenePosition? position) => position is null ? "-" : $"{Value(position.X)}, {Value(position.Y)}, {Value(position.Z)}";
    private static string Value(double? value) => value?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) ?? "-";
    private static string Dimensions(SceneUnitSize? dimensions) => dimensions is { } value ? $"{Value(value.Width)} x {Value(value.Height)}" : "unavailable";
    private static string Persistence(SceneDumpObject node)
    {
        var persistent = node.Components.FirstOrDefault(x => x.Type.StartsWith("Persistent", StringComparison.Ordinal));
        return persistent is null ? "-" : $"{persistent.Type}: {(string.IsNullOrWhiteSpace(persistent.ItemDataId) ? "[no ID]" : persistent.ItemDataId)}";
    }

    private string RowClass(SceneDumpObject node) => string.Join(' ', new[]
    {
        node.IsFiller || !IsPromoted(node) ? "scene-muted-row" : null
    }.Where(x => x is not null));

    private void InitializeDrafts(SceneDumpReview parsed)
    {
        visibleObjectIds.Clear();
        drafts.Clear();
        foreach (var node in Flatten(parsed.RootObjects))
        {
            if (IsPromoted(node)) visibleObjectIds.Add(node.Id);
        }
        ReconcileDrafts();
        AllocateNames();
    }

    private void ReconcileDrafts(Guid? reclassifiedObjectId = null)
    {
        var nodes = Flatten(review!.RootObjects).ToArray();
        var identityCounts = ReviewProjection.CountCheckIdentities(nodes);
        foreach (var node in nodes.Where(node => SceneDumpIdentity.IsImportable(node.Classification)))
        {
            drafts.TryGetValue(node.Id, out var retained);
            // Classification resets only that row; room changes reset every target.
            // Automatic peer rematching must not replace a deliberate Create/Update.
            if (reclassifiedObjectId is not null && node.Id != reclassifiedObjectId && retained?.HasDeliberateRecordSelection == true) continue;
            drafts[node.Id] = ReviewProjection.CreateDraft(node, preview!, EffectiveTargetRoomId, identityCounts)
                with { AuthoredName = retained?.AuthoredName };
        }
    }
    private void AllocateNames() => ReviewProjection.AllocateNames(Flatten(review!.RootObjects).Where(node => SceneDumpIdentity.IsImportable(node.Classification)), preview!, EffectiveTargetRoomId, drafts);

    private SceneReviewImportDraft Draft(SceneDumpObject node) => drafts[node.Id];
    private IReadOnlyList<SceneImportSelectableRecord> SelectableRecords(SceneDumpObject node) => ReviewProjection.SelectableRecords(preview!, node.Classification, EffectiveTargetRoomId);
    private void ToggleVisible(Guid id)
    {
        if (!visibleObjectIds.Add(id)) visibleObjectIds.Remove(id);
        RebuildSpatialPreview();
    }
    private void SetHoveredObject(Guid? id)
    {
        if (hoveredObjectId == id) return;
        hoveredObjectId = id;
        RebuildSpatialPreview();
    }
    private void SetSearch(ChangeEventArgs args)
    {
        search = args.Value?.ToString() ?? string.Empty;
        RebuildVisibleRows();
    }
    private void SetFilter(SceneReviewFilter value) { filter = value; RebuildVisibleRows(); }
    private void SetShowFiller(ChangeEventArgs args) { showFiller = args.Value is true; RebuildVisibleRows(); }
    private void RebuildVisibleRows()
    {
        visibleRows = review is null ? [] : BuildVisibleRows(review.RootObjects).ToList();
        if (hoveredObjectId is { } hovered && !visibleRows.Any(node => node.Id == hovered))
        {
            hoveredObjectId = null;
            RebuildSpatialPreview();
        }
    }
    private void RebuildSpatialPreview() => spatialPreview = ReviewProjection.Project(allPreviewPoints, visibleObjectIds, hoveredObjectId);
    private void SetExistingRecord(SceneDumpObject node, string? value)
    {
        var draft = Draft(node);
        drafts[node.Id] = Guid.TryParse(value, out var id) && SelectableRecords(node).Any(record => record.Id == id)
            ? draft with { Mode = SceneImportMode.Update, ExistingRecordId = id, FriendlyName = SelectableRecords(node).Single(record => record.Id == id).FriendlyName, HasDeliberateRecordSelection = true }
            : draft with { Mode = SceneImportMode.Create, ExistingRecordId = null, HasDeliberateRecordSelection = true };
        AllocateNames();
    }
    private void SetFriendlyName(SceneDumpObject node, string? value)
    {
        drafts[node.Id] = Draft(node) with { FriendlyName = value ?? string.Empty, AuthoredName = value ?? string.Empty };
        AllocateNames();
    }

    private Task ImportAsync() => ImportAsync(false);
    private Task ImportEnemiesOnlyAsync() => ImportAsync(true);

    private async Task ImportAsync(bool enemiesOnly)
    {
        if (enemiesOnly && !CanImportEnemiesOnly) return;
        try
        {
            var instructions = Flatten(review!.RootObjects).Where(node => enemiesOnly
                ? node.Classification == SceneDumpClassification.Enemy
                : SceneDumpIdentity.IsImportable(node.Classification)).Select(Draft).Select(draft => new SceneImportInstruction(draft.ObjectId, draft.Mode, draft.ExistingRecordId, draft.FriendlyName)).ToArray();
            var result = await Importer.ImportAsync(review, targetRoomId, instructions, ReplacementDimensions);
            await Cancel();
            WorkspaceChanges.NotifyChanged();
            Navigation.NavigateTo($"rooms/{result.RoomId}");
            InverseSetupState.Enqueue(result.TransitionIds);
        }
        catch (Exception exception)
        {
            importError = $"Import failed: {exception.Message}";
            Diagnostics.Show(exception.ToString());
        }
    }

    private async Task Cancel()
    {
        var owner = resizeOwner;
        resizeOwner = null;
        review = null;
        preview = null;
        expanded.Clear();
        search = string.Empty;
        filter = SceneReviewFilter.All;
        showFiller = false;
        importError = null;
        targetRoomId = null;
        replacementWidth = null;
        replacementHeight = null;
        visibleObjectIds.Clear();
        drafts.Clear();
        hoveredObjectId = null;
        visibleRows = [];
        allPreviewPoints = [];
        spatialPreview = new([], null, new SceneReviewBounds(-1, -1, 2, 2));
        if (owner is not null) await DisposeResizeOwnerAsync(owner);
    }
    private async Task DisposeResizeOwnerAsync(IJSObjectReference owner)
    {
        Exception? cleanupError = null;
        try { await owner.InvokeVoidAsync("dispose"); }
        catch (JSDisconnectedException) { }
        catch (Exception exception) { cleanupError = exception; }

        // Reference release is independent of the optional browser-owner invocation.
        try { await owner.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        catch (Exception exception)
        {
            cleanupError = cleanupError is null ? exception : new AggregateException(cleanupError, exception);
        }

        if (cleanupError is null) return;
        // Neither cleanup nor diagnostic delivery may turn a committed import into
        // a failure or interrupt close/stale-mount/component disposal.
        try
        {
            Logger.LogError(cleanupError, "Unexpected Scene Review preview resize cleanup failure.");
            Diagnostics.Show(cleanupError.ToString());
        }
        catch (Exception diagnosticException)
        {
            try { Logger.LogError(diagnosticException, "Scene Review resize cleanup diagnostics could not be delivered."); }
            catch (Exception) { /* Best-effort diagnostics remain inside this cleanup boundary. */ }
        }
    }
    public async ValueTask DisposeAsync() { disposed = true; await Cancel(); }
    private enum SceneReviewFilter { All, Unclassified, Classified, Exits, Checks, Enemies }
}
