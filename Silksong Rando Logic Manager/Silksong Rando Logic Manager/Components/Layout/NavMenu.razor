@rendermode InteractiveServer
@implements IAsyncDisposable
@inject LogicCatalogService Catalog
@inject NavigationManager Navigation
@inject WorkspaceChangeNotifier WorkspaceChanges
@inject IJSRuntime JS
@inject DiagnosticState Diagnostics
@using Silksong_Rando_Logic_Manager.Services
@using System.Text

@{ sidebarViewVersion++; }
<div class="sidebar-layout" @ref="sidebarRoot" data-sidebar-view="@sidebarViewVersion" data-sidebar-search="@AnySearchIsActive.ToString().ToLowerInvariant()">
    <div class="nav-header">
        <a class="nav-title" href="/">Silksong Logic</a>
        <input class="search-entry" placeholder="search groups or rooms" aria-label="Search groups or rooms" @bind="searchText" @bind:event="oninput" autocomplete="off" />
        <button class="advanced-search-toggle" type="button" aria-expanded="@showAdvancedSearch" aria-controls="advanced-sidebar-search" aria-label="@(showAdvancedSearch ? "Collapse advanced search" : "Expand advanced search")" @onclick="ToggleAdvancedSearchAsync"><i class="fa-solid @(showAdvancedSearch ? "fa-caret-down" : "fa-caret-right")" aria-hidden="true"></i><span>advanced search</span></button>
        @if (showAdvancedSearch)
        {
            <div id="advanced-sidebar-search" class="advanced-search-fields">
                <input class="search-entry" placeholder="location name" aria-label="Search location names" @bind="locationSearchText" @bind:event="oninput" autocomplete="off" />
                <input class="search-entry" placeholder="requirements" aria-label="Search requirements" @bind="requirementsSearchText" @bind:event="oninput" autocomplete="off" />
            </div>
        }
    </div>

@if (workspace is null)
{
    <div class="nav-empty">loading</div>
}
else
{
    <nav class="room-tree" aria-label="Room navigation">
        <div class="tree-top-row">
            <div class="tree-primary-actions">
                <button class="tree-action" type="button" @onclick="CreateRoomGroupAsync"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i> group</button>
            </div>
            <button class="archive-mode-button tree-action" type="button" title="@(showArchivedRooms ? "Hide archived rooms" : "Show archived rooms")" aria-label="@(showArchivedRooms ? "Hide archived rooms" : "Show archived rooms")" aria-pressed="@showArchivedRooms" @onclick="ToggleArchiveModeAsync"><i class="fa-solid @(showArchivedRooms ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i> @(showArchivedRooms ? "hide archive" : "show archive")</button>
        </div>
        @{ var ungroupedRooms = workspace!.Rooms.Where(x => x.RoomGroupId is null && RoomPassesFilters(x, false)).ToList(); }
        @if (ungroupedRooms.Count > 0)
        {
            <section class="room-group">
                <div class="group-heading" data-sidebar-room-target="" data-sidebar-room-index="@ungroupedRooms.Count(x => !x.IsArchived)">
                    <span class="group-label @StatusClass(GroupStatus(null))">Ungrouped</span>
                    <button class="rename-group-button icon-button" type="button" title="Auto-match ungrouped rooms" aria-label="Auto-match ungrouped rooms" @onclick="AutoMatchUngroupedRoomsAsync"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i></button>
                </div>
                @if (!AnySearchIsActive)
                {
                    <button class="new-page-button page-list-action" type="button" @onclick="(() => CreateRoomAsync(null))" aria-label="Add ungrouped page"><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i> page</button>
                }
                @for (var index = 0; index < ungroupedRooms.Count(x => !x.IsArchived); index++)
                {
                    var room = ungroupedRooms.Where(x => !x.IsArchived).ElementAt(index);
                    <div class="drop-line" aria-hidden="true" data-sidebar-room-target="" data-sidebar-room-index="@index"></div>
                    <a class="@RoomLinkClass(room)" href="@($"rooms/{room.Id}")" title="@RoomLinkLabel(room)" aria-label="@RoomLinkLabel(room)" draggable="@(!AnySearchIsActive ? "true" : "false")" data-sidebar-room="@room.Id" data-sidebar-room-target="" data-sidebar-room-index="@index">@RoomImageSlot(room)<span class="room-link-name">@room.FriendlyName</span></a>
                }
                <div class="drop-line" aria-hidden="true" data-sidebar-room-target="" data-sidebar-room-index="@ungroupedRooms.Count(x => !x.IsArchived)"></div>
                @if (showArchivedRooms && ungroupedRooms.Any(x => x.IsArchived))
                {
                    <div class="archived-section-label">[archived]</div>
                    @foreach (var room in ungroupedRooms.Where(x => x.IsArchived))
                    {
                        <a class="@RoomLinkClass(room)" href="@($"rooms/{room.Id}")" title="@RoomLinkLabel(room)" aria-label="@RoomLinkLabel(room)">@RoomImageSlot(room)<span class="room-link-name">@room.FriendlyName</span></a>
                    }
                }
            </section>
        }
        @for (var groupIndex = 0; groupIndex < workspace.RoomGroups.Count; groupIndex++)
        {
            var groupDropIndex = groupIndex;
            var group = workspace.RoomGroups[groupIndex];
            var groupMatches = MatchesNameSearch(group.FriendlyName);
            var groupRooms = workspace.Rooms.Where(x => x.RoomGroupId == group.Id && RoomPassesFilters(x, groupMatches)).ToList();
            if (groupRooms.Count == 0 && (AdvancedSearchIsActive || !groupMatches))
            {
                continue;
            }
            <section class="room-group">
                <div class="group-heading" draggable="@(!AnySearchIsActive ? "true" : "false")" data-sidebar-group="@group.Id" data-sidebar-group-index="@groupDropIndex" data-sidebar-room-target="@group.Id" data-sidebar-room-index="@groupRooms.Count(x => !x.IsArchived)">
                    <button class="group-label @StatusClass(GroupStatus(group.Id))" type="button" @onclick="(() => ToggleGroupAsync(group.Id))" aria-expanded="@(!IsEffectivelyCollapsed(group.Id))"><span class="group-toggle-icon" aria-hidden="true"><i class="fa-solid @(IsEffectivelyCollapsed(group.Id) ? "fa-chevron-right" : "fa-chevron-down")"></i></span>@group.FriendlyName</button>
                    <button class="rename-group-button icon-button" type="button" title="Edit @group.FriendlyName" @onclick="(() => OpenGroupEditorAsync(group.Id))" aria-label="Edit @group.FriendlyName"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>
                </div>
                @if (!IsEffectivelyCollapsed(group.Id))
                {
                    @if (!AnySearchIsActive)
                    {
                        <button class="new-page-button page-list-action" type="button" @onclick="(() => CreateRoomAsync(group.Id))"><i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i> page</button>
                    }
                    @for (var index = 0; index < groupRooms.Count(x => !x.IsArchived); index++)
                    {
                        var room = groupRooms.Where(x => !x.IsArchived).ElementAt(index);
                        var dropIndex = index;
                        <div class="drop-line" aria-hidden="true" data-sidebar-room-target="@group.Id" data-sidebar-room-index="@dropIndex"></div>
                        <a class="@RoomLinkClass(room)" href="@($"rooms/{room.Id}")" title="@RoomLinkLabel(room)" aria-label="@RoomLinkLabel(room)" draggable="@(!AnySearchIsActive ? "true" : "false")" data-sidebar-room="@room.Id" data-sidebar-room-target="@group.Id" data-sidebar-room-index="@dropIndex">@RoomImageSlot(room)<span class="room-link-name">@GroupedRoomLinkText(group, room)</span></a>
                    }
                    <div class="drop-line" aria-hidden="true" data-sidebar-room-target="@group.Id" data-sidebar-room-index="@groupRooms.Count(x => !x.IsArchived)"></div>
                    @if (showArchivedRooms && groupRooms.Any(x => x.IsArchived))
                    {
                        <div class="archived-section-label">[archived]</div>
                        @foreach (var room in groupRooms.Where(x => x.IsArchived))
                        {
                            <a class="@RoomLinkClass(room)" href="@($"rooms/{room.Id}")" title="@RoomLinkLabel(room)" aria-label="@RoomLinkLabel(room)">@RoomImageSlot(room)<span class="room-link-name">@GroupedRoomLinkText(group, room)</span></a>
                        }
                    }
                }
            </section>
        }
        <div class="group-drop-line" aria-hidden="true" data-sidebar-group-index="@workspace.RoomGroups.Count"></div>
        @if (groupEditDraft is not null)
        {
            <div class="confirmation-backdrop">
                <section class="confirmation-modal group-edit-modal" role="dialog" aria-modal="true" aria-labelledby="group-edit-title">
                    <h2 id="group-edit-title">edit room group</h2>
                    <label class="group-edit-field">friendly name<input id="group-friendly-name" @ref="groupFriendlyNameInput" @bind="groupEditDraft.FriendlyName" autocomplete="off" /></label>
                    <label class="group-edit-field">zone reference<input class="@GroupZoneReferenceClass(groupEditDraft.Id)" @bind="groupEditDraft.ZoneReferenceText" list="map-zone-ids" autocomplete="off" /></label>
                    <label class="group-edit-field group-edit-virtual"><input type="checkbox" @bind="groupEditDraft.IsVirtual" /> virtual</label>
                    <datalist id="map-zone-ids">@foreach (var zoneId in groupEditorData!.ZoneIds) { <option value="@zoneId"></option> }</datalist>
                    @if (groupEditorData!.ZoneReferenceStatus is { } status)
                    {
                        <p class="@("group-zone-status " + (status == ReferenceResolutionStatus.Resolved ? "" : "danger"))">zone reference: @status</p>
                    }
                    <div class="confirmation-actions">
                        <button type="button" @onclick="SaveGroupEditorAsync">save</button>
                        <button type="button" @onclick="CancelGroupEditor">cancel</button>
                        <button type="button" @onclick="OpenGroupDeleteFromEditor">delete group</button>
                    </div>
                </section>
            </div>
        }
        @if (groupDeleteId is not null)
        {
            <div class="confirmation-backdrop">
                <section class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="group-delete-title">
                    <h2 id="group-delete-title">delete room group?</h2>
                    <p>Delete <strong>@groupDeleteName</strong>? Linked rooms will become ungrouped. This cannot be undone.</p>
                    <div class="confirmation-actions">
                        <button type="button" @onclick="DeleteGroupAsync">delete group</button>
                        <button type="button" @onclick="CloseGroupDeleteConfirmation">cancel</button>
                    </div>
                </section>
            </div>
        }
    </nav>
}
    <footer class="sidebar-export-footer">
        <archipelago-launcher><button class="tree-action sidebar-archipelago-control" type="button" data-archipelago-launcher aria-label="Archipelago" aria-controls="archipelago-modal" aria-haspopup="dialog"><i class="fa-solid fa-wifi" aria-hidden="true"></i> archipelago</button></archipelago-launcher>
        <a class="tree-action sidebar-requirements-control" href="/requirements"><i class="fa-solid fa-book" aria-hidden="true"></i> requirements</a>
        <div class="sidebar-scene-image-row"><SceneReviewTrigger /><RoomImageOperations /></div>
        <div class="sidebar-export-row">
            <button class="tree-action sidebar-export-control" type="button" @onclick="OpenImportPickerAsync">import rooms</button>
            <button class="tree-action sidebar-export-control" type="button" @onclick="OpenExportModal">export rooms</button>
        </div>
        @{
#if DEBUG
            <DebugDiagnosticControls />
#endif
        }
    </footer>

    @if (showExportModal)
    {
        <div class="confirmation-backdrop">
            <section class="confirmation-modal sidebar-export-modal" role="dialog" aria-modal="true" aria-labelledby="sidebar-export-title">
                <h2 id="sidebar-export-title">export complete catalogue</h2>
                <label class="sidebar-export-map-option"><input type="checkbox" @bind="includeAreaMap" /> include area map (only recommended for master copy)</label>
                <div class="confirmation-actions">
                    <button type="button" @onclick="CloseExportModal">cancel</button>
                    <button type="button" @onclick="DownloadCompleteExport">download complete catalogue</button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private SidebarWorkspaceSnapshot? workspace;
    private ElementReference sidebarRoot;
    private IJSObjectReference? sidebarDragModule, sidebarDragOwner;
    private DotNetObjectReference<NavMenu>? sidebarDragCallback;
    private readonly string sidebarOwnerId = Guid.NewGuid().ToString();
    private long sidebarViewVersion;
    private bool sidebarOwnerInitializing, sidebarDisposed, sidebarMovePending;
    private bool focusGroupNameEditor;
    private ElementReference groupFriendlyNameInput;
    private readonly HashSet<Guid> collapsedGroupIds = [];
    private string searchText = string.Empty;
    private string locationSearchText = string.Empty;
    private string requirementsSearchText = string.Empty;
    private bool showAdvancedSearch;
    private IReadOnlyDictionary<Guid, IReadOnlyList<string>>? locationNamesByRoom;
    private IReadOnlyDictionary<Guid, IReadOnlyList<string>>? requirementsByRoom;
    private Guid? currentRoomRouteId;
    private bool initialized;
    private bool showArchivedRooms;
    private bool sidebarStateRestored;
    private Guid? groupDeleteId;
    private string groupDeleteName = string.Empty;
    private RoomGroupEditorDraft? groupEditDraft;
    private GroupEditorData? groupEditorData;
    private bool showExportModal;
    private bool includeAreaMap;

    protected override async Task OnInitializedAsync()
    {
        currentRoomRouteId = GetRoomRouteId(Navigation.Uri);
        WorkspaceChanges.Changed += HandleWorkspaceChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        await ExecuteAsync(ReloadAsync);
    }

    private Task CreateRoomGroupAsync() => ExecuteAsync(async () =>
    {
        var group = await Catalog.CreateRoomGroupAsync("New group");
        searchText = string.Empty;
        await ReloadAsync();
        WorkspaceChanges.NotifyChanged();
        await OpenGroupEditorAsync(group.Id);
        focusGroupNameEditor = true;
        collapsedGroupIds.Remove(group.Id);
        await PersistSidebarStateAsync();
    });

    private Task CreateRoomAsync(Guid? groupId) => ExecuteAsync(async () =>
    {
        var room = await Catalog.CreateRoomAsync("New room", groupId);
        await ReloadAsync();
        WorkspaceChanges.NotifyChanged();
        Navigation.NavigateTo($"rooms/{room.Id}");
        await JS.InvokeVoidAsync("focusAndSelectById", "room-title");
    });

    private Task AutoMatchUngroupedRoomsAsync() => ExecuteAsync(async () =>
    {
        await Catalog.AutoMatchUngroupedRoomsAsync();
        await ReloadAsync();
        WorkspaceChanges.NotifyChanged();
    });

    private Task SaveGroupEditorAsync() => ExecuteAsync(async () =>
    {
        if (groupEditDraft is null)
        {
            return;
        }

        await Catalog.SaveRoomGroupAsync(new(groupEditorData!.Baseline, groupEditDraft));
        groupEditDraft = null;
        groupEditorData = null;
        focusGroupNameEditor = false;
        await ReloadAsync();
        WorkspaceChanges.NotifyChanged();
    });

    private async Task ReloadAsync()
    {
        // Retire callbacks from the displayed projection before an async replacement.
        sidebarViewVersion++;
        workspace = await Catalog.GetWorkspaceAsync();
        if (!initialized)
        {
            collapsedGroupIds.Clear();
            foreach (var group in workspace.RoomGroups)
            {
                collapsedGroupIds.Add(group.Id);
            }

            initialized = true;
        }
    }

    private bool IsVisibleRoom(SidebarRoom room) => !room.IsArchived || showArchivedRooms;

    private bool RoomPassesFilters(SidebarRoom room, bool groupMatchesName) =>
        IsVisibleRoom(room)
        && (!NameSearchIsActive || groupMatchesName || MatchesNameSearch(room.FriendlyName)
            || !string.IsNullOrWhiteSpace(room.InGameId) && MatchesNameSearch(room.InGameId))
        && MatchesLocationSearch(room.Id)
        && MatchesRequirementsSearch(room.Id);

    private string RoomLinkClass(SidebarRoom room)
    {
        var classes = room.IsArchived
            ? "room-link archived-room-link"
            : $"room-link {StatusClass(room.Status)}";
        return IsSelectedRoom(room.Id) ? $"{classes} active" : classes;
    }

    private bool IsSelectedRoom(Guid roomId)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(path, $"rooms/{roomId}", StringComparison.OrdinalIgnoreCase)
            || string.Equals(path, $"rooms/{roomId}/audit", StringComparison.OrdinalIgnoreCase);
    }

    private static string? RoomImageReason(SidebarRoom room) => room.ImageState switch
    {
        SidebarRoomImageState.Disabled => "Scene image intentionally disabled",
        SidebarRoomImageState.NeedsRecapture => "Needs recapture",
        SidebarRoomImageState.Missing => "Scene image missing",
        SidebarRoomImageState.NonstandardScale => "Nonstandard image scale",
        _ => null
    };

    private static string RoomLinkLabel(SidebarRoom room) => RoomImageReason(room) is { } reason
        ? $"{room.FriendlyName}: {reason}"
        : room.FriendlyName;

    private RenderFragment RoomImageSlot(SidebarRoom room) => @<span class="room-image-slot @(room.ImageState switch
        {
            SidebarRoomImageState.Disabled => "room-image-disabled",
            SidebarRoomImageState.NeedsRecapture or SidebarRoomImageState.Missing => "room-image-danger",
            SidebarRoomImageState.NonstandardScale => "room-image-warning",
            _ => string.Empty
        })" aria-hidden="true">
        @if (room.ImageState != SidebarRoomImageState.None)
        {
            <i class="fa-solid fa-image"></i>
            @if (room.ImageState != SidebarRoomImageState.Disabled)
            {
                <i class="fa-solid fa-triangle-exclamation room-image-warning-mark"></i>
            }
        }
    </span>;

    private Task ToggleArchiveModeAsync() => ExecuteAsync(async () =>
    {
        showArchivedRooms = !showArchivedRooms;
        await PersistSidebarStateAsync();
    });

    private void OpenExportModal()
    {
        includeAreaMap = false;
        showExportModal = true;
    }

    private void CloseExportModal() => showExportModal = false;

    private void DownloadCompleteExport()
    {
        Navigation.NavigateTo($"{LocalExchangeDownloadEndpoints.CompletePath}?includeAreaMap={includeAreaMap.ToString().ToLowerInvariant()}", forceLoad: true);
    }

    private Task OpenImportPickerAsync() => JS.InvokeVoidAsync("openSceneUploadPicker", "distributed-import-input").AsTask();

    private void PrepareGroupDelete(GroupEditorView group)
    {
        groupDeleteId = group.Id;
        groupDeleteName = group.FriendlyName;
    }

    private void OpenGroupDeleteConfirmation() { }

    private void CloseGroupDeleteConfirmation()
    {
        groupDeleteId = null;
    }

    private Task DeleteGroupAsync() => ExecuteAsync(async () =>
    {
        if (groupDeleteId is not { } id)
        {
            return;
        }

        await Catalog.DeleteRoomGroupAsync(id);
        groupDeleteId = null;
        collapsedGroupIds.Remove(id);
        await PersistSidebarStateAsync();
        await ReloadAsync();
        WorkspaceChanges.NotifyChanged();
    });

    public sealed record SidebarMoveIntent(string Owner, long ViewVersion, string Family, Guid SourceId, Guid? GroupId, int Index);

    [JSInvokable]
    public async Task SubmitSidebarMoveAsync(SidebarMoveIntent intent)
    {
        if (sidebarDisposed || sidebarMovePending || workspace is null || AnySearchIsActive
            || intent.Owner != sidebarOwnerId || intent.ViewVersion != sidebarViewVersion || intent.Index < 0)
        {
            return;
        }

        var isRoom = intent.Family == "room";
        if (isRoom)
        {
            if (!workspace.Rooms.Any(room => room.Id == intent.SourceId && !room.IsArchived)
                || intent.GroupId is { } destination && !workspace.RoomGroups.Any(group => group.Id == destination)
                || intent.Index > workspace.Rooms.Count(room => room.RoomGroupId == intent.GroupId && !room.IsArchived)) return;
        }
        else if (intent.Family != "group" || intent.GroupId is not null
            || !workspace.RoomGroups.Any(group => group.Id == intent.SourceId)
            || intent.Index > workspace.RoomGroups.Count) return;

        sidebarMovePending = true;
        var admittedWorkspace = workspace;
        try
        {
            await ExecuteAsync(async () =>
            {
                if (isRoom)
                {
                    var committedRooms = await Catalog.MoveRoomAsync(intent.SourceId, intent.GroupId, intent.Index);
                    if (sidebarDisposed || !ReferenceEquals(workspace, admittedWorkspace)) return;
                    ApplyCommittedRoomMove(committedRooms);
                }
                else
                {
                    var committedGroups = await Catalog.MoveRoomGroupAsync(intent.SourceId, intent.Index);
                    if (sidebarDisposed || !ReferenceEquals(workspace, admittedWorkspace)) return;
                    workspace = admittedWorkspace with { RoomGroups = committedGroups };
                }

                WorkspaceChanges.NotifyChanged(WorkspaceChangeScope.None);
                await InvokeAsync(StateHasChanged);
            });
        }
        finally
        {
            sidebarMovePending = false;
        }
    }

    private void ApplyCommittedRoomMove(IReadOnlyList<Room> committedRooms)
    {
        var committedById = committedRooms.ToDictionary(item => item.Id, item =>
        {
            var existing = workspace!.Rooms.Single(room => room.Id == item.Id);
            return new SidebarRoom(item.Id, item.RoomGroupId, item.FriendlyName, item.InGameId, item.SortOrder, item.IsArchived, existing.Status, existing.ImageState);
        });
        workspace = workspace! with
        {
            Rooms = workspace.Rooms
                .Select(item => committedById.GetValueOrDefault(item.Id, item))
                .OrderBy(item => item.SortOrder)
                .ThenBy(item => item.FriendlyName)
                .ToList()
        };
    }

    private bool IsCollapsed(Guid groupId) => collapsedGroupIds.Contains(groupId);

    private bool IsEffectivelyCollapsed(Guid groupId)
    {
        return AnySearchIsActive ? false : IsCollapsed(groupId);
    }

    private bool NameSearchIsActive => SearchTermIsActive(searchText);
    private bool AdvancedSearchIsActive => SearchTermIsActive(locationSearchText) || SearchTermIsActive(requirementsSearchText);
    private bool AnySearchIsActive => NameSearchIsActive || AdvancedSearchIsActive;

    private bool MatchesNameSearch(string value) => MatchesSearch(value, searchText);

    private bool MatchesLocationSearch(Guid roomId) =>
        !SearchTermIsActive(locationSearchText)
        || locationNamesByRoom is not null
            && locationNamesByRoom.TryGetValue(roomId, out var names)
            && names.Any(value => MatchesSearch(value, locationSearchText));

    private bool MatchesRequirementsSearch(Guid roomId) =>
        !SearchTermIsActive(requirementsSearchText)
        || requirementsByRoom is not null
            && requirementsByRoom.TryGetValue(roomId, out var requirements)
            && requirements.Any(value => MatchesSearch(value, requirementsSearchText));

    private static bool SearchTermIsActive(string value) => NormalizeSearchText(value).Length > 0;

    private static bool MatchesSearch(string source, string term)
    {
        var normalizedTerm = NormalizeSearchText(term);
        return normalizedTerm.Length == 0
            || NormalizeSearchText(source).Contains(normalizedTerm, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeSearchText(string value)
    {
        var result = new StringBuilder(value.Length);
        var pendingSpace = false;
        foreach (var character in value)
        {
            if (char.IsWhiteSpace(character))
            {
                pendingSpace = result.Length > 0;
                continue;
            }

            if (pendingSpace)
            {
                result.Append(' ');
                pendingSpace = false;
            }

            result.Append(character);
        }

        return result.ToString();
    }

    private static string GroupedRoomLinkText(SidebarRoomGroup group, SidebarRoom room) =>
        !string.IsNullOrWhiteSpace(group.FriendlyName) &&
        !string.Equals(room.FriendlyName, group.FriendlyName, StringComparison.OrdinalIgnoreCase) &&
        room.FriendlyName.StartsWith(group.FriendlyName, StringComparison.OrdinalIgnoreCase)
            ? room.FriendlyName[group.FriendlyName.Length..].TrimStart()
            : room.FriendlyName;

    private AppliedRoomStatus GroupStatus(Guid? groupId)
    {
        var active = workspace!.Rooms.Where(x => x.RoomGroupId == groupId && !x.IsArchived).Select(x => x.Status).ToArray();
        return active.Contains(AppliedRoomStatus.Danger) ? AppliedRoomStatus.Danger
            : active.Contains(AppliedRoomStatus.Warning) ? AppliedRoomStatus.Warning
            : active.Length > 0 && active.All(x => x == AppliedRoomStatus.Success) ? AppliedRoomStatus.Success
            : AppliedRoomStatus.Neutral;
    }
    private static string StatusClass(AppliedRoomStatus status) => status switch
    {
        AppliedRoomStatus.Success => "sidebar-status-success",
        AppliedRoomStatus.Warning => "sidebar-status-warning",
        AppliedRoomStatus.Danger => "sidebar-status-danger",
        _ => "sidebar-status-neutral"
    };

    private Task ToggleGroupAsync(Guid groupId) => ExecuteAsync(async () =>
    {
        if (AnySearchIsActive)
        {
            return;
        }

        if (!collapsedGroupIds.Add(groupId))
        {
            collapsedGroupIds.Remove(groupId);
        }

        await PersistSidebarStateAsync();
    });

    private async Task OpenGroupEditorAsync(Guid groupId)
    {
        groupEditorData = await Catalog.GetGroupEditorDataAsync(groupId)
            ?? throw new InvalidOperationException($"Room group {groupId} no longer exists.");
        groupEditDraft = groupEditorData.Draft;
        focusGroupNameEditor = true;
    }

    private void CancelGroupEditor()
    {
        groupEditDraft = null;
        groupEditorData = null;
        focusGroupNameEditor = false;
    }

    private void OpenGroupDeleteFromEditor()
    {
        if (groupEditDraft is null)
        {
            return;
        }

        PrepareGroupDelete(groupEditorData!.View);
        groupEditDraft = null;
        groupEditorData = null;
        focusGroupNameEditor = false;
    }

    private string GroupZoneReferenceClass(Guid groupId) => groupEditorData?.ZoneReferenceStatus is { } status && status != ReferenceResolutionStatus.Resolved ? "danger" : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureSidebarDragOwnerAsync();
        if (sidebarDisposed) return;
        if (!sidebarStateRestored)
        {
            sidebarStateRestored = true;
            await ExecuteAsync(RestoreSidebarStateAsync);
            StateHasChanged();
            return;
        }

        if (!focusGroupNameEditor || groupEditDraft is null)
        {
            return;
        }

        focusGroupNameEditor = false;
        await ExecuteAsync(async () => await JS.InvokeVoidAsync("focusAndSelect", groupFriendlyNameInput));
    }

    private void HandleWorkspaceChanged(WorkspaceChangeScope scope)
    {
        if (scope.HasFlag(WorkspaceChangeScope.Sidebar)) _ = RefreshAfterWorkspaceChangeAsync();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var previousRoomId = currentRoomRouteId;
        var nextRoomId = GetRoomRouteId(args.Location);
        currentRoomRouteId = nextRoomId;
        _ = InvokeAsync(async () =>
        {
            if (showAdvancedSearch && previousRoomId is { } previous && nextRoomId is { } next && previous != next)
            {
                await ExecuteAsync(LoadAdvancedSearchAsync);
            }

            StateHasChanged();
        });
    }

    private async Task ToggleAdvancedSearchAsync()
    {
        if (showAdvancedSearch)
        {
            showAdvancedSearch = false;
            locationSearchText = string.Empty;
            requirementsSearchText = string.Empty;
            locationNamesByRoom = null;
            requirementsByRoom = null;
            return;
        }

        showAdvancedSearch = true;
        await ExecuteAsync(LoadAdvancedSearchAsync);
    }

    private async Task LoadAdvancedSearchAsync()
    {
        var locationRows = await Catalog.GetSidebarLocationSearchAsync();
        var requirements = await Catalog.GetSidebarRequirementsSearchAsync();
        var requirementRows = requirements.Transitions.Concat(requirements.Connections).Concat(requirements.Checks);
        locationNamesByRoom = GroupSearchValues(locationRows.Select(x => (x.RoomId, x.FriendlyName)));
        requirementsByRoom = GroupSearchValues(requirementRows.Select(x => (x.RoomId, x.Requirements)));
    }

    private static IReadOnlyDictionary<Guid, IReadOnlyList<string>> GroupSearchValues(IEnumerable<(Guid RoomId, string Value)> rows) =>
        rows.GroupBy(x => x.RoomId).ToDictionary(
            group => group.Key,
            group => (IReadOnlyList<string>)group.Select(x => x.Value).ToArray());

    private Guid? GetRoomRouteId(string uri)
    {
        var path = Navigation.ToBaseRelativePath(uri).Split('?', '#')[0].Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return (segments.Length == 2 || segments.Length == 3 && string.Equals(segments[2], "audit", StringComparison.OrdinalIgnoreCase))
            && string.Equals(segments[0], "rooms", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(segments[1], out var roomId)
                ? roomId
                : null;
    }

    private async Task RefreshAfterWorkspaceChangeAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await ReloadAsync();
                StateHasChanged();
            });
        }
        catch (Exception exception)
        {
            Diagnostics.Show(exception.ToString());
        }
    }

    private async Task ExecuteAsync(Func<Task> operation)
    {
        try
        {
            await operation();
        }
        catch (Exception exception)
        {
            Diagnostics.Show(exception.ToString());
        }
    }

    private async Task RestoreSidebarStateAsync()
    {
        var savedState = await JS.InvokeAsync<SidebarSessionState?>("loadSidebarSessionState");
        if (savedState is null)
        {
            return;
        }

        showArchivedRooms = savedState.ShowArchivedRooms;
        var currentGroupIds = workspace!.RoomGroups.Select(x => x.Id).ToHashSet();
        collapsedGroupIds.Clear();
        foreach (var groupId in savedState.CollapsedGroupIds.Where(currentGroupIds.Contains))
        {
            collapsedGroupIds.Add(groupId);
        }
    }

    private Task PersistSidebarStateAsync() => JS.InvokeVoidAsync(
        "saveSidebarSessionState",
        new SidebarSessionState(showArchivedRooms, collapsedGroupIds.ToArray())).AsTask();

    private async Task EnsureSidebarDragOwnerAsync()
    {
        if (sidebarDisposed || sidebarOwnerInitializing || sidebarDragOwner is not null) return;
        sidebarOwnerInitializing = true;
        try
        {
            var module = sidebarDragModule ?? await JS.InvokeAsync<IJSObjectReference>("import", "./sidebar-drag.js");
            if (sidebarDisposed) { await module.DisposeAsync(); return; }
            sidebarDragModule = module;
            sidebarDragCallback ??= DotNetObjectReference.Create(this);
            var owner = await module.InvokeAsync<IJSObjectReference>("mount", sidebarRoot, sidebarDragCallback, sidebarOwnerId);
            if (sidebarDisposed)
            {
                await ReleaseSidebarDragOwnerAsync(owner);
                return;
            }
            sidebarDragOwner = owner;
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) when (sidebarDisposed) { }
        catch (Exception exception) { if (!sidebarDisposed) Diagnostics.Show(exception.ToString()); }
        finally { sidebarOwnerInitializing = false; }
    }

    private static async Task ReleaseSidebarDragOwnerAsync(IJSObjectReference owner)
    {
        try { await owner.InvokeVoidAsync("dispose"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            try { await owner.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        sidebarDisposed = true;
        WorkspaceChanges.Changed -= HandleWorkspaceChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
        try
        {
            if (sidebarDragOwner is not null) await ReleaseSidebarDragOwnerAsync(sidebarDragOwner);
        }
        finally
        {
            sidebarDragCallback?.Dispose();
            try { if (sidebarDragModule is not null) await sidebarDragModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    private sealed record SidebarSessionState(bool ShowArchivedRooms, IReadOnlyList<Guid> CollapsedGroupIds);
}

