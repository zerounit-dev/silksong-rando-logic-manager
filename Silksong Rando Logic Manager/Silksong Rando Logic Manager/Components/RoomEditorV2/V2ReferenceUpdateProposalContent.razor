@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<h2 id="v2-page-modal-title">update authored references?</h2><p id="v2-page-modal-description">@View.SourceKind <strong>@View.SourceFriendlyName</strong> would use <strong>@View.NewReferenceId</strong>.</p><div class="v2-modal-footer"><div><button class="compact-control" type="button" disabled="@Disabled" @onclick="Revert">revert change</button></div><div><button class="compact-control" type="button" disabled="@Disabled" @onclick="DoNotUpdate">do not update references</button><button class="compact-control" type="button" disabled="@Disabled" @onclick="Update">update references</button></div></div>
@code { [Parameter, EditorRequired] public V2ReferenceUpdateProposalView View { get; set; } = null!; [Parameter] public EventCallback Revert { get; set; } [Parameter] public EventCallback DoNotUpdate { get; set; } [Parameter] public EventCallback Update { get; set; } [Parameter] public bool Disabled { get; set; } }
