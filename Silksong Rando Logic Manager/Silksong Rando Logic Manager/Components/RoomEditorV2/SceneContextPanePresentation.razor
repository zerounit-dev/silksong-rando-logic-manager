@using System.Globalization
@using Microsoft.JSInterop
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="room-context-scene-pane" aria-label="Scene layout pane" data-scene-selected-kind="@(SelectedItem is { } selectedIntent ? KindText(selectedIntent.Kind) : null)" data-scene-selected-id="@SelectedItem?.EntityId">
    @{ var scene = View ?? new SceneLayoutView(false, 0, 0, null, null, [], []); var viewport = SceneViewportMath.Initial(scene); }
    <svg @ref="canvas" class="@($"scene-layout {(placement is null ? "" : "scene-layout-placement-armed")}")" viewBox="@Box(viewport)" role="img" aria-label="Scene layout canvas" data-scene-layout-canvas="true" data-scene-initial-viewbox="@Box(viewport)" data-scene-viewport-key="@RoomId" data-scene-owner-generation="@ownerGeneration" data-scene-min-x="@N(scene.SceneMinX)" data-scene-min-y="@N(scene.SceneMinY)" data-scene-max-x="@N(scene.SceneMaxX ?? 0)" data-scene-max-y="@N(scene.SceneMaxY ?? 0)" data-scene-placement-armed="@(placement is null ? null : "true")" tabindex="0">
        @if (scene.HasValidBounds && scene.Image?.IsAvailable == true && scene.SceneUnitWidth is double imageWidth && scene.SceneUnitHeight is double imageHeight) { <image class="scene-layout-image" data-scene-layout-image="true" href="@($"/data/scenes/{RoomId:D}.webp?v={scene.Image.ImageVersion}")" x="@N(scene.SceneMinX)" y="@N(-scene.SceneMaxY!.Value)" width="@N(imageWidth)" height="@N(imageHeight)" preserveAspectRatio="none" /> }
        @if (scene.HasValidBounds && scene.SceneUnitWidth is double width && scene.SceneUnitHeight is double height)
        {
            <rect class="scene-layout-room-bounds" x="@N(scene.SceneMinX)" y="@N(-scene.SceneMaxY!.Value)" width="@N(width)" height="@N(height)" />
            <rect class="scene-layout-room-bounds-edge edge-n" data-scene-snap-room-edge="t" x="@N(scene.SceneMinX)" y="@N(-scene.SceneMaxY!.Value-1)" width="@N(width)" height="1" />
            <rect class="scene-layout-room-bounds-edge edge-s" data-scene-snap-room-edge="b" x="@N(scene.SceneMinX)" y="@N(-scene.SceneMinY)" width="@N(width)" height="1" />
            <rect class="scene-layout-room-bounds-edge edge-e" data-scene-snap-room-edge="r" x="@N(scene.SceneMaxX!.Value)" y="@N(-scene.SceneMaxY!.Value)" width="1" height="@N(height)" />
            <rect class="scene-layout-room-bounds-edge edge-w" data-scene-snap-room-edge="l" x="@N(scene.SceneMinX-1)" y="@N(-scene.SceneMaxY!.Value)" width="1" height="@N(height)" />
        }
        <g data-scene-annotations="true">
            @foreach (var frame in scene.Frames) { <g class="scene-layout-subroom" data-scene-layout-frame="true" data-scene-selection-kind="subroom" data-scene-id="@frame.EntityId" data-scene-frame-x="@N(frame.X)" data-scene-frame-y="@N(frame.Y)" data-scene-frame-width="@N(frame.Width)" data-scene-frame-height="@N(frame.Height)"><title>@frame.Title</title><rect class="scene-layout-subroom-body" data-scene-frame-target="move" x="@N(frame.X)" y="@N(-frame.Y-frame.Height)" width="@N(frame.Width)" height="@N(frame.Height)" /><rect class="scene-layout-subroom-edge edge-n" data-scene-frame-target="t" x="@N(frame.X)" y="@N(-frame.Y-frame.Height-1)" width="@N(frame.Width)" height="1" /><rect class="scene-layout-subroom-edge edge-s" data-scene-frame-target="b" x="@N(frame.X)" y="@N(-frame.Y)" width="@N(frame.Width)" height="1" /><rect class="scene-layout-subroom-edge edge-e" data-scene-frame-target="r" x="@N(frame.X+frame.Width)" y="@N(-frame.Y-frame.Height)" width="1" height="@N(frame.Height)" /><rect class="scene-layout-subroom-edge edge-w" data-scene-frame-target="l" x="@N(frame.X-1)" y="@N(-frame.Y-frame.Height)" width="1" height="@N(frame.Height)" /><rect class="scene-layout-subroom-corner corner-nw" data-scene-frame-target="tl" x="@N(frame.X-1)" y="@N(-frame.Y-frame.Height-1)" width="2" height="2" /><rect class="scene-layout-subroom-corner corner-ne" data-scene-frame-target="tr" x="@N(frame.X+frame.Width-1)" y="@N(-frame.Y-frame.Height-1)" width="2" height="2" /><rect class="scene-layout-subroom-corner corner-sw" data-scene-frame-target="bl" x="@N(frame.X-1)" y="@N(-frame.Y-1)" width="2" height="2" /><rect class="scene-layout-subroom-corner corner-se" data-scene-frame-target="br" x="@N(frame.X+frame.Width-1)" y="@N(-frame.Y-1)" width="2" height="2" /><text x="@N(frame.X+frame.Width/2)" y="@N(-frame.Y-frame.Height/2)" text-anchor="middle" dominant-baseline="central">@frame.Label</text></g> }
            @foreach (var thread in scene.RelationshipThreads) { <line class="@($"scene-layout-relationship-thread{(thread.IsOneWayConnection ? " scene-layout-relationship-thread-one-way" : "")}")" data-scene-relationship-thread="true" data-scene-thread-marker-id="@thread.MarkerEntityId" data-scene-thread-frame-id="@thread.FrameEntityId" data-scene-thread-marker-x="@N(thread.MarkerX)" data-scene-thread-marker-y="@N(thread.MarkerY)" data-scene-thread-frame-x="@N(thread.FrameX)" data-scene-thread-frame-y="@N(thread.FrameY)" data-scene-thread-frame-width="@N(thread.FrameWidth)" data-scene-thread-frame-height="@N(thread.FrameHeight)" x1="@N(thread.MarkerX)" y1="@N(-thread.MarkerY)" x2="@N(NearestX(thread))" y2="@N(-NearestY(thread))" style="@ThreadStyle(thread)" /> }
            @foreach (var marker in scene.Markers) { var y = -marker.Y; <g class="@($"scene-layout-marker scene-layout-{marker.Kind}{(marker.IsEnemy ? " scene-layout-enemy" : "")}")" data-scene-layout-marker="@marker.Kind" data-scene-selection-kind="@marker.Kind" data-scene-id="@marker.EntityId" data-scene-marker-x="@N(marker.X)" data-scene-marker-y="@N(marker.Y)"><title>@marker.Title</title>@if (marker.Kind == "check") { <circle cx="@N(marker.X)" cy="@N(y)" r="1.5" /> } else { <rect x="@N(marker.X-5.25)" y="@N(y-3)" width="10.5" height="6" rx=".6" /><svg:text x="@N(marker.X)" y="@N(y)" text-anchor="middle" dominant-baseline="central">@marker.Label</svg:text> }</g> }
            <g class="row-annotation-foreground" data-v2-row-annotation-foreground="true" aria-hidden="true" pointer-events="none"></g>
        </g>
    </svg>
    @{ var fallbackStatus = !scene.HasValidBounds ? "scene dimensions unavailable" : placement is { } armed ? (armed.Kind == "subroom" ? "draw subroom rectangle; drag to the opposite corner, or press Escape to cancel" : $"place {armed.Kind} annotation; click the scene, or press Escape to cancel") : scene.Image?.IsStale == true ? "needs recapture" : ""; var actionBox = ActionBox ?? new V2SceneActionBoxView(false, false, false, false, false, "re-arm placement", "reset annotation to game position", "clear annotation geometry", "show annotation", "dismiss scene interaction", false, fallbackStatus, false); var statusText = !scene.HasValidBounds ? "scene dimensions unavailable" : actionBox.StatusText; }
    <div class="scene-layout-status" data-scene-status="true" role="status"><div class="scene-annotation-action-box" data-scene-annotation-action-box="true"><button type="button" data-scene-action="rearm" title="@actionBox.RearmLabel" aria-label="@actionBox.RearmLabel" disabled="@(!actionBox.RearmEnabled)" @onclick="()=>RequestAction(V2SceneAction.Rearm)"><i class="fa-solid @(SelectedItem?.Kind == V2SceneSelectedItemKind.Subroom ? "fa-expand" : "fa-crosshairs") fa-fw" aria-hidden="true"></i></button><button type="button" class="@(actionBox.AnnotationMatchesGamePosition ? "scene-annotation-game-aligned" : null)" data-scene-action="reset" title="@actionBox.ResetLabel" aria-label="@actionBox.ResetLabel" disabled="@(!actionBox.ResetEnabled)" @onclick="()=>RequestAction(V2SceneAction.Reset)"><i class="fa-solid fa-gamepad fa-fw" aria-hidden="true"></i></button><button type="button" data-scene-action="clear" title="@actionBox.ClearLabel" aria-label="@actionBox.ClearLabel" disabled="@(!actionBox.ClearEnabled)" @onclick="()=>RequestAction(V2SceneAction.Clear)"><i class="fa-solid fa-eraser fa-fw" aria-hidden="true"></i></button><button type="button" data-scene-action="visibility" title="@actionBox.VisibilityLabel" aria-label="@actionBox.VisibilityLabel" disabled="@(!actionBox.VisibilityEnabled)" @onclick="()=>RequestAction(V2SceneAction.ToggleVisibility)"><i class="fa-solid @(actionBox.AnnotationIsVisible ? "fa-eye-slash" : "fa-eye") fa-fw" aria-hidden="true"></i></button><button type="button" data-scene-action="dismiss" title="@actionBox.DismissLabel" aria-label="@actionBox.DismissLabel" disabled="@(!actionBox.DismissEnabled)" @onclick="()=>RequestAction(V2SceneAction.Dismiss)"><i class="fa-solid fa-xmark fa-fw" aria-hidden="true"></i></button></div><div class="scene-status-message"><span class="scene-status-text" data-scene-status-text="true" title="@statusText">@statusText</span><button type="button" data-scene-marker-retry="true" hidden><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> retry marker save</button></div></div>
    <div class="scene-layout-actions" aria-label="Scene layout actions"><div data-scene-actions-left="true">
        <button class="scene-layout-zone-toggle" type="button" data-scene-zone-toggle="true" aria-pressed="true" aria-label="Hide zone map" title="Hide zone map"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
        <button id="scene-image-capture" class="@(scene.Image?.BoundsImageSeverity switch { V2Severity.Danger => "scene-bounds-image-danger", V2Severity.Warning => "scene-bounds-image-warning", _ => null })" type="button" data-scene-capture="true" @onclick="CaptureRequested" aria-label="Scene bounds and image"><i class="fa-solid fa-camera" aria-hidden="true"></i> bounds and image</button>
    </div><div data-scene-actions-right="true">
        <button type="button" data-scene-annotation-toggle="true" aria-pressed="true" aria-label="Hide annotations" title="Hide annotations"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></button>
        <button type="button" data-scene-layer-toggle="subroom" aria-pressed="true" aria-label="Hide subrooms" title="Hide subrooms"><svg class="scene-layer-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 11h18M11 11v10M15 3v8" /></svg></button>
        <button type="button" data-scene-layer-toggle="exit" aria-pressed="true" aria-label="Hide exits and connections" title="Hide exits and connections"><svg class="scene-layer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16m-5-5 5 5-5 5M20 17H4m5-5-5 5 5 5" /></svg></button>
        <button type="button" data-scene-layer-toggle="check" aria-pressed="true" aria-label="Hide check locations and enemies" title="Hide check locations and enemies"><svg class="scene-layer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg></button>
        @if (scene.Image?.IsAvailable == true) { <button type="button" data-scene-image-toggle="true" aria-pressed="true" aria-label="Hide scene image" title="Hide scene image"><i class="fa-solid fa-image" aria-hidden="true"></i></button> }
        <button type="button" data-scene-reset-view="true" aria-label="Reset scene view"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> reset view</button>
    </div></div>
</div>

@code {
    [Parameter] public SceneLayoutView? View { get; set; }
    [Parameter] public Guid RoomId { get; set; }
    [Parameter] public SceneAnnotationPlacementRequest? Placement { get; set; }
    [Parameter] public Func<Guid, long, SceneAnnotationPlacementRequest, bool>? TakePlacementFocus { get; set; }
    [Parameter] public V2SceneSelectedItem? SelectedItem { get; set; }
    [Parameter] public V2SceneActionBoxView? ActionBox { get; set; }
    [Parameter] public Func<Guid, long, V2SceneAction, Task>? ActionRequested { get; set; }
    [Parameter] public Func<Guid, long, Task>? OwnerMounted { get; set; }
    [Parameter] public Func<Guid, long, V2SceneSelectedItemKind, bool, Task>? LayerVisibilityChanged { get; set; }
    [Parameter] public Func<V2SceneSelectionCallback, Task>? SelectionChanged { get; set; }
    [Parameter] public Func<Guid, long, SceneAnnotationPlacementRequest, double, double, Task<bool>>? PlacementCommitted { get; set; }
    [Parameter] public Func<Guid, long, SceneAnnotationPlacementRequest, Task<bool>>? PlacementCancelled { get; set; }
    [Parameter] public Func<Guid, long, string, Guid, double, double, Task<bool>>? MarkerDragCommitted { get; set; }
    [Parameter] public Func<Guid, long, string, Guid, double, double, Task<bool>>? SceneNudgeCommitted { get; set; }
    [Parameter] public Func<Guid, long, Guid, double, double, double, double, Task<bool>>? FrameGeometryCommitted { get; set; }
    [Parameter] public bool ClearSelectionAfterRefresh { get; set; }
    [Parameter] public Func<Task>? SelectionCleared { get; set; }
    [Parameter] public Guid? SelectMarkerAfterRefresh { get; set; }
    [Parameter] public Func<Task>? MarkerSelected { get; set; }
    [Parameter] public EventCallback Capture { get; set; }
    private static long nextOwnerGeneration;
    private ElementReference canvas; private bool viewportInitialized; private bool viewportDisposed; private DotNetObjectReference<SceneContextPanePresentation>? placementCallback; private SceneAnnotationPlacementRequest? placement; private V2SceneSelectedItem? renderedSelection; private Guid mountedRoomId; private long ownerGeneration;
    private SceneAnnotationPlacementRequest? lastPlacementParameter;
    private V2SceneSelectedItem? lastSelectionParameter;
    private long placementRevision, selectionRevision;
    protected override void OnParametersSet() { if (!ReferenceEquals(lastPlacementParameter, Placement)) { lastPlacementParameter = Placement; placementRevision++; } if (lastSelectionParameter != SelectedItem) { lastSelectionParameter = SelectedItem; selectionRevision++; } placement = Placement; if (mountedRoomId != RoomId) { mountedRoomId = RoomId; ownerGeneration = Interlocked.Increment(ref nextOwnerGeneration); renderedSelection = null; } }
    private Task CaptureRequested() => Capture.InvokeAsync();
    private Task RequestAction(V2SceneAction action) => ActionRequested?.Invoke(mountedRoomId, ownerGeneration, action) ?? Task.CompletedTask;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (viewportDisposed) return;
        var room = mountedRoomId; var generation = ownerGeneration; var renderedCanvas = canvas;
        var armRevision = placementRevision; var itemRevision = selectionRevision;
        placementCallback ??= DotNetObjectReference.Create(this);
        await (OwnerMounted?.Invoke(room, generation) ?? Task.CompletedTask);
        if (viewportDisposed || room != mountedRoomId || generation != ownerGeneration) return;
        await JS.InvokeVoidAsync("initializeV2SceneViewport", renderedCanvas, room.ToString("N"), generation, placementCallback);
        if (viewportDisposed || room != mountedRoomId || generation != ownerGeneration)
        {
            await JS.InvokeVoidAsync("disposeV2SceneViewport", renderedCanvas, generation);
            return;
        }
        viewportInitialized = true;
        if (armRevision != placementRevision || itemRevision != selectionRevision) return;
        if (placement is { } armed)
        {
            // Only the page can consume a new explicit arm intent. A retained
            // request (including on a replacement pane) is reconciliation, not focus.
            var acquireFocus = TakePlacementFocus?.Invoke(room, generation, armed) == true;
            await JS.InvokeVoidAsync("armV2ScenePlacement", renderedCanvas, armed.Kind, armed.EntityId.ToString("N"), acquireFocus, generation, armRevision);
        }
        else await JS.InvokeVoidAsync("clearV2ScenePlacement", renderedCanvas, generation, armRevision);
        if (viewportDisposed || room != mountedRoomId || generation != ownerGeneration || armRevision != placementRevision || itemRevision != selectionRevision) return;
        if (SelectedItem is { } selected && IsRendered(selected)) { if (renderedSelection != selected) await JS.InvokeVoidAsync("selectV2SceneLayoutItem", renderedCanvas, selected.EntityId.ToString("D"), generation, itemRevision); if (!viewportDisposed && room == mountedRoomId && generation == ownerGeneration && itemRevision == selectionRevision) renderedSelection = selected; }
        else { renderedSelection = null; await JS.InvokeVoidAsync("clearV2SceneLayoutSelection", renderedCanvas, generation, itemRevision); }
    }
    [JSInvokable] public async Task CommitPlacementAsync(string ownerRoomId, long callbackGeneration, string kind, string entityId, double x, double y) { if (!OwnsMountedOwner(ownerRoomId, callbackGeneration) || placement is not { } armed || armed.Kind != kind || !Guid.TryParse(entityId, out var id) || id != armed.EntityId) return; if (await (PlacementCommitted?.Invoke(mountedRoomId, ownerGeneration, armed, x, y) ?? Task.FromResult(false)) && OwnsMountedOwner(ownerRoomId, callbackGeneration) && ReferenceEquals(placement, armed)) { placement = null; await InvokeAsync(StateHasChanged); } }
    public Task CommitPlacementAsync(string kind, string entityId, double x, double y) => CommitPlacementAsync(mountedRoomId.ToString(), ownerGeneration, kind, entityId, x, y);
    [JSInvokable] public async Task CancelPlacementAsync(string ownerRoomId, long callbackGeneration) { if (!OwnsMountedOwner(ownerRoomId, callbackGeneration) || placement is not { } armed) return; if (await (PlacementCancelled?.Invoke(mountedRoomId, ownerGeneration, armed) ?? Task.FromResult(false)) && OwnsMountedOwner(ownerRoomId, callbackGeneration) && ReferenceEquals(placement, armed)) { placement = null; await InvokeAsync(StateHasChanged); } }
    public Task CancelPlacementAsync() => CancelPlacementAsync(mountedRoomId.ToString(), ownerGeneration);
    [JSInvokable] public Task SelectSceneItemAsync(string ownerRoomId, long callbackGeneration, string kind, string entityId) => OwnsMountedOwner(ownerRoomId, callbackGeneration) && Guid.TryParse(ownerRoomId, out var roomId) && Guid.TryParse(entityId, out var id) && TryKind(kind, out var selectedKind) ? (SelectionChanged?.Invoke(new(roomId, callbackGeneration, new(selectedKind, id))) ?? Task.CompletedTask) : Task.CompletedTask;
    [JSInvokable] public Task ClearSceneSelectionAsync(string ownerRoomId, long callbackGeneration) => OwnsMountedOwner(ownerRoomId, callbackGeneration) && Guid.TryParse(ownerRoomId, out var roomId) ? SelectionChanged?.Invoke(new(roomId, callbackGeneration, null)) ?? Task.CompletedTask : Task.CompletedTask;
    [JSInvokable] public Task SetSceneLayerVisibilityAsync(string ownerRoomId, long callbackGeneration, string kind, bool shown) => OwnsMountedOwner(ownerRoomId, callbackGeneration) && TryKind(kind, out var selectedKind) ? LayerVisibilityChanged?.Invoke(mountedRoomId, callbackGeneration, selectedKind, shown) ?? Task.CompletedTask : Task.CompletedTask;
    [JSInvokable] public Task<bool> CommitMarkerDragAsync(string ownerRoomId, long callbackGeneration, string kind, string entityId, double x, double y) => !OwnsMountedOwner(ownerRoomId, callbackGeneration) || !Guid.TryParse(entityId, out var id) || kind is not ("exit" or "check" or "connection") ? Task.FromResult(false) : MarkerDragCommitted?.Invoke(mountedRoomId, ownerGeneration, kind, id, x, y) ?? Task.FromResult(false);
    public Task<bool> CommitMarkerDragAsync(string kind, string entityId, double x, double y) => CommitMarkerDragAsync(mountedRoomId.ToString(), ownerGeneration, kind, entityId, x, y);
    [JSInvokable] public Task<bool> CommitSceneNudgeAsync(string ownerRoomId, long callbackGeneration, string kind, string entityId, double x, double y) => !OwnsMountedOwner(ownerRoomId, callbackGeneration) || !Guid.TryParse(entityId, out var id) || kind is not ("exit" or "check" or "connection" or "subroom") ? Task.FromResult(false) : SceneNudgeCommitted?.Invoke(mountedRoomId, ownerGeneration, kind, id, x, y) ?? Task.FromResult(false);
    public Task<bool> CommitSceneNudgeAsync(string kind, string entityId, double x, double y) => CommitSceneNudgeAsync(mountedRoomId.ToString(), ownerGeneration, kind, entityId, x, y);
    [JSInvokable] public Task<bool> CommitSubroomGeometryAsync(string ownerRoomId, long callbackGeneration, string entityId, double x, double y, double width, double height) => !OwnsMountedOwner(ownerRoomId, callbackGeneration) || !Guid.TryParse(entityId, out var id) || width <= 0 || height <= 0 ? Task.FromResult(false) : FrameGeometryCommitted?.Invoke(mountedRoomId, ownerGeneration, id, x, y, width, height) ?? Task.FromResult(false);
    public Task<bool> CommitSubroomGeometryAsync(string entityId, double x, double y, double width, double height) => CommitSubroomGeometryAsync(mountedRoomId.ToString(), ownerGeneration, entityId, x, y, width, height);
    public async ValueTask DisposeAsync() { if (viewportDisposed) return; viewportDisposed = true; try { if (viewportInitialized) await JS.InvokeVoidAsync("disposeV2SceneViewport", canvas); } catch (JSDisconnectedException) { } placementCallback?.Dispose(); }
    private static string N(double value) => value.ToString("R", CultureInfo.InvariantCulture); private static string Box(SceneViewportBounds value) => $"{N(value.X)} {N(value.Y)} {N(value.Width)} {N(value.Height)}";
    private static bool ThreadHidden(SceneRelationshipThreadView thread) => thread.MarkerX >= thread.FrameX && thread.MarkerX <= thread.FrameX + thread.FrameWidth && thread.MarkerY >= thread.FrameY && thread.MarkerY <= thread.FrameY + thread.FrameHeight;
    private static double NearestX(SceneRelationshipThreadView thread) => Math.Clamp(thread.MarkerX, thread.FrameX, thread.FrameX + thread.FrameWidth);
    private static double NearestY(SceneRelationshipThreadView thread) => Math.Clamp(thread.MarkerY, thread.FrameY, thread.FrameY + thread.FrameHeight);
    private static string? ThreadStyle(SceneRelationshipThreadView thread) => ThreadHidden(thread) ? "display:none" : null;
    private static bool TryKind(string kind, out V2SceneSelectedItemKind selectedKind) { selectedKind = kind switch { "subroom" => V2SceneSelectedItemKind.Subroom, "exit" => V2SceneSelectedItemKind.Transition, "check" => V2SceneSelectedItemKind.Check, "connection" => V2SceneSelectedItemKind.Connection, _ => default }; return kind is "subroom" or "exit" or "check" or "connection"; }
    private static string KindText(V2SceneSelectedItemKind kind) => kind == V2SceneSelectedItemKind.Subroom ? "subroom" : kind == V2SceneSelectedItemKind.Transition ? "exit" : kind == V2SceneSelectedItemKind.Check ? "check" : "connection";
    private bool OwnsMountedOwner(string ownerRoomId, long callbackGeneration) => !viewportDisposed && Guid.TryParse(ownerRoomId, out var roomId) && roomId == mountedRoomId && callbackGeneration == ownerGeneration;
    private bool IsRendered(V2SceneSelectedItem selected) => View is { } scene && (selected.Kind == V2SceneSelectedItemKind.Subroom ? scene.Frames.Any(x => x.EntityId == selected.EntityId) : scene.Markers.Any(x => x.EntityId == selected.EntityId && x.Kind == (selected.Kind == V2SceneSelectedItemKind.Transition ? "exit" : selected.Kind.ToString().ToLowerInvariant())));
}
