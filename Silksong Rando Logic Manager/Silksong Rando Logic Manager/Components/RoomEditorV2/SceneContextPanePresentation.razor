@using System.Globalization
@using Microsoft.JSInterop
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="room-context-scene-pane" aria-label="Scene layout pane">
    @{ var scene = View ?? new SceneLayoutView(false, null, null, [], []); var viewport = SceneViewportMath.Initial(scene); }
    <svg @ref="canvas" class="@($"scene-layout {(placement is null ? "" : "scene-layout-placement-armed")}")" viewBox="@Box(viewport)" role="img" aria-label="Scene layout canvas" data-scene-layout-canvas="true" data-scene-initial-viewbox="@Box(viewport)" data-scene-viewport-key="@RoomId" data-scene-width="@N(scene.SceneUnitWidth ?? 0)" data-scene-height="@N(scene.SceneUnitHeight ?? 0)" data-scene-placement-armed="@(placement is null ? null : "true")" tabindex="0">
        @if (scene.HasValidBounds && scene.Image?.IsAvailable == true && scene.SceneUnitWidth is double imageWidth && scene.SceneUnitHeight is double imageHeight) { <image class="scene-layout-image" data-scene-layout-image="true" href="@($"/data/scenes/{RoomId:D}.webp?v={scene.Image.ImageVersion}")" x="0" y="@N(-imageHeight)" width="@N(imageWidth)" height="@N(imageHeight)" preserveAspectRatio="none" /> }
        @if (scene.HasValidBounds && scene.SceneUnitWidth is double width && scene.SceneUnitHeight is double height) { <rect class="scene-layout-room-bounds" x="0" y="@N(-height)" width="@N(width)" height="@N(height)" /><rect class="scene-layout-room-bounds-edge edge-n" data-scene-snap-room-edge="t" x="0" y="@N(-height-1)" width="@N(width)" height="1" /><rect class="scene-layout-room-bounds-edge edge-s" data-scene-snap-room-edge="b" x="0" y="0" width="@N(width)" height="1" /><rect class="scene-layout-room-bounds-edge edge-e" data-scene-snap-room-edge="r" x="@N(width)" y="@N(-height)" width="1" height="@N(height)" /><rect class="scene-layout-room-bounds-edge edge-w" data-scene-snap-room-edge="l" x="-1" y="@N(-height)" width="1" height="@N(height)" /> }
        <g data-scene-annotations="true">
            @foreach (var frame in scene.Frames) { <g class="scene-layout-subroom" data-scene-layout-frame="true" data-scene-selection-kind="subroom" data-scene-id="@frame.EntityId" data-scene-frame-x="@N(frame.X)" data-scene-frame-y="@N(frame.Y)" data-scene-frame-width="@N(frame.Width)" data-scene-frame-height="@N(frame.Height)"><title>@frame.Title</title><rect class="scene-layout-subroom-body" data-scene-frame-target="move" x="@N(frame.X)" y="@N(-frame.Y-frame.Height)" width="@N(frame.Width)" height="@N(frame.Height)" /><rect class="scene-layout-subroom-edge edge-n" data-scene-frame-target="t" x="@N(frame.X)" y="@N(-frame.Y-frame.Height-1)" width="@N(frame.Width)" height="1" /><rect class="scene-layout-subroom-edge edge-s" data-scene-frame-target="b" x="@N(frame.X)" y="@N(-frame.Y)" width="@N(frame.Width)" height="1" /><rect class="scene-layout-subroom-edge edge-e" data-scene-frame-target="r" x="@N(frame.X+frame.Width)" y="@N(-frame.Y-frame.Height)" width="1" height="@N(frame.Height)" /><rect class="scene-layout-subroom-edge edge-w" data-scene-frame-target="l" x="@N(frame.X-1)" y="@N(-frame.Y-frame.Height)" width="1" height="@N(frame.Height)" /><rect class="scene-layout-subroom-corner corner-nw" data-scene-frame-target="tl" x="@N(frame.X-1)" y="@N(-frame.Y-frame.Height-1)" width="2" height="2" /><rect class="scene-layout-subroom-corner corner-ne" data-scene-frame-target="tr" x="@N(frame.X+frame.Width-1)" y="@N(-frame.Y-frame.Height-1)" width="2" height="2" /><rect class="scene-layout-subroom-corner corner-sw" data-scene-frame-target="bl" x="@N(frame.X-1)" y="@N(-frame.Y-1)" width="2" height="2" /><rect class="scene-layout-subroom-corner corner-se" data-scene-frame-target="br" x="@N(frame.X+frame.Width-1)" y="@N(-frame.Y-1)" width="2" height="2" /><text x="@N(frame.X+frame.Width/2)" y="@N(-frame.Y-frame.Height/2)" text-anchor="middle" dominant-baseline="central">@frame.Label</text></g> }
            @foreach (var marker in scene.Markers) { var y = -marker.Y; <g class="@($"scene-layout-marker scene-layout-{marker.Kind}")" data-scene-layout-marker="@marker.Kind" data-scene-selection-kind="@marker.Kind" data-scene-id="@marker.EntityId" data-scene-marker-x="@N(marker.X)" data-scene-marker-y="@N(marker.Y)"><title>@marker.Title</title>@if (marker.Kind == "check") { <circle cx="@N(marker.X)" cy="@N(y)" r="1.5" /> } else { <rect x="@N(marker.X-7)" y="@N(y-4)" width="14" height="8" rx=".8" /><svg:text x="@N(marker.X)" y="@N(y)" text-anchor="middle" dominant-baseline="central">@marker.Label</svg:text> }</g> }
        </g>
    </svg>
    @{ var fallbackStatus = !scene.HasValidBounds ? "scene dimensions unavailable" : placement is { } armed ? (armed.Kind == "subroom" ? "draw subroom rectangle; drag to the opposite corner, or press Escape to cancel" : $"place {armed.Kind} annotation; click the scene, or press Escape to cancel") : scene.Image?.IsStale == true ? "needs recapture" : ""; var actionBox = ActionBox ?? new V2SceneActionBoxView(false, false, false, false, false, "re-arm placement", "reset annotation to game position", "clear annotation geometry", "show annotation", "dismiss scene interaction", false, fallbackStatus); var statusText = !scene.HasValidBounds ? "scene dimensions unavailable" : actionBox.StatusText; }
    <div class="scene-layout-status" data-scene-status="true" role="status"><div class="scene-annotation-action-box" data-scene-annotation-action-box="true"><button type="button" data-scene-action="rearm" title="@actionBox.RearmLabel" aria-label="@actionBox.RearmLabel" disabled="@(!actionBox.RearmEnabled)" @onclick="()=>RequestAction(V2SceneAction.Rearm)"><i class="fa-solid @(SelectedItem?.Kind == V2SceneSelectedItemKind.Subroom ? "fa-expand" : "fa-crosshairs") fa-fw" aria-hidden="true"></i></button><button type="button" data-scene-action="reset" title="@actionBox.ResetLabel" aria-label="@actionBox.ResetLabel" disabled="@(!actionBox.ResetEnabled)" @onclick="()=>RequestAction(V2SceneAction.Reset)"><i class="fa-solid fa-gamepad fa-fw" aria-hidden="true"></i></button><button type="button" data-scene-action="clear" title="@actionBox.ClearLabel" aria-label="@actionBox.ClearLabel" disabled="@(!actionBox.ClearEnabled)" @onclick="()=>RequestAction(V2SceneAction.Clear)"><i class="fa-solid fa-eraser fa-fw" aria-hidden="true"></i></button><button type="button" data-scene-action="visibility" title="@actionBox.VisibilityLabel" aria-label="@actionBox.VisibilityLabel" disabled="@(!actionBox.VisibilityEnabled)" @onclick="()=>RequestAction(V2SceneAction.ToggleVisibility)"><i class="fa-solid @(actionBox.AnnotationIsVisible ? "fa-eye-slash" : "fa-eye") fa-fw" aria-hidden="true"></i></button><button type="button" data-scene-action="dismiss" title="@actionBox.DismissLabel" aria-label="@actionBox.DismissLabel" disabled="@(!actionBox.DismissEnabled)" @onclick="()=>RequestAction(V2SceneAction.Dismiss)"><i class="fa-solid fa-xmark fa-fw" aria-hidden="true"></i></button></div><div class="scene-status-message"><span class="scene-status-text" data-scene-status-text="true" title="@statusText">@statusText</span><button type="button" data-scene-marker-retry="true" hidden><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> retry marker save</button></div></div>
    <div class="scene-layout-actions" aria-label="Scene layout actions"><div data-scene-actions-left="true">
        <button class="scene-layout-zone-toggle" type="button" data-scene-zone-toggle="true" aria-pressed="true" aria-label="Hide zone map" title="Hide zone map"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
        <button id="room-scene-dimensions" type="button" data-scene-dimensions="true" aria-label="scene dimensions" title="scene dimensions" @onclick="SceneDimensionsRequested"><i class="fa-solid fa-ruler-combined" aria-hidden="true"></i></button>
        <button type="button" data-scene-capture="true" disabled="@(!scene.HasValidBounds)" @onclick="CaptureRequested" aria-label="@(scene.Image?.HasTransform == true ? "Recapture scene image" : "Capture scene image")"><i class="fa-solid fa-camera" aria-hidden="true"></i> @(scene.Image?.HasTransform == true ? "recapture scene image" : "capture scene image")</button>
    </div><div data-scene-actions-right="true">
        <button type="button" data-scene-annotation-toggle="true" aria-pressed="true" aria-label="Hide annotations" title="Hide annotations"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></button>
        @if (scene.Image?.IsAvailable == true) { <button type="button" data-scene-image-toggle="true" aria-pressed="true" aria-label="Hide scene image" title="Hide scene image"><i class="fa-solid fa-image" aria-hidden="true"></i></button> }
        <button type="button" data-scene-reset-view="true" aria-label="Reset scene view"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> reset view</button>
    </div></div>
</div>

@code {
    [Parameter] public SceneLayoutView? View { get; set; }
    [Parameter] public Guid RoomId { get; set; }
    [Parameter] public SceneAnnotationPlacementRequest? Placement { get; set; }
    [Parameter] public V2SceneSelectedItem? SelectedItem { get; set; }
    [Parameter] public V2SceneActionBoxView? ActionBox { get; set; }
    [Parameter] public Func<Guid, long, V2SceneAction, Task>? ActionRequested { get; set; }
    [Parameter] public Func<Guid, long, Task>? OwnerMounted { get; set; }
    [Parameter] public Func<V2SceneSelectionCallback, Task>? SelectionChanged { get; set; }
    [Parameter] public Func<Guid, long, SceneAnnotationPlacementRequest, double, double, Task<bool>>? PlacementCommitted { get; set; }
    [Parameter] public Func<Guid, long, SceneAnnotationPlacementRequest, Task<bool>>? PlacementCancelled { get; set; }
    [Parameter] public Func<Guid, long, string, Guid, double, double, Task<bool>>? MarkerDragCommitted { get; set; }
    [Parameter] public Func<Guid, long, string, Guid, double, double, Task<bool>>? SceneNudgeCommitted { get; set; }
    [Parameter] public Func<Guid, long, Guid, double, double, double, double, Task<bool>>? FrameGeometryCommitted { get; set; }
    [Parameter] public bool ClearSelectionAfterRefresh { get; set; }
    [Parameter] public Func<Task>? SelectionCleared { get; set; }
    [Parameter] public Guid? SelectMarkerAfterRefresh { get; set; }
    [Parameter] public Func<Task>? MarkerSelected { get; set; }
    [Parameter] public EventCallback Capture { get; set; }
    [Parameter] public EventCallback SceneDimensions { get; set; }
    private static long nextOwnerGeneration;
    private ElementReference canvas; private bool viewportInitialized; private bool viewportDisposed; private DotNetObjectReference<SceneContextPanePresentation>? placementCallback; private SceneAnnotationPlacementRequest? placement; private V2SceneSelectedItem? renderedSelection; private Guid mountedRoomId; private long ownerGeneration;
    protected override void OnParametersSet() { placement = Placement; if (mountedRoomId != RoomId) { mountedRoomId = RoomId; ownerGeneration = Interlocked.Increment(ref nextOwnerGeneration); renderedSelection = null; } }
    private Task CaptureRequested() => Capture.InvokeAsync(); private Task SceneDimensionsRequested() => SceneDimensions.InvokeAsync();
    private Task RequestAction(V2SceneAction action) => ActionRequested?.Invoke(mountedRoomId, ownerGeneration, action) ?? Task.CompletedTask;
    protected override async Task OnAfterRenderAsync(bool firstRender) { placementCallback ??= DotNetObjectReference.Create(this); await (OwnerMounted?.Invoke(RoomId, ownerGeneration) ?? Task.CompletedTask); await JS.InvokeVoidAsync("initializeV2SceneViewport", canvas, RoomId.ToString("N"), ownerGeneration, placementCallback); viewportInitialized = true; if (placement is { } armed) await JS.InvokeVoidAsync("armV2ScenePlacement", canvas, armed.Kind, armed.EntityId.ToString("N")); else await JS.InvokeVoidAsync("clearV2ScenePlacement", canvas); if (SelectedItem is { } selected && IsRendered(selected)) { if (renderedSelection != selected) await JS.InvokeVoidAsync("selectV2SceneLayoutItem", canvas, selected.EntityId.ToString("D")); renderedSelection = selected; } else { renderedSelection = null; await JS.InvokeVoidAsync("clearV2SceneLayoutSelection", canvas); } }
    [JSInvokable] public async Task CommitPlacementAsync(string ownerRoomId, long callbackGeneration, string kind, string entityId, double x, double y) { if (!OwnsMountedOwner(ownerRoomId, callbackGeneration) || placement is not { } armed || armed.Kind != kind || !Guid.TryParse(entityId, out var id) || id != armed.EntityId) return; if (await (PlacementCommitted?.Invoke(mountedRoomId, ownerGeneration, armed, x, y) ?? Task.FromResult(false))) { placement = null; await InvokeAsync(StateHasChanged); } }
    public Task CommitPlacementAsync(string kind, string entityId, double x, double y) => CommitPlacementAsync(mountedRoomId.ToString(), ownerGeneration, kind, entityId, x, y);
    [JSInvokable] public async Task CancelPlacementAsync(string ownerRoomId, long callbackGeneration) { if (!OwnsMountedOwner(ownerRoomId, callbackGeneration) || placement is not { } armed) return; if (await (PlacementCancelled?.Invoke(mountedRoomId, ownerGeneration, armed) ?? Task.FromResult(false))) { placement = null; await InvokeAsync(StateHasChanged); } }
    public Task CancelPlacementAsync() => CancelPlacementAsync(mountedRoomId.ToString(), ownerGeneration);
    [JSInvokable] public Task SelectSceneItemAsync(string ownerRoomId, long callbackGeneration, string kind, string entityId) => OwnsMountedOwner(ownerRoomId, callbackGeneration) && Guid.TryParse(ownerRoomId, out var roomId) && Guid.TryParse(entityId, out var id) && TryKind(kind, out var selectedKind) ? (SelectionChanged?.Invoke(new(roomId, callbackGeneration, new(selectedKind, id))) ?? Task.CompletedTask) : Task.CompletedTask;
    [JSInvokable] public Task ClearSceneSelectionAsync(string ownerRoomId, long callbackGeneration) => OwnsMountedOwner(ownerRoomId, callbackGeneration) && Guid.TryParse(ownerRoomId, out var roomId) ? SelectionChanged?.Invoke(new(roomId, callbackGeneration, null)) ?? Task.CompletedTask : Task.CompletedTask;
    [JSInvokable] public Task<bool> CommitMarkerDragAsync(string ownerRoomId, long callbackGeneration, string kind, string entityId, double x, double y) => !OwnsMountedOwner(ownerRoomId, callbackGeneration) || !Guid.TryParse(entityId, out var id) || kind is not ("exit" or "check" or "connection") ? Task.FromResult(false) : MarkerDragCommitted?.Invoke(mountedRoomId, ownerGeneration, kind, id, x, y) ?? Task.FromResult(false);
    public Task<bool> CommitMarkerDragAsync(string kind, string entityId, double x, double y) => CommitMarkerDragAsync(mountedRoomId.ToString(), ownerGeneration, kind, entityId, x, y);
    [JSInvokable] public Task<bool> CommitSceneNudgeAsync(string ownerRoomId, long callbackGeneration, string kind, string entityId, double x, double y) => !OwnsMountedOwner(ownerRoomId, callbackGeneration) || !Guid.TryParse(entityId, out var id) || kind is not ("exit" or "check" or "connection" or "subroom") ? Task.FromResult(false) : SceneNudgeCommitted?.Invoke(mountedRoomId, ownerGeneration, kind, id, x, y) ?? Task.FromResult(false);
    public Task<bool> CommitSceneNudgeAsync(string kind, string entityId, double x, double y) => CommitSceneNudgeAsync(mountedRoomId.ToString(), ownerGeneration, kind, entityId, x, y);
    [JSInvokable] public Task<bool> CommitSubroomGeometryAsync(string ownerRoomId, long callbackGeneration, string entityId, double x, double y, double width, double height) => !OwnsMountedOwner(ownerRoomId, callbackGeneration) || !Guid.TryParse(entityId, out var id) || width <= 0 || height <= 0 ? Task.FromResult(false) : FrameGeometryCommitted?.Invoke(mountedRoomId, ownerGeneration, id, x, y, width, height) ?? Task.FromResult(false);
    public Task<bool> CommitSubroomGeometryAsync(string entityId, double x, double y, double width, double height) => CommitSubroomGeometryAsync(mountedRoomId.ToString(), ownerGeneration, entityId, x, y, width, height);
    public async ValueTask DisposeAsync() { if (!viewportInitialized || viewportDisposed) return; viewportDisposed = true; try { await JS.InvokeVoidAsync("disposeV2SceneViewport", canvas); } catch (JSDisconnectedException) { } placementCallback?.Dispose(); }
    private static string N(double value) => value.ToString("0.###", CultureInfo.InvariantCulture); private static string Box(SceneViewportBounds value) => $"{N(value.X)} {N(value.Y)} {N(value.Width)} {N(value.Height)}";
    private static bool TryKind(string kind, out V2SceneSelectedItemKind selectedKind) { selectedKind = kind switch { "subroom" => V2SceneSelectedItemKind.Subroom, "exit" => V2SceneSelectedItemKind.Transition, "check" => V2SceneSelectedItemKind.Check, "connection" => V2SceneSelectedItemKind.Connection, _ => default }; return kind is "subroom" or "exit" or "check" or "connection"; }
    private bool OwnsMountedOwner(string ownerRoomId, long callbackGeneration) => !viewportDisposed && Guid.TryParse(ownerRoomId, out var roomId) && roomId == mountedRoomId && callbackGeneration == ownerGeneration;
    private bool IsRendered(V2SceneSelectedItem selected) => View is { } scene && (selected.Kind == V2SceneSelectedItemKind.Subroom ? scene.Frames.Any(x => x.EntityId == selected.EntityId) : scene.Markers.Any(x => x.EntityId == selected.EntityId && x.Kind == (selected.Kind == V2SceneSelectedItemKind.Transition ? "exit" : selected.Kind.ToString().ToLowerInvariant())));
}
