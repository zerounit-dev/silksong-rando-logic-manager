@using System.Globalization
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<h2 id="v2-page-modal-title">edit in-game data</h2><p id="v2-page-modal-description">@View.RecordKind metadata</p><div class="in-game-coordinate-grid"><label class="@SeverityClass(View.InGameIdSeverity)">game ID<input aria-label="game ID" autocomplete="off" value="@Draft.InGameId" disabled="@Disabled" @oninput="e=>ChangeText(e)" /></label><label>in-game X<input aria-label="in-game X" autocomplete="off" type="number" value="@Draft.InGamePositionX" disabled="@Disabled" @oninput="e=>ChangeNumber(nameof(Draft.InGamePositionX),e)" /></label><label>in-game Y<input aria-label="in-game Y" autocomplete="off" type="number" value="@Draft.InGamePositionY" disabled="@Disabled" @oninput="e=>ChangeNumber(nameof(Draft.InGamePositionY),e)" /></label><label>in-game Z<input aria-label="in-game Z" autocomplete="off" type="number" value="@Draft.InGamePositionZ" disabled="@Disabled" @oninput="e=>ChangeNumber(nameof(Draft.InGamePositionZ),e)" /></label><label>local X<input aria-label="local X" autocomplete="off" type="number" value="@Draft.LocalPositionX" disabled="@Disabled" @oninput="e=>ChangeNumber(nameof(Draft.LocalPositionX),e)" /></label><label>local Y<input aria-label="local Y" autocomplete="off" type="number" value="@Draft.LocalPositionY" disabled="@Disabled" @oninput="e=>ChangeNumber(nameof(Draft.LocalPositionY),e)" /></label><label>local Z<input aria-label="local Z" autocomplete="off" type="number" value="@Draft.LocalPositionZ" disabled="@Disabled" @oninput="e=>ChangeNumber(nameof(Draft.LocalPositionZ),e)" /></label><label>annotation X<input aria-label="annotation X" autocomplete="off" type="number" value="@Draft.AnnotationSceneUnitX" disabled="@Disabled" @oninput="e=>ChangeNumber(nameof(Draft.AnnotationSceneUnitX),e)" /></label><label>annotation Y<input aria-label="annotation Y" autocomplete="off" type="number" value="@Draft.AnnotationSceneUnitY" disabled="@Disabled" @oninput="e=>ChangeNumber(nameof(Draft.AnnotationSceneUnitY),e)" /></label></div><div class="v2-modal-footer"><div></div><div><button type="button" disabled="@Disabled" @onclick="Cancel">Cancel</button><button type="button" disabled="@Disabled" @onclick="Apply">Apply</button></div></div>
@code { [Parameter, EditorRequired] public V2InGameMetadataDialogView View { get; set; } = null!; [Parameter, EditorRequired] public TransitionInGameMetadataDraft Draft { get; set; } = null!; [Parameter] public bool Disabled { get; set; } [Parameter] public EventCallback<TransitionInGameMetadataDraft> DraftChanged { get; set; } [Parameter] public EventCallback Cancel { get; set; } [Parameter] public EventCallback Apply { get; set; }
 private Task ChangeText(ChangeEventArgs e)=>DraftChanged.InvokeAsync(Draft with { InGameId=e.Value?.ToString() });
 private static string? SeverityClass(V2Severity severity)=>severity==V2Severity.Danger?"danger":severity==V2Severity.Warning?"warning":null;
 private Task ChangeNumber(string field,ChangeEventArgs e){var text=e.Value?.ToString();double? value=string.IsNullOrWhiteSpace(text)?null:double.Parse(text!,CultureInfo.InvariantCulture);var next=field switch { nameof(Draft.InGamePositionX)=>Draft with {InGamePositionX=value},nameof(Draft.InGamePositionY)=>Draft with {InGamePositionY=value},nameof(Draft.InGamePositionZ)=>Draft with {InGamePositionZ=value},nameof(Draft.LocalPositionX)=>Draft with {LocalPositionX=value},nameof(Draft.LocalPositionY)=>Draft with {LocalPositionY=value},nameof(Draft.LocalPositionZ)=>Draft with {LocalPositionZ=value},nameof(Draft.AnnotationSceneUnitX)=>Draft with {AnnotationSceneUnitX=value},_=>Draft with {AnnotationSceneUnitY=value}};return DraftChanged.InvokeAsync(next);}
}
