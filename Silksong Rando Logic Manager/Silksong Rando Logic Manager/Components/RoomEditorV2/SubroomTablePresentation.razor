@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Rendering
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<section class="document-section"><h2>subrooms</h2>
    <table class="logic-table subroom-table" data-v2-subroom-table="active" data-v2-child-count="@active.Count(x => x.EntityId is not null)">
        <colgroup><col class="reorder-column" /><col class="subroom-name-column" /><col class="subroom-reference-column" /><col class="subroom-notes-column" /><col class="actions-column" /></colgroup>
        <thead><tr><th class="reorder-heading"></th><th>name</th><th>reference</th><th>notes</th><th class="actions-heading"></th></tr></thead>
        <tbody>
        @for (var rowIndex = 0; rowIndex < active.Count; rowIndex++) { var row = active[rowIndex]; <tr @key="row.ClientDraftId" class="@RowClass(row)" data-v2-subroom-row="@row.EntityId" data-v2-child-index="@(row.EntityId is null ? null : active.Take(rowIndex).Count(x => x.EntityId is not null))" data-v2-subroom-state="@row.State" data-v2-subroom-tail="@(row.EntityId is null ? "true" : null)">
            <td class="reorder-cell">@Grip(row)</td>
            @Fields(row)
            <td class="row-actions">@if (row.EntityId is Guid id) { @if (!row.IsArchived) { var geometry = UsableRectangle(row.Baseline); var renderable = geometry && row.Baseline!.EnableAnnotation; var annotationText = AnnotationActionText(renderable, geometry); <span class="action-slot"><button id="v2-subroom-geometry-@id" title="edit scene rectangle" aria-label="edit scene rectangle" @onclick="(()=>Geometry(row))" disabled="@(row.State != RowState.Persisted)"><i class="fa-solid fa-pen-ruler"></i></button></span><span class="action-slot"><button id="v2-subroom-@(renderable ? "select" : geometry ? "show" : "place")-@id" title="@annotationText" aria-label="@annotationText" @onclick="(()=>Annotation(row))" disabled="@(row.State != RowState.Persisted || !SceneActionsAvailable)"><span class="annotation-crosshairs @(renderable ? null : "annotation-crosshairs-warning")" aria-hidden="true"><i class="fa-solid fa-crosshairs"></i></span></button></span><span class="action-slot"><button title="archive" aria-label="archive" @onclick="(()=>Archive(row,true))" disabled="@(row.State != RowState.Persisted)"><i class="fa-solid fa-box-archive"></i></button></span> } else { <span class="action-slot"></span><span class="action-slot"><button title="restore" aria-label="restore" @onclick="(()=>Archive(row,false))" disabled="@(row.State != RowState.Persisted)"><i class="fa-solid fa-rotate-left"></i></button></span><span class="action-slot"><button id="delete-subroom-@id" title="delete permanently" aria-label="delete permanently" @onclick="(()=>Delete(row))" disabled="@(row.State != RowState.Persisted)"><i class="fa-solid fa-trash"></i></button></span> } }</td>
        </tr> }
        </tbody>
    </table>
    @if (ShowArchivedChildren && View.ArchivedRows.Count > 0) { <div class="archived-table-label">[archived]</div><table class="logic-table subroom-table" data-v2-subroom-table="archived" data-v2-child-count="@archived.Count"><colgroup><col class="reorder-column" /><col class="subroom-name-column" /><col class="subroom-reference-column" /><col class="subroom-notes-column" /><col class="actions-column" /></colgroup><thead><tr><th class="reorder-heading"></th><th>name</th><th>reference</th><th>notes</th><th class="actions-heading"></th></tr></thead><tbody>@for(var rowIndex=0;rowIndex<archived.Count;rowIndex++){var row=archived[rowIndex];<tr @key="row.ClientDraftId" class="@RowClass(row)" data-v2-subroom-row="@row.EntityId" data-v2-child-index="@rowIndex" data-v2-subroom-state="@row.State"><td class="reorder-cell">@Grip(row)</td>@Fields(row)<td class="row-actions"><span class="action-slot"></span><span class="action-slot"><button title="restore" aria-label="restore" @onclick="(()=>Archive(row,false))" disabled="@(row.State != RowState.Persisted)"><i class="fa-solid fa-rotate-left"></i></button></span><span class="action-slot"><button id="delete-subroom-@row.EntityId" title="delete permanently" aria-label="delete permanently" @onclick="(()=>Delete(row))" disabled="@(row.State != RowState.Persisted)"><i class="fa-solid fa-trash"></i></button></span></td></tr>}</tbody></table> }
    @if (!string.IsNullOrEmpty(message)) { <p class="warning" role="status">@message</p> }
</section>
@code {
    [Parameter, EditorRequired] public SubroomTableView View { get; set; } = null!;
    [Parameter] public bool ShowArchivedChildren { get; set; }
    [Parameter] public Guid RoomId { get; set; }
    [Parameter] public Func<SubroomDurableBaseline, SubroomDraft, string, string?, Task<V2SubroomCommandOutcome>>? Save { get; set; }
    [Parameter] public Func<SubroomDraft, Task<V2SubroomCommandOutcome>>? Create { get; set; }
    [Parameter] public Func<Guid, int, Task<V2SubroomCommandOutcome>>? Reorder { get; set; }
    [Parameter] public Func<Guid, bool, Task<V2SubroomCommandOutcome>>? SetArchive { get; set; }
    [Parameter] public Func<V2DeleteConfirmationIntent, Task>? DeleteConfirmationRequested { get; set; }
    [Parameter] public Func<V2DeleteConfirmationIntent, Task>? DeleteConfirmationCancelled { get; set; }
    [Parameter] public Func<V2DeleteConfirmationIntent, Task>? DeleteConfirmationConfirmed { get; set; }
    [Parameter] public Func<Guid, string, Task>? FocusRequested { get; set; }
    [Parameter] public Func<bool, Task>? DraftStateChanged { get; set; }
    [Parameter] public Func<Task>? RefreshApplied { get; set; }
    [Parameter] public Func<Task>? ClearDragFeedback { get; set; }
    [Parameter] public bool SceneActionsAvailable { get; set; }
    [Parameter] public string SceneActionsUnavailableReason { get; set; } = "Scene annotation actions are unavailable.";
    [Parameter] public Func<SubroomDurableBaseline, string, Task>? AnnotationRequested { get; set; }
    [Parameter] public Func<SubroomDurableBaseline, string, Task>? GeometryRequested { get; set; }
    private Task Annotation(Row row) => row.Baseline is { } b && row.EntityId is Guid id ? (AnnotationRequested?.Invoke(b, $"v2-subroom-{(UsableRectangle(b) && b.EnableAnnotation ? "select" : UsableRectangle(b) ? "show" : "place")}-{id}") ?? Task.CompletedTask) : Task.CompletedTask;
    private string AnnotationActionText(bool renderable, bool geometry) => !SceneActionsAvailable ? SceneActionsUnavailableReason : renderable ? "select annotation" : geometry ? "show and select annotation" : "re-arm placement";
    private Task Geometry(Row row) => row.Baseline is { } b && row.EntityId is Guid id ? (GeometryRequested?.Invoke(b, $"v2-subroom-geometry-{id}") ?? Task.CompletedTask) : Task.CompletedTask;
    private static bool UsableRectangle(SubroomDurableBaseline? value) => value is { SceneUnitX: double x, SceneUnitY: double y, SceneUnitWidth: double width, SceneUnitHeight: double height } && double.IsFinite(x) && double.IsFinite(y) && double.IsFinite(width) && double.IsFinite(height) && width > 0 && height > 0;
    private async Task Archive(Row row, bool archived) { if (row.EntityId is not Guid id) return; var result = await (SetArchive?.Invoke(id, archived) ?? Unavailable("Archive")); message = result.Message; if (result.Status == V2SubroomCommandStatus.Committed) await (RefreshApplied?.Invoke() ?? Task.CompletedTask); }
    private Task Delete(Row row) => row.EntityId is Guid id ? (DeleteConfirmationRequested?.Invoke(new(V2DeleteConfirmationKind.Subroom, id)) ?? Task.CompletedTask) : Task.CompletedTask;
    private static readonly string[] fields = ["name", "reference", "notes"];
    private readonly List<Row> active = []; private readonly List<Row> archived = []; private string? message;
    private readonly ChildTableInteractionController sharedInteraction = new(); private Guid latentSuccessorId { get=>sharedInteraction.LatentSuccessorId; set=>sharedInteraction.LatentSuccessorId=value; } private Guid? pendingTailPromotionId { get=>sharedInteraction.PendingTailPromotionId; set=>sharedInteraction.PendingTailPromotionId=value; } private ChildTableFocusTarget? pendingFocus { get=>sharedInteraction.PendingFocus; set=>sharedInteraction.PendingFocus=value; }
    private Guid? renderedRoomId; private bool clearDragFeedback; private bool tabFocusAwaitingRefresh; private Guid? tabFocusCreatedEntityId;
    // A proposal conflict reaches this component before the page's fresh view is
    // rendered. Hold the local draft until reconciliation has installed the fresh
    // durable baseline, then restore it as the correction draft.
    private (Guid EntityId, SubroomDraft Draft)? pendingReferenceConflictDraft;
    protected override void OnParametersSet() { if (renderedRoomId is Guid previous && previous != RoomId) { sharedInteraction.ResetForRoute(active.Concat(archived)); tabFocusAwaitingRefresh=false; tabFocusCreatedEntityId=null; clearDragFeedback=true; } renderedRoomId=RoomId; Reconcile(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (clearDragFeedback) { clearDragFeedback=false; await (ClearDragFeedback?.Invoke() ?? Task.CompletedTask); } if (!tabFocusAwaitingRefresh && pendingFocus is { } target) { pendingFocus = null; await (FocusRequested?.Invoke(RoomId, target.ElementId) ?? Task.CompletedTask); } }
    private RenderFragment Fields(Row row) => builder => { var i=0; Input(builder, ref i, row, "name", "Subroom name", row.Draft.FriendlyName, "text-editor", DisplaySeverity(row, row.FriendlyNameSeverity), EventCallback.Factory.Create<ChangeEventArgs>(this, e=>NameChanged(row,e))); Input(builder, ref i, row, "reference", "Subroom reference ID", row.Draft.ReferenceId, "text-editor", DisplaySeverity(row, Max(row.ReferenceIdSeverity, row.UsageSeverity)), EventCallback.Factory.Create<ChangeEventArgs>(this, e=>ReferenceChanged(row,e)), true); Input(builder, ref i, row, "notes", "Subroom notes", row.Draft.Notes, "detail-editor", V2Severity.Neutral, EventCallback.Factory.Create<ChangeEventArgs>(this, e=>NotesChanged(row,e))); };
    private void Input(RenderTreeBuilder b, ref int i, Row row, string field, string label, string value, string cssClass, V2Severity severity, EventCallback<ChangeEventArgs> changed, bool singleLine = false) { b.OpenElement(i++, "td"); b.AddAttribute(i++, "class", SeverityClass(severity)); b.OpenElement(i++, singleLine ? "input" : "textarea"); b.AddAttribute(i++, "id", Id(row,field)); b.AddAttribute(i++, "aria-label",label); b.AddAttribute(i++, "class",cssClass); if (!singleLine) b.AddAttribute(i++, "rows",1); else b.AddAttribute(i++, "type", "text"); b.AddAttribute(i++, "autocomplete","off"); b.AddAttribute(i++, "value",value); b.AddAttribute(i++, "data-v2-subroom-field",field); b.AddAttribute(i++, "data-v2-subroom-client-row",row.ClientDraftId); b.AddAttribute(i++, "data-v2-child-row-changed", Changed(row) ? "true" : "false"); foreach(var direction in new[]{"left","right","up","down"}) { var target=Target(row,field,direction); if(target is not null) { b.AddAttribute(i++, $"data-v2-subroom-{direction}", $"{target.Value.ClientRowId}|{target.Value.Field}"); if(target.Value.ClientRowId==latentSuccessorId) b.AddAttribute(i++, $"data-v2-subroom-{direction}-latent", "true"); } } b.AddAttribute(i++, "oninput",changed); b.CloseElement(); b.CloseElement(); }
    private RenderFragment Grip(Row row) => builder => { var i=0; if (!row.IsArchived && row.EntityId is Guid && row.State == RowState.Persisted) { builder.OpenElement(i++, "button"); builder.AddAttribute(i++, "class", "reorder-handle"); builder.AddAttribute(i++, "type", "button"); builder.AddAttribute(i++, "draggable", "true"); builder.AddAttribute(i++, "data-v2-subroom-grip", "true"); builder.AddAttribute(i++, "title", "Reorder subroom"); builder.AddAttribute(i++, "aria-label", $"Reorder subroom: {row.Draft.FriendlyName}"); builder.OpenElement(i++, "i"); builder.AddAttribute(i++, "class", "fa-solid fa-grip-vertical"); builder.AddAttribute(i++, "aria-hidden", "true"); builder.CloseElement(); builder.CloseElement(); } else if (!row.IsArchived && row.State == RowState.Saving) { builder.OpenElement(i++, "i"); builder.AddAttribute(i++, "class", "fa-solid fa-spinner fa-spin"); builder.AddAttribute(i++, "role", "img"); builder.AddAttribute(i++, "aria-label", "Saving subroom"); builder.CloseElement(); } else if (!row.IsArchived && row.State == RowState.Failed) { builder.OpenElement(i++, "i"); builder.AddAttribute(i++, "class", "fa-solid fa-circle-xmark danger"); builder.AddAttribute(i++, "role", "img"); builder.AddAttribute(i++, "title", FailureMessage(row)); builder.AddAttribute(i++, "aria-label", FailureMessage(row)); builder.CloseElement(); } };
    private static string? RowClass(Row row) => row.State == RowState.Saving ? "child-row-saving" : row.State == RowState.Failed ? "child-row-failed" : row.EntityId is null ? "uncommitted-row" : null;
    private void Reconcile() { ChildTableRowReconciliation.Reconcile(active, archived, View.ActiveRows, View.ArchivedRows, row => row.EntityId, view => view.EntityId, Row.From, (row, view) => row.Load(view), Row.Empty, sharedInteraction); if (pendingReferenceConflictDraft is { } retained) { var row = active.Concat(archived).SingleOrDefault(x => x.EntityId == retained.EntityId); if (row is not null) { row.Draft = retained.Draft; row.Interaction.BeginRetryFromEdit(); } pendingReferenceConflictDraft = null; } if(tabFocusAwaitingRefresh && tabFocusCreatedEntityId is Guid created && View.ActiveRows.Concat(View.ArchivedRows).Any(x=>x.EntityId==created)) { tabFocusAwaitingRefresh=false; tabFocusCreatedEntityId=null; } _=NotifyDraftState(); }
    private static Row FindOrLoad(IEnumerable<Row> old, SubroomRowView view) { var r=old.FirstOrDefault(x=>x.EntityId==view.EntityId) ?? Row.From(view); r.Load(view); return r; }
    private Task NameChanged(Row row, ChangeEventArgs e) { var value=e.Value?.ToString()??""; row.Draft=row.Draft with { FriendlyName=value,ReferenceId=row.Baseline is null ? value : row.Draft.ReferenceId}; row.Interaction.BeginRetryFromEdit(); return NotifyDraftState(); }
    private Task ReferenceChanged(Row row, ChangeEventArgs e) { row.Draft=row.Draft with {ReferenceId=e.Value?.ToString()??""}; row.Interaction.BeginRetryFromEdit(); return NotifyDraftState(); }
    private Task NotesChanged(Row row, ChangeEventArgs e) { row.Draft=row.Draft with {Notes=e.Value?.ToString()??""}; row.Interaction.BeginRetryFromEdit(); return NotifyDraftState(); }
    private async Task Blur(Row row, string? correctionField = null) { if(!Meaningful(row) || (row.EntityId is not null && !Changed(row)) || !row.Interaction.BeginSave()) return; try { var result=row.Baseline is null ? await (Create?.Invoke(row.Draft)??Unavailable("Creation")) : await (Save?.Invoke(row.Baseline,row.Draft,Id(row,correctionField??"reference"),pendingFocus?.ElementId)??Unavailable("Saving")); if(result.Status==V2SubroomCommandStatus.Unexpected) throw new InvalidOperationException(result.Message ?? "Unexpected V2 subroom command failure."); message=result.Message; if(result.Status==V2SubroomCommandStatus.Committed) { if(result.CreatedEntityId is Guid id && tabFocusAwaitingRefresh) tabFocusCreatedEntityId=id; row.Interaction.CompleteCommitted(result.CreatedEntityId); await (RefreshApplied?.Invoke() ?? Task.CompletedTask); } else if(result.Status is V2SubroomCommandStatus.Unchanged or V2SubroomCommandStatus.Proposal) row.Interaction.CompleteUnchanged(); else Fail(row, correctionField, result.Message, result.FreshBaseline); } catch (InvalidOperationException exception) when (exception.Message.StartsWith("V2 Phase 2a does not permit", StringComparison.Ordinal)) { throw; } catch { message="Save failed; edit a field to try again."; Fail(row, correctionField, message, null); } await NotifyDraftState(); if(row.State==RowState.Failed) await InvokeAsync(StateHasChanged); }
    private void Fail(Row row, string? correctionField, string? failureMessage, SubroomDurableBaseline? freshBaseline) { row.Interaction.Fail(failureMessage??"Save failed; edit a field to try again.", freshBaseline); pendingTailPromotionId=null; tabFocusAwaitingRefresh=false; tabFocusCreatedEntityId=null; pendingFocus=new(row.ClientDraftId,correctionField??"name"); }
    // This is the actual DotNetObjectReference callback used by editor.js.  It must
    // never let stale client metadata or a failed create escape into the circuit.
    [JSInvokable] public async Task<bool> NavigateSubroomAsync(string clientRowId, string field, string direction) { try { if(!Guid.TryParse(clientRowId,out var id) || !fields.Contains(field) || direction is not ("left" or "right" or "up" or "down")) return false; var row=active.Concat(archived).SingleOrDefault(x=>x.ClientDraftId==id); if(row is null) return false; var target=Target(row,field,direction); if(target is null) return false; if(row.State==RowState.Saving) { AdvanceVirtualTarget(row,direction); return true; } if(row.EntityId is not null) { pendingFocus=target; if(Changed(row)) await Blur(row, field); else await InvokeAsync(StateHasChanged); return true; } if(!Meaningful(row)) { if(target.Value.ClientRowId==latentSuccessorId) { row.Interaction.PromoteClientRowId(latentSuccessorId); latentSuccessorId=Guid.NewGuid(); pendingFocus=new(row.ClientDraftId,target.Value.Field!); } else pendingFocus=target; await InvokeAsync(StateHasChanged); return true; } pendingFocus=target; pendingTailPromotionId=target.Value.ClientRowId==latentSuccessorId ? target.Value.ClientRowId : null; await Blur(row, field); return true; } catch { return false; } }
    [JSInvokable] public async Task BlurSubroomAsync(string clientRowId, string field, string? tabTargetId) { if(!Guid.TryParse(clientRowId,out var id) || !fields.Contains(field)) return; var row=active.Concat(archived).SingleOrDefault(x=>x.ClientDraftId==id); if(row is null || row.State==RowState.Saving || !Meaningful(row) || (row.EntityId is not null && !Changed(row))) return; if(row.EntityId is null && !string.IsNullOrEmpty(tabTargetId)) { pendingFocus=ChildTableFocusTarget.Element(tabTargetId); tabFocusAwaitingRefresh=true; } await Blur(row, field); }
    [JSInvokable] public async Task ChildActionSubroomAsync(string action, string entityId) { if (!Guid.TryParse(entityId, out var id)) return; var intent=new V2DeleteConfirmationIntent(V2DeleteConfirmationKind.Subroom,id); if (action == "open-delete") { await (DeleteConfirmationRequested?.Invoke(intent) ?? Task.CompletedTask); return; } if (action == "cancel-delete") { await (DeleteConfirmationCancelled?.Invoke(intent) ?? Task.CompletedTask); return; } if (action == "delete") { await (DeleteConfirmationConfirmed?.Invoke(intent) ?? Task.CompletedTask); return; } var archivedValue = action == "archive"; var result = await (SetArchive?.Invoke(id, archivedValue) ?? Unavailable("Archive")); message=result.Message; if(result.Status==V2SubroomCommandStatus.Committed) await (RefreshApplied?.Invoke() ?? Task.CompletedTask); }
    /// <summary>Transfers the typed no-write/conflict reference draft after a page proposal closes.</summary>
    public void RetainSubroomReferenceConflict(SubroomDurableBaseline baseline, SubroomDraft draft) => pendingReferenceConflictDraft = (baseline.EntityId, draft);
    private void AdvanceVirtualTarget(Row row, string direction) { if(pendingFocus is not { ClientRowId: Guid clientRowId, Field: string field } current) return; var fieldIndex=fields.IndexOf(field); if(direction=="left" && fieldIndex>0) pendingFocus=new(clientRowId,fields[fieldIndex-1]); else if(direction=="right" && fieldIndex<fields.Length-1) pendingFocus=new(clientRowId,fields[fieldIndex+1]); else if(direction=="up") { pendingFocus=new(row.ClientDraftId,field); pendingTailPromotionId=null; } else if(direction=="down") { pendingFocus=new(latentSuccessorId,field); pendingTailPromotionId=latentSuccessorId; latentSuccessorId=Guid.NewGuid(); } }
    private ChildTableFocusTarget? Target(Row row,string field,string direction) { var rows=row.IsArchived?archived:active; return ChildTableInteractionPrimitives.Target(fields, row.ClientDraftId, rows.IndexOf(row), rows.Count, row.IsArchived, row.EntityId is null, latentSuccessorId, field, direction, index => rows[index].ClientDraftId); }
    [JSInvokable] public async Task DropSubroomAsync(string entityId, string partition, int targetIndex) { if (!Guid.TryParse(entityId, out var id) || partition != "active" || Reorder is null) return; var row=active.FirstOrDefault(x=>x.EntityId==id); if(row?.State!=RowState.Persisted) return; var result=await Reorder(id,targetIndex); message=result.Message; if(result.Status==V2SubroomCommandStatus.Committed) await (RefreshApplied?.Invoke() ?? Task.CompletedTask); }
    private static V2Severity DisplaySeverity(Row row, V2Severity severity) => row.IsArchived ? V2Severity.Neutral : severity;
    private static V2Severity Max(V2Severity first, V2Severity second) => (V2Severity)Math.Max((int)first, (int)second);
    private static string? SeverityClass(V2Severity? severity) => severity switch { V2Severity.Warning => "warning", V2Severity.Danger => "danger", _ => null };
    private static string FailureMessage(Row row)=>row.FailureMessage??"Save failed; edit a field to try again."; private Task<V2SubroomCommandOutcome> Unavailable(string verb)=>Task.FromResult(new V2SubroomCommandOutcome(V2SubroomCommandStatus.ExpectedFailure,$"{verb} is unavailable.")); private Task NotifyDraftState()=>DraftStateChanged?.Invoke(active.Any(x=>x.EntityId is null&&Meaningful(x)))??Task.CompletedTask; private static bool Meaningful(Row row)=>!string.IsNullOrEmpty(row.Draft.FriendlyName)||!string.IsNullOrEmpty(row.Draft.ReferenceId)||!string.IsNullOrEmpty(row.Draft.Notes); private static bool Changed(Row row) => row.Baseline is { } baseline && (row.Draft.FriendlyName!=baseline.FriendlyName || row.Draft.ReferenceId!=baseline.ReferenceId || row.Draft.Notes!=baseline.Notes); private static string Id(Row r,string field)=>ChildTableInteractionPrimitives.FieldId(r.ClientDraftId,field);
    private static class RowState { public const ChildTableRowLifecycle Uncommitted=ChildTableRowLifecycle.Uncommitted, Saving=ChildTableRowLifecycle.Saving, Failed=ChildTableRowLifecycle.Failed, Persisted=ChildTableRowLifecycle.Persisted; }
    private sealed class Row : IChildTableRowInteraction {
        private readonly ChildTableRowInteraction<SubroomDurableBaseline, SubroomDraft> interaction;
        private Row(Guid id, SubroomDraft draft) => interaction=new(id,draft);
        public ChildTableRowInteraction<SubroomDurableBaseline, SubroomDraft> Interaction => interaction;
        public Guid ClientDraftId => interaction.ClientRowId; public Guid? EntityId => interaction.EntityId; Guid IChildTableRowInteraction.ClientRowId => interaction.ClientRowId; public bool IsArchived=>interaction.IsArchived; public ChildTableRowLifecycle State =>interaction.Lifecycle; public string? FailureMessage =>interaction.FailureMessage; public V2Severity FriendlyNameSeverity; public V2Severity ReferenceIdSeverity; public V2Severity UsageSeverity; public SubroomDurableBaseline? Baseline =>interaction.Baseline; public SubroomDraft Draft {get=>interaction.Draft;set=>interaction.ReplaceDraft(value);}
        void IChildTableRowInteraction.ResetForRoute() => interaction.ResetForRoute();
        public static Row Empty(Guid id)=>new(id,new(id,"","","",null,null,null,null)); public static Row From(SubroomRowView v){var r=Empty(Guid.NewGuid());r.Load(v);return r;} public void Load(SubroomRowView v){FriendlyNameSeverity=v.FriendlyNameSeverity;ReferenceIdSeverity=v.ReferenceIdSeverity;UsageSeverity=v.UsageSeverity;interaction.Load(v.EntityId,v.IsArchived,RoomEditorV2CommandService.FromView(v),new(ClientDraftId,v.FriendlyName,v.ReferenceId,v.Notes,v.SceneUnitX,v.SceneUnitY,v.SceneUnitWidth,v.SceneUnitHeight));}
    }
}
