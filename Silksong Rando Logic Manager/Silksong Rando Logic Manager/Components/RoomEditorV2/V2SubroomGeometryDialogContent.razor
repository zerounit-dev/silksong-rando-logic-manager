@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<h2 id="v2-page-modal-title">edit subroom rectangle</h2><p id="v2-page-modal-description">Scene rectangle for <strong>@View.FriendlyName</strong>.</p><div class="in-game-coordinate-grid"><label>X<input type="number" value="@View.X" @oninput="e=>Changed(0,e)" disabled="@Disabled" /></label><label>Y<input type="number" value="@View.Y" @oninput="e=>Changed(1,e)" disabled="@Disabled" /></label><label>width<input type="number" value="@View.Width" @oninput="e=>Changed(2,e)" disabled="@Disabled" /></label><label>height<input type="number" value="@View.Height" @oninput="e=>Changed(3,e)" disabled="@Disabled" /></label></div><div class="v2-modal-footer"><div></div><div><button class="compact-control" type="button" @onclick="Cancel" disabled="@Disabled">Cancel</button><button class="compact-control" type="button" @onclick="Apply" disabled="@Disabled">Apply</button></div></div>
@code { [Parameter, EditorRequired] public V2SubroomGeometryDialogView View { get; set; } = null!; [Parameter] public EventCallback<V2SubroomGeometryDialogView> DraftChanged {get;set;} [Parameter] public EventCallback Cancel {get;set;} [Parameter] public EventCallback Apply {get;set;} [Parameter] public bool Disabled {get;set;} private async Task Changed(int n, ChangeEventArgs e) { double? v=double.TryParse(e.Value?.ToString(), out var parsed)?parsed:null; var d=n switch {0=>View with {X=v},1=>View with {Y=v},2=>View with {Width=v},_=>View with {Height=v}}; await DraftChanged.InvokeAsync(d); } }
