    private async Task ReloadCheckRoomAsync()
    {
        if(disposed || modalState?.Content is not V2CheckRoomReloadView || refresh is null)return;
        var owner=CaptureCheckOwner();
        var sourceRoom = owner.Room;
        var recovery = modalState;
        await commandGate.WaitAsync();
        try
        {
            if(!OwnsCheckAdmission(owner)||modalState!=recovery)return;
            owner.Refresh=refresh!.RefreshGeneration;
            var missing = await refresh.ReloadCheckRoomAsync(sourceRoom);
            if(!OwnsCheckOwner(owner,refreshDelta:1)||modalState!=recovery)return;
            if(refresh.RequiresCheckRoomReload)return;
            if(missing) { ClearModalState(); Navigation.NavigateTo("/", replace:true); return; }
            // A blocked header/comments blur has no successful write to reconcile.
            // Adopt fresh untouched fields without discarding its authored deltas.
            var previous=headerBaseline;var local=headerDraft;
            SetRefreshDiagnostic(); ResetHeaderDraft();
            if(previous is not null&&local is not null&&headerDraft is { } fresh)
            {
                headerDraft=fresh with
                {
                    FriendlyName=local.FriendlyName!=previous.FriendlyName?local.FriendlyName:fresh.FriendlyName,
                    ReferenceId=local.ReferenceId!=previous.ReferenceId?local.ReferenceId:fresh.ReferenceId,
                    InGameId=local.InGameId!=previous.InGameId?local.InGameId:fresh.InGameId,
                    Contributors=local.Contributors!=previous.Contributors?local.Contributors:fresh.Contributors,
                    Comments=local.Comments!=previous.Comments?local.Comments:fresh.Comments
                };
                // Keep the observed comparison evidence for those local fields;
                // fresh untouched values are not permission to overwrite overlap.
                if(headerBaseline is { } freshBaseline)
                    headerBaseline=freshBaseline with
                    {
                        UpdatedUtc=previous.UpdatedUtc,
                        FriendlyName=local.FriendlyName!=previous.FriendlyName?previous.FriendlyName:freshBaseline.FriendlyName,
                        ReferenceId=local.ReferenceId!=previous.ReferenceId?previous.ReferenceId:freshBaseline.ReferenceId,
                        InGameId=local.InGameId!=previous.InGameId?previous.InGameId:freshBaseline.InGameId,
                        Contributors=local.Contributors!=previous.Contributors?previous.Contributors:freshBaseline.Contributors,
                        Comments=local.Comments!=previous.Comments?previous.Comments:freshBaseline.Comments
                    };
            }
            ClearModalState();
            WorkspaceChanges.NotifyChanged(WorkspaceChangeScope.Sidebar);
            if(view is { } snapshot)
            {
                await(subroomTable?.ResumeAfterRoomReloadAsync(snapshot.Subrooms)??Task.CompletedTask);
                await(transitionTable?.ResumeAfterRoomReloadAsync(snapshot.Transitions)??Task.CompletedTask);
                await(connectionTable?.ResumeAfterRoomReloadAsync(snapshot.Connections)??Task.CompletedTask);
                await(checkTable?.ResumeAfterRoomReloadAsync(snapshot.CheckLocations,snapshot.Enemies) ?? Task.CompletedTask);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch(Exception exception)
        {
            Logger.LogError(exception, "Complete-room recovery reload failed.");
            if(OwnsCheckOwner(owner,refreshDelta:1)&&modalState==recovery) Diagnostics.Show(exception.ToString());
        }
        finally { commandGate.Release(); }
    }
