    private async Task HandleSceneActionAsync(Guid ownerRoomId, long ownerGeneration, V2SceneAction action)
    {
        if (!OwnsCurrentSceneOwner(ownerRoomId, ownerGeneration) || !SceneTableActionsAvailable || selectedSceneItem is not { } selected) return;
        if (action == V2SceneAction.Dismiss)
        {
            sceneIntentRevision++;
            if (placementRequest is not null) { placementRequest = null; sceneActionStatus = null; }
            else ClearSceneTransientState();
            await InvokeAsync(StateHasChanged); return;
        }
        var data = SelectedSceneData(selected);
        if (data is null || sceneActionPending) return;
        if (action == V2SceneAction.Rearm)
        {
            AdmitSceneLayerIntent(selected.Kind);
            if (placementRequest is null) { placementRequest = new(selected.Kind == V2SceneSelectedItemKind.Subroom ? "subroom" : selected.Kind == V2SceneSelectedItemKind.Transition ? "exit" : selected.Kind == V2SceneSelectedItemKind.Check ? "check" : "connection", selected.Kind == V2SceneSelectedItemKind.Connection ? (Guid)data.Baseline : selected.EntityId, "scene-action-box", selected.Kind == V2SceneSelectedItemKind.Connection ? selected.EntityId : null); sceneActionStatus = null; await InvokeAsync(StateHasChanged); }
            return;
        }
        if ((action == V2SceneAction.Reset && !(data.Kind is V2SceneSelectedItemKind.Transition or V2SceneSelectedItemKind.Check && Usable(data.GameX, data.GameY))) || (action == V2SceneAction.Clear && !data.IsValidGeometry) || (action == V2SceneAction.ToggleVisibility && !data.IsValidGeometry) || modalState is not null || meaningfulPendingDraft) return;
        var owner=CaptureCheckOwner(scene:true);
        var intentRevision = sceneIntentRevision;
        pendingCheckScenePage=owner.Page;
        sceneActionPending = true; sceneActionStatus = null; await InvokeAsync(StateHasChanged);
        await commandGate.WaitAsync();
        try
        {
            if(!OwnsCheckAdmission(owner))return;
            owner.Refresh=refresh!.RefreshGeneration;
            if (!OwnsCurrentSceneOwner(ownerRoomId, ownerGeneration) || refresh?.CurrentRoomId != RoomId || SelectedSceneData(selected) is null || modalState is not null || meaningfulPendingDraft) return;
            if (intentRevision == sceneIntentRevision) placementRequest = null;
            var result = await ExecuteSceneActionCommandAsync(action, data);
            if(!OwnsCheckAdmission(owner)||refresh!.RequiresCheckRoomReload)return;
            if(data.Kind==V2SceneSelectedItemKind.Check&&(result.checkOutcome is not { } check||check.RequiresRoomReload||!OwnsCheckResult(owner,check)))return;
            if (result.committed) { SetRefreshDiagnostic(); sceneActionStatus = null; }
            else if (result.unexpected) (Services.GetService(typeof(DiagnosticState)) as DiagnosticState)?.Show(result.message ?? "The scene annotation action failed unexpectedly.");
            else sceneActionStatus = result.message ?? "The scene annotation action could not be completed.";
        }
        finally
        {
            commandGate.Release();
            if(pendingCheckScenePage==owner.Page&&OwnsCheckPage(owner))
            {
                pendingCheckScenePage=null;sceneActionPending = false;await InvokeAsync(StateHasChanged);
            }
        }
    }
    private async Task<(bool committed, bool unexpected, string? message,V2CheckCommandOutcome? checkOutcome)> ExecuteSceneActionCommandAsync(V2SceneAction action, SceneActionData data)
    {
        if (data.Kind == V2SceneSelectedItemKind.Subroom)
        {
            var b = (SubroomDurableBaseline)data.Baseline;
            var r = await CommitSubroomWithRecoveryAsync(RoomId, action == V2SceneAction.Clear ? "subroom-annotation-clear" : data.Enabled ? "subroom-annotation-hide" : "subroom-annotation-show", () => action == V2SceneAction.Clear ? Commands.ClearSubroomAnnotationAsync(RoomId, b) : data.Enabled ? Commands.HideSubroomAnnotationAsync(RoomId, b) : Commands.ShowSubroomAnnotationAsync(RoomId, b), SceneRefreshImpact.SubroomGeometry);
            return (r.Status == V2SubroomCommandStatus.Committed&&r.PresentationRefreshed&&!r.RequiresRoomReload, r.Status == V2SubroomCommandStatus.Unexpected, r.Message,null);
        }
        if (data.Kind == V2SceneSelectedItemKind.Transition)
        {
            var b=(TransitionDurableBaseline)data.Baseline; var r=await CommitTransitionWithRecoveryAsync(RoomId, action == V2SceneAction.Reset ? "transition-annotation-reset" : action == V2SceneAction.Clear ? "transition-annotation-clear" : data.Enabled ? "transition-annotation-hide" : "transition-annotation-show", () => action == V2SceneAction.Reset ? Commands.ResetTransitionAnnotationAsync(RoomId,b) : action == V2SceneAction.Clear ? Commands.ClearTransitionAnnotationAsync(RoomId,b) : data.Enabled ? Commands.RemoveTransitionAnnotationAsync(RoomId,b) : Commands.ShowTransitionAnnotationAsync(RoomId,b), true); return (r.Status==V2TransitionCommandStatus.Committed&&r.PresentationRefreshed&&!r.RequiresRoomReload,r.Status==V2TransitionCommandStatus.Unexpected,r.Message,null);
        }
        if (data.Kind == V2SceneSelectedItemKind.Check)
        {
            var sourceRoom=RoomId;var b=(CheckMetadataDurableBaseline)data.Baseline; var r=await CommitCheckWithRecoveryAsync(sourceRoom, action == V2SceneAction.Reset ? "check-annotation-reset" : action == V2SceneAction.Clear ? "check-annotation-clear" : data.Enabled ? "check-annotation-hide" : "check-annotation-show", () => action == V2SceneAction.Reset ? Commands.ResetCheckAnnotationAsync(sourceRoom,b) : action == V2SceneAction.Clear ? Commands.ClearCheckAnnotationAsync(sourceRoom,b) : data.Enabled ? Commands.RemoveCheckAnnotationAsync(sourceRoom,b) : Commands.ShowCheckAnnotationAsync(sourceRoom,b), true); return (r.Status==V2CheckCommandStatus.Committed&&!r.RequiresRoomReload,r.Status==V2CheckCommandStatus.Unexpected,r.Message,r);
        }
        var id=(Guid)data.Baseline; var c=await CommitConnectionWithRecoveryAsync(RoomId, action == V2SceneAction.Clear ? "connection-annotation-clear" : data.Enabled ? "connection-annotation-hide" : "connection-annotation-show", () => action == V2SceneAction.Clear ? Commands.ClearConnectionAnnotationAsync(RoomId,id) : data.Enabled ? Commands.DisableConnectionAnnotationAsync(RoomId,id) : Commands.ShowConnectionAnnotationAsync(RoomId,id), true); return (c.Status==V2ConnectionCommandStatus.Committed&&c.PresentationRefreshed&&!c.RequiresRoomReload,c.Status==V2ConnectionCommandStatus.Unexpected,c.Message,null);
    }
