    private async Task<V2RoomHeaderCommandOutcome> SaveHeaderCore()
    {
        if (headerBaseline is null || headerDraft is null) return new(V2RoomHeaderCommandStatus.Missing, "This room is not loaded.");
        if (modalState is not null) return new(V2RoomHeaderCommandStatus.Unchanged, "Close the open dialog first.");
        if (!headerSaveStatus.IsEditable) return new(V2RoomHeaderCommandStatus.Missing, headerSaveStatus.Message);
        var sourceRoom=RoomId;var sourcePage=childInteractionOwnerGeneration;
        await commandGate.WaitAsync();
        try
        {
            if(HeaderWriteAdmission(sourceRoom,sourcePage) is { } rejected)return rejected;
            var priorStatus=headerSaveStatus;
            headerSaveStatus = new(V2RoomHeaderSaveState.Saving);
            await InvokeAsync(StateHasChanged);
            // Preparation can itself save when Reference ID is unchanged. Do not
            // rely on the coordinator's later guard to authorize that write.
            if(HeaderWriteAdmission(sourceRoom,sourcePage) is { } lateRejection)
            {
                if(!disposed&&RoomId==sourceRoom&&childInteractionOwnerGeneration==sourcePage)headerSaveStatus=priorStatus;
                return lateRejection;
            }
            var coordinator=refresh!;
            var before = coordinator.LastAppliedRefresh?.Sequence;
            var result = await Commands.PrepareRoomReferenceRenameAsync(sourceRoom, headerBaseline!, headerDraft!);
            if(!OwnsCheckPage((sourceRoom,sourcePage,0,null)))return result;
            if (result.Status == V2RoomHeaderCommandStatus.Committed)
                result = await coordinator.CommitRoomHeaderCommandAsync(sourceRoom, "header-save", () => Task.FromResult(result));
            if(!OwnsCheckPage((sourceRoom,sourcePage,0,null))||coordinator.RequiresCheckRoomReload)return result;
            if (result.Status == V2RoomHeaderCommandStatus.Committed && coordinator.LastAppliedRefresh?.Sequence != before) { SetRefreshDiagnostic(); ResetHeaderDraft(); }
            if (result.Status == V2RoomHeaderCommandStatus.Proposal && result.Proposal is { } proposal)
            {
                modalState = new(new V2ReferenceUpdateProposalView("room", view?.Header.FriendlyName ?? "Room", proposal.SourceCurrent.ReferenceId), "room-reference-id", null, V2ModalRuntimeStage.ProposalOpen, RoomReferenceRenameProposal: proposal);
                modalFocusRequested = true; StateHasChanged();
            }
            return ApplyHeaderOutcome(result);
        }
        finally { commandGate.Release(); }
    }
    private V2RoomHeaderCommandOutcome ApplyHeaderOutcome(V2RoomHeaderCommandOutcome result)
    {
        if (result.Status == V2RoomHeaderCommandStatus.Conflict && result.FreshBaseline is not null)
        {
            headerBaseline = result.FreshBaseline;
            headerDraft = result.RetainedDraft ?? headerDraft;
            headerSaveStatus = new(V2RoomHeaderSaveState.Conflict, result.Message);
        }
        else if (result.Status == V2RoomHeaderCommandStatus.Missing)
            headerSaveStatus = new(V2RoomHeaderSaveState.Missing, result.Message);
        else if (result.Status == V2RoomHeaderCommandStatus.Unexpected)
            headerSaveStatus = new(V2RoomHeaderSaveState.Failed, result.Message);
        else if (result.Status is V2RoomHeaderCommandStatus.Unchanged or V2RoomHeaderCommandStatus.Proposal)
            headerSaveStatus = new(V2RoomHeaderSaveState.Saved);
        return result;
    }
