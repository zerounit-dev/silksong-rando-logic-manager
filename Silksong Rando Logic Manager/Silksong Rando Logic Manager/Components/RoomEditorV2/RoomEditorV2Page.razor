    private async Task CompleteSceneDimensionsModalAsync()
    {
        if (modalState is not { Stage: V2ModalRuntimeStage.ProposalOpen, SceneDimensionsOperation: { } operation } state) return;
        if (!TryParseSceneDimensions(operation.Draft, out var draft, out var error))
        {
            var invalid = operation.Draft with { ValidationMessage = error };
            modalState = state with { Content = invalid, SceneDimensionsOperation = operation with { Draft = invalid } };
            StateHasChanged(); return;
        }
        modalState = state with { Stage = V2ModalRuntimeStage.Committing }; StateHasChanged(); await commandGate.WaitAsync();
        try
        {
            // The SQLite command is completion-bound. Capture the operation's
            // source page identity immediately before admitting it so a route
            // switch cannot make the destination look like the source after
            // the await resumes.
            var sourceRoomId = operation.Baseline.RoomId;
            var sourceGeneration = refresh?.RefreshGeneration;
            var outcome = refresh is null || refresh.CurrentRoomId != RoomId
                ? new V2RoomSceneDimensionsCommandOutcome(V2RoomSceneDimensionsCommandStatus.Missing, "This room is not loaded.")
                : await refresh.CommitRoomSceneDimensionsCommandAsync(RoomId, "room-scene-dimensions", () => Commands.SaveRoomSceneDimensionsAsync(RoomId, operation.Baseline, draft));
            // A completion-bound durable command may finish after this page has
            // been disposed or switched rooms. Its database result is valid, but
            // it must not restore old modal/focus/refresh state to this page.
            if (!IsActiveSceneDimensionsOperation(sourceRoomId, sourceGeneration,
                    outcome.Status == V2RoomSceneDimensionsCommandStatus.Committed))
            {
                suppressStaleSceneDimensionsCompletionRender = true;
                return;
            }
            if (outcome.Status == V2RoomSceneDimensionsCommandStatus.Committed) { SetRefreshDiagnostic(); ResetHeaderDraft(); QueueModalFocus(state, V2ModalFocusOutcome.Initiator); ClearModalState(false); }
            else if (outcome.Status == V2RoomSceneDimensionsCommandStatus.Unchanged) { QueueModalFocus(state, V2ModalFocusOutcome.Initiator); ClearModalState(false); }
            else
            {
                if (refresh is not null && refresh.CurrentRoomId == RoomId) { var before = refresh.LastAppliedRefresh?.Sequence; if (!await refresh.RefreshAsync(RoomId) && refresh.LastAppliedRefresh?.Sequence != before) SetRefreshDiagnostic(); }
                QueueModalFocus(state, V2ModalFocusOutcome.Correction); ClearModalState(false);
            }
            StateHasChanged();
        }
        finally { commandGate.Release(); }
    }
    private bool IsActiveSceneDimensionsOperation(Guid sourceRoomId, long? sourceGeneration, bool committed) =>
        !disposed
        && RoomId == sourceRoomId
        && displayedRoomId == sourceRoomId
        && refresh is not null
        && refresh.CurrentRoomId == sourceRoomId
        // A committed dimensions command itself performs exactly one refresh,
        // advancing the iterator once. Any other advance is a route/refresh
        // supersession and invalidates the operation's page effects.
        && refresh.RefreshGeneration == sourceGeneration + (committed ? 1 : 0);
    private static bool TryParseSceneDimensions(V2SceneDimensionsDialogView text, out RoomSceneDimensionsDraft draft, out string error)
    {
        var widthBlank = string.IsNullOrWhiteSpace(text.Width); var heightBlank = string.IsNullOrWhiteSpace(text.Height);
        if (widthBlank && heightBlank) { draft = new(null, null); error = ""; return true; }
        if (widthBlank || heightBlank) { draft = new(null, null); error = "Enter both dimensions or leave both blank."; return false; }
        if (!double.TryParse(text.Width, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var width) || !double.TryParse(text.Height, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var height) || !double.IsFinite(width) || !double.IsFinite(height) || width <= 0 || height <= 0)
        { draft = new(null, null); error = "Dimensions must be finite positive values."; return false; }
        draft = new(width, height); error = ""; return true;
    }
    private async Task CompleteSceneImageCaptureModalAsync()
    {
        if (modalState is not { Stage: V2ModalRuntimeStage.ProposalOpen, SceneImageCaptureOperation: { } operation } state) return;
        if (!TryParseSceneImageDraft(operation.Draft, out var draft))
        {
            var invalid = operation.Draft with { AvailabilitySummary = "Enter finite positive scales and finite pan values." };
            modalState = state with { Content = invalid, SceneImageCaptureOperation = operation with { Draft = invalid } }; StateHasChanged(); return;
        }
        // Keep the V1-parity capture surface in place while generation runs; its
        // modal-local content renders progress in the established footer slot.
        modalState = state with { Stage = V2ModalRuntimeStage.Committing, Content = operation.Draft }; StateHasChanged(); await commandGate.WaitAsync();
        try
        {
            var sourceRoom = RoomId; var generation = refresh?.RefreshGeneration;
            var outcome = refresh is null || refresh.CurrentRoomId != RoomId ? new V2SceneImageCaptureCommandOutcome(V2SceneImageCaptureCommandStatus.Missing, "This room is not loaded.") : await refresh.CommitSceneImageCommandAsync(RoomId, "scene-image-capture", () => Commands.ApplySceneImageCaptureAsync(RoomId, draft));
            if (disposed || RoomId != sourceRoom || refresh?.CurrentRoomId != sourceRoom || refresh.RefreshGeneration != generation + (outcome.Status == V2SceneImageCaptureCommandStatus.Committed ? 1 : 0))
            {
                // Async event completion otherwise schedules an additional render on
                // the current route after this completion-bound source command.
                suppressStaleSceneImageCaptureCompletionRender = true;
                return;
            }
            if (outcome.Status == V2SceneImageCaptureCommandStatus.Committed) { SetRefreshDiagnostic(); ResetHeaderDraft(); QueueModalFocus(state, V2ModalFocusOutcome.Initiator); ClearModalState(false); }
            else { var failed = operation.Draft with { AvailabilitySummary = outcome.Message ?? "Scene image capture failed." }; modalState = state with { Content = failed, Stage = V2ModalRuntimeStage.ProposalOpen, SceneImageCaptureOperation = operation with { Draft = failed } }; QueueModalFocus(state, V2ModalFocusOutcome.Correction); }
            StateHasChanged();
        }
        finally { commandGate.Release(); }
    }
    private static bool TryParseSceneImageDraft(V2SceneImageCaptureDialogView text, out SceneImageCaptureDraft draft)
    {
        double x = 0, y = 0, panX = 0, panY = 0;
        var ok = double.TryParse(text.ScaleXPercent, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out x)
            && double.TryParse(text.ScaleYPercent, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out y)
            && double.TryParse(text.PanXPercent, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out panX)
            && double.TryParse(text.PanYPercent, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out panY)
            && double.IsFinite(x) && double.IsFinite(y) && double.IsFinite(panX) && double.IsFinite(panY) && x > 0 && y > 0;
        draft = new(x, y, panX, panY); return ok;
    }
    private async Task CompleteChildDeleteModalAsync()
    {
        if (modalState is not { Stage: V2ModalRuntimeStage.ProposalOpen, DeleteConfirmationIntent: { } delete } state) return;
        modalState = state with { Stage = V2ModalRuntimeStage.Committing }; StateHasChanged();
        await commandGate.WaitAsync();
        try
        {
            switch (delete.Kind)
            {
                case V2DeleteConfirmationKind.Subroom:
                {
                    var outcome = refresh is null || refresh.CurrentRoomId != RoomId
                        ? new V2SubroomCommandOutcome(V2SubroomCommandStatus.Missing, "This room is not loaded.")
                        : await refresh.CommitSubroomCommandAsync(RoomId, "subroom-permanent-delete", () => Commands.DeleteSubroomAsync(RoomId, delete.EntityId), SceneRefreshImpact.ArchiveRestoreDelete);
                    if (outcome.Status == V2SubroomCommandStatus.Committed) { SetRefreshDiagnostic(); QueueModalFocus(state, V2ModalFocusOutcome.Initiator); }
                    else QueueModalFocus(state, V2ModalFocusOutcome.Correction);
                    break;
                }
                case V2DeleteConfirmationKind.Check:
                {
                    var outcome = refresh is null || refresh.CurrentRoomId != RoomId
                        ? new V2CheckCommandOutcome(V2CheckCommandStatus.Missing, "This room is not loaded.")
                        : await refresh.CommitCheckCommandAsync(RoomId, "check-permanent-delete", () => Commands.DeleteCheckAsync(RoomId, delete.EntityId), SceneRefreshImpact.ArchiveRestoreDelete);
                    if (outcome.Status == V2CheckCommandStatus.Committed) { SetRefreshDiagnostic(); QueueModalFocus(state, V2ModalFocusOutcome.Initiator); }
                    else QueueModalFocus(state, V2ModalFocusOutcome.Correction);
                    break;
                }
            }
            ClearModalState(false); StateHasChanged();
        }
        finally { commandGate.Release(); }
    }
    private async Task CompleteRoomDeleteModalAsync()
    {
        if (modalState is not { Stage: V2ModalRuntimeStage.ProposalOpen, RoomPermanentDeleteOperation: { } delete } state) return;
        modalState = state with { Stage = V2ModalRuntimeStage.Committing }; StateHasChanged();
        await commandGate.WaitAsync();
        try
        {
            var outcome = refresh is null || refresh.CurrentRoomId != RoomId || delete.RoomId != RoomId
                ? new V2RoomLifecycleCommandOutcome(V2RoomLifecycleCommandStatus.Missing, "This room is not loaded.")
                : await refresh.CommitRoomLifecycleCommandAsync(RoomId, "room-permanent-delete", () => Commands.DeleteRoomAsync(RoomId), SceneRefreshImpact.RoomLifecycle);
            if (outcome.Status == V2RoomLifecycleCommandStatus.Committed)
            {
                // The missing refresh has cleared the complete room view. Successful
                // deletion intentionally follows its lifecycle destination, not field focus.
                headerBaseline = null; headerDraft = null; meaningfulPendingDraft = false; showArchivedChildren = false;
                refreshDiagnostic = null; ClearModalState(); StateHasChanged();
                Navigation.NavigateTo("/", replace: true);
            }
            else { QueueModalFocus(state, V2ModalFocusOutcome.Correction); ClearModalState(false); StateHasChanged(); }
        }
        finally { commandGate.Release(); }
    }
    /// <summary>Test-only completion point models the already-complete refresh required before committed focus.</summary>
