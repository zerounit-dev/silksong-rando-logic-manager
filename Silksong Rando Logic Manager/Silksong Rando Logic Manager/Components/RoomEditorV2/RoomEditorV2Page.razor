    private readonly Dictionary<Guid, TransitionInGameMetadataDraft> retainedTransitionMetadataDrafts = [];
    private readonly Dictionary<Guid, CheckInGameMetadataDraft> retainedCheckMetadataDrafts = [];
    private const string ReminderFooterProse = "remember your options: ledge grab, spike pogo, crest pogo, run, dash, drifter's cloak, faydown cloak, cling grip, silk soar, clawline, sharpdart, scuttlebrace";
    private const string RoomFriendlyNameFocusId = "room-friendly-name";

    protected override async Task OnParametersSetAsync()
    {
        childInteractionOwnerGeneration++;
        if (displayedRoomId is Guid previous && previous != RoomId)
        {
            await RetireChildInteractionOwnerAsync();
            applicationNavigationActive = false; roomMapLinkModalOwner = null; roomMapLinkModalState = AreaMapPanePresentation.RoomMapLinkModalState.Closed; mapLoads?.Clear(); showArchivedChildren = false; recheckingRoomLogic = false; ClearSceneTransientState();
        }
        displayedRoomId = RoomId; retainedTransitionMetadataDrafts.Clear(); retainedCheckMetadataDrafts.Clear(); ClearModalState();
        mapLoads ??= new(AreaMaps);
        refresh?.InvalidateRouteState(); refresh ??= new(Loader, sidebarInvalidated: () => WorkspaceChanges.NotifyChanged(WorkspaceChangeScope.Sidebar));
        var before = refresh.LastAppliedRefresh?.Sequence;
        try
        {
            if (await refresh.RefreshAsync(RoomId)) Navigation.NavigateTo("/", replace: true);
            else if (refresh.LastAppliedRefresh?.Sequence != before) { SetRefreshDiagnostic(); ResetHeaderDraft(); }
            if (view?.Header.IsArchived == false)
                await mapLoads.LoadAsync(RoomId, mapLoads.RetainedGeometry, refresh.RefreshGeneration, OwnsMapLoad);
            else mapLoads.Clear();
        }
        catch (OperationCanceledException) { }
        if (view?.Header.IsArchived == true) await DisposeMapContextHeightOwnerAsync();
    }
    protected override bool ShouldRender()
    {
        // Blazor schedules a render when an async event completes even when its
        // stale completion intentionally changed no page state. Do not let a
        // source-room operation result redraw a newer destination room.
        if (!suppressStaleSceneDimensionsCompletionRender && !suppressStaleSceneImageCaptureCompletionRender && !suppressStaleRoomLogicRecheckCompletionRender) return true;
        suppressStaleSceneDimensionsCompletionRender = false;
        suppressStaleSceneImageCaptureCompletionRender = false;
        suppressStaleRoomLogicRecheckCompletionRender = false;
        return false;
    }
    private Task ToggleArchivedChildren() { showArchivedChildren = !showArchivedChildren; return Task.CompletedTask; }
    private async Task HandleReminderFooterIntentAsync(RoomReminderFooterIntent intent)
    {
        if (intent != RoomReminderFooterIntent.OpenSyntaxGuide || disposed || modalState is not null) return;
        if (childInteractionOwner is not null)
        {
            try
            {
                if (!await childInteractionOwner.InvokeAsync<bool>("commitActiveRequirement")) return;
            }
            catch (JSDisconnectedException) { return; }
            catch (ObjectDisposedException) when (disposed) { return; }
        }
        if (disposed || modalState is not null || refresh?.CurrentRoomId != RoomId) return;
        var reference = await Catalogue.LoadReferenceAsync();
        if (disposed || modalState is not null || refresh?.CurrentRoomId != RoomId) return;
        modalState = new(new V2RequirementSyntaxGuideDialogView(reference), "room-syntax-guide", null, V2ModalRuntimeStage.ProposalOpen);
        modalFocusRequested = true;
        StateHasChanged();
    }
    private async Task NavigateToRequirementCatalogueAsync()
    {
        if (modalState?.Content is not V2RequirementSyntaxGuideDialogView) return;
        ClearModalState();
        await InvokeAsync(StateHasChanged);
        Navigation.NavigateTo("/requirements");
    }
    private void DownloadCurrentRoomExport(RoomExportIntent intent) => Navigation.NavigateTo($"{LocalExchangeDownloadEndpoints.CurrentRoomPathPrefix}{intent.RoomId:D}", forceLoad: true);
    private void DownloadZoneExport(RoomExportIntent intent) => Navigation.NavigateTo($"{LocalExchangeDownloadEndpoints.ZonePathPrefix}{intent.RoomId:D}", forceLoad: true);
    private void NavigateBackToMap() => Navigation.NavigateTo("/");
    private async Task ToggleMapContextAsync()
    {
        if (!mapContextVisibilityResolved) return;
        showMapContext = !showMapContext;
        await JS.InvokeVoidAsync("saveRoomMapContextVisibility", showMapContext);
        if (!showMapContext) await DisposeMapContextHeightOwnerAsync();
    }
    private void ResetHeaderDraft() { if (view is null) return; headerBaseline = RoomEditorV2CommandService.HeaderFromView(view.Header); headerDraft = new(view.Header.FriendlyName, view.Header.InGameId, view.Header.Contributors, view.Header.Comments, view.Header.ReferenceId); headerSaveStatus = new(V2RoomHeaderSaveState.Saved); }
    private Task SetHeaderDraft(RoomHeaderDraft draft) { headerDraft = draft; return Task.CompletedTask; }
    private Task SetHeaderComments(string comments) { if (headerDraft is not null) headerDraft = headerDraft with { Comments = comments }; return Task.CompletedTask; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        if (!mapContextVisibilityResolved && !mapContextVisibilityLoadStarted)
        {
            mapContextVisibilityLoadStarted = true;
            try
            {
                showMapContext = await JS.InvokeAsync<bool>("loadRoomMapContextVisibility");
                mapContextVisibilityResolved = true;
                await InvokeAsync(StateHasChanged);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) when (disposed) { }
        }
        if (modalState is not null && modalFocusRequested)
        {
            modalFocusRequested = false;
            await InvokeAsync(StateHasChanged);
        }
        if (pendingModalFocus is { } focus)
        {
            pendingModalFocus = null;
            try { await JS.InvokeVoidAsync("focusEditorField", focus.TargetId); }
            catch (JSDisconnectedException) { } catch (ObjectDisposedException) when (disposed) { }
        }
        if (pendingConnectionFocusId is { } connectionFocus)
        {
            pendingConnectionFocusId = null;
            try { await JS.InvokeVoidAsync("focusEditorField", connectionFocus); }
            catch (JSDisconnectedException) { } catch (ObjectDisposedException) when (disposed) { }
        }
        if (childInteractionOwner is null && !childInteractionOwnerInitializing && view is { } ownerView && subroomTable is not null && transitionTable is not null && connectionTable is not null && checkTable is not null)
        {
            childInteractionOwnerInitializing = true;
            var ownerGeneration = childInteractionOwnerGeneration;
            var retryCurrentInitialization = false;
            Exception? initializationFailure = null;
            IJSObjectReference? candidate = null;
            try
            {
                subroomCallback ??= DotNetObjectReference.Create(subroomTable);
                transitionCallback ??= DotNetObjectReference.Create(transitionTable);
                connectionCallback ??= DotNetObjectReference.Create(connectionTable);
                checkCallback ??= DotNetObjectReference.Create(checkTable);
                candidate = await JS.InvokeAsync<IJSObjectReference>("createV2ChildInteractionOwner", pageRoot, ownerView.RequirementsParserContext);
                if (OwnsChildInteractionInitialization(ownerGeneration))
                {
                    await candidate.InvokeVoidAsync("register", subroomCallback, "subroom");
                    await candidate.InvokeVoidAsync("register", transitionCallback, "transition");
                    await candidate.InvokeVoidAsync("register", connectionCallback, "connection");
                    await candidate.InvokeVoidAsync("register", checkCallback, "check");
                    if (OwnsChildInteractionInitialization(ownerGeneration))
                    {
                        childInteractionOwner = candidate;
                        candidate = null;
                    }
                    else retryCurrentInitialization = !disposed;
                }
                else retryCurrentInitialization = !disposed;
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) when (disposed) { }
            catch (Exception ex) { initializationFailure = ex; }
            finally
            {
                try
                {
                    if (candidate is not null) await DisposeUnpublishedChildInteractionOwnerAsync(candidate);
                }
                catch (Exception ex) { initializationFailure ??= ex; }
                finally
                {
                    candidate = null;
                    childInteractionOwnerInitializing = false;
                    if ((retryCurrentInitialization || initializationFailure is not null) && CanRetryChildInteractionInitialization())
                    {
                        try { await InvokeAsync(StateHasChanged); }
                        catch (Exception ex) { initializationFailure ??= ex; }
                    }
                }
            }
            if (initializationFailure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(initializationFailure).Throw();
        }
        if (childInteractionOwner is not null && view is not null)
        {
            try { await childInteractionOwner.InvokeVoidAsync("setRequirementsContext", view.RequirementsParserContext); }
            catch (JSDisconnectedException) { } catch (ObjectDisposedException) when (disposed) { }
        }
        if (mapContextHeightOwner is null && view?.Header.IsArchived == false && mapContextVisibilityResolved && showMapContext)
        {
            try { mapContextHeightOwner = await JS.InvokeAsync<IJSObjectReference>("createV2MapContextHeightOwner", pageRoot); }
            catch (JSDisconnectedException) { } catch (ObjectDisposedException) when (disposed) { }
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        childInteractionOwnerGeneration++;
        var owner = childInteractionOwner;
        childInteractionOwner = null;
        var callbacks = new IDisposable?[] { subroomCallback, transitionCallback, connectionCallback, checkCallback };
        subroomCallback = null; transitionCallback = null; connectionCallback = null; checkCallback = null;
        Exception? disposalFailure = null;
        try { ClearSceneTransientState(); ClearModalState(); refresh?.Dispose(); }
        catch (Exception ex) { disposalFailure = ex; }
        try { if (mapLoads is not null) await mapLoads.DisposeAsync(); }
        catch (Exception ex) { disposalFailure ??= ex; }
        try { await DisposeMapContextHeightOwnerAsync(); }
        catch (Exception ex) { disposalFailure ??= ex; }
        if (owner is not null)
        {
            foreach (var kind in new[] { "subroom", "transition", "connection", "check" })
            {
                try { await owner.InvokeVoidAsync("unregister", kind); }
                catch (JSDisconnectedException) { }
                catch (ObjectDisposedException) { }
                catch (Exception ex) { disposalFailure ??= ex; }
            }
            try { await owner.InvokeVoidAsync("dispose"); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { disposalFailure ??= ex; }
            try { await owner.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { disposalFailure ??= ex; }
        }
        foreach (var callback in callbacks)
        {
            try { callback?.Dispose(); }
            catch (Exception ex) { disposalFailure ??= ex; }
        }
        if (disposalFailure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(disposalFailure).Throw();
    }
    private bool OwnsChildInteractionInitialization(long generation) =>
        !disposed && childInteractionOwner is null && childInteractionOwnerGeneration == generation && refresh?.CurrentRoomId == RoomId;
    private bool CanRetryChildInteractionInitialization() =>
        !disposed && childInteractionOwner is null && refresh?.CurrentRoomId == RoomId;
    private async Task RetireChildInteractionOwnerAsync()
    {
        var owner = childInteractionOwner;
        childInteractionOwner = null;
        var callbacks = new IDisposable?[] { subroomCallback, transitionCallback, connectionCallback, checkCallback };
        subroomCallback = null; transitionCallback = null; connectionCallback = null; checkCallback = null;
        Exception? retirementFailure = null;
        if (owner is not null)
        {
            foreach (var kind in new[] { "subroom", "transition", "connection", "check" })
            {
                try { await owner.InvokeVoidAsync("unregister", kind); }
                catch (JSDisconnectedException) { }
                catch (ObjectDisposedException) { }
                catch (Exception ex) { retirementFailure ??= ex; }
            }
            try { await owner.InvokeVoidAsync("dispose"); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { retirementFailure ??= ex; }
            try { await owner.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { retirementFailure ??= ex; }
        }
        foreach (var callback in callbacks)
        {
            try { callback?.Dispose(); }
            catch (Exception ex) { retirementFailure ??= ex; }
        }
        if (retirementFailure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(retirementFailure).Throw();
    }
    private static async ValueTask DisposeUnpublishedChildInteractionOwnerAsync(IJSObjectReference owner)
    {
        Exception? failure = null;
        try { await owner.InvokeVoidAsync("dispose"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { failure = ex; }
        finally
        {
            try { await owner.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { failure ??= ex; }
        }
        if (failure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
    }
    private async Task DisposeMapContextHeightOwnerAsync()
    {
        if (mapContextHeightOwner is null) return;
        try { await mapContextHeightOwner.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
        try { await mapContextHeightOwner.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
        mapContextHeightOwner = null;
    }
    private async Task<V2SubroomCommandOutcome> SaveSubroom(SubroomDurableBaseline b, SubroomDraft d, string initiatorId, string? pendingTargetId)
    {
        if (b.ReferenceId == d.ReferenceId) return await Execute(() => Commands.SaveSubroomAsync(RoomId, b, d), sceneRelevant: SceneRefreshImpact.SubroomSave(b, d));
        await commandGate.WaitAsync();
        try
        {
            if (modalState is not null) return new(V2SubroomCommandStatus.ExpectedFailure, "Close the open dialog first.");
            if (refresh is null || refresh.CurrentRoomId != RoomId) return new(V2SubroomCommandStatus.Missing, "This room is not loaded.");
            var result = await Commands.PrepareSubroomReferenceRenameAsync(RoomId, b, d);
            if (result.Status == V2SubroomCommandStatus.Proposal && result.Proposal is { } proposal)
            {
                modalState = new(new V2ReferenceUpdateProposalView("subroom", view?.Subrooms.ActiveRows.FirstOrDefault(x => x.EntityId == b.EntityId)?.FriendlyName ?? "Subroom", proposal.SourceCurrent.ReferenceId), initiatorId, pendingTargetId, V2ModalRuntimeStage.ProposalOpen, SubroomReferenceRenameProposal: proposal);
                modalFocusRequested = true; StateHasChanged();
            }
            return result;
        }
        finally { commandGate.Release(); }
    }
    private Task<V2SubroomCommandOutcome> CreateSubroom(SubroomDraft d) => Execute(() => Commands.CreateSubroomAsync(RoomId, d), true, SceneRefreshImpact.Create);
    private Task<V2SubroomCommandOutcome> ReorderSubroom(Guid id, int index) => Execute(() => Commands.ReorderSubroomAsync(RoomId, id, index), sceneRelevant: SceneRefreshImpact.Reorder);
    private Task<V2SubroomCommandOutcome> SetSubroomArchive(Guid id, bool archived) => Execute(() => Commands.SetSubroomArchiveAsync(RoomId, id, archived), sceneRelevant: SceneRefreshImpact.ArchiveRestoreDelete);
    private Task ArmSubroomDrawAsync(SubroomDurableBaseline baseline, string initiatorId)
    {
        if (!disposed && modalState is null && !meaningfulPendingDraft && view?.Scene?.HasValidBounds == true && view.Subrooms.ActiveRows.Any(x => x.EntityId == baseline.EntityId))
        { selectedSceneItem = new(V2SceneSelectedItemKind.Subroom, baseline.EntityId); placementRequest = new("subroom", baseline.EntityId, initiatorId); }
        return InvokeAsync(StateHasChanged);
    }
    private bool SceneTableActionsAvailable => !disposed && showMapContext && view?.Scene?.HasValidBounds == true && sceneOwnerGeneration != 0;
    private string SceneTableActionsUnavailableReason => disposed
        ? "Scene annotation actions are unavailable because the scene view is no longer active."
        : !showMapContext
            ? "Scene annotation actions are unavailable because map context is hidden."
            : view?.Scene?.HasValidBounds != true
                ? "Scene annotation actions are unavailable because scene dimensions are unavailable."
                : "Scene annotation actions are unavailable because the scene view is not ready.";
    private V2SceneActionBoxView SceneActionBox
    {
        get
        {
            var unavailable = !SceneTableActionsAvailable;
            var reason = unavailable ? SceneTableActionsUnavailableReason : "Select a scene item first.";
            var armed = placementRequest is not null;
            // The unavailable-dimensions status is the scene contract. Button
            // disablement still explains its own precise admission reason.
            var status = view?.Scene?.HasValidBounds != true ? "scene dimensions unavailable" : sceneActionStatus ?? (armed ? PlacementStatus(placementRequest!) : unavailable ? reason : view?.Scene?.Image?.IsStale == true ? "needs recapture" : "");
            if (selectedSceneItem is not { } selected)
                return new(false, false, false, false, false, reason, reason, reason, reason, reason, false, status);
            var data = SelectedSceneData(selected);
            if (unavailable || data is null)
                return new(false, false, false, false, false, reason, reason, reason, reason, reason, false, status);
            var reset = data.Kind is V2SceneSelectedItemKind.Transition or V2SceneSelectedItemKind.Check && Usable(data.GameX, data.GameY);
            var valid = data.IsValidGeometry;
            var rearm = !armed;
            var clear = valid;
            var visibility = valid;
            var pending = sceneActionPending;
            var immediateActionBlocked = modalState is not null || meaningfulPendingDraft;
            return new(rearm && !pending, reset && !pending && !immediateActionBlocked, clear && !pending && !immediateActionBlocked, visibility && !pending && !immediateActionBlocked, !pending,
                armed ? "placement is already armed" : "re-arm placement", "reset annotation to game position", "clear annotation geometry",
                data.Enabled ? "hide annotation" : "show annotation", armed ? "cancel placement" : "dismiss scene interaction", data.Enabled, status);
        }
    }
    private static string PlacementStatus(SceneAnnotationPlacementRequest request) => request.Kind == "subroom"
        ? "draw subroom rectangle; drag to the opposite corner, or press Escape to cancel"
        : $"place {request.Kind} annotation; click the scene, or press Escape to cancel";
    private sealed record SceneActionData(V2SceneSelectedItemKind Kind, Guid EntityId, bool Enabled, bool IsValidGeometry, double? GameX, double? GameY, object Baseline);
    private SceneActionData? SelectedSceneData(V2SceneSelectedItem selected) => selected.Kind switch
    {
        V2SceneSelectedItemKind.Subroom => view?.Subrooms.ActiveRows.SingleOrDefault(x => x.EntityId == selected.EntityId) is { } row
            ? new(selected.Kind, selected.EntityId, row.EnableAnnotation, row.SceneUnitX is double x && row.SceneUnitY is double y && row.SceneUnitWidth is double w && row.SceneUnitHeight is double h && double.IsFinite(x) && double.IsFinite(y) && double.IsFinite(w) && double.IsFinite(h) && w > 0 && h > 0, null, null, RoomEditorV2CommandService.FromView(row)) : null,
        V2SceneSelectedItemKind.Transition => view?.Transitions.ActiveRows.SingleOrDefault(x => x.EntityId == selected.EntityId) is { } row
            ? new(selected.Kind, selected.EntityId, row.EnableAnnotation, Usable(row.AnnotationSceneUnitX, row.AnnotationSceneUnitY), row.InGamePositionX, row.InGamePositionY, RoomEditorV2CommandService.TransitionFromView(row)) : null,
        V2SceneSelectedItemKind.Check => view?.Checks.ActiveRows.SingleOrDefault(x => x.EntityId == selected.EntityId) is { } row
            ? new(selected.Kind, selected.EntityId, row.EnableAnnotation, Usable(row.AnnotationSceneUnitX, row.AnnotationSceneUnitY), row.InGamePositionX, row.InGamePositionY, RoomEditorV2CommandService.CheckMetadataFromView(row)) : null,
        V2SceneSelectedItemKind.Connection => view?.Connections.ActiveRows.SingleOrDefault(x => x.EntityId == selected.EntityId) is { } row
            ? new(selected.Kind, selected.EntityId, row.CanRemoveAnnotation, row.HasCompleteAnnotationCoordinates, null, null, row.EntityId) : null,
