        ClearModalState(false);
        StateHasChanged();
    }
    public async Task CompleteModalTestFailureAsync()
    {
        if (modalState is not { } state) return;
        QueueModalFocus(state, V2ModalFocusOutcome.Correction);
        ClearModalState(false);
        StateHasChanged();
    }
    private async Task CancelModalAsync()
    {
        if (modalState is not { Stage: V2ModalRuntimeStage.ProposalOpen } state) return;
        if (state.TransitionOperation is V2TransitionInverseEditModalOperation edit)
        {
            var reverted = Commands.RevertInverse(edit.Proposal);
            if (reverted.RetainedDraft is { } draft) transitionTable?.RetainRevertedDraft(edit.Proposal.SourceBaseline, draft);
        }
        if (state.TransitionOperation is V2TransitionInverseCreateModalOperation create)
        {
            var reverted = Commands.RevertCreateInverse(create.Proposal);
            if (reverted.RetainedDraft is { } draft) transitionTable?.RetainRevertedCreateDraft(draft);
        }
        if (state.RoomReferenceRenameProposal is { } rename)
        {
            var reverted = Commands.RevertRoomReferenceRename(rename);
            headerDraft = reverted.RetainedDraft ?? headerDraft;
            headerSaveStatus = new(V2RoomHeaderSaveState.Saved);
        }
        if (state.SubroomReferenceRenameProposal is { } subroomRename)
        {
            var reverted = Commands.RevertSubroomReferenceRename(subroomRename);
            if (reverted.RetainedDraft is { } draft) subroomTable?.RetainSubroomReferenceConflict(subroomRename.SourceBaseline, draft);
        }
        QueueModalFocus(state, V2ModalFocusOutcome.Initiator);
        ClearModalState(false);
        StateHasChanged();
    }
    private void QueueModalFocus(V2ModalRuntimeState state, V2ModalFocusOutcome outcome) => pendingModalFocus = new(state.InitiatorId, state.PendingTargetId, outcome);
    private void QueueTransitionMetadataCorrectionFocus(V2ModalRuntimeState state, Guid transitionId, V2TransitionCommandStatus status)
    {
        // The stable modal initiator remains correction focus for conflicts. A
        // Missing transition has no surviving row/action after its required full
        // refresh, so use the one settled page-level fallback instead of DOM or
        // row-index recovery.
        var rowMissing = view?.Transitions.ActiveRows.Concat(view.Transitions.ArchivedRows).All(x => x.EntityId != transitionId) != false;
        pendingModalFocus = status == V2TransitionCommandStatus.Missing && rowMissing
            ? new(RoomFriendlyNameFocusId, null, V2ModalFocusOutcome.Correction)
            : new(state.InitiatorId, state.PendingTargetId, V2ModalFocusOutcome.Correction);
    }
    private void QueueCheckMetadataCorrectionFocus(V2ModalRuntimeState state, Guid checkId, V2CheckCommandStatus status)
    {
        var rowMissing = view?.Checks.ActiveRows.Concat(view.Checks.ArchivedRows).All(x => x.EntityId != checkId) != false;
        pendingModalFocus = status == V2CheckCommandStatus.Missing && rowMissing
            ? new(RoomFriendlyNameFocusId, null, V2ModalFocusOutcome.Correction)
            : new(state.InitiatorId, state.PendingTargetId, V2ModalFocusOutcome.Correction);
    }
    private void ClearModalState(bool discardPendingFocus = true) { modalState = null; modalFocusRequested = false; if (discardPendingFocus) pendingModalFocus = null; }
