    private async Task<bool> CommitScenePlacementAsync(Guid ownerRoomId, long ownerGeneration, SceneAnnotationPlacementRequest request, double x, double y)
    {
        if (!OwnsCurrentSceneOwner(ownerRoomId, ownerGeneration) || placementRequest != request || !SelectionMatches(request) || refresh?.CurrentRoomId != RoomId) return false;
        await commandGate.WaitAsync();
        try
        {
            if (placementRequest != request || !SelectionMatches(request)) return false;
            if (request.Kind == "exit")
            {
                var row = view?.Transitions.ActiveRows.SingleOrDefault(x => x.EntityId == request.EntityId);
                if (row is null || !AdmitsCurrentSceneCommandAfterGate(ownerRoomId, ownerGeneration, request.Kind, request.EntityId, requiresRenderedTarget: false)) return false;
                var result = await refresh!.CommitTransitionCommandAsync(RoomId, "transition-annotation-placement", () => Commands.PlaceTransitionAnnotationAsync(RoomId, RoomEditorV2CommandService.TransitionFromView(row), x, y), true);
                if (result.Status != V2TransitionCommandStatus.Committed) return false;
            }
            else if (request.Kind == "check")
            {
                var row = view?.Checks.ActiveRows.SingleOrDefault(x => x.EntityId == request.EntityId);
                if (row is null || !AdmitsCurrentSceneCommandAfterGate(ownerRoomId, ownerGeneration, request.Kind, request.EntityId, requiresRenderedTarget: false)) return false;
                var result = await refresh!.CommitCheckCommandAsync(RoomId, "check-annotation-placement", () => Commands.PlaceCheckAnnotationAsync(RoomId, RoomEditorV2CommandService.CheckMetadataFromView(row), x, y), true);
                if (result.Status != V2CheckCommandStatus.Committed) return false;
            }
            else if (request.Kind == "connection")
            {
                var row = view?.Connections.ActiveRows.SingleOrDefault(x => x.EntityId == request.EntityId);
                if (row is null || !AdmitsCurrentSceneCommandAfterGate(ownerRoomId, ownerGeneration, request.Kind, request.EntityId, requiresRenderedTarget: false)) return false;
                var result = await refresh!.CommitConnectionCommandAsync(RoomId, "connection-annotation-placement", () => Commands.PlaceConnectionAnnotationAsync(RoomId, row.EntityId, x, y), true);
                if (result.Status != V2ConnectionCommandStatus.Committed)
                {
                    if (result.Status == V2ConnectionCommandStatus.ExpectedFailure)
                    {
                        placementRequest = null;
                        connectionPlacementOutcome = result.Message ?? "Connection annotation is already enabled.";
                        pendingModalFocus = new(request.InitiatorId, null, V2ModalFocusOutcome.Initiator);
                        await InvokeAsync(StateHasChanged);
                    }
                    return false;
                }
            }
            else return false;
            placementRequest = null; SetRefreshDiagnostic();
            await InvokeAsync(StateHasChanged);
