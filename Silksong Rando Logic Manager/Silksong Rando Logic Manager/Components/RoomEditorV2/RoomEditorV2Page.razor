    {
        if (headerBaseline is null || headerDraft is null) return new(V2RoomHeaderCommandStatus.Missing, "This room is not loaded.");
        if (modalState is not null) return new(V2RoomHeaderCommandStatus.Unchanged, "Close the open dialog first.");
