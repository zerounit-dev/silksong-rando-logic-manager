    private async Task<V2ConnectionCommandOutcome> ExecuteConnectionAsync(string commandName, Func<Task<V2ConnectionCommandOutcome>> command, bool permitsPendingDraft = false, bool sceneRelevant = false)
    {
        await commandGate.WaitAsync();
        try
        {
            if (modalState is not null) return new(V2ConnectionCommandStatus.ExpectedFailure, "Close the open dialog first.");
            if (meaningfulPendingDraft && !permitsPendingDraft) return new(V2ConnectionCommandStatus.ExpectedFailure, "Finish or clear the pending child row first.");
            if (refresh is null || refresh.CurrentRoomId != RoomId) return new(V2ConnectionCommandStatus.Missing, "This room is not loaded.");
            var before = refresh.LastAppliedRefresh?.Sequence;
            var result = await refresh.CommitConnectionCommandAsync(RoomId, commandName, command, sceneRelevant);
            if (result.Status == V2ConnectionCommandStatus.Committed && refresh.LastAppliedRefresh?.Sequence != before) SetRefreshDiagnostic();
