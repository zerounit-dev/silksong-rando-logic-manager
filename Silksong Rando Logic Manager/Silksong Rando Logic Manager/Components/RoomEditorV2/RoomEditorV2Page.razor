                ? new V2RoomHeaderCommandOutcome(V2RoomHeaderCommandStatus.Missing, "This room is not loaded.", null, proposal.SourceCurrent)
                : await CommitRoomReferenceRenameAsync(proposal, updateReferences);
            if (outcome.Status == V2RoomHeaderCommandStatus.Committed)
            {
                if (outcome.MapResolutionChanged && mapLoads is not null)
                    await mapLoads.LoadAsync(RoomId, null, refresh!.RefreshGeneration, OwnsMapLoad);
                SetRefreshDiagnostic(); ResetHeaderDraft(); QueueModalFocus(state, state.PendingTargetId is null ? V2ModalFocusOutcome.Initiator : V2ModalFocusOutcome.PendingTarget);
            }
            else
            {
                // Captured-target conflicts and missing sources require a fresh complete
                // room view before retaining the correction draft; no partial patch applies.
                if (refresh is not null && refresh.CurrentRoomId == RoomId)
                {
                    var before = refresh.LastAppliedRefresh?.Sequence;
                    if (!await refresh.RefreshAsync(RoomId) && refresh.LastAppliedRefresh?.Sequence != before) SetRefreshDiagnostic();
                    if (view is not null) headerBaseline = RoomEditorV2CommandService.HeaderFromView(view.Header);
                }
                headerDraft = outcome.RetainedDraft ?? proposal.SourceCurrent;
                ApplyHeaderOutcome(outcome);
                QueueModalFocus(state, V2ModalFocusOutcome.Correction);
            }
            ClearModalState(false); StateHasChanged();
        }
        finally { commandGate.Release(); }
    }
