    private Task HandleLifecycleContentIntentAsync(RoomLifecycleContentControlsIntent intent) => intent switch
    {
        RoomLifecycleContentControlsIntent.RecheckRoomLogic => RecheckRoomLogicAsync(),
        _ => Task.CompletedTask
    };
    private async Task RecheckRoomLogicAsync()
    {
        if (disposed || recheckingRoomLogic || modalState is not null || meaningfulPendingDraft || refresh?.CurrentRoomId != RoomId || view?.Header.IsArchived != false) return;
        var owner=CaptureCheckOwner();
        var sourceRoomId = RoomId;
        var sourceGeneration = refresh.RefreshGeneration;
        recheckingRoomLogic = true;
        await InvokeAsync(StateHasChanged);
        await commandGate.WaitAsync();
        try
        {
            if (!OwnsRequirementRecheckOperation(sourceRoomId, sourceGeneration) || modalState is not null || meaningfulPendingDraft || view?.Header.IsArchived != false) return;
            try
            {
                var before = refresh.LastAppliedRefresh?.Sequence;
                var completion = await refresh.CommitRequirementRecheckAsync(sourceRoomId, () => RequirementValidation.RecheckRoomAsync(sourceRoomId));
                if (!completion.RefreshApplied || !OwnsRequirementRecheckOperation(sourceRoomId, sourceGeneration + 1))
                {
                    suppressStaleRoomLogicRecheckCompletionRender = true;
                    return;
                }
                if (refresh.LastAppliedRefresh?.Sequence != before) SetRefreshDiagnostic();
            }
            catch (RequirementValidationOperationException)
            {
                if (!OwnsRequirementRecheckOperation(sourceRoomId, sourceGeneration)) { suppressStaleRoomLogicRecheckCompletionRender = true; return; }
            }
            catch (Exception exception)
            {
                if (!OwnsRequirementRecheckOperation(sourceRoomId, sourceGeneration)) { suppressStaleRoomLogicRecheckCompletionRender = true; return; }
                Logger.LogError(exception, "Unexpected current-room requirement recheck failure.");
                Diagnostics.Show(exception.ToString());
            }
            finally
            {
                if (OwnsCheckPage(owner)) recheckingRoomLogic = false;
            }
        }
        finally
        {
            commandGate.Release();
            if(OwnsCheckPage(owner))recheckingRoomLogic=false;
            else suppressStaleRoomLogicRecheckCompletionRender=true;
        }
    }
    private bool OwnsCurrentRequirementRecheckRoom(Guid sourceRoomId) =>
        !disposed && RoomId == sourceRoomId && displayedRoomId == sourceRoomId && refresh?.CurrentRoomId == sourceRoomId;
    private bool OwnsMapLoad(Guid sourceRoomId, long expectedGeneration) =>
