@page "/rooms/{RoomId:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IRoomEditorV2LogicLoader Loader
@inject IRoomEditorV2CommandService Commands
@inject IRequirementValidationService RequirementValidation
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject RequirementCatalogueService Catalogue
@inject IServiceProvider Services
@inject WorkspaceChangeNotifier WorkspaceChanges
@inject ILogger<RoomEditorV2Page> Logger
@inject DiagnosticState Diagnostics
@inject IAreaMapLoader AreaMaps
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
@using Microsoft.JSInterop

@if (view is null)
{
    <p class="text-secondary">Loading room…</p>
}
else
{
    <div @ref="pageRoot" class="room-editor-v2">
        <article class="room-document" aria-label="Room editor">
            <RoomHeaderPresentation View="view.Header" Map="mapView" MapOwnerGeneration="@(mapLoads?.AppliedGeneration ?? 0)" Scene="view.Scene" Placement="placementRequest" SelectedItem="selectedSceneItem" ActionBox="SceneActionBox" ActionRequested="HandleSceneActionAsync" OwnerMounted="SetSceneOwnerAsync" SelectionChanged="SetSceneSelectionAsync" PlacementCommitted="CommitScenePlacementAsync" PlacementCancelled="CancelScenePlacementAsync" MarkerDragCommitted="CommitSceneMarkerDragAsync" SceneNudgeCommitted="CommitSceneNudgeAsync" FrameGeometryCommitted="CommitSubroomGeometryAsync" Capture="RequestSceneImageCaptureAsync" LinkedRoomActivated="NavigateLinkedMapRoomAsync" MapLinksChanged="ReloadAreaMapAfterMapLinkChangeAsync" MapLinkModalStateChanged="SetRoomMapLinkModalStateAsync" Draft="headerDraft" RefreshDiagnostic="refreshDiagnostic" Status="headerSaveStatus" ShowMapContext="showMapContext" MapContextVisibilityResolved="mapContextVisibilityResolved" BackToMap="NavigateBackToMap" ToggleMapContext="ToggleMapContextAsync" ShowArchivedChildren="showArchivedChildren" ToggleArchivedChildren="ToggleArchivedChildren" LifecycleContentIntent="HandleLifecycleContentIntentAsync" RecheckRoomLogicBusy="recheckingRoomLogic" Archive="ArchiveRoomAsync" Restore="RestoreRoomAsync" PermanentDelete="RequestRoomPermanentDeleteAsync" SceneDimensions="RequestSceneDimensionsAsync" CurrentRoomExport="DownloadCurrentRoomExport" ZoneExport="DownloadZoneExport" DraftChanged="SetHeaderDraft" Save="SaveHeader" />
            <div class="room-document-content">
                <RoomCommentsPresentation View="new RoomCommentsView(headerDraft?.Comments ?? view.Header.Comments)" Editable="headerSaveStatus.IsEditable" DraftChanged="SetHeaderComments" Save="SaveHeader" />
                <SubroomTablePresentation @ref="subroomTable" RoomId="RoomId" View="view.Subrooms" ShowArchivedChildren="showArchivedChildren" SceneActionsAvailable="SceneTableActionsAvailable" SceneActionsUnavailableReason="@SceneTableActionsUnavailableReason" Save="SaveSubroom" Create="CreateSubroom" Reorder="ReorderSubroom" SetArchive="SetSubroomArchive" AnnotationRequested="HandleSubroomAnnotationAsync" GeometryRequested="RequestSubroomGeometryAsync" DeleteConfirmationRequested="RequestChildPermanentDeleteAsync" DeleteConfirmationCancelled="CancelChildPermanentDeleteAsync" DeleteConfirmationConfirmed="ConfirmChildPermanentDeleteAsync" FocusRequested="RequestChildFocusAsync" DraftStateChanged="SetPendingDraft" RefreshApplied="ApplyRefreshedState" ClearDragFeedback="ClearSubroomDragFeedbackAsync" />
                <TransitionTablePresentation @ref="transitionTable" RoomId="RoomId" View="view.Transitions" ShowArchivedChildren="showArchivedChildren" SceneActionsAvailable="SceneTableActionsAvailable" SceneActionsUnavailableReason="@SceneTableActionsUnavailableReason" Save="SaveTransitionAsync" Create="CreateTransitionAsync" Reorder="ReorderTransitionAsync" SetArchive="SetTransitionArchiveAsync" PermanentDeleteRequested="RequestTransitionPermanentDeleteAsync" EditInGameDataRequested="RequestTransitionMetadataAsync" InverseStatusActionRequested="RequestTransitionInverseStatusActionAsync" InverseRoomNavigationRequested="RequestApplicationRoomNavigationAsync" AnnotationRequested="HandleTransitionAnnotationAsync" FocusRequested="RequestChildFocusAsync" DraftStateChanged="SetPendingDraft" RefreshApplied="ApplyRefreshedState" ClearDragFeedback="ClearTransitionDragFeedbackAsync" />
                <ConnectionTablePresentation @ref="connectionTable" RoomId="RoomId" View="view.Connections" ShowArchivedChildren="showArchivedChildren" SceneActionsAvailable="SceneTableActionsAvailable" SceneActionsUnavailableReason="@SceneTableActionsUnavailableReason" PlacementOutcome="@connectionPlacementOutcome" Save="SaveConnectionAsync" Create="CreateConnectionAsync" Reorder="ReorderConnectionAsync" SetArchive="SetConnectionArchiveAsync" PermanentDeleteRequested="RequestConnectionPermanentDeleteAsync" Scaffold="ScaffoldInverseConnectionAsync" AnnotationRequested="HandleConnectionAnnotationAsync" FocusRequested="RequestChildFocusAsync" DraftStateChanged="SetPendingDraft" RefreshApplied="ApplyRefreshedState" ClearDragFeedback="ClearConnectionDragFeedbackAsync" />
                <CheckTablePresentation @ref="checkTable" RoomId="RoomId" View="view.Checks" ShowArchivedChildren="showArchivedChildren" SceneActionsAvailable="SceneTableActionsAvailable" SceneActionsUnavailableReason="@SceneTableActionsUnavailableReason" Save="SaveCheck" Create="CreateCheck" Reorder="ReorderCheck" SetArchive="SetCheckArchive" EditInGameDataRequested="RequestCheckMetadataAsync" AnnotationRequested="HandleCheckAnnotationAsync" DeleteConfirmationRequested="RequestChildPermanentDeleteAsync" DeleteConfirmationCancelled="CancelChildPermanentDeleteAsync" DeleteConfirmationConfirmed="ConfirmChildPermanentDeleteAsync" FocusRequested="RequestChildFocusAsync" DraftStateChanged="SetPendingDraft" RefreshApplied="ApplyRefreshedState" ClearDragFeedback="ClearCheckDragFeedbackAsync" />
            </div>
            <RoomReminderFooterPresentation View="new RoomReminderFooterView(ReminderFooterProse)" Intent="HandleReminderFooterIntentAsync" />
        </article>
        <V2PageModalHost Content="modalState?.Content" Stage="modalState?.Stage" FocusRequested="modalFocusRequested" MetadataDraft="modalState?.TransitionMetadataOperation?.Draft" MetadataDraftChanged="SetTransitionMetadataDraft" CheckMetadataDraft="modalState?.CheckMetadataOperation?.Draft" CheckMetadataDraftChanged="SetCheckMetadataDraft" SubroomGeometryDraftChanged="SetSubroomGeometryDraft" SceneDimensionsDraftChanged="SetSceneDimensionsDraft" SceneImageCaptureDraftChanged="SetSceneImageCaptureDraft" SceneImageCaptureReset="ResetSceneImageCaptureEstimateAsync" ManageRequirementCatalogue="NavigateToRequirementCatalogueAsync" Cancel="CancelModalAsync" Apply="ApplyModalAsync" DoNotUpdate="DoNotUpdateModalAsync" />
        <div data-v2-requirements-expanded-host></div>
    </div>
}

@code {
    [Parameter] public Guid RoomId { get; set; }
    private RoomEditorV2RefreshCoordinator? refresh;
    private RoomEditorV2View? view => refresh?.View;
    private RoomAreaMapLoadOwner? mapLoads;
    private AreaMapSurfaceView? mapView => mapLoads?.View;
    private readonly SemaphoreSlim commandGate = new(1, 1);
    private bool meaningfulPendingDraft, showArchivedChildren, disposed, sceneActionPending, recheckingRoomLogic, applicationNavigationActive, suppressStaleSceneDimensionsCompletionRender, suppressStaleSceneImageCaptureCompletionRender, suppressStaleRoomLogicRecheckCompletionRender, childInteractionOwnerInitializing;
    private Guid? roomMapLinkModalOwner;
