    private async Task<V2RoomLifecycleCommandOutcome> ExecuteRoomLifecycleAsync(string commandName, Func<Task<V2RoomLifecycleCommandOutcome>> command)
    {
        var owner=CaptureCheckOwner();
        await commandGate.WaitAsync();
        try
        {
            if(!OwnsCheckPage(owner))return new(V2RoomLifecycleCommandStatus.Missing,"This room is no longer loaded.");
            if (modalState is not null) return new(V2RoomLifecycleCommandStatus.ExpectedFailure, "Close the open dialog first.");
            if (meaningfulPendingDraft) return new(V2RoomLifecycleCommandStatus.ExpectedFailure, "Finish or clear the pending child row first.");
            if (refresh is null || refresh.CurrentRoomId != RoomId) return new(V2RoomLifecycleCommandStatus.Missing, "This room is not loaded.");
            var before = refresh.LastAppliedRefresh?.Sequence;
            owner.Refresh=refresh.RefreshGeneration;
            var result = await refresh.CommitRoomLifecycleCommandAsync(owner.Room, commandName, command, sceneRelevant: SceneRefreshImpact.RoomLifecycle);
            if(!OwnsCheckOwner(owner,result.Status==V2RoomLifecycleCommandStatus.Committed?1:0))return result;
            if (result.Status == V2RoomLifecycleCommandStatus.Committed && refresh.LastAppliedRefresh?.Sequence != before)
            {
                if (view?.Header.IsArchived == true) { mapLoads?.Clear(); await DisposeMapContextHeightOwnerAsync(); }
                else if (mapLoads is not null) await mapLoads.LoadAsync(RoomId, null, refresh.RefreshGeneration, OwnsMapLoad);
                if(!OwnsCheckPage(owner))return result;
                SetRefreshDiagnostic(); ResetHeaderDraft();
            }
            return result;
        }
        finally { commandGate.Release(); }
    }
