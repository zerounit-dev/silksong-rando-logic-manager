    private bool TryNavigateToRoom(Guid sourceRoomId, long sourceGeneration, Guid targetRoomId, long? requiredMapGeneration)
    {
        if (targetRoomId == sourceRoomId) return false;
        if (disposed || applicationNavigationActive || meaningfulPendingDraft || modalState is not null ||
            roomMapLinkModalState != AreaMapPanePresentation.RoomMapLinkModalState.Closed ||
            commandGate.CurrentCount == 0 || sceneActionPending || recheckingRoomLogic ||
            headerSaveStatus.State == V2RoomHeaderSaveState.Saving || targetRoomId == Guid.Empty ||
            displayedRoomId != sourceRoomId || RoomId != sourceRoomId ||
            refresh is null || refresh.IsLoading || refresh.CurrentRoomId != sourceRoomId ||
            refresh.RefreshGeneration != sourceGeneration || refresh.View is null) return false;
        if (requiredMapGeneration is { } mapGeneration &&
            (!showMapContext || refresh.View.Header.IsArchived || mapLoads?.View is null || mapLoads.AppliedGeneration != mapGeneration)) return false;
        applicationNavigationActive = true;
        Navigation.NavigateTo($"/rooms/{targetRoomId}");
