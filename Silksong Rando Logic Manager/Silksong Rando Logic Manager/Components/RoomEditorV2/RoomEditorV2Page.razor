    private async Task CompleteTransitionModalAsync(bool updateInverse)
    {
        if (modalState is not { Stage: V2ModalRuntimeStage.ProposalOpen } state) return;
        var owner=CaptureCheckOwner();
        modalState = state with { Stage = V2ModalRuntimeStage.Committing }; StateHasChanged();
        await commandGate.WaitAsync();
        try
        {
            if(!OwnsCheckPage(owner)||!ReferenceEquals(modalState?.Content,state.Content))return;
            owner.Refresh=refresh!.RefreshGeneration;
            var operation = state.TransitionOperation!;
            V2TransitionCommandOutcome outcome = operation switch
            {
                V2TransitionInverseEditModalOperation edit => updateInverse
                    ? await CommitTransitionModalCommandAsync("transition-inverse-update", () => Commands.ApplyInverseAsync(RoomId, edit.Proposal, true), SceneRefreshImpact.TransitionInverseEditProposal)
                    : await CommitTransitionModalCommandAsync("transition-inverse-do-not-update", () => Commands.ApplyInverseAsync(RoomId, edit.Proposal, false), SceneRefreshImpact.TransitionInverseEditProposal),
                V2TransitionInverseCreateModalOperation create => updateInverse
                    ? await CommitTransitionModalCommandAsync("transition-create-inverse-update", () => Commands.ApplyCreateInverseAsync(RoomId, create.Proposal, true), SceneRefreshImpact.TransitionInverseCreateProposal)
                    : await CommitTransitionModalCommandAsync("transition-create-inverse-do-not-update", () => Commands.ApplyCreateInverseAsync(RoomId, create.Proposal, false), SceneRefreshImpact.TransitionInverseCreateProposal),
                V2TransitionPermanentDeleteModalOperation delete => await CommitTransitionModalCommandAsync("transition-permanent-delete", () => Commands.DeleteTransitionAsync(RoomId, delete.EntityId), SceneRefreshImpact.ArchiveRestoreDelete),
                _ => new(V2TransitionCommandStatus.Unexpected)
            };
            if(!OwnsAppliedChild(owner,outcome.Status==V2TransitionCommandStatus.Committed,outcome.PresentationRefreshed,outcome.RequiresRoomReload))return;
            if(operation is V2TransitionInverseEditModalOperation sourceEdit)await(transitionTable?.CompleteInverseProposal(sourceEdit.Proposal.SourceCurrent,outcome)??Task.CompletedTask);
            else if(operation is V2TransitionInverseCreateModalOperation sourceCreate)await(transitionTable?.CompleteInverseProposal(sourceCreate.Proposal.SourceCurrent,outcome)??Task.CompletedTask);
            if(outcome.RequiresRoomReload)return;
            if (outcome.Status == V2TransitionCommandStatus.Committed) { SetRefreshDiagnostic(); QueueModalFocus(state, state.PendingTargetId is null ? V2ModalFocusOutcome.Initiator : V2ModalFocusOutcome.PendingTarget); }
            else
            {
                // A stale explicit status-action proposal has no source save to retain,
                // but its source/target evidence is no longer a valid room view.
                if (operation is V2TransitionInverseEditModalOperation { Proposal.IsTargetOnlyStatusAction: true } && refresh?.CurrentRoomId == RoomId)
                {
                    var before = refresh.LastAppliedRefresh?.Sequence;
                    if (!await refresh.RefreshAsync(RoomId) && refresh.LastAppliedRefresh?.Sequence != before) SetRefreshDiagnostic();
                    if(!OwnsCheckPage(owner)||!ReferenceEquals(modalState?.Content,state.Content))return;
                }
                QueueModalFocus(state, V2ModalFocusOutcome.Correction);
            }
            ClearModalState(false); StateHasChanged();
        }
        finally { commandGate.Release(); }
    }
