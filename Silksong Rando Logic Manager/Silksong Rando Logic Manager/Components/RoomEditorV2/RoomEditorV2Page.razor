        if(!OwnsCheckPage(owner)||modalState!=state)return;
        QueueModalFocus(state, V2ModalFocusOutcome.Initiator);
        ClearModalState(false);
        StateHasChanged();
    }
    private void QueueModalFocus(V2ModalRuntimeState state, V2ModalFocusOutcome outcome) => pendingModalFocus = new(state.InitiatorId, state.PendingTargetId, outcome);
    private void QueueTransitionMetadataCorrectionFocus(V2ModalRuntimeState state, Guid transitionId, V2TransitionCommandStatus status)
    {
        // The stable modal initiator remains correction focus for conflicts. A
        // Missing transition has no surviving row/action after its required full
        // refresh, so use the one settled page-level fallback instead of DOM or
        // row-index recovery.
        var rowMissing = view?.Transitions.ActiveRows.Concat(view.Transitions.ArchivedRows).All(x => x.EntityId != transitionId) != false;
        pendingModalFocus = status == V2TransitionCommandStatus.Missing && rowMissing
            ? new(RoomFriendlyNameFocusId, null, V2ModalFocusOutcome.Correction)
            : new(state.InitiatorId, state.PendingTargetId, V2ModalFocusOutcome.Correction);
    }
    private void QueueCheckMetadataCorrectionFocus(V2ModalRuntimeState state, Guid checkId, V2CheckCommandStatus status)
    {
        var rowMissing = ActiveCheckRows.Concat(ArchivedCheckRows).All(x => x.EntityId != checkId);
        pendingModalFocus = status == V2CheckCommandStatus.Missing && rowMissing
            ? new(RoomFriendlyNameFocusId, null, V2ModalFocusOutcome.Correction)
            : new(state.InitiatorId, state.PendingTargetId, V2ModalFocusOutcome.Correction);
    }
    private void ClearModalState(bool discardPendingFocus = true) { modalState = null; modalFocusRequested = false; sceneCaptureCorrectionFocusVersion = 0; if (discardPendingFocus) pendingModalFocus = null; }
