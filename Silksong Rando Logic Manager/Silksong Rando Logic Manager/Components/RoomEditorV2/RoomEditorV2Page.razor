    private async Task<bool> CommitScenePlacementAsync(Guid ownerRoomId, long ownerGeneration, SceneAnnotationPlacementRequest request, double x, double y)
    {
        if (!OwnsCurrentSceneOwner(ownerRoomId, ownerGeneration) || placementRequest != request || !SelectionMatches(request) || refresh?.CurrentRoomId != RoomId) return false;
        var intentRevision = sceneIntentRevision;
        var owner=CaptureCheckOwner(scene:true);
        await commandGate.WaitAsync();
        try
        {
            if(!OwnsCheckAdmission(owner))return false;
            owner.Refresh=refresh!.RefreshGeneration;
            if (placementRequest != request || !SelectionMatches(request)) return false;
            if (request.Kind == "exit")
            {
                var row = view?.Transitions.ActiveRows.SingleOrDefault(x => x.EntityId == request.EntityId);
                if (row is null || !AdmitsCurrentSceneCommandAfterGate(ownerRoomId, ownerGeneration, request.Kind, request.EntityId, requiresRenderedTarget: false)) return false;
                var result = await CommitTransitionWithRecoveryAsync(RoomId, "transition-annotation-placement", () => Commands.PlaceTransitionAnnotationAsync(RoomId, RoomEditorV2CommandService.TransitionFromView(row), x, y), true);
                if (result.Status != V2TransitionCommandStatus.Committed||result.RequiresRoomReload||!OwnsAppliedChild(owner,true,result.PresentationRefreshed,result.RequiresRoomReload)) return false;
            }
            else if (request.Kind == "check")
            {
                var row = ActiveCheckRows.SingleOrDefault(x => x.EntityId == request.EntityId);
                if (row is null || !AdmitsCurrentSceneCommandAfterGate(ownerRoomId, ownerGeneration, request.Kind, request.EntityId, requiresRenderedTarget: false)) return false;
                var result = await CommitCheckWithRecoveryAsync(owner.Room, "check-annotation-placement", () => Commands.PlaceCheckAnnotationAsync(owner.Room, RoomEditorV2CommandService.CheckMetadataFromView(row), x, y), true);
                if(result.RequiresRoomReload||!OwnsCheckResult(owner,result))return false;
                if (result.Status != V2CheckCommandStatus.Committed) return false;
            }
            else if (request.Kind == "connection")
            {
                var row = view?.Connections.ActiveRows.SingleOrDefault(x => x.EntityId == request.EntityId);
                if (row is null || !AdmitsCurrentSceneCommandAfterGate(ownerRoomId, ownerGeneration, request.Kind, request.EntityId, requiresRenderedTarget: false)) return false;
                var result = await CommitConnectionWithRecoveryAsync(RoomId, "connection-annotation-placement", () => Commands.PlaceConnectionAnnotationAsync(RoomId, row.EntityId, x, y), true);
                if(result.RequiresRoomReload||!OwnsAppliedChild(owner,result.Status==V2ConnectionCommandStatus.Committed,result.PresentationRefreshed,result.RequiresRoomReload))return false;
                if (result.Status != V2ConnectionCommandStatus.Committed)
                {
                    if (result.Status == V2ConnectionCommandStatus.ExpectedFailure && intentRevision == sceneIntentRevision)
                    {
                        placementRequest = null;
                        connectionPlacementOutcome = result.Message ?? "Connection annotation is already enabled.";
                        pendingModalFocus = new(request.InitiatorId, null, V2ModalFocusOutcome.Initiator);
                        await InvokeAsync(StateHasChanged);
                    }
                    return false;
                }
            }
            else return false;
            if (intentRevision == sceneIntentRevision) placementRequest = null;
            SetRefreshDiagnostic();
            await InvokeAsync(StateHasChanged);
            return true;
        }
        finally { commandGate.Release(); }
    }
