            if (modalState is not null) return new(V2ConnectionCommandStatus.ExpectedFailure, "Close the open dialog first.");
            if (HasOtherPendingDraft(ChildTableKind.Connection) || (meaningfulPendingDraft && !permitsPendingDraft)) return new(V2ConnectionCommandStatus.ExpectedFailure, "Finish or clear the pending child row first.");
            if (refresh is null || refresh.CurrentRoomId != RoomId) return new(V2ConnectionCommandStatus.Missing, "This room is not loaded.");
            var before = refresh.LastAppliedRefresh?.Sequence;
            owner.Refresh=refresh.RefreshGeneration;
            var result = await CommitConnectionWithRecoveryAsync(owner.Room, commandName, command, sceneRelevant);
            if (OwnsAppliedChild(owner,result.Status==V2ConnectionCommandStatus.Committed,result.PresentationRefreshed,result.RequiresRoomReload)&&!result.RequiresRoomReload&&refresh.LastAppliedRefresh?.Sequence != before)
            {
                if (reconcileConnectionOrder && result.Status == V2ConnectionCommandStatus.Committed && result.PresentationRefreshed && result.AnnotationRefreshImpact == V2AnnotationRefreshImpact.CanvasAndViewport)
                    ReconcileSelectedConnectionOrder();
                SetRefreshDiagnostic();
