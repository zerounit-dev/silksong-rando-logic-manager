    private void ReconcileSelectedConnectionOrder()
    {
        if (selectedSceneItem is not { Kind: V2SceneSelectedItemKind.Connection } selected || view?.Connections.ActiveRows is not { } rows) return;
        var previous = rows.SingleOrDefault(row => row.EntityId == selected.EntityId);
        if (previous is null) return;
        var canonical = rows.Where(row => string.Equals(row.Alias.Trim(), previous.Alias.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(row => row.SortOrder).ThenBy(row => row.EntityId).First();
        if (canonical.EntityId == selected.EntityId || (!canonical.CanPlaceAnnotation && !canonical.CanRemoveAnnotation)) return;
        selectedSceneItem = new(V2SceneSelectedItemKind.Connection, canonical.EntityId);
        if (placementRequest is { Kind: "connection" } armed && armed.GroupMarkerEntityId == selected.EntityId &&
            rows.Any(row => row.EntityId == armed.EntityId && string.Equals(row.Alias.Trim(), canonical.Alias.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            placementRequest = armed with { EntityId = canonical.EntityId, GroupMarkerEntityId = canonical.EntityId };
            // Canonical identity reconciliation is not a new explicit arm intent.
            if (ReferenceEquals(reconciledPlacementFocusRequest, armed)) reconciledPlacementFocusRequest = placementRequest;
        }
    }
    private async Task<V2TransitionCommandOutcome> ExecuteTransitionAsync(string commandName, Func<Task<V2TransitionCommandOutcome>> command, string? initiatorId, string? pendingTargetId, bool permitsPendingDraft = false, bool sceneRelevant = false)
    {
        var owner=CaptureCheckOwner();
        // Modal admission is checked before the command gate so a competing
        // durable request is rejected while a completion-bound modal command is
        // held, rather than waiting behind it and running after it closes.
        if (modalState is not null) return new(V2TransitionCommandStatus.ExpectedFailure, "Close the open dialog first.");
        await commandGate.WaitAsync();
        try
        {
            if(!OwnsCheckPage(owner))return new(V2TransitionCommandStatus.Missing,"This room is no longer loaded.");
            if (modalState is not null) return new(V2TransitionCommandStatus.ExpectedFailure, "Close the open dialog first.");
            if (HasOtherPendingDraft(ChildTableKind.Transition) || (meaningfulPendingDraft && !permitsPendingDraft)) return new(V2TransitionCommandStatus.ExpectedFailure, "Finish or clear the pending child row first.");
            if (refresh is null || refresh.CurrentRoomId != RoomId) return new(V2TransitionCommandStatus.Missing, "This room is not loaded.");
            owner.Refresh=refresh.RefreshGeneration;
            var result = await CommitTransitionWithRecoveryAsync(owner.Room, commandName, command, sceneRelevant);
            if(!OwnsAppliedChild(owner,result.Status==V2TransitionCommandStatus.Committed,result.PresentationRefreshed,result.RequiresRoomReload)||result.RequiresRoomReload)return result;
            if (result.Status == V2TransitionCommandStatus.Committed) { SetRefreshDiagnostic(); return result; }
            if (result.Status == V2TransitionCommandStatus.Proposal && initiatorId is not null)
            {
                var operation = result.Proposal is not null ? new V2TransitionInverseEditModalOperation(result.Proposal) as V2TransitionModalOperation : new V2TransitionInverseCreateModalOperation(result.CreateProposal!);
                var proposal = result.Proposal;
                var createProposal = result.CreateProposal;
                var target = proposal?.Target ?? createProposal!.Target;
                modalState = new(new V2InverseSetupProposalView(proposal?.SourceFriendlyName ?? createProposal!.SourceFriendlyName, proposal?.TargetFriendlyName ?? createProposal!.TargetFriendlyName,
                    proposal?.SourceRoomReferenceId ?? createProposal!.SourceRoomReferenceId, proposal?.SourceAlias ?? createProposal!.SourceAlias,
                    target.FillDestinationRoomReferenceText, target.FillDestinationTransitionAliasText), initiatorId, pendingTargetId, V2ModalRuntimeStage.ProposalOpen, operation);
                modalFocusRequested = true; StateHasChanged();
            }
            return result;
        }
        finally { commandGate.Release(); }
    }
