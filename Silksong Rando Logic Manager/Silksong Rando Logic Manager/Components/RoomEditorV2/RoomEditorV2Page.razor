            var armed = placementRequest is not null;
            // The unavailable-dimensions status is the scene contract. Button
            // disablement still explains its own precise admission reason.
            var status = sceneActionStatus ?? view?.Scene?.BoundsImageDiagnostic ?? (armed ? PlacementStatus(placementRequest!) : unavailable ? reason : view?.Scene?.Image?.IsStale == true ? "needs recapture" : "");
            if (selectedSceneItem is not { } selected)
                return new(false, false, false, false, false, reason, reason, reason, reason, reason, false, status, false);
            var data = SelectedSceneData(selected);
            if (unavailable || data is null)
                return new(false, false, false, false, false, reason, reason, reason, reason, reason, false, status, data?.AnnotationMatchesGamePosition == true);
            var reset = data.Kind is V2SceneSelectedItemKind.Transition or V2SceneSelectedItemKind.Check && Usable(data.GameX, data.GameY);
            var valid = data.IsValidGeometry;
            var rearm = !armed;
            var clear = valid;
            var visibility = valid;
            var pending = sceneActionPending;
            var immediateActionBlocked = modalState is not null || meaningfulPendingDraft;
            return new(rearm && !pending, reset && !pending && !immediateActionBlocked, clear && !pending && !immediateActionBlocked, visibility && !pending && !immediateActionBlocked, !pending,
                armed ? "placement is already armed" : "re-arm placement", "reset annotation to game position", "clear annotation geometry",
                data.Enabled ? "hide annotation" : "show annotation", armed ? "cancel placement" : "dismiss scene interaction", data.Enabled, status, data.AnnotationMatchesGamePosition);
        }
