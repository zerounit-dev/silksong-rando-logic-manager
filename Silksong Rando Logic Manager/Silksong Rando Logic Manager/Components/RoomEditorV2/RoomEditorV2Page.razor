    private async Task<TOutcome> CommitChildWithRecoveryAsync<TOutcome>(Guid sourceRoom,Func<Task<TOutcome>> command,Func<TOutcome> missing,Func<TOutcome,TOutcome> safePresentation,Func<TOutcome,string?> unexpectedDetails)
    {
        var owner=CaptureCheckOwner();
        if(sourceRoom!=owner.Room||!OwnsCheckOwner(owner))return missing();
        try
        {
            var result=await command();
            if(OwnsCheckPage(owner)&&unexpectedDetails?.Invoke(result) is { } details)
            {
                Logger.LogError("Unexpected child command failure: {Details}",details);
                Diagnostics.Show(details);
            }
            if(OwnsCheckOwner(owner,refreshDelta:1)&&refresh!.View is null)
            {
                ClearModalState();Navigation.NavigateTo("/",replace:true);
            }
            return safePresentation(result);
        }
        catch(ChildPostCommitRefreshException<TOutcome> exception)
        {
            Logger.LogError(exception,"Committed child command requires complete-room reload.");
            if(OwnsCheckOwner(owner,refreshDelta:1))
            {
                // Reuse the existing modal admission boundary for the specified
                // post-commit editing lock. It cannot cancel into stale views.
                modalState=new(new V2CheckRoomReloadView(),"",null,V2ModalRuntimeStage.Committing);
                modalFocusRequested=true;
                Diagnostics.Show(exception.ToString());
                await InvokeAsync(StateHasChanged);
            }
            return exception.Committed;
        }
    }
