            await InvokeAsync(StateHasChanged);
            if (refresh is null) return ApplyHeaderOutcome(await Commands.PrepareRoomReferenceRenameAsync(RoomId, headerBaseline, headerDraft));
            var before = refresh.LastAppliedRefresh?.Sequence;
            var result = await Commands.PrepareRoomReferenceRenameAsync(RoomId, headerBaseline, headerDraft);
            if (result.Status == V2RoomHeaderCommandStatus.Committed)
                result = await refresh.CommitRoomHeaderCommandAsync(RoomId, "header-save", () => Task.FromResult(result));
            if (result.Status == V2RoomHeaderCommandStatus.Committed && refresh.LastAppliedRefresh?.Sequence != before) { SetRefreshDiagnostic(); ResetHeaderDraft(); }
