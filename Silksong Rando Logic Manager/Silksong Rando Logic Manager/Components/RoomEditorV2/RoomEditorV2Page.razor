    private async Task<V2SubroomCommandOutcome> SaveSubroom(SubroomDurableBaseline b, SubroomDraft d, string initiatorId, string? pendingTargetId)
    {
        if (b.ReferenceId == d.ReferenceId) return await Execute(() => Commands.SaveSubroomAsync(RoomId, b, d), sceneRelevant: SceneRefreshImpact.SubroomSave(b, d));
        var owner=CaptureCheckOwner();
        await commandGate.WaitAsync();
        try
        {
            if(!OwnsCheckPage(owner))return new(V2SubroomCommandStatus.Missing,"This room is no longer loaded.");
            if (modalState is not null) return new(V2SubroomCommandStatus.ExpectedFailure, "Close the open dialog first.");
            if (refresh?.RequiresCheckRoomReload==true) return new(V2SubroomCommandStatus.ExpectedFailure,"Reload room before editing.");
            if (meaningfulPendingDraft) return new(V2SubroomCommandStatus.ExpectedFailure,"Finish or clear the pending child row first.");
            if (refresh is null || refresh.CurrentRoomId != RoomId) return new(V2SubroomCommandStatus.Missing, "This room is not loaded.");
            var result = await Commands.PrepareSubroomReferenceRenameAsync(owner.Room, b, d);
            if(!OwnsCheckPage(owner))return result;
            if(result.Status==V2SubroomCommandStatus.Unexpected)
            {
                Logger.LogError("Unexpected subroom reference preparation: {Details}",result.Message);
                Diagnostics.Show(result.Message??"Unexpected subroom reference preparation failure.");
                return result with{Message="An unexpected error occurred; consult the detailed error modal and server logs."};
            }
            if (result.Status == V2SubroomCommandStatus.Proposal && result.Proposal is { } proposal)
            {
                modalState = new(new V2ReferenceUpdateProposalView("subroom", view?.Subrooms.ActiveRows.FirstOrDefault(x => x.EntityId == b.EntityId)?.FriendlyName ?? "Subroom", proposal.SourceCurrent.ReferenceId), initiatorId, pendingTargetId, V2ModalRuntimeStage.ProposalOpen, SubroomReferenceRenameProposal: proposal);
                modalFocusRequested = true; StateHasChanged();
            }
            return result;
        }
        finally { commandGate.Release(); }
    }
