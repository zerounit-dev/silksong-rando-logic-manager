    private async Task CompleteSceneImageCaptureModalAsync(bool clearBounds = false)
    {
        if (modalState is not { Stage: V2ModalRuntimeStage.ProposalOpen, SceneImageCaptureOperation: { } operation } state) return;
        if (operation.Draft.SourcePreparing) return;
        var owner=CaptureCheckOwner();
        if (!TryParseSceneImageDraft(operation.Draft, out var draft) && !clearBounds)
        {
            var invalid = operation.Draft with { AvailabilitySummary = "Enter finite ordered bounds and positive pixels per unit; the scene image also needs complete finite pixel offsets." };
            modalState = state with { Content = invalid, SceneImageCaptureOperation = operation with { Draft = invalid } }; sceneCaptureCorrectionFocusVersion++; StateHasChanged(); return;
        }
        // Keep the V1-parity capture surface in place while generation runs; its
        // modal-local content renders progress in the established footer slot.
        modalState = state with { Stage = V2ModalRuntimeStage.Committing, Content = operation.Draft }; StateHasChanged(); await commandGate.WaitAsync();
        try
        {
            if(!OwnsCheckPage(owner)||!ReferenceEquals(modalState?.Content,state.Content)||refresh!.RequiresCheckRoomReload||meaningfulPendingDraft)return;
            var sourceRoom = owner.Room; owner.Refresh = refresh!.RefreshGeneration;
            var outcome = await CommitSceneImageWithRecoveryAsync(sourceRoom, clearBounds ? "scene-bounds-clear" : "scene-image-capture", () => clearBounds ? Commands.ClearRoomSceneBoundsAsync(sourceRoom, operation.Draft.Baseline) : Commands.ApplySceneImageCaptureAsync(sourceRoom, draft));
            if (!OwnsAppliedChild(owner, outcome.Status == V2SceneImageCaptureCommandStatus.Committed, outcome.PresentationRefreshed, outcome.RequiresRoomReload))
            {
                // Async event completion otherwise schedules an additional render on
                // the current route after this completion-bound source command.
                suppressStaleSceneImageCaptureCompletionRender = true;
                return;
            }
            if (outcome.RequiresRoomReload || modalState?.Content is V2CheckRoomReloadView) return;
            if (outcome.Status == V2SceneImageCaptureCommandStatus.Committed) { sceneActionStatus = null; SetRefreshDiagnostic(); ResetHeaderDraft(); QueueModalFocus(state, V2ModalFocusOutcome.Initiator); ClearModalState(false); if (outcome.Message is { } diagnostic) Diagnostics.Show(diagnostic); }
            else
            {
                var failed = operation.Draft with { AvailabilitySummary = outcome.Message ?? "Scene image capture failed.", Baseline = outcome.FreshBaseline ?? operation.Draft.Baseline, UpdatedUtc = outcome.FreshBaseline?.UpdatedUtc ?? operation.Draft.UpdatedUtc };
                if (outcome.FreshBaseline is { } fresh && failed.UploadHandle is null)
                {
                    // Rebase retained ownership, not the user's bounds/alignment/mode
                    // corrections. A staged replacement remains owned by this draft.
                    failed = failed with { OriginalHash = fresh.OriginalHash,
                        PreviewUrl = failed.UseUploadedSceneImage ? null : failed.PreviewUrl };
                    if (failed.UseUploadedSceneImage && failed.UseSceneImage)
                    {
                        var source = await Commands.SelectSceneImageSourceAsync(sourceRoom, draft with
                        { Baseline = fresh, UpdatedUtc = fresh.UpdatedUtc, OriginalHash = fresh.OriginalHash }, true, null);
                        if (!OwnsCheckPage(owner) || modalState?.Stage != V2ModalRuntimeStage.Committing) return;
                        if (source.Draft is { } reconciled)
                            failed = failed with { SourcePixelWidth = reconciled.SourcePixelWidth, SourcePixelHeight = reconciled.SourcePixelHeight,
                                PreviewUrl = reconciled.PreviewUrl, AvailabilitySummary = source.Message is { } message ? $"{failed.AvailabilitySummary} {message}" : failed.AvailabilitySummary };
                        else failed = failed with { AvailabilitySummary = source.Message ?? "The retained original is unavailable. Replace it or choose another source." };
                    }
                }
                modalState = state with { Content = failed, Stage = V2ModalRuntimeStage.ProposalOpen, SceneImageCaptureOperation = operation with { Draft = failed } };
                if (!clearBounds) sceneCaptureCorrectionFocusVersion++;
                else QueueModalFocus(state, V2ModalFocusOutcome.Correction);
            }
            StateHasChanged();
        }
        finally { commandGate.Release(); }
    }
    private static V2SceneImageCaptureDialogView CaptureContent(SceneImageCaptureDraft d, string? information, V2SceneImageCapturePreviewView? preview) =>
        RememberSceneImageMapping(new V2SceneImageCaptureDialogView(information ?? "", FormatDimension(d.MinX), FormatDimension(d.MinY), FormatDimension(d.MaxX), FormatDimension(d.MaxY),
            FormatDimension(d.PixelsPerUnitX), FormatDimension(d.PixelsPerUnitY), FormatDimension(d.PixelOffsetX), FormatDimension(d.PixelOffsetY), d.UseSceneImage, d.UpdatedUtc, d.Baseline, true, "Apply", preview)
        { UseUploadedSceneImage = d.UseUploadedSceneImage, OriginalHash = d.OriginalHash, UploadHandle = d.UploadHandle,
            UploadPreparation = d.UploadPreparation, UploadCustomTarget = FormatDimension(d.UploadPreparation?.CustomTarget),
            SourcePixelWidth = d.SourcePixelWidth, SourcePixelHeight = d.SourcePixelHeight, PreviewUrl = d.PreviewUrl }, includeOptedOut: true);
    private static V2SceneImageCaptureDialogView RememberSceneImageMapping(V2SceneImageCaptureDialogView text, bool includeOptedOut = false)
    {
        if (!text.UseSceneImage && !includeOptedOut) return text;
        var mapping = new V2SceneImageMappingText(text.PixelsPerUnitX, text.PixelsPerUnitY, text.PixelOffsetX, text.PixelOffsetY);
        return text.UseUploadedSceneImage ? text with { UploadMapping = mapping } : text with { MapMapping = mapping };
    }
    private static SceneImageCaptureDraft SceneImageSourceDraft(V2SceneImageCaptureDialogView text)
    {
        var saved = text.Baseline;
        return new(saved.MinX, saved.MinY, saved.MaxX, saved.MaxY, saved.PixelsPerUnitX, saved.PixelsPerUnitY,
            saved.PixelOffsetX, saved.PixelOffsetY, text.UseSceneImage, text.UpdatedUtc, saved)
        { UseUploadedSceneImage = text.UseUploadedSceneImage, OriginalHash = text.OriginalHash, UploadHandle = text.UploadHandle,
            UploadPreparation = text.UploadPreparation, SourcePixelWidth = text.SourcePixelWidth, SourcePixelHeight = text.SourcePixelHeight, PreviewUrl = text.PreviewUrl };
    }
    private static bool TryParseSceneImageDraft(V2SceneImageCaptureDialogView text, out SceneImageCaptureDraft draft, bool requireUsable = true)
    {
        bool Parse(string value, out double? number)
        {
            number = null; if (string.IsNullOrWhiteSpace(value)) return true;
            if (!double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var n) || !double.IsFinite(n)) return false;
            number = n; return true;
        }
        var ok = Parse(text.MinX, out var minX); ok &= Parse(text.MinY, out var minY);
        ok &= Parse(text.MaxX, out var maxX); ok &= Parse(text.MaxY, out var maxY);
        ok &= Parse(text.PixelsPerUnitX, out var sx); ok &= Parse(text.PixelsPerUnitY, out var sy);
        ok &= Parse(text.PixelOffsetX, out var px); ok &= Parse(text.PixelOffsetY, out var py);
        draft = new(minX ?? 0, minY ?? 0, maxX, maxY, sx, sy, px, py, text.UseSceneImage, text.UpdatedUtc, text.Baseline)
        { UseUploadedSceneImage = text.UseUploadedSceneImage, OriginalHash = text.OriginalHash, UploadHandle = text.UploadHandle,
            UploadPreparation = text.UploadPreparation, SourcePixelWidth = text.SourcePixelWidth, SourcePixelHeight = text.SourcePixelHeight, PreviewUrl = text.PreviewUrl };
        // None ignores all hidden numeric edits, including malformed/incomplete ones.
        if (!text.UseSceneImage) return true;
        if (text.UseUploadedSceneImage && text.UploadPreparation is { } preparation)
        {
            var customOk = Parse(text.UploadCustomTarget, out var custom);
            draft = draft with { UploadPreparation = preparation with { CustomTarget = custom } };
            if (requireUsable && preparation.Resolution == "custom") ok &= customOk && custom is > 0;
        }
        return ok && minX is not null && minY is not null && (!requireUsable ||
            SceneBounds.TryGetSize(draft.MinX, draft.MinY, maxX, maxY, out _, out _) && SceneBounds.HasUsableScales(sx, sy) && (!text.UseSceneImage || SceneBounds.HasUsablePixelOffsets(px, py)));
    }
