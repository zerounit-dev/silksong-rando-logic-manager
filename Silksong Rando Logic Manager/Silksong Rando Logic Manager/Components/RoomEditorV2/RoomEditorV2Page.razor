    private V2RoomHeaderCommandOutcome ApplyHeaderOutcome(V2RoomHeaderCommandOutcome result)
    {
        if (result.Status == V2RoomHeaderCommandStatus.Conflict && result.FreshBaseline is not null)
        {
            headerBaseline = result.FreshBaseline;
            headerDraft = result.RetainedDraft ?? headerDraft;
            headerSaveStatus = new(V2RoomHeaderSaveState.Conflict, result.Message);
        }
        else if (result.Status == V2RoomHeaderCommandStatus.Missing)
            headerSaveStatus = new(V2RoomHeaderSaveState.Missing, result.Message);
        else if (result.Status == V2RoomHeaderCommandStatus.Unexpected)
            headerSaveStatus = new(V2RoomHeaderSaveState.Failed, result.Message);
        else if (result.Status is V2RoomHeaderCommandStatus.Unchanged or V2RoomHeaderCommandStatus.Proposal)
            headerSaveStatus = new(V2RoomHeaderSaveState.Saved);
