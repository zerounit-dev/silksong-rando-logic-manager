    private async Task CompleteRoomReferenceRenameModalAsync(bool updateReferences)
    {
        if (modalState is not { Stage: V2ModalRuntimeStage.ProposalOpen, RoomReferenceRenameProposal: { } proposal } state) return;
        modalState = state with { Stage = V2ModalRuntimeStage.Committing }; StateHasChanged();
        await commandGate.WaitAsync();
