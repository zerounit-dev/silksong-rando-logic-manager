    private DotNetObjectReference<TransitionTablePresentation>? transitionCallback;
    private DotNetObjectReference<ConnectionTablePresentation>? connectionCallback;
    private DotNetObjectReference<CheckTablePresentation>? checkCallback;
    private SubroomTablePresentation? subroomTable;
    private TransitionTablePresentation? transitionTable;
    private ConnectionTablePresentation? connectionTable;
    private CheckTablePresentation? checkTable;
