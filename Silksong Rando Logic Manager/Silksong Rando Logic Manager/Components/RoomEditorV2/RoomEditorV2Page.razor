            {
                modalState = new(new V2ReferenceUpdateProposalView("room", view?.Header.FriendlyName ?? "Room", proposal.SourceCurrent.ReferenceId), "room-reference-id", null, V2ModalRuntimeStage.ProposalOpen, RoomReferenceRenameProposal: proposal);
