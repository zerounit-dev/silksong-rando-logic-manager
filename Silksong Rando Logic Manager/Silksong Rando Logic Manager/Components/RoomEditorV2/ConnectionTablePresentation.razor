    }
    private Task Annotation(Row row)=>Event(()=>!PageOwned||Boundary(row).HoldsPresentation?Task.CompletedTask:row.Baseline is { } baseline&&row.EntityId is Guid id
        ?AnnotationRequested?.Invoke(baseline,$"v2-connection-{(row.CanRemoveAnnotation?"select":row.HasCompleteAnnotationCoordinates?"show":"place")}-{id}")??Task.CompletedTask:Task.CompletedTask);
    private string AnnotationActionText(bool renderable,bool usable,bool eligible)=>!SceneActionsAvailable?SceneActionsUnavailableReason:renderable?"select annotation":usable?"show and select annotation":eligible?"re-arm placement":"Connection annotation is unavailable because this connection group is ineligible.";
    private static bool Usable(double? x,double? y)=>x is double a&&y is double b&&double.IsFinite(a)&&double.IsFinite(b);
    private Task ArchiveRow(Row row,bool value)=>Event(async()=>
    {
        if(!PageOwned||Boundary(row).HoldsPresentation||row.EntityId is not Guid id)return;
        var source=RoomId;var generation=routeGeneration;var result=await(SetArchive?.Invoke(id,value)??Unavailable("Archive"));
        if(!Owns(source,generation)||result.Status==V2ConnectionCommandStatus.Committed&&(!result.PresentationRefreshed||result.RequiresRoomReload))return;
        message=result.Message;if(result.Status==V2ConnectionCommandStatus.Committed)await(RefreshApplied?.Invoke()??Task.CompletedTask);
    });
    private Task DeleteRow(Row row)=>Event(()=>!PageOwned||Boundary(row).HoldsPresentation?Task.CompletedTask:row.EntityId is Guid id
        ?PermanentDeleteRequested?.Invoke(id,$"v2-connection-delete-{id}")??Task.CompletedTask:Task.CompletedTask);
    private Task ScaffoldRow(Row row)=>Event(async()=>
    {
        if(!PageOwned||Boundary(row).HoldsPresentation||row.EntityId is not Guid id)return;
        var source=RoomId;var generation=routeGeneration;
        var result=await(Scaffold?.Invoke(id,ChildTableInteractionPrimitives.FieldId(row.ClientDraftId,"requirements"))??Unavailable("Scaffold inverse connection"));
        if(Owns(source,generation)&&(!result.RequiresRoomReload)&&(result.Status!=V2ConnectionCommandStatus.Committed||result.PresentationRefreshed))message=result.Message;
