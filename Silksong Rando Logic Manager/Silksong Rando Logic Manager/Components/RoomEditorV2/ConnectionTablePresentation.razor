     private Task Annotation(Row r)=>r.Baseline is not null&&r.EntityId is Guid id?(AnnotationRequested?.Invoke(r.Baseline,$"v2-connection-{(r.CanRemoveAnnotation?"select":Usable(r.Draft.SceneUnitX,r.Draft.SceneUnitY)?"show":"place")}-{id}")??Task.CompletedTask):Task.CompletedTask; private string AnnotationActionText(bool renderable,bool usable,bool eligible)=>!SceneActionsAvailable?SceneActionsUnavailableReason:renderable?"select annotation":usable?"show and select annotation":eligible?"re-arm placement":"Connection annotation is unavailable because this connection group is ineligible."; private static bool Usable(double? x,double? y)=>x is double a&&y is double b&&double.IsFinite(a)&&double.IsFinite(b); private async Task ArchiveRow(Row r,bool value){if(r.EntityId is not Guid id)return;var result=await(SetArchive?.Invoke(id,value)??Unavailable("Archive"));message=result.Message;if(result.Status==V2ConnectionCommandStatus.Committed)await(RefreshApplied?.Invoke()??Task.CompletedTask);} private async Task DeleteRow(Row r){if(r.EntityId is Guid id)await(PermanentDeleteRequested?.Invoke(id,$"v2-connection-delete-{id}")??Task.CompletedTask);} private async Task ScaffoldRow(Row r){if(r.EntityId is not Guid id)return;var result=await(Scaffold?.Invoke(id,ChildTableInteractionPrimitives.FieldId(r.ClientDraftId,"requirements"))??Unavailable("Scaffold inverse connection"));message=result.Message;}
  public string FieldIdFor(Guid entityId,string field)=>ChildTableInteractionPrimitives.FieldId(ClientId(entityId),field); private Guid ClientId(Guid entityId)=>clientIds.TryGetValue(entityId,out var id)?id:clientIds[entityId]=Guid.NewGuid(); private ChildTableFocusTarget? Target(Row r,string f,string d){var rows=r.IsArchived?archived:active;return ChildTableInteractionPrimitives.Target(fields,r.ClientDraftId,rows.IndexOf(r),rows.Count,r.IsArchived,r.EntityId is null,interaction.LatentSuccessorId,f,d,n=>rows[n].ClientDraftId);} private static string Verify(bool? x)=>x==true?"true":x==false?"false":""; private static string? RowClass(Row r)=>r.State==ChildTableRowLifecycle.Saving?"child-row-saving":r.State==ChildTableRowLifecycle.Failed?"child-row-failed":r.EntityId is null?"uncommitted-row":null; private static V2Severity Max(V2Severity a,V2Severity b)=>(V2Severity)Math.Max((int)a,(int)b); private static V2Severity AppliedRequirementsSeverity(Row r)=>r.Baseline is { } b&&r.Draft.Requirements!=b.Requirements?(string.IsNullOrWhiteSpace(r.Draft.Requirements)||r.Draft.IsTodo?V2Severity.Warning:V2Severity.Neutral):r.RequirementsSeverity; private static string? Severity(Row r,V2Severity s,string f)=>r.IsArchived?null:s switch{V2Severity.Warning=>"warning",V2Severity.Danger=>"danger",_ when f=="requirements"&&r.Draft.IsTodo=>"warning",_=>null}; private static string PathwayIcon(string s)=>s switch{"one-way"=>"fa-solid fa-arrow-right connection-state-one-way","bidirectional"=>"fa-solid fa-arrow-right-arrow-left","ambiguous"=>"fa-solid fa-circle-exclamation",_=>"fa-solid fa-triangle-exclamation"}; private static bool Meaningful(Row r)=>!string.IsNullOrEmpty(r.Draft.Alias)||!string.IsNullOrEmpty(r.Draft.FriendlyName)||!string.IsNullOrEmpty(r.Draft.SourceSubroomReferenceText)||!string.IsNullOrEmpty(r.Draft.DestinationSubroomReferenceText)||!string.IsNullOrEmpty(r.Draft.Requirements)||!string.IsNullOrEmpty(r.Draft.Notes)||r.Draft.IsTodo||r.Draft.IsVerified is not null; private static bool Changed(Row r)=>r.Baseline is { } b&&(r.Draft.Alias!=b.Alias||r.Draft.FriendlyName!=b.FriendlyName||r.Draft.SourceSubroomReferenceText!=b.SourceSubroomReferenceText||r.Draft.DestinationSubroomReferenceText!=b.DestinationSubroomReferenceText||r.Draft.Requirements!=b.Requirements||r.Draft.Notes!=b.Notes||r.Draft.IsTodo!=b.IsTodo||r.Draft.IsVerified!=b.IsVerified); private Task Notify()=>DraftStateChanged?.Invoke(active.Any(x=>x.EntityId is null&&Meaningful(x)))??Task.CompletedTask; private static Task<V2ConnectionCommandOutcome> Unavailable(string x)=>Task.FromResult(new V2ConnectionCommandOutcome(V2ConnectionCommandStatus.ExpectedFailure,$"{x} is unavailable."));
