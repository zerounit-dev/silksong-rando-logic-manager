    [JSInvokable] public Task<bool> BlurConnectionAsync(string client, string field, string? tab, string? value=null)
    {
        if (!Guid.TryParse(client, out var id) || !ChildTableBrowserFacts.TryField(field, out var typedField) || !ChildTableDraftAdapters.IsText(typedField) || !fields.Contains(field)) return Task.FromResult(true);
