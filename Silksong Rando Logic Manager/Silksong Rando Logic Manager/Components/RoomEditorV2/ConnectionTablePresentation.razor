    }
    private async Task<bool> TextBlur(Row r, ChildTableField field, string? tab, string? value)
    {
        if(disposed||!PageOwned)return false;InstallTextValue(r, field, value);
        if (r.State == ChildTableRowLifecycle.Failed) return false;
        if (Boundary(r).RequiresReload)return false;
        if (!Boundary(r).InFlight&&((r.EntityId is null&&!Meaningful(r)) || (r.EntityId is not null&&!Changed(r)))) {await Notify();return true;}
