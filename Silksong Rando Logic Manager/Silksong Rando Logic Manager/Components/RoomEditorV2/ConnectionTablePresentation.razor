    private RenderFragment Cells(Row r) => @<text>
        <td class="connection-state @Severity(r, Max(r.PathwaySeverity, r.NoSubroomSeverity), "state")">
            @if (!r.IsArchived && r.EntityId is not null) { <i class="@PathwayIcon(r.PathwayState)" role="img" aria-label="@r.PathwayState"></i> }
        </td>
        <td class="@Severity(r, r.AliasSeverity, "alias")"><input @attributes='FieldAttributes(r, ChildTableField.Alias, "Connection alias")' class="alias-editor" autocomplete="off" value="@r.Draft.Alias" readonly="@r.IsArchived" /></td>
        <td class="@Severity(r, r.NameSeverity, "name")"><input @attributes='FieldAttributes(r, ChildTableField.Name, "Connection friendly name")' class="text-editor focus-muted" autocomplete="off" value="@r.Draft.FriendlyName" readonly="@r.IsArchived" /></td>
        <td class="@Severity(r, r.SourceSeverity, "source")"><input @attributes='FieldAttributes(r, ChildTableField.Source, "Connection source subroom reference")' class="text-editor" list="v2-connection-subroom-references" value="@r.Draft.SourceSubroomReferenceText" readonly="@r.IsArchived" /></td>
        <td class="@Severity(r, r.DestinationSeverity, "destination")"><input @attributes='FieldAttributes(r, ChildTableField.Destination, "Connection destination subroom reference")' class="text-editor" list="v2-connection-subroom-references" value="@r.Draft.DestinationSubroomReferenceText" readonly="@r.IsArchived" /></td>
