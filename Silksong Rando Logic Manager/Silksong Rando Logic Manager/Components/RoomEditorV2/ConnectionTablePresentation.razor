    protected override async Task OnAfterRenderAsync(bool first){if(disposed)return;if(clear){clear=false;await(ClearDragFeedback?.Invoke()??Task.CompletedTask);}if(!boundaries.Values.Any(owner=>owner.HoldsPresentation)&&interaction.TakePendingFocus() is { } target)await(FocusRequested?.Invoke(RoomId,target.ElementId)??Task.CompletedTask);}
