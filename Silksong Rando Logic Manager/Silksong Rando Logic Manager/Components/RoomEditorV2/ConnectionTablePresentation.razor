    }
    [JSInvokable] public Task<bool> NavigateConnectionAsync(string client, string field, string direction, string? value=null)
    {
        if (!Guid.TryParse(client, out var id) || !ChildTableBrowserFacts.TryField(field, out var typedField) || !fields.Contains(field) || !ChildTableBrowserFacts.TryDirection(direction, out var typedDirection)) return Task.FromResult(false);
        var row = active.Concat(archived).SingleOrDefault(x => x.ClientDraftId == id);
        return row is null ? Task.FromResult(false) : Navigate(row, typedField, typedDirection, value);
    }
    private async Task<bool> Navigate(Row r, ChildTableField field, ChildTableDirection direction, string? value)
    {
        if(disposed||!PageOwned)return false;InstallTextValue(r, field, value);if(Boundary(r).RequiresReload)return false;
