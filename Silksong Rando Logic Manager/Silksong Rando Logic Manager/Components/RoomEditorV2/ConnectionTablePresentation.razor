  private async Task Toggle(Row r,ChangeEventArgs e){r.Draft=r.Draft with{IsTodo=e.Value is bool x&&x};r.Interaction.BeginRetryFromEdit();await Commit(r,"todo",null);} private async Task Select(Row r,ChangeEventArgs e){r.Draft=r.Draft with{IsVerified=e.Value?.ToString() switch{"true"=>true,"false"=>false,_=>null}};r.Interaction.BeginRetryFromEdit();await Commit(r,"verification",null);}
  private async Task Commit(Row r,string correction,string? pending){if(!Meaningful(r)||(r.EntityId is not null&&!Changed(r))||!r.Interaction.BeginSave())return;try{var result=r.Baseline is null?await(Create?.Invoke(r.Draft,ChildTableInteractionPrimitives.FieldId(r.ClientDraftId,correction),pending)??Unavailable("Creation")):await(Save?.Invoke(r.Baseline,r.Draft,ChildTableInteractionPrimitives.FieldId(r.ClientDraftId,correction),pending)??Unavailable("Saving"));message=result.Message;if(result.Status==V2ConnectionCommandStatus.Committed){r.Interaction.CompleteCommitted(result.CreatedEntityId);await(RefreshApplied?.Invoke()??Task.CompletedTask);}else if(result.Status==V2ConnectionCommandStatus.Unchanged)r.Interaction.CompleteUnchanged();else Fail(r,correction,result.Message,result.FreshBaseline);}catch{Fail(r,correction,"Save failed; edit a field to try again.",null);}await Notify();}
  private void Fail(Row r,string correction,string? failure,ConnectionDurableBaseline? freshBaseline){r.Interaction.Fail(failure??"Save failed; edit a field to try again.",freshBaseline);if(correction=="requirements"){interaction.TakePendingFocus();interaction.SetPendingFocus(new(r.ClientDraftId,"requirements"));}}
  [JSInvokable] public async Task<bool> NavigateConnectionAsync(string client,string field,string direction,string? value=null){if(!Guid.TryParse(client,out var id)||!fields.Contains(field))return false;var r=active.Concat(archived).SingleOrDefault(x=>x.ClientDraftId==id);if(r is null)return false;await InstallTextValue(r,field,value);var t=Target(r,field,direction);if(t is null)return false;if(r.State==ChildTableRowLifecycle.Saving)return true;interaction.SetPendingFocus(t);if(r.EntityId is null&&Meaningful(r)){if(t.Value.ClientRowId==interaction.LatentSuccessorId)interaction.PromoteTail(t.Value.ClientRowId!.Value);await Commit(r,field,t.Value.ElementId);}else if(r.EntityId is not null&&Changed(r))await Commit(r,field,t.Value.ElementId);else await InvokeAsync(StateHasChanged);return true;}
  [JSInvokable] public async Task<bool> BlurConnectionAsync(string client,string field,string? tab,string? value=null){if(!Guid.TryParse(client,out var id)||!fields.Contains(field))return true;var r=active.Concat(archived).SingleOrDefault(x=>x.ClientDraftId==id);if(r is null)return true;await InstallTextValue(r,field,value);if(!Meaningful(r)||(r.EntityId is not null&&!Changed(r)))return true;if(tab is not null)interaction.SetPendingFocus(ChildTableFocusTarget.Element(tab));await Commit(r,field,tab);return r.State!=ChildTableRowLifecycle.Failed;}
  private async Task InstallTextValue(Row r,string field,string? value){if(value is null)return;var edited=field switch{"alias"=>r.Draft.Alias!=value,"name"=>r.Draft.FriendlyName!=value,"source"=>r.Draft.SourceSubroomReferenceText!=value,"destination"=>r.Draft.DestinationSubroomReferenceText!=value,"requirements"=>r.Draft.Requirements!=value,"notes"=>r.Draft.Notes!=value,_=>false};if(edited){r.Draft=field switch{"alias"=>r.Draft with{Alias=value},"name"=>r.Draft with{FriendlyName=value},"source"=>r.Draft with{SourceSubroomReferenceText=value},"destination"=>r.Draft with{DestinationSubroomReferenceText=value},"requirements"=>r.Draft with{Requirements=value},"notes"=>r.Draft with{Notes=value},_=>r.Draft};r.Interaction.BeginRetryFromEdit();}await Notify();}
 [JSInvokable] public async Task ControlConnectionAsync(string client,string field,string? value){if(!Guid.TryParse(client,out var id))return;var r=active.Concat(archived).SingleOrDefault(x=>x.ClientDraftId==id);if(r is null)return;if(field=="todo")r.Draft=r.Draft with{IsTodo=string.Equals(value,"true",StringComparison.OrdinalIgnoreCase)};else if(field=="verification")r.Draft=r.Draft with{IsVerified=value switch{"true"=>true,"false"=>false,_=>null}};else return;r.Interaction.BeginRetryFromEdit();await Commit(r,field,null);}
