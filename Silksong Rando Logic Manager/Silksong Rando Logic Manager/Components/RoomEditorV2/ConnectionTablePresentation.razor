                    <button type="button" title="scaffold inverse connection" aria-label="scaffold inverse connection" disabled="@(r.State != ChildTableRowLifecycle.Persisted)" @onclick="() => ScaffoldRow(r)"><i class="fa-solid fa-arrow-right-arrow-left"></i></button>
                }
