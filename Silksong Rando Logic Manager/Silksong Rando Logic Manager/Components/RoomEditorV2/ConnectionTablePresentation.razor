  private RenderFragment Grip(Row r)=>b=>{if(!r.IsArchived&&r.EntityId is Guid&&r.State==ChildTableRowLifecycle.Persisted){b.OpenElement(0,"button");b.AddAttribute(1,"class","reorder-handle");b.AddAttribute(2,"type","button");b.AddAttribute(3,"draggable","true");b.AddAttribute(4,"data-v2-connection-grip","true");b.AddAttribute(5,"title","Reorder connection");b.AddAttribute(6,"aria-label",$"Reorder connection: {r.Draft.FriendlyName}");b.AddMarkupContent(7,"<i class=\"fa-solid fa-grip-vertical\" aria-hidden=\"true\"></i>");b.CloseElement();}else if(!r.IsArchived&&r.State==ChildTableRowLifecycle.Saving)b.AddMarkupContent(0,"<i class=\"fa-solid fa-spinner fa-spin\" role=\"img\" aria-label=\"Saving connection\"></i>");else if(!r.IsArchived&&r.State==ChildTableRowLifecycle.Failed)b.AddMarkupContent(0,"<i class=\"fa-solid fa-circle-xmark danger\" role=\"img\" aria-label=\"Save failed; edit a field to try again.\"></i>");};
  private RenderFragment ActiveActions(Row r) => b =>
