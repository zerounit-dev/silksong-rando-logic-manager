                    <textarea @attributes='FieldAttributes(r, ChildTableField.Requirements, "Connection requirements")' class="detail-editor requirements-editor" data-v2-requirements-editor="" data-v2-requirements-room="@RoomId" rows="1" value="@r.Draft.Requirements"></textarea>
                </div>
            }
        </td>
        <td><textarea @attributes='FieldAttributes(r, ChildTableField.Notes, "Connection notes")' class="detail-editor" autocomplete="off" rows="1" value="@r.Draft.Notes" readonly="@r.IsArchived"></textarea></td>
        <td class="checkbox-cell @(!r.IsArchived && r.Draft.IsTodo ? "todo" : null)"><input @attributes='FieldAttributes(r, ChildTableField.Todo, "Connection is TODO")' type="checkbox" checked="@r.Draft.IsTodo" disabled="@r.IsArchived" @onchange="e => Toggle(r, e)" /></td>
