            <select @attributes='FieldAttributes(r, ChildTableField.Verification, "Connection verification")' value="@Verify(r.Draft.IsVerified)" disabled="@r.IsArchived" @onchange="e => Select(r, e)">
                <option value="false">not verified</option><option value="">unknown</option><option value="true">verified</option>
            </select>
        </td>
    </text>;
    private Dictionary<string, object> FieldAttributes(Row row, ChildTableField field, string label) =>
        ChildTableBrowserFacts.FieldAttributes("connection", row.ClientDraftId, field, label, Changed(row), interaction.LatentSuccessorId,
            direction => Target(row, field.Wire(), direction.Wire()));
    private RenderFragment Grip(Row r) => @<text>
        @if (!r.IsArchived && r.EntityId is Guid && r.State == ChildTableRowLifecycle.Persisted && !Boundary(r).HoldsPresentation)
        {
            <button class="reorder-handle" type="button" draggable="true" data-v2-connection-grip="true" title="Reorder connection" aria-label="@($"Reorder connection: {r.Draft.FriendlyName}")"><i class="fa-solid fa-grip-vertical" aria-hidden="true"></i></button>
        }
