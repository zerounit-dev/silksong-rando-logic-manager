  private RenderFragment Cells(Row r)=>b=>{var i=0;b.OpenElement(i++,"td");b.AddAttribute(i++,"class",$"connection-state {Severity(r,Max(r.PathwaySeverity,r.NoSubroomSeverity),"state")}");if(!r.IsArchived&&r.EntityId is not null){b.OpenElement(i++,"i");b.AddAttribute(i++,"class",PathwayIcon(r.PathwayState));b.AddAttribute(i++,"role","img");b.AddAttribute(i++,"aria-label",r.PathwayState);b.CloseElement();}b.CloseElement();Text(b,ref i,r,"alias","Connection alias",r.Draft.Alias,false,"alias-editor",r.AliasSeverity,null);Text(b,ref i,r,"name","Connection friendly name",r.Draft.FriendlyName,false,"text-editor",r.NameSeverity,null);Text(b,ref i,r,"source","Connection source subroom reference",r.Draft.SourceSubroomReferenceText,false,"text-editor",r.SourceSeverity,"v2-connection-subroom-references");Text(b,ref i,r,"destination","Connection destination subroom reference",r.Draft.DestinationSubroomReferenceText,false,"text-editor",r.DestinationSeverity,"v2-connection-subroom-references");Text(b,ref i,r,"requirements","Connection requirements",r.Draft.Requirements,true,"detail-editor",r.Draft.IsTodo&&r.RequirementsSeverity==V2Severity.Neutral?V2Severity.Warning:r.RequirementsSeverity,null);Text(b,ref i,r,"notes","Connection notes",r.Draft.Notes,true,"detail-editor",V2Severity.Neutral,null);Toggle(b,ref i,r,"todo","Connection is TODO",r.Draft.IsTodo);b.OpenElement(i++,"td");b.AddAttribute(i++,"class",$"verification-cell {(r.EntityId is null?null:r.Draft.IsVerified==true?"verification-success":r.Draft.IsVerified==false?"verification-danger":"verification-warning")}");b.OpenElement(i++,"select");Attrs(b,ref i,r,"verification","Connection verification");b.AddAttribute(i++,"value",Verify(r.Draft.IsVerified));b.AddAttribute(i++,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>Select(r,e)));foreach(var x in new[]{("false","not verified"),("","unknown"),("true","verified")}){b.OpenElement(i++,"option");b.AddAttribute(i++,"value",x.Item1);b.AddContent(i++,x.Item2);b.C