@using Microsoft.JSInterop
@implements IDisposable
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<section class="document-section connection-table-presentation"><h2>subroom connections</h2>
<table class="logic-table connection-table" data-v2-connection-table="active" data-v2-child-count="@active.Count(x=>x.EntityId is not null)"><colgroup><col class="reorder-column"/><col class="connection-state-column"/><col class="connection-alias-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="checkbox-column"/><col class="verification-column"/><col class="actions-column"/></colgroup><thead><tr><th></th><th>state</th><th>alias</th><th>name</th><th>source</th><th>destination</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th></th></tr></thead><tbody>@for(var n=0;n<active.Count;n++){var r=active[n];if(r.EntityId is not null||View.CanRenderUncommittedTail){<tr @key="r.ClientDraftId" data-v2-row-annotation-kind="connection" data-v2-row-annotation-id="@(r.EntityId is null ? null : r.AnnotationMarkerEntityId)" class="@RowClass(r)" data-v2-connection-row="@r.EntityId" data-v2-child-index="@(r.EntityId is null?null:active.Take(n).Count(x=>x.EntityId is not null))" data-v2-connection-tail="@(r.EntityId is null?"true":null)"><td class="reorder-cell">@Grip(r)</td>@Cells(r)<td class="row-actions">@ActiveActions(r)</td></tr>}}</tbody></table>
<datalist id="v2-connection-subroom-references">@foreach(var x in View.SubroomReferenceSuggestions){<option value="@x"/>}</datalist>
@if(ShowArchivedChildren&&View.ArchivedRows.Count>0){<div class="archived-table-label">[archived]</div><table class="logic-table connection-table" data-v2-connection-table="archived" data-v2-child-count="@archived.Count"><colgroup><col class="reorder-column"/><col class="connection-state-column"/><col class="connection-alias-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="checkbox-column"/><col class="verification-column"/><col class="actions-column"/></colgroup><thead><tr><th></th><th>state</th><th>alias</th><th>name</th><th>source</th><th>destination</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th></th></tr></thead><tbody>@for(var n=0;n<archived.Count;n++){var r=archived[n];<tr @key="r.ClientDraftId" data-v2-connection-row="@r.EntityId" data-v2-child-index="@n"><td class="reorder-cell"></td>@Cells(r)<td class="row-actions"><span class="action-slot"></span><span class="action-slot"><button type="button" title="restore" aria-label="restore" @onclick="()=>ArchiveRow(r,false)"><i class="fa-solid fa-rotate-left"/></button></span><span class="action-slot"><button id="v2-connection-delete-@r.EntityId" type="button" title="delete permanently" aria-label="delete permanently" @onclick="()=>DeleteRow(r)"><i class="fa-solid fa-trash"/></button></span></td></tr>}</tbody></table>}
 @if((message ?? PlacementOutcome) is not null){<p class="warning" role="status">@(message ?? PlacementOutcome)</p>}
</section>
@code {
    [Parameter,EditorRequired] public long OwnerGeneration {get;set;}
    [Parameter,EditorRequired] public Func<bool> OwnerIsCurrent {get;set;}=null!;
    private long renderedOwnerGeneration=-1;
    private bool PageOwned=>!disposed&&OwnerIsCurrent?.Invoke()==true;
 [Parameter,EditorRequired] public ConnectionTableView View {get;set;}=null!; [Parameter] public Guid RoomId {get;set;} [Parameter] public bool ShowArchivedChildren {get;set;} [Parameter] public bool SceneActionsAvailable {get;set;} [Parameter] public string SceneActionsUnavailableReason {get;set;}="Scene annotation actions are unavailable."; [Parameter] public string? PlacementOutcome {get;set;} [Parameter] public Func<Guid,string,Task>? FocusRequested {get;set;} [Parameter] public Func<ConnectionDurableBaseline,ConnectionDraft,string,string?,Task<V2ConnectionCommandOutcome>>? Save {get;set;} [Parameter] public Func<ConnectionDraft,string,string?,Task<V2ConnectionCommandOutcome>>? Create {get;set;} [Parameter] public Func<Guid,int,Task<V2ConnectionCommandOutcome>>? Reorder {get;set;} [Parameter] public Func<Guid,bool,Task<V2ConnectionCommandOutcome>>? SetArchive {get;set;} [Parameter] public Func<Guid,string,Task<V2ConnectionCommandOutcome>>? PermanentDeleteRequested {get;set;} [Parameter] public Func<Guid,string,Task<V2ConnectionCommandOutcome>>? Scaffold {get;set;} [Parameter] public Func<ConnectionDurableBaseline,string,Task>? AnnotationRequested {get;set;} [Parameter] public Func<bool,Task>? DraftStateChanged {get;set;} [Parameter] public Func<Task>? RefreshApplied {get;set;} [Parameter] public Func<Task>? ClearDragFeedback {get;set;}
 private static readonly string[] fields=["alias","name","source","destination","requirements","notes"]; private readonly List<Row> active=[]; private readonly List<Row> archived=[]; private readonly Dictionary<Guid,Guid> clientIds=[]; private readonly ChildTableInteractionController interaction=new(); private Guid? room; private string? message; private bool clear;
    private bool disposed; private long routeGeneration;
    private ConnectionTableView? pendingView, appliedView;
    private readonly Dictionary<Row, ChildTableBoundaryOwnership<ConnectionDurableBaseline, ConnectionDraft>> boundaries=[];
    private ChildTableBoundaryOwnership<ConnectionDurableBaseline, ConnectionDraft> Boundary(Row row)=>boundaries.TryGetValue(row,out var owner)?owner:boundaries[row]=new(row.Interaction,ChildTableDraftAdapters.ConnectionBoundaries);
    private bool Owns(Guid source,long generation)=>!disposed&&PageOwned&&RoomId==source&&routeGeneration==generation;
    private readonly ChildTableEventCompletionGuard eventCompletion=new();
    private Task Event(Func<Task> action){var source=RoomId;var generation=routeGeneration;return eventCompletion.RunAsync(action,()=>Owns(source,generation));}
    protected override bool ShouldRender()=>eventCompletion.ShouldRender(!disposed&&PageOwned);
    private void Reset(){routeGeneration++;foreach(var owner in boundaries.Values)owner.Reset();boundaries.Clear();interaction.ResetForRoute(active.Concat(archived));active.Clear();archived.Clear();clientIds.Clear();pendingView=appliedView=null;}
    public void Dispose(){disposed=true;Reset();}
    protected override void OnParametersSet(){if((room is Guid old&&old!=RoomId)||(renderedOwnerGeneration>=0&&renderedOwnerGeneration!=OwnerGeneration)){Reset();clear=true;}room=RoomId;renderedOwnerGeneration=OwnerGeneration;ApplyFreshView(RoomId,View);}
    public void ApplyFreshView(Guid source,ConnectionTableView fresh){if(disposed||source!=RoomId)return;pendingView=fresh;Reconcile();}
    private void Reconcile()
    {
        if(disposed||pendingView is not { } fresh||ReferenceEquals(appliedView,fresh)||boundaries.Values.Any(owner=>owner.HoldsPresentation))return;
