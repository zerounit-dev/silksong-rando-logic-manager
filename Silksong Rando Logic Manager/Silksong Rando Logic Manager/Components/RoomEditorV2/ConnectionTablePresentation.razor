        }
    </text>;
    private RenderFragment ActiveActions(Row r) => @<text>
        @if (r.EntityId is Guid id)
        {
            var renderable = r.CanRemoveAnnotation;
            var eligible = r.CanPlaceAnnotation || renderable;
            var usable = eligible && r.HasCompleteAnnotationCoordinates;
            var annotationText = AnnotationActionText(renderable, usable, eligible);
            <span class="action-slot">
                @if (r.CanScaffoldInverse)
