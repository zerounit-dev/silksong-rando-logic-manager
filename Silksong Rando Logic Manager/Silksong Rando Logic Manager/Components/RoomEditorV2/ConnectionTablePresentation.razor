@if(ShowArchivedChildren&&View.ArchivedRows.Count>0){<div class="archived-table-label">[archived]</div><table class="logic-table connection-table" data-v2-connection-table="archived" data-v2-child-count="@archived.Count"><colgroup><col class="reorder-column"/><col class="connection-state-column"/><col class="connection-alias-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="connection-text-column"/><col class="checkbox-column"/><col class="verification-column"/><col class="actions-column"/></colgroup><thead><tr><th></th><th>state</th><th>alias</th><th>name</th><th>source</th><th>destination</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th></th></tr></thead><tbody>@for(var n=0;n<archived.Count;n++){var r=archived[n];<tr @key="r.ClientDraftId" data-v2-connection-row="@r.EntityId" data-v2-child-index="@n"><td class="reorder-cell"></td>@Cells(r)<td class="row-actions"><span class="action-slot"></span><span class="action-slot"><button type="button" title="restore" aria-label="restore" @onclick="()=>ArchiveRow(r,false)"><i class="fa-solid fa-rotate-left"/></button></span><span class="action-slot"><button id="v2-connection-delete-@r.EntityId" type="button" title="delete permanently" aria-label="delete permanently" @onclick="()=>DeleteRow(r)"><i class="fa-solid fa-trash"/></button></span></td></tr>}</tbody></table>}
 @if((message ?? PlacementOutcome) is not null){<p class="warning" role="status">@(message ?? PlacementOutcome)</p>}
</section>
