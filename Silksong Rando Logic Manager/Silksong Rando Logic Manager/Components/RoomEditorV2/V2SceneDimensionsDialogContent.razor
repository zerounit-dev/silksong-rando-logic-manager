@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<h2 id="v2-page-modal-title">edit scene dimensions</h2><p id="v2-page-modal-description">Leave both values blank to clear the declared scene bounds.</p><div class="in-game-coordinate-grid"><label>width<input type="text" inputmode="decimal" value="@View.Width" @oninput="WidthChanged" disabled="@Disabled" /></label><label>height<input type="text" inputmode="decimal" value="@View.Height" @oninput="HeightChanged" disabled="@Disabled" /></label></div>@if (View.ValidationMessage is not null) { <p class="danger" role="alert">@View.ValidationMessage</p> }<div class="v2-modal-footer"><div></div><div><button class="compact-control" type="button" @onclick="Cancel" disabled="@Disabled">Cancel</button><button class="compact-control" type="button" @onclick="Apply" disabled="@Disabled">Apply</button></div></div>
@code { [Parameter, EditorRequired] public V2SceneDimensionsDialogView View { get; set; } = null!; [Parameter] public bool Disabled { get; set; } [Parameter] public EventCallback<V2SceneDimensionsDialogView> DraftChanged { get; set; } [Parameter] public EventCallback Cancel { get; set; } [Parameter] public EventCallback Apply { get; set; } private Task WidthChanged(ChangeEventArgs e) => DraftChanged.InvokeAsync(View with { Width = e.Value?.ToString() ?? "", ValidationMessage = null }); private Task HeightChanged(ChangeEventArgs e) => DraftChanged.InvokeAsync(View with { Height = e.Value?.ToString() ?? "", ValidationMessage = null }); }
