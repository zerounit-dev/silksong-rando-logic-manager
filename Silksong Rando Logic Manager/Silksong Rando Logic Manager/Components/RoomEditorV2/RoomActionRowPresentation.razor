@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts

<div class="document-action-row">
    <RoomNavigationContextControlsPresentation View="NavigationContext" BackToMap="BackToMap" ToggleMapContext="ToggleMapContext" />
    <RoomLifecycleContentControlsPresentation View="LifecycleContent" ExportLinks="ExportLinks" ToggleArchivedChildren="ToggleArchivedChildren" Intent="LifecycleContentIntent" Archive="Archive" Restore="Restore" PermanentDelete="PermanentDelete" />
</div>

@code {
    [Parameter, EditorRequired] public RoomNavigationContextControlsView NavigationContext { get; set; } = null!;
    [Parameter, EditorRequired] public RoomLifecycleContentControlsView LifecycleContent { get; set; } = null!;
    [Parameter, EditorRequired] public RoomExportLinksView ExportLinks { get; set; } = null!;
    [Parameter] public EventCallback BackToMap { get; set; }
    [Parameter] public EventCallback ToggleMapContext { get; set; }
    [Parameter] public EventCallback ToggleArchivedChildren { get; set; }
    [Parameter] public EventCallback<RoomLifecycleContentControlsIntent> LifecycleContentIntent { get; set; }
    [Parameter] public EventCallback Archive { get; set; }
    [Parameter] public EventCallback Restore { get; set; }
    [Parameter] public EventCallback PermanentDelete { get; set; }
}
