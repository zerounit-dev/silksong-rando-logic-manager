@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts

<section class="room-sticky-context" aria-label="Room document workspace">
    <DocumentHeaderPresentation View="View" Draft="Draft" RefreshDiagnostic="RefreshDiagnostic" Status="Status" DraftChanged="DraftChanged" Save="Save" />
    <RoomActionRowPresentation NavigationContext="new RoomNavigationContextControlsView(View.IsArchived)" BackToMap="BackToMap" ToggleMapContext="ToggleMapContext" LifecycleContent="new RoomLifecycleContentControlsView(View.IsArchived, ShowArchivedChildren, RecheckRoomLogicBusy, View.CanExportZone)" RoomId="View.RoomId" ToggleArchivedChildren="ToggleArchivedChildren" LifecycleContentIntent="LifecycleContentIntent" Archive="Archive" Restore="Restore" PermanentDelete="PermanentDelete" CurrentRoomExport="CurrentRoomExport" ZoneExport="ZoneExport" />
    @if (!View.IsArchived && (!MapContextVisibilityResolved || ShowMapContext))
    {
        <RoomContextSplitPanePresentation View="new RoomContextPresentationView(true)" Map="Map" MapOwnerGeneration="MapOwnerGeneration" Scene="Scene" Placement="Placement" SelectedItem="SelectedItem" ActionBox="ActionBox" ActionRequested="ActionRequested" OwnerMounted="OwnerMounted" SelectionChanged="SelectionChanged" PlacementCommitted="PlacementCommitted" PlacementCancelled="PlacementCancelled" MarkerDragCommitted="MarkerDragCommitted" SceneNudgeCommitted="SceneNudgeCommitted" FrameGeometryCommitted="FrameGeometryCommitted" Capture="Capture" SceneDimensions="SceneDimensions" RoomId="View.RoomId" LinkedRoomActivated="LinkedRoomActivated" MapLinksChanged="MapLinksChanged" MapLinkModalStateChanged="MapLinkModalStateChanged" />
    }
</section>

@code {
    [Parameter, EditorRequired] public RoomHeaderView View { get; set; } = null!;
    [Parameter] public SceneLayoutView? Scene { get; set; }
    [Parameter] public AreaMapSurfaceView? Map { get; set; }
    [Parameter] public SceneAnnotationPlacementRequest? Placement { get; set; }
    [Parameter] public V2SceneSelectedItem? SelectedItem { get; set; }
    [Parameter] public V2SceneActionBoxView? ActionBox { get; set; }
    [Parameter] public Func<Guid, long, V2SceneAction, Task>? ActionRequested { get; set; }
    [Parameter] public Func<Guid, long, Task>? OwnerMounted { get; set; }
    [Parameter] public Func<V2SceneSelectionCallback, Task>? SelectionChanged { get; set; }
    [Parameter] public Func<Guid, long, SceneAnnotationPlacementRequest, double, double, Task<bool>>? PlacementCommitted { get; set; }
    [Parameter] public Func<Guid, long, SceneAnnotationPlacementRequest, Task<bool>>? PlacementCancelled { get; set; }
    [Parameter] public Func<Guid, long, string, Guid, double, double, Task<bool>>? MarkerDragCommitted { get; set; }
    [Parameter] public Func<Guid, long, string, Guid, double, double, Task<bool>>? SceneNudgeCommitted { get; set; }
    [Parameter] public Func<Guid, long, Guid, double, double, double, double, Task<bool>>? FrameGeometryCommitted { get; set; }
    [Parameter] public bool ClearSceneSelectionAfterRefresh { get; set; }
    [Parameter] public Func<Task>? SceneSelectionCleared { get; set; }
    [Parameter] public Guid? SelectSceneMarkerAfterRefresh { get; set; }
    [Parameter] public Func<Task>? SceneMarkerSelected { get; set; }
    [Parameter] public EventCallback Capture { get; set; }
    [Parameter] public EventCallback<AreaMapSurface.LinkedMapRoomIntent> LinkedRoomActivated { get; set; }
    [Parameter] public long MapOwnerGeneration { get; set; }
    [Parameter] public EventCallback MapLinksChanged { get; set; }
    [Parameter] public EventCallback<AreaMapPanePresentation.RoomMapLinkModalStateIntent> MapLinkModalStateChanged { get; set; }
    [Parameter] public RoomHeaderDraft? Draft { get; set; }
    [Parameter] public V2RefreshDiagnosticView? RefreshDiagnostic { get; set; }
    [Parameter] public V2RoomHeaderSaveStatus Status { get; set; } = new(V2RoomHeaderSaveState.Saved);
    [Parameter] public bool ShowMapContext { get; set; }
    [Parameter] public bool MapContextVisibilityResolved { get; set; }
    [Parameter] public EventCallback ToggleMapContext { get; set; }
    [Parameter] public EventCallback BackToMap { get; set; }
    [Parameter] public bool ShowArchivedChildren { get; set; }
    [Parameter] public EventCallback ToggleArchivedChildren { get; set; }
    [Parameter] public EventCallback<RoomLifecycleContentControlsIntent> LifecycleContentIntent { get; set; }
    [Parameter] public bool RecheckRoomLogicBusy { get; set; }
    [Parameter] public EventCallback Archive { get; set; }
    [Parameter] public EventCallback Restore { get; set; }
    [Parameter] public EventCallback PermanentDelete { get; set; }
    [Parameter] public EventCallback SceneDimensions { get; set; }
    [Parameter] public EventCallback<RoomExportIntent> CurrentRoomExport { get; set; }
    [Parameter] public EventCallback<RoomExportIntent> ZoneExport { get; set; }
    [Parameter] public EventCallback<RoomHeaderDraft> DraftChanged { get; set; }
    [Parameter] public EventCallback Save { get; set; }
}
