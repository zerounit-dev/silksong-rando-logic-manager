    private Task Notify()
    {
        var pending=ActiveRows.Where(x=>x.EntityId is null&&(x.WriteInFlight||Meaningful(x))).ToArray();
        if(!pending.Any(x=>x.ClientDraftId==pendingCreationId))pendingCreationId=pending.FirstOrDefault()?.ClientDraftId;
        return DraftStateChanged?.Invoke(pending.Length>0)??Task.CompletedTask;
    }
    private static bool Meaningful(Row r)=>r.EntityId is not null||r.ControlChanged||!string.IsNullOrEmpty(r.Draft.FriendlyName)||!string.IsNullOrEmpty(r.Draft.SubroomReferenceText)||!string.IsNullOrEmpty(r.Draft.Requirements)||!string.IsNullOrEmpty(r.Draft.Notes)||r.Draft.LocationType!=r.DefaultType||r.Draft.IsTodo||r.Draft.IsVerified is not null;
    private static bool Changed(Row r)=>r.Baseline is { } b&&(r.Draft.FriendlyName!=b.FriendlyName||r.Draft.SubroomReferenceText!=b.SubroomReferenceText||r.Draft.Requirements!=b.Requirements||r.Draft.Notes!=b.Notes||r.Draft.LocationType!=b.LocationType||r.Draft.IsTodo!=b.IsTodo||r.Draft.IsVerified!=b.IsVerified);
