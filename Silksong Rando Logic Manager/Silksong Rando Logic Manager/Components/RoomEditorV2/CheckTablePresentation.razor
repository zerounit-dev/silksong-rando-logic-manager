  private static readonly string[] fields=["type","name","subroom","requirements","notes","todo","verification"]; private readonly List<Row> active=[]; private readonly List<Row> archived=[]; private readonly ChildTableInteractionController sharedInteraction=new(); private Guid latentSuccessorId {get=>sharedInteraction.LatentSuccessorId;set=>sharedInteraction.LatentSuccessorId=value;} private Guid? pendingTailPromotionId {get=>sharedInteraction.PendingTailPromotionId;set=>sharedInteraction.PendingTailPromotionId=value;} private ChildTableFocusTarget? pendingFocus {get=>sharedInteraction.PendingFocus;set=>sharedInteraction.PendingFocus=value;} private Guid? renderedRoomId; private string? message; private bool clearDragFeedback; private bool tabFocusAwaitingRefresh; private Guid? tabFocusCreatedEntityId;
 protected override void OnParametersSet(){if(renderedRoomId is Guid old&&old!=RoomId){sharedInteraction.ResetForRoute(active.Concat(archived));tabFocusAwaitingRefresh=false;tabFocusCreatedEntityId=null;clearDragFeedback=true;}renderedRoomId=RoomId;ChildTableRowReconciliation.Reconcile(active,archived,View.ActiveRows,View.ArchivedRows,row=>row.EntityId,view=>view.EntityId,Row.From,(row,view)=>row.Load(view),Row.Empty,sharedInteraction);if(tabFocusAwaitingRefresh&&tabFocusCreatedEntityId is Guid created&&View.ActiveRows.Concat(View.ArchivedRows).Any(x=>x.EntityId==created)){tabFocusAwaitingRefresh=false;tabFocusCreatedEntityId=null;}_=Notify();}
