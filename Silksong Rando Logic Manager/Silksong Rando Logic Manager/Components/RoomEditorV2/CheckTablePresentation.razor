    // external edit merely because D1's result supplied a newer timestamp.
    private static CheckDurableBaseline ComparisonBaseline(CheckDurableBaseline fresh,PendingWrite request,DateTime? chainObservation)=>fresh with
    {
        UpdatedUtc=request.ObservedUtc??chainObservation??fresh.UpdatedUtc,
        FriendlyName=request.Origin.FriendlyName!=request.AuthoredSnapshot.FriendlyName?request.Origin.FriendlyName:fresh.FriendlyName,
        SubroomReferenceText=request.Origin.SubroomReferenceText!=request.AuthoredSnapshot.SubroomReferenceText?request.Origin.SubroomReferenceText:fresh.SubroomReferenceText,
        Requirements=request.Origin.Requirements!=request.AuthoredSnapshot.Requirements?request.Origin.Requirements:fresh.Requirements,
        Notes=request.Origin.Notes!=request.AuthoredSnapshot.Notes?request.Origin.Notes:fresh.Notes,
        LocationType=request.Origin.LocationType!=request.AuthoredSnapshot.LocationType?request.Origin.LocationType:fresh.LocationType,
        IsTodo=request.Origin.IsTodo!=request.AuthoredSnapshot.IsTodo?request.Origin.IsTodo:fresh.IsTodo,
        IsVerified=request.Origin.IsVerified!=request.AuthoredSnapshot.IsVerified?request.Origin.IsVerified:fresh.IsVerified
    };
    private static CheckDraft Rebase(CheckDraft origin,CheckDraft local,CheckDraft fresh)=>fresh with
    {
        FriendlyName=origin.FriendlyName!=local.FriendlyName?local.FriendlyName:fresh.FriendlyName,
        SubroomReferenceText=origin.SubroomReferenceText!=local.SubroomReferenceText?local.SubroomReferenceText:fresh.SubroomReferenceText,
        Requirements=origin.Requirements!=local.Requirements?local.Requirements:fresh.Requirements,
        Notes=origin.Notes!=local.Notes?local.Notes:fresh.Notes,
        LocationType=origin.LocationType!=local.LocationType?local.LocationType:fresh.LocationType,
        IsTodo=origin.IsTodo!=local.IsTodo?local.IsTodo:fresh.IsTodo,
        IsVerified=origin.IsVerified!=local.IsVerified?local.IsVerified:fresh.IsVerified
    };
    private sealed class Row:IChildTableRowInteraction
    {
        private readonly ChildTableRowInteraction<CheckDurableBaseline,CheckDraft> interaction;
        private Row(Guid id,CheckDraft draft,bool enemies){interaction=new(id,draft);DefaultType=enemies?"enemy":null;}
        public ChildTableRowInteraction<CheckDurableBaseline,CheckDraft> Interaction=>interaction;
        public Guid ClientDraftId=>interaction.ClientRowId;
        Guid IChildTableRowInteraction.ClientRowId=>interaction.ClientRowId;
        public Guid? EntityId=>interaction.EntityId;
        public bool IsArchived=>interaction.IsArchived;
        public string? DefaultType {get;}
        public CheckRowView? View {get;private set;}
        public bool WriteInFlight,RequiresReload;
        public Queue<PendingWrite> PendingWrites {get;}=[];
        public PendingWrite? CurrentWrite;
        public CheckDraft? LastBoundaryDraft;
        public CheckDraft? ObservedOrigin,CommittedBoundary;
        public DateTime? BoundaryObservedUtc;
        public bool ControlChanged {get;set;}
        public ChildTableRowLifecycle State=>interaction.Lifecycle;
        public string? FailureMessage=>interaction.FailureMessage;
        public V2Severity FriendlyNameSeverity,SubroomSeverity,RequirementsSeverity,LocationTypeSeverity;
        public V2ReferenceState SubroomReferenceState;
        public CheckDurableBaseline? Baseline=>interaction.Baseline;
        public CheckDraft Draft{get=>interaction.Draft;set=>interaction.ReplaceDraft(value);}
        void IChildTableRowInteraction.ResetForRoute()=>interaction.ResetForRoute();
        public static Row Empty(Guid id,bool enemies)=>new(id,new(id,"","","","",enemies?"enemy":null,false,null),enemies);
        public void ClearPendingWrites()
        {
            CurrentWrite?.Completion.TrySetResult(false);
            while(PendingWrites.TryDequeue(out var pending))pending.Completion.TrySetResult(false);
        }
        public void AdoptCommitted(CheckDurableBaseline fresh,CheckDraft authoredBoundary)
        {
            var carry=DraftFrom(fresh,ClientDraftId);
            foreach(var pending in PendingWrites)
            {
                var next=Rebase(pending.Origin,pending.AuthoredSnapshot,carry);
                pending.Snapshot=next;carry=next;
            }
            // Live authoring values still correspond to the rendered controls.
            // Do not manufacture an edit from their untouched old value while
            // effective queued snapshots adopt disjoint durable updates.
            CommittedBoundary=authoredBoundary;
            BoundaryObservedUtc??=fresh.UpdatedUtc;
            interaction.ReplaceBaseline(fresh);
        }
        public void RebaseFailure(CheckDurableBaseline fresh)
        {
            if((CommittedBoundary??ObservedOrigin) is { } origin)Draft=Rebase(origin,Draft,DraftFrom(fresh,ClientDraftId));
            else if(Baseline is { } previous)Draft=Rebase(DraftFrom(previous,ClientDraftId),Draft,DraftFrom(fresh,ClientDraftId));
            interaction.ReplaceBaseline(fresh);
        }
        public void Load(CheckRowView x)
        {
            if(WriteInFlight||RequiresReload)return;
            View=x;
            FriendlyNameSeverity=x.FriendlyNameSeverity;SubroomSeverity=x.SubroomReferenceSeverity;
            RequirementsSeverity=x.RequirementsSeverity;LocationTypeSeverity=x.LocationTypeSeverity;SubroomReferenceState=x.SubroomReferenceState;
            interaction.Load(x.EntityId,x.IsArchived,RoomEditorV2CommandService.CheckFromView(x),new(ClientDraftId,x.FriendlyName,x.SubroomReferenceText,x.Requirements,x.Notes,x.LocationType,x.IsTodo,x.IsVerified),retainCorrection:true,
                rebaseCorrection:(previous,local,fresh)=>Rebase(DraftFrom(previous,ClientDraftId),local,fresh));
        }
    }
