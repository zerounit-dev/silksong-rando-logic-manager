@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<section class="document-section"><h2>check locations</h2>
<table class="logic-table check-table" data-v2-check-table="active" data-v2-child-count="@active.Count(x => x.EntityId is not null)"><colgroup><col class="reorder-column" /><col class="check-type-column" /><col class="check-name-column" /><col class="check-subroom-column" /><col class="check-requirements-column" /><col class="check-notes-column" /><col class="checkbox-column" /><col class="verification-column" /><col class="actions-column" /></colgroup><thead><tr><th class="reorder-heading"></th><th>type</th><th>name</th><th>subroom</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th class="actions-heading"></th></tr></thead><tbody>
       @for(var rowIndex=0;rowIndex<active.Count;rowIndex++){var row=active[rowIndex];<tr @key="row.ClientDraftId" class="@RowClass(row)" data-v2-check-row="@row.EntityId" data-v2-child-index="@(row.EntityId is null ? null : active.Take(rowIndex).Count(x => x.EntityId is not null))" data-v2-check-state="@row.State" data-v2-check-tail="@(row.EntityId is null ? "true" : null)"><td class="reorder-cell">@Grip(row)</td>@Cells(row)<td class="row-actions">@if(row.EntityId is Guid id&&View.ActiveRows.SingleOrDefault(x=>x.EntityId==id) is { } source){var usable=Usable(source.AnnotationSceneUnitX,source.AnnotationSceneUnitY);var renderable=source.EnableAnnotation&&usable;var annotationText=AnnotationActionText(renderable,usable);<span class="action-slot"><button id="@($"v2-check-metadata-{id}")" type="button" title="edit in-game data" aria-label="edit in-game data" disabled="@(row.State!=RowState.Persisted)" @onclick="()=>EditInGameData(row)"><i class="fa-solid fa-pen"></i></button></span><span class="action-slot"><button id="@($"v2-check-{(renderable?"select":usable?"show":"place")}-{id}")" type="button" title="@annotationText" aria-label="@annotationText" disabled="@(row.State!=RowState.Persisted||!SceneActionsAvailable)" @onclick="()=>Annotation(row)"><span class="annotation-crosshairs @(renderable ? null : "annotation-crosshairs-warning")" aria-hidden="true"><i class="fa-solid fa-crosshairs"></i></span></button></span><span class="action-slot"><button title="archive" aria-label="archive" disabled="@(row.State!=RowState.Persisted)" @onclick="()=>Archive(row,true)"><i class="fa-solid fa-box-archive"></i></button></span>}</td></tr>}
</tbody></table>
<datalist id="v2-check-subroom-references">@foreach (var suggestion in View.SubroomReferenceSuggestions) { <option value="@suggestion"></option> }</datalist>
 @if(ShowArchivedChildren && View.ArchivedRows.Count>0){<div class="archived-table-label">[archived]</div><table class="logic-table check-table" data-v2-check-table="archived" data-v2-child-count="@archived.Count"><colgroup><col class="reorder-column" /><col class="check-type-column" /><col class="check-name-column" /><col class="check-subroom-column" /><col class="check-requirements-column" /><col class="check-notes-column" /><col class="checkbox-column" /><col class="verification-column" /><col class="actions-column" /></colgroup><thead><tr><th class="reorder-heading"></th><th>type</th><th>name</th><th>subroom</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th class="actions-heading"></th></tr></thead><tbody>@for(var rowIndex=0;rowIndex<archived.Count;rowIndex++){var row=archived[rowIndex];<tr @key="row.ClientDraftId" class="@RowClass(row)" data-v2-check-row="@row.EntityId" data-v2-child-index="@rowIndex" data-v2-check-state="@row.State"><td class="reorder-cell">@Grip(row)</td>@Cells(row)<td class="row-actions"><span class="action-slot"></span><span class="action-slot"><button title="restore" aria-label="restore" @onclick="()=>Archive(row,false)" disabled="@(row.State!=RowState.Persisted)"><i class="fa-solid fa-rotate-left"></i></button></span><span class="action-slot"><button id="delete-check-@row.EntityId" title="delete permanently" aria-label="delete permanently" @onclick="()=>RequestDelete(row)" disabled="@(row.State!=RowState.Persisted)"><i class="fa-solid fa-trash"></i></button></span></td></tr>}</tbody></table>}
@if(!string.IsNullOrEmpty(message)){<p class="warning" role="status">@message</p>}
</section>
