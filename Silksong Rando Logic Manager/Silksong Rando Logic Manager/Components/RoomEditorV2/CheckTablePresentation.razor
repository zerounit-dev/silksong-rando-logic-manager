    private static CheckDraft DraftFrom(CheckDurableBaseline baseline,Guid clientId)=>new(clientId,baseline.FriendlyName,baseline.SubroomReferenceText,baseline.Requirements,baseline.Notes,baseline.LocationType,baseline.IsTodo,baseline.IsVerified);
    // A queued boundary retains its observed comparison values/version on fields
