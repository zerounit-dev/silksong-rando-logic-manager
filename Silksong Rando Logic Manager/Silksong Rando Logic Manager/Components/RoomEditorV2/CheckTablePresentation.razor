 @if(ShowArchivedChildren && sectionArchived.Count>0){<div class="archived-table-label">[archived]</div><table class="logic-table check-table" data-v2-check-section="@(enemies ? "enemies" : "checks")" data-v2-check-table="archived" data-v2-child-count="@sectionArchived.Count"><colgroup><col class="reorder-column" /><col class="check-type-column" /><col class="check-name-column" /><col class="check-subroom-column" /><col class="check-requirements-column" /><col class="check-notes-column" /><col class="checkbox-column" /><col class="verification-column" /><col class="actions-column" /></colgroup><thead><tr><th class="reorder-heading"></th><th>type</th><th>name</th><th>subroom</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th class="actions-heading"></th></tr></thead><tbody>@for(var rowIndex=0;rowIndex<sectionArchived.Count;rowIndex++){var row=sectionArchived[rowIndex];<tr @key="row.ClientDraftId" class="@RowClass(row)" data-v2-check-row="@row.EntityId" data-v2-child-index="@rowIndex" data-v2-check-state="@row.State"><td class="reorder-cell">@Grip(row)</td>@Cells(row, enemies)<td class="row-actions"><span class="action-slot"></span><span class="action-slot"><button data-v2-child-action="restore" title="restore" aria-label="restore" @onclick="()=>Archive(row,false)" disabled="@(row.State!=RowState.Persisted)"><i class="fa-solid fa-rotate-left"></i></button></span><span class="action-slot"><button data-v2-child-action="open-delete" id="delete-check-@row.EntityId" title="delete permanently" aria-label="delete permanently" @onclick="()=>RequestDelete(row)" disabled="@(row.State!=RowState.Persisted)"><i class="fa-solid fa-trash"></i></button></span></td></tr>}</tbody></table>}
</section>
}
<datalist id="v2-check-subroom-references">@foreach (var suggestion in appliedPair?.CheckLocations.SubroomReferenceSuggestions ?? []) { <option value="@suggestion"></option> }</datalist>
@if(!string.IsNullOrEmpty(message)){<p class="warning" role="status">@message</p>}
@code {
    [Parameter,EditorRequired] public long OwnerGeneration {get;set;}
    [Parameter,EditorRequired] public Func<bool> OwnerIsCurrent {get;set;}=null!;
    private long renderedOwnerGeneration=-1;
    private bool PageOwned=>!disposed&&OwnerIsCurrent?.Invoke()==true;
 [Parameter,EditorRequired] public CheckLocationsTableView CheckLocations {get;set;}=null!;
 [Parameter,EditorRequired] public EnemiesTableView Enemies {get;set;}=null!;
 [Parameter] public Guid RoomId {get;set;} [Parameter] public bool ShowArchivedChildren {get;set;}
    [Parameter] public bool SceneActionsAvailable {get;set;} [Parameter] public string SceneActionsUnavailableReason {get;set;}="Scene annotation actions are unavailable."; [Parameter] public Func<Guid,string,Task>? FocusRequested {get;set;} [Parameter] public Func<CheckDurableBaseline,CheckDraft,Task<V2CheckCommandOutcome>>? Save {get;set;} [Parameter] public Func<CheckDraft,Task<V2CheckCommandOutcome>>? Create {get;set;} [Parameter] public Func<Guid,bool,int,Task<V2CheckCommandOutcome>>? Reorder {get;set;} [Parameter] public Func<Guid,bool,Task<V2CheckCommandOutcome>>? SetArchive {get;set;} [Parameter] public Func<CheckMetadataDurableBaseline,string,Task<V2CheckCommandOutcome>>? EditInGameDataRequested {get;set;} [Parameter] public Func<CheckMetadataDurableBaseline,string,Task>? AnnotationRequested {get;set;} [Parameter] public Func<V2DeleteConfirmationIntent,Task>? DeleteConfirmationRequested {get;set;} [Parameter] public Func<V2DeleteConfirmationIntent,Task>? DeleteConfirmationCancelled {get;set;} [Parameter] public Func<V2DeleteConfirmationIntent,Task>? DeleteConfirmationConfirmed {get;set;} [Parameter] public Func<bool,Task>? DraftStateChanged {get;set;} [Parameter] public Func<Task>? RefreshApplied {get;set;} [Parameter] public Func<Task>? ClearDragFeedback {get;set;}
    private static readonly string[] fields=["type","name","subroom","requirements","notes","todo","verification"];
    private readonly SectionState checkLocationsSection=new(false), enemiesSection=new(true);
    private IEnumerable<SectionState> Sections => new[] { checkLocationsSection, enemiesSection };
    private IEnumerable<Row> ActiveRows => checkLocationsSection.ActiveRows.Concat(enemiesSection.ActiveRows);
    private IEnumerable<Row> AllRows => Sections.SelectMany(section=>section.ActiveRows.Concat(section.ArchivedRows));
    private ViewPair? pendingPair, appliedPair;
    private Guid? renderedRoomId, pendingCreationId;
    private string? message;
    private bool clearDragFeedback, disposed;
    private bool suppressStaleCompletionRender;
    private long routeGeneration;
    private SectionState Section(Row row) => Sections.Single(section=>section.ActiveRows.Contains(row)||section.ArchivedRows.Contains(row));
    private ChildTableInteractionController Controller(Row row) => Section(row).Controller;
    private List<Row> Rows(Row row) => row.IsArchived ? Section(row).ArchivedRows : Section(row).ActiveRows;
    private sealed record ViewPair(CheckLocationsTableView CheckLocations, EnemiesTableView Enemies);
    private sealed class SectionState(bool isEnemy)
    {
        public bool IsEnemy {get;}=isEnemy;
        public List<Row> ActiveRows {get;set;}=[];
        public List<Row> ArchivedRows {get;set;}=[];
        public ChildTableInteractionController Controller {get;}=new();
    }
    private bool OwnsCompletion(Guid room,long generation,bool suppressEventRender=false)
    {
        if(!disposed&&PageOwned&&RoomId==room&&routeGeneration==generation)return true;
        if(suppressEventRender)suppressStaleCompletionRender=true;
        return false;
    }
    protected override bool ShouldRender()
    {
        if(disposed||!PageOwned)return false;
        if(!suppressStaleCompletionRender)return true;
        suppressStaleCompletionRender=false;
        return false;
    }

    protected override void OnParametersSet()
    {
        if((renderedRoomId is Guid old && old != RoomId)||(renderedOwnerGeneration>=0&&renderedOwnerGeneration!=OwnerGeneration))
        {
            Reset(); clearDragFeedback=true;
        }
        renderedRoomId=RoomId;
        renderedOwnerGeneration=OwnerGeneration;
        // A creation's returned identity has not reached the transient row yet
        // while its required refresh is running. Never manufacture a second UI
        // row for that identity or overwrite supplied D2 values in this interval.
        ApplyFreshViews(RoomId,CheckLocations,Enemies);
        _=Notify();
    }
    public void ApplyFreshViews(Guid roomId,CheckLocationsTableView checkLocations,EnemiesTableView enemies)
    {
        if(disposed||roomId!=RoomId||renderedRoomId!=roomId)return;
        // Re-rendering the already applied pair is not a fresh durable baseline,
        // particularly after a conflict returned newer comparison evidence.
        if(ReferenceEquals(appliedPair?.CheckLocations,checkLocations)&&ReferenceEquals(appliedPair?.Enemies,enemies))return;
        pendingPair=new(checkLocations,enemies);
        ApplyPendingPair();
    }
    private void ApplyPendingPair()
    {
        if(pendingPair is not { } pair||AllRows.Any(row=>row.WriteInFlight||row.RequiresReload))return;
        // Capture every identity AND its source owner before staging any partition.
        // This registry is lookup bookkeeping only; rendering owns four real lists.
        var ownership=Sections.SelectMany(section=>section.ActiveRows.Concat(section.ArchivedRows)
            .Select(row=>(Row:row,Section:section))).ToDictionary(item=>item.Row,item=>item.Section);
        var byEntity=ownership.Keys.Where(row=>row.EntityId is not null).ToDictionary(row=>row.EntityId!.Value);
        var checksActive=new List<Row>();var checksArchived=new List<Row>();
        var enemiesActive=new List<Row>();var enemiesArchived=new List<Row>();
        Stage(pair.CheckLocations.ActiveRows,checkLocationsSection,false);
        Stage(pair.CheckLocations.ArchivedRows,checkLocationsSection,true);
        Stage(pair.Enemies.ActiveRows,enemiesSection,false);
        Stage(pair.Enemies.ArchivedRows,enemiesSection,true);
        AddTail(checkLocationsSection,checksActive);
        AddTail(enemiesSection,enemiesActive);
        // No await/render/callback between the four staged assignments.
        checkLocationsSection.ActiveRows=checksActive;checkLocationsSection.ArchivedRows=checksArchived;
        enemiesSection.ActiveRows=enemiesActive;enemiesSection.ArchivedRows=enemiesArchived;
        appliedPair=pair;pendingPair=null;

        void Stage(IReadOnlyList<CheckRowView> views,SectionState target,bool archived)
        {
            foreach(var view in views)
            {
                var row=byEntity.GetValueOrDefault(view.EntityId)??Row.Empty(Guid.NewGuid(),target.IsEnemy);
                var source=ownership.GetValueOrDefault(row);
                // A fresh baseline may classify elsewhere while a failed authored
                // correction still belongs to its original section. Load diagnostics
                // and rebase the real deltas, but never duplicate it in destination.
                var owner=!archived&&row.Interaction.HasRetainedCorrection&&source is not null?source:target;
                row.Load(view);
                (owner==checkLocationsSection ? archived?checksArchived:checksActive : archived?enemiesArchived:enemiesActive).Add(row);
                if(source is not null&&source!=owner&&source.Controller.PendingFocus is { } focus&&
                    (focus.ClientRowId==row.ClientDraftId||fields.Any(field=>focus.ElementId==Id(row,field))))
                {
                    owner.Controller.PendingFocus=source.Controller.TakePendingFocus();
                }
            }
        }
        void AddTail(SectionState section,List<Row> rows)
        {
            rows.AddRange(ownership.Where(item=>item.Value==section&&item.Key.EntityId is null).Select(item=>item.Key));
            if(!rows.Any(row=>row.EntityId is null))rows.Add(Row.Empty(section.Controller.ConsumeTailId(null),section.IsEnemy));
        }
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if(disposed)return;
        if(clearDragFeedback){clearDragFeedback=false;await(ClearDragFeedback?.Invoke()??Task.CompletedTask);}
        foreach(var controller in Sections.Select(section=>section.Controller))
        {
            if(AllRows.Any(row=>row.WriteInFlight||row.RequiresReload))continue;
            if(controller.TakePendingFocus() is { } target)
                await(FocusRequested?.Invoke(RoomId,target.ElementId)??Task.CompletedTask);
        }
    }
    private void Reset()
    {
        routeGeneration++;
        foreach(var section in Sections)
        {
            foreach(var row in section.ActiveRows.Concat(section.ArchivedRows))row.ClearPendingWrites();
            section.Controller.ResetForRoute(section.ActiveRows.Concat(section.ArchivedRows));
            section.ActiveRows.Clear();section.ArchivedRows.Clear();
        }
        pendingPair=null;appliedPair=null;pendingCreationId=null;message=null;
    }
    public void Dispose(){disposed=true;Reset();}
    private RenderFragment Cells(Row r, bool enemies) => @<text>
        <td class="check-type-cell @SeverityClass(DisplaySeverity(r, r.EntityId is null ? V2Severity.Neutral : r.LocationTypeSeverity))">
            <select @attributes='FieldAttributes(r, ChildTableField.Type, "Check type")' autocomplete="off" value="@(r.Draft.LocationType ?? "")" disabled="@r.IsArchived" @onchange="e => SelectType(r, e)">
                <option value="">unknown</option>
                @if (r.Draft.LocationType is { } raw && !(appliedPair?.CheckLocations.LocationTypes ?? []).Any(type => string.Equals(type.OutputValue, raw, StringComparison.Ordinal)))
                {
                    <option value="@raw" disabled>Unrecognized: @raw</option>
                }
                @foreach (var group in (appliedPair?.CheckLocations.LocationTypes ?? []).GroupBy(type => type.Group, StringComparer.Ordinal))
                {
                    <optgroup @key="group.Key" label="@group.Key">
                        @foreach (var type in group)
                        {
                            <option @key="type.OutputValue" value="@type.OutputValue">@type.Name.ToLowerInvariant()</option>
                        }
                    </optgroup>
                }
            </select>
        </td>
        <td class="@SeverityClass(DisplaySeverity(r, r.FriendlyNameSeverity))">
            <textarea @attributes='FieldAttributes(r, ChildTableField.Name, "Check name")' class="text-editor" data-v2-friendly-name-space="@(enemies ? "enemies" : "checks")" rows="1" autocomplete="off" value="@r.Draft.FriendlyName" readonly="@r.IsArchived"></textarea>
        </td>
        <td class="@SeverityClass(DisplaySeverity(r, r.SubroomSeverity))" title="@(r.IsArchived ? null : r.SubroomReferenceState.ToString())">
            <input @attributes='FieldAttributes(r, ChildTableField.Subroom, "Check subroom")' class="text-editor" list="v2-check-subroom-references" value="@(r.Draft.SubroomReferenceText ?? "")" readonly="@r.IsArchived" />
        </td>
        <td class="@RequirementsClass(r, "requirements", DisplaySeverity(r, RequirementsSeverity(r)))">
            @if (r.IsArchived)
            {
                <div class="requirements-preview" data-v2-requirements-highlight="">@r.Draft.Requirements</div>
            }
            else
            {
                <div class="requirements-editor-layer requirements-inline-layer">
                    <div data-v2-requirements-highlight="">@r.Draft.Requirements</div>
                    <textarea @attributes='FieldAttributes(r, ChildTableField.Requirements, "Check requirements")' class="detail-editor requirements-editor" data-v2-requirements-editor="" data-v2-requirements-room="@RoomId" rows="1" value="@r.Draft.Requirements"></textarea>
                </div>
            }
        </td>
        <td>
            <textarea @attributes='FieldAttributes(r, ChildTableField.Notes, "Check notes")' class="detail-editor" rows="1" autocomplete="off" value="@r.Draft.Notes" readonly="@r.IsArchived"></textarea>
        </td>
        <td class="checkbox-cell @(!r.IsArchived && r.Draft.IsTodo ? "todo" : null)">
            <input @attributes='FieldAttributes(r, ChildTableField.Todo, "Check is TODO")' type="checkbox" autocomplete="off" checked="@r.Draft.IsTodo" disabled="@r.IsArchived" @onchange='e => ToggleChanged(r, "todo", e)' />
        </td>
        <td class="verification-cell @(r.IsArchived || r.EntityId is null ? null : r.Draft.IsVerified == true ? "verification-success" : r.Draft.IsVerified == false ? "verification-danger" : "verification-warning")">
            <select @attributes='FieldAttributes(r, ChildTableField.Verification, "Check verification")' autocomplete="off" value="@Verification(r.Draft.IsVerified)" disabled="@r.IsArchived" @onchange="e => SelectVerification(r, e)">
                <option value="false">not verified</option>
                <option value="">unknown</option>
                <option value="true">verified</option>
            </select>
        </td>
    </text>;
    private Dictionary<string, object> FieldAttributes(Row row, ChildTableField field, string label) =>
        ChildTableBrowserFacts.FieldAttributes("check", row.ClientDraftId, field, label, Changed(row), Controller(row).LatentSuccessorId,
            direction => Target(row, field.Wire(), direction.Wire()));
    private RenderFragment Grip(Row row) => @<text>
        @if (!row.IsArchived && row.EntityId is Guid && row.State == RowState.Persisted && !row.WriteInFlight && !row.RequiresReload)
        {
            <button class="reorder-handle" type="button" draggable="true" data-v2-check-grip="true" title="Reorder check" aria-label="@($"Reorder check: {row.Draft.FriendlyName}")"><i class="fa-solid fa-grip-vertical" aria-hidden="true"></i></button>
        }
        else if (!row.IsArchived && (row.WriteInFlight || row.State == RowState.Saving))
        {
            <i class="fa-solid fa-spinner fa-spin" role="img" aria-label="Saving check"></i>
        }
        else if (!row.IsArchived && row.State == RowState.Failed)
        {
            <i class="fa-solid fa-circle-xmark danger" role="img" title="@Failure(row)" aria-label="@Failure(row)"></i>
        }
    </text>;
   private static V2Severity DisplaySeverity(Row row,V2Severity severity)=>row.IsArchived?V2Severity.Neutral:severity; private static string? SeverityClass(V2Severity severity)=>severity switch { V2Severity.Warning=>"warning",V2Severity.Danger=>"danger",_=>null }; private static string? RequirementsClass(Row row,string field,V2Severity severity)=>severity switch { V2Severity.Warning=>"warning", V2Severity.Danger=>"danger", _ when !row.IsArchived&&field=="requirements"&&row.Draft.IsTodo=>"warning", _=>null }; private static V2Severity RequirementsSeverity(Row row)=>row.Baseline is { } baseline&&row.Draft.Requirements!=baseline.Requirements?(string.IsNullOrWhiteSpace(row.Draft.Requirements)||row.Draft.IsTodo?V2Severity.Warning:V2Severity.Neutral):row.RequirementsSeverity; private static string? RowClass(Row row)=>row.State==RowState.Saving?"child-row-saving":row.State==RowState.Failed?"child-row-failed":row.EntityId is null?"uncommitted-row":null;
    private Task ToggleChanged(Row r,string f,ChangeEventArgs e)=>ControlEventAsync(r,f,e.Value is bool enabled&&enabled?"true":"false");
    private Task SelectType(Row r,ChangeEventArgs e)=>ControlEventAsync(r,"type",e.Value?.ToString());
    private Task SelectVerification(Row r,ChangeEventArgs e)=>ControlEventAsync(r,"verification",e.Value?.ToString());
    private async Task ControlEventAsync(Row row,string field,string? value)
    {
        var room=RoomId;var generation=routeGeneration;
        try { await ControlCheckAsync(row.ClientDraftId.ToString(),field,value); }
        finally { OwnsCompletion(room,generation,suppressEventRender:true); }
    }
    private async Task Commit(Row row,string? correction=null)
    {
        if(disposed||row.IsArchived||row.RequiresReload||row.State==RowState.Failed||(!row.WriteInFlight&&row.EntityId is null&&!Meaningful(row)))return;
        if(row.WriteInFlight)
        {
            if(row.LastBoundaryDraft==row.Draft)
            {
                if(row.PendingWrites.LastOrDefault() is { } pending)
                {
                    pending.Focus=Controller(row).PendingFocus;pending.Field=correction;
                    await pending.Completion.Task;
                }
                else if(row.CurrentWrite is { } current)
                {
                    current.Focus=Controller(row).PendingFocus;current.Field=correction;
                    await current.Completion.Task;
                }
                return;
            }
        }
        else if(row.EntityId is not null&&!Changed(row))return;
        var request=new PendingWrite(row.LastBoundaryDraft??(row.Baseline is { } observed?DraftFrom(observed,row.ClientDraftId):row.Draft),row.Draft,row.WriteInFlight?row.BoundaryObservedUtc:row.Baseline?.UpdatedUtc,correction,Controller(row).PendingFocus,Section(row));
        var notification=Notify();
        if(row.EntityId is null && pendingCreationId!=row.ClientDraftId)
        {
            Fail(row,correction,"Finish or clear the pending check row first.",null);
            await notification;
            await InvokeAsync(StateHasChanged);return;
        }
        row.LastBoundaryDraft=request.Snapshot;
        row.PendingWrites.Enqueue(request);
        var ownsDrain=!row.WriteInFlight;
        if(ownsDrain){row.WriteInFlight=true;row.BoundaryObservedUtc=row.Baseline?.UpdatedUtc;row.ObservedOrigin=request.Origin;row.CommittedBoundary=null;row.Interaction.BeginSave();}
        await notification;
        if(ownsDrain){await InvokeAsync(StateHasChanged);await DrainWrites(row);}
        await request.Completion.Task;
    }
    private async Task DrainWrites(Row row)
    {
        row.WriteInFlight=true;
        var sourceRoom=RoomId;var generation=routeGeneration;
        try
        {
            while(row.PendingWrites.TryDequeue(out var request))
            {
                row.CurrentWrite=request;
                if(!OwnsCompletion(sourceRoom,generation)){request.Completion.TrySetResult(false);return;}
                row.Interaction.BeginSave();
                var initiatingController=request.SourceSection.Controller;
                var baseline=row.Baseline is { } freshBaseline?ComparisonBaseline(freshBaseline,request,row.BoundaryObservedUtc):null;
                var draft=request.Snapshot;
                var result=baseline is null?await(Create?.Invoke(draft)??Unavailable("Creation")):await(Save?.Invoke(baseline,draft)??Unavailable("Saving"));
                if(result.Status==V2CheckCommandStatus.Committed)
                {
                    row.Interaction.CompleteCommitted(result.CreatedEntityId);
                    if(result.FreshBaseline is { } committed)row.AdoptCommitted(committed,request.AuthoredSnapshot);
                }
                if(!OwnsCompletion(sourceRoom,generation)){request.Completion.TrySetResult(false);return;}
                // Route invalidation can precede this child's disposal/parameters.
                // A durable stale commit is not permission to render the new page.
                if(result.Status==V2CheckCommandStatus.Committed&&!result.PresentationRefreshed&&!result.RequiresRoomReload){row.ClearPendingWrites();request.Completion.TrySetResult(false);return;}
                message=result.Message;
                if(result.Status is V2CheckCommandStatus.Committed or V2CheckCommandStatus.Unchanged)
                {
                    if(result.Status==V2CheckCommandStatus.Unchanged)
                    {
                        row.Interaction.CompleteUnchanged();
                        if(result.FreshBaseline is { } fresh)row.AdoptCommitted(fresh,request.AuthoredSnapshot);
                    }
                    // The promoted creation is no longer a pending tail. Release
                    // that aggregate guard before its queued ordinary row saves.
                    if(result.CreatedEntityId is not null)await Notify();
                    if(result.RequiresRoomReload)
                    {
                        row.RequiresReload=true;
                        if(row.PendingWrites.Count>0||row.CommittedBoundary!=row.Draft)
                        {
                            if(row.Baseline is { } saved)row.RebaseFailure(saved);
                            Fail(row,row.PendingWrites.LastOrDefault()?.Field??request.Field,"The change was saved. Reload room before correcting the retained later edits.",row.Baseline);
                        }
                        else
                        {
                            initiatingController.PendingFocus=request.Focus;
                            if(request.Field=="type"&&result.CommittedIsEnemy is bool target&&target!=request.SourceSection.IsEnemy)
                                initiatingController.PendingFocus=new(row.ClientDraftId,"type");
                        }
                        row.ClearPendingWrites();
                        request.Completion.TrySetResult(false);
                        break;
                    }
                    if(row.PendingWrites.Count==0)
                    {
                        var controller=initiatingController;
                        controller.PendingFocus=request.Focus;
                        if(request.Field=="type"&&result.CommittedIsEnemy is bool target&&target!=request.SourceSection.IsEnemy)controller.PendingFocus=new(row.ClientDraftId,"type");
                    }
                    request.Completion.TrySetResult(true);
                }
                else
                {
                    // Preserve the combined authored deltas, not untouched old fields.
                    if((result.FreshBaseline??row.Baseline) is { } fresh)row.RebaseFailure(fresh);
                    initiatingController.PendingFocus=null;
                    Fail(row,row.PendingWrites.LastOrDefault()?.Field??request.Field,result.Message,row.Baseline);
                    row.ClearPendingWrites();
                    request.Completion.TrySetResult(false);
                    break;
                }
                row.CurrentWrite=null;
            }
        }
        catch
        {
            if(!OwnsCompletion(sourceRoom,generation))return;
            message="An unexpected error has occurred; consult the detailed error modal and server logs. Edit a field to try again.";
            if(row.Baseline is { } durable)row.RebaseFailure(durable);
            Fail(row,row.PendingWrites.LastOrDefault()?.Field??row.CurrentWrite?.Field,message,null);
            row.ClearPendingWrites();
        }
        finally
        {
            if(!OwnsCompletion(sourceRoom,generation)){row.ClearPendingWrites();row.Interaction.ResetForRoute();}
            else row.CurrentWrite?.Completion.TrySetResult(false);
            if(row.State!=RowState.Failed&&row.Baseline is { } durable&&!row.RequiresReload)
