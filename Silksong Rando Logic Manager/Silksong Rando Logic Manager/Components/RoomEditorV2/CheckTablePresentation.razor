    [JSInvokable] public Task<bool> NavigateCheckAsync(string clientRowId,string field,string direction,string? value=null)
    {
        if (disposed || !PageOwned || !Guid.TryParse(clientRowId, out var id) || !ChildTableBrowserFacts.TryField(field, out var typedField) || !ChildTableDraftAdapters.IsText(typedField) || !fields.Contains(field) || !ChildTableBrowserFacts.TryDirection(direction, out var typedDirection)) return Task.FromResult(false);
        var row = AllRows.SingleOrDefault(x => x.ClientDraftId == id);
        return row is null ? Task.FromResult(false) : Navigate(row, typedField, typedDirection, value);
    }
    private async Task<bool> Navigate(Row row, ChildTableField field, ChildTableDirection direction, string? value)
    {
        try
        {
            await InstallTextValue(row,field,value);
            if(row.RequiresReload||row.State==RowState.Failed)return false;
            var controller=Controller(row);
            var rows = Rows(row);
            var decision = ChildTableInteractionPrimitives.Navigate(row.Interaction, controller, fields, rows.Select(x => x.ClientDraftId).ToArray(), Meaningful(row), Changed(row), row.WriteInFlight,
                field, direction, (index, current, next) => Target(rows[index], current, next.Wire()), (draft, promoted) => draft with { ClientDraftId = promoted });
            if (decision == ChildTableNavigationDecision.SubmitBoundary) await Commit(row, field.Wire());
            else if (decision == ChildTableNavigationDecision.Focus) await InvokeAsync(StateHasChanged);
            return decision != ChildTableNavigationDecision.Rejected && row.State != RowState.Failed && !row.RequiresReload;
        }
        catch{return false;}
    }
    [JSInvokable] public Task<bool> BlurCheckAsync(string clientRowId,string field,string? tabTargetId,string? value=null)
    {
        if (disposed || !PageOwned || !Guid.TryParse(clientRowId, out var id) || !ChildTableBrowserFacts.TryField(field, out var typedField) || !ChildTableDraftAdapters.IsText(typedField) || !fields.Contains(field)) return Task.FromResult(true);
        var row = ActiveRows.SingleOrDefault(x => x.ClientDraftId == id);
        return row is null ? Task.FromResult(true) : TextBlur(row, typedField, tabTargetId, value);
    }
    private async Task<bool> TextBlur(Row row, ChildTableField field, string? tabTargetId, string? value)
    {
        var previous=row.Draft;
        await InstallTextValue(row,field,value);
        if(row.RequiresReload||row.State==RowState.Failed)return false;
        if(!row.WriteInFlight&&(!Meaningful(row)||(row.EntityId is not null&&!Changed(row))))return true;
        if(!string.IsNullOrEmpty(tabTargetId)&&(row.EntityId is null||row.Interaction.HasRetainedCorrection||row.WriteInFlight))Controller(row).PendingFocus=ChildTableFocusTarget.Element(tabTargetId);
        else if(row.WriteInFlight&&row.Draft!=previous)Controller(row).PendingFocus=null;
        await Commit(row,field.Wire());return row.State!=RowState.Failed&&!row.RequiresReload;
    }
    private Task InstallTextValue(Row row, ChildTableField field, string? value)
    {
        ChildTableDraftAdapters.InstallGenuineEdit(row.Interaction, ChildTableDraftAdapters.Install(row.Draft, field, value));
        return Notify();
    }
    [JSInvokable] public Task ControlCheckAsync(string clientRowId,string field,string? value)
    {
        if (disposed || !PageOwned || !Guid.TryParse(clientRowId, out var id) || !ChildTableBrowserFacts.TryField(field, out var typedField) || typedField is not (ChildTableField.Type or ChildTableField.Todo or ChildTableField.Verification)) return Task.CompletedTask;
        var row = ActiveRows.SingleOrDefault(x => x.ClientDraftId == id);
        return row is null ? Task.CompletedTask : Control(row, typedField, value);
    }
    private async Task Control(Row row, ChildTableField field, string? value)
    {
        if (!ChildTableDraftAdapters.InstallGenuineEdit(row.Interaction, ChildTableDraftAdapters.Install(row.Draft, field, value))) return;
        if(row.EntityId is null)row.ControlChanged=true;
        if(row.WriteInFlight)Controller(row).PendingFocus=new(row.ClientDraftId,field.Wire());
        await Commit(row,field.Wire());
    }
    [JSInvokable] public async Task ChildActionCheckAsync(string action,string entityId)
    {
        if(disposed||!PageOwned||!Guid.TryParse(entityId,out var id)||!ChildTableBrowserFacts.TryAction(action,out var typedAction))return;
        var row=AllRows.SingleOrDefault(x=>x.EntityId==id);
        if(row is null||row.State!=RowState.Persisted||row.WriteInFlight||row.RequiresReload)return;
        var room=RoomId;var generation=routeGeneration;var intent=new V2DeleteConfirmationIntent(V2DeleteConfirmationKind.Check,id);
        if(typedAction==ChildTableAction.OpenDelete&&row.IsArchived)await(DeleteConfirmationRequested?.Invoke(intent)??Task.CompletedTask);
        else if(typedAction==ChildTableAction.CancelDelete&&row.IsArchived)await(DeleteConfirmationCancelled?.Invoke(intent)??Task.CompletedTask);
        else if(typedAction==ChildTableAction.Delete&&row.IsArchived)await(DeleteConfirmationConfirmed?.Invoke(intent)??Task.CompletedTask);
        else if(typedAction==ChildTableAction.Archive&&!row.IsArchived)await SetArchiveAsync(id,true);
        else if(typedAction==ChildTableAction.Restore&&row.IsArchived)await SetArchiveAsync(id,false);
        OwnsCompletion(room,generation);
    }
    private ChildTableFocusTarget? Target(Row row,string field,string direction)
    {
        var rows=Rows(row);
        return ChildTableInteractionPrimitives.Target(fields,row.ClientDraftId,rows.IndexOf(row),rows.Count,row.IsArchived,row.EntityId is null,Controller(row).LatentSuccessorId,field,direction,index=>rows[index].ClientDraftId);
    }
    [JSInvokable] public async Task DropCheckAsync(string entityId,string partition,int targetIndex,string section)
    {
        if(disposed||!PageOwned||!Guid.TryParse(entityId,out var id)||!ChildTableBrowserFacts.TryPartition(partition,out var typedPartition)||typedPartition!=ChildTablePartition.Active||!ChildTableBrowserFacts.TrySection(section,out var typedSection)||Reorder is null)return;
        var row=ActiveRows.FirstOrDefault(x=>x.EntityId==id);
        if(row?.State!=RowState.Persisted||row.WriteInFlight||row.RequiresReload||row.Interaction.HasRetainedCorrection||Section(row).IsEnemy!=(typedSection==ChildTableSection.Enemies))return;
        var room=RoomId;var generation=routeGeneration;
        var result=await Reorder(id,Section(row).IsEnemy,targetIndex);
        if(!OwnsCompletion(room,generation))return;
        if(result.Status==V2CheckCommandStatus.Committed&&(!result.PresentationRefreshed||result.RequiresRoomReload))return;
        message=result.Message;if(result.Status==V2CheckCommandStatus.Committed)await(RefreshApplied?.Invoke()??Task.CompletedTask);
    }
