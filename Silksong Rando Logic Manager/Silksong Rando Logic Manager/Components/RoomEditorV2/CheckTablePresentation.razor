  private RenderFragment Cells(Row r)=>b=>{var i=0;TypeSelect(b,ref i,r);Text(b,ref i,r,"name","Check name",r.Draft.FriendlyName,true,"text-editor",r.FriendlyNameSeverity);Text(b,ref i,r,"subroom","Check subroom",r.Draft.SubroomReferenceText??"",false,"text-editor",r.SubroomSeverity);Text(b,ref i,r,"requirements","Check requirements",r.Draft.Requirements,true,"detail-editor",RequirementsSeverity(r));Text(b,ref i,r,"notes","Check notes",r.Draft.Notes,true,"detail-editor",V2Severity.Neutral);Toggle(b,ref i,r,"todo","Check is TODO",r.Draft.IsTodo);b.OpenElement(i++,"td");b.AddAttribute(i++,"class",$"verification-cell {(r.EntityId is null?null:r.Draft.IsVerified==true?"verification-success":r.Draft.IsVerified==false?"verification-danger":"verification-warning")}");b.OpenElement(i++,"select");Attrs(b,ref i,r,"verification","Check verification");b.AddAttribute(i++,"autocomplete","off");b.AddAttribute(i++,"value",Verification(r.Draft.IsVerified));b.AddAttribute(i++,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>SelectVerification(r,e)));foreach(var v in new[]{("false","not verified"),("","unknown"),("true","verified")}){b.OpenElement(i++,"option");b.AddAttribute(i++,"value",v.Item1);b.AddContent(i++,v.Item2);b.CloseElement();}b.CloseElement();b.CloseElement();};
  private void TypeSelect(RenderTreeBuilder b,ref int i,Row r){var recognized=r.Draft.LocationType is not null&&View.LocationTypes.Any(type=>string.Equals(type.OutputValue,r.Draft.LocationType,StringComparison.Ordinal));b.OpenElement(i++,"td");b.AddAttribute(i++,"class",$"check-type-cell {SeverityClass(r.EntityId is null?V2Severity.Neutral:r.LocationTypeSeverity)}");b.OpenElement(i++,"select");Attrs(b,ref i,r,"type","Check type");b.AddAttribute(i++,"autocomplete","off");b.AddAttribute(i++,"value",r.Draft.LocationType??"");b.AddAttribute(i++,"disabled",r.IsArchived);b.AddAttribute(i++,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>SelectType(r,e)));b.OpenElement(i++,"option");b.AddAttribute(i++,"value","");b.AddContent(i++,"unknown");b.CloseElement();if(r.Draft.LocationType is { } raw&&!recognized){b.OpenElement(i++,"option");b.AddAttribute(i++,"value",raw);b.AddAttribute(i++,"disabled",true);b.AddContent(i++,$"Unrecognized: {raw}");b.CloseElement();}foreach(var group in View.LocationTypes.GroupBy(type=>type.Group,StringComparer.Ordinal)){b.OpenElement(i++,"optgroup");b.AddAttribute(i++,"label",group.Key);foreach(var type in group){b.OpenElement(i++,"option");b.AddAttribute(i++,"value",type.OutputValue);b.AddContent(i++,type.Name.ToLowerInvariant());b.CloseElement();}b.CloseElement();}b.CloseElement();b.CloseElement();}
   private void Text(RenderTreeBuilder b,ref int i,Row r,string f,string label,string value,bool area,string cssClass,V2Severity severity){if(f=="requirements"){b.OpenElement(i++,"td");b.AddAttribute(i++,"class",RequirementsClass(r,f,DisplaySeverity(r,severity)));if(r.IsArchived){b.OpenElement(i++,"div");b.AddAttribute(i++,"class","requirements-preview");b.AddAttribute(i++,"data-v2-requirements-highlight","");b.AddContent(i++,value);b.CloseElement();}else{b.OpenElement(i++,"div");b.AddAttribute(i++,"class","requirements-editor-layer requirements-inline-layer");b.OpenElement(i++,"div");b.AddAttribute(i++,"data-v2-requirements-highlight","");b.AddContent(i++,value);b.CloseElement();b.OpenElement(i++,"textarea");Attrs(b,ref i,r,"requirements",label);b.AddAttribute(i++,"class","detail-editor requirements-editor");b.AddAttribute(i++,"data-v2-requirements-editor","");b.AddAttribute(i++,"data-v2-requirements-room",RoomId);b.AddAttribute(i++,"rows",1);b.AddAttribute(i++,"value",value);b.CloseElement();b.CloseElement();}b.CloseElement();return;}b.OpenElement(i++,"td");b.AddAttribute(i++,"class",RequirementsClass(r,f,DisplaySeverity(r,severity)));if(!area&&!r.IsArchived)b.AddAttribute(i++,"title",f=="subroom"?r.SubroomReferenceState.ToString():null);b.OpenElement(i++,area?"textarea":"input");Attrs(b,ref i,r,f,label);b.AddAttribute(i++,"class",cssClass);if(r.IsArchived)b.AddAttribute(i++,"readonly",true);b.AddAttribute(i++,"autocomplete",f=="subroom"?null:"off");if(f=="subroom")b.AddAttribute(i++,"list","v2-check-subroom-references");if(area)b.AddAttribute(i++,"rows",1);b.AddAttribute(i++,"value",value);b.CloseElement();b.CloseElement();}
 private void Toggle(RenderTreeBuilder b,ref int i,Row r,string f,string label,bool value){b.OpenElement(i++,"td");b.AddAttribute(i++,"class",$"checkbox-cell {(!r.IsArchived&&f=="todo"&&value?"todo":null)}");b.OpenElement(i++,"input");b.AddAttribute(i++,"type","checkbox");Attrs(b,ref i,r,f,label);b.AddAttribute(i++,"autocomplete","off");b.AddAttribute(i++,"checked",value);b.AddAttribute(i++,"onchange",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>ToggleChanged(r,f,e)));b.CloseElement();b.CloseElement();}
   private void Attrs(RenderTreeBuilder b,ref int i,Row r,string field,string label){b.AddAttribute(i++,"id",Id(r,field));b.AddAttribute(i++,"aria-label",label);b.AddAttribute(i++,"data-v2-check-field",field);b.AddAttribute(i++,"data-v2-check-client-row",r.ClientDraftId);b.AddAttribute(i++,"data-v2-child-row-changed",Changed(r)?"true":"false");foreach(var direction in new[]{"left","right","up","down"})if(Target(r,field,direction) is { } target){b.AddAttribute(i++,$"data-v2-check-{direction}",$"{target.ClientRowId}|{target.Field}");if(target.ClientRowId==latentSuccessorId)b.AddAttribute(i++,$"data-v2-check-{direction}-latent","true");}}
  private RenderFragment Grip(Row row)=>b=>{var i=0;if(!row.IsArchived&&row.EntityId is Guid&&row.State==RowState.Persisted){b.OpenElement(i++,"button");b.AddAttribute(i++,"class","reorder-handle");b.AddAttribute(i++,"type","button");b.AddAttribute(i++,"draggable","true");b.AddAttribute(i++,"data-v2-check-grip","true");b.AddAttribute(i++,"title","Reorder check");b.AddAttribute(i++,"aria-label",$"Reorder check: {row.Draft.FriendlyName}");b.OpenElement(i++,"i");b.AddAttribute(i++,"class","fa-solid fa-grip-vertical");b.AddAttribute(i++,"aria-hidden","true");b.CloseElement();b.CloseElement();}else if(!row.IsArchived&&row.State==RowState.Saving){b.OpenElement(i++,"i");b.AddAttribute(i++,"class","fa-solid fa-spinner fa-spin");b.AddAttribute(i++,"role","img");b.AddAttribute(i++,"aria-label","Saving check");b.CloseElement();}else if(!row.IsArchived&&row.State==RowState.Failed){b.OpenElement(i++,"i");b.AddAttribute(i++,"class","fa-solid fa-circle-xmark danger");b.AddAttribute(i++,"role","img");b.AddAttribute(i++,"title",Failure(row));b.AddAttribute(i++,"aria-label",Failure(row));b.CloseElement();}};
   private static V2Severity DisplaySeverity(Row row,V2Severity severity)=>row.IsArchived?V2Severity.Neutral:severity; private static string? SeverityClass(V2Severity severity)=>severity switch { V2Severity.Warning=>"warning",V2Severity.Danger=>"danger",_=>null }; private static string? RequirementsClass(Row row,string field,V2Severity severity)=>severity switch { V2Severity.Warning=>"warning", V2Severity.Danger=>"danger", _ when !row.IsArchived&&field=="requirements"&&row.Draft.IsTodo=>"warning", _=>null }; private static V2Severity RequirementsSeverity(Row row)=>row.Baseline is { } baseline&&row.Draft.Requirements!=baseline.Requirements?(string.IsNullOrWhiteSpace(row.Draft.Requirements)||row.Draft.IsTodo?V2Severity.Warning:V2Severity.Neutral):row.RequirementsSeverity; private static string? RowClass(Row row)=>row.State==RowState.Saving?"child-row-saving":row.State==RowState.Failed?"child-row-failed":row.EntityId is null?"uncommitted-row":null;
  private async Task ToggleChanged(Row r,string f,ChangeEventArgs e){var selected=e.Value is bool enabled&&enabled;r.Draft=r.Draft with{IsTodo=selected};r.Interaction.BeginRetryFromEdit();await Commit(r,f);} private async Task SelectType(Row r,ChangeEventArgs e){var value=e.Value?.ToString();r.Draft=r.Draft with{LocationType=string.IsNullOrEmpty(value)?null:value};r.Interaction.BeginRetryFromEdit();await Commit(r,"type");} private async Task SelectVerification(Row r,ChangeEventArgs e){r.Draft=r.Draft with{IsVerified=e.Value?.ToString() switch{"true"=>true,"false"=>false,_=>null}};r.Interaction.BeginRetryFromEdit();await Commit(r,"verification");}
 private async Task Commit(Row r,string? correction=null){if(!Meaningful(r)||(r.EntityId is not null&&!Changed(r))||!r.Interaction.BeginSave())return;try{var result=r.Baseline is null?await(Create?.Invoke(r.Draft)??Unavailable("Creation")):await(Save?.Invoke(r.Baseline,r.Draft)??Unavailable("Saving"));if(result.Status==V2CheckCommandStatus.Unexpected)throw new InvalidOperationException(result.Message);message=result.Message;if(result.Status==V2CheckCommandStatus.Committed){if(result.CreatedEntityId is Guid id&&tabFocusAwaitingRefresh)tabFocusCreatedEntityId=id;r.Interaction.CompleteCommitted(result.CreatedEntityId);await(RefreshApplied?.Invoke()??Task.CompletedTask);}else{if(result.Status==V2CheckCommandStatus.Unchanged)r.Interaction.CompleteUnchanged();else Fail(r,correction,result.Message,result.FreshBaseline);}}catch{message="Save failed; edit a field to try again.";Fail(r,correction,message,null);}await Notify();if(r.State==RowState.Failed)await InvokeAsync(StateHasChanged);}
  private void Fail(Row row,string? correction,string? failure,CheckDurableBaseline? freshBaseline){row.Interaction.Fail(failure??"Save failed; edit a field to try again.",freshBaseline);pendingTailPromotionId=null;tabFocusAwaitingRefresh=false;tabFocusCreatedEntityId=null;pendingFocus=new(row.ClientDraftId,correction??"name");}
   private async Task EditInGameData(Row row){if(row.EntityId is Guid id&&View.ActiveRows.SingleOrDefault(x=>x.EntityId==id) is { } source){var result=await(EditInGameDataRequested?.Invoke(RoomEditorV2CommandService.CheckMetadataFromView(source),$"v2-check-metadata-{id}")??Unavailable("Metadata editing"));message=result.Message;}} private Task Annotation(Row row)=>row.EntityId is Guid id?Annotation(row,id):Task.CompletedTask; private Task Annotation(Row row,Guid id){var source=View.ActiveRows.SingleOrDefault(x=>x.EntityId==id);if(source is null)return Task.CompletedTask;var usable=Usable(source.AnnotationSceneUnitX,source.AnnotationSceneUnitY);return AnnotationRequested?.Invoke(RoomEditorV2CommandService.CheckMetadataFromView(source),$"v2-check-{(source.EnableAnnotation&&usable?"select":usable?"show":"place")}-{id}") ?? Task.CompletedTask;} private string AnnotationActionText(bool renderable,bool usable)=>!SceneActionsAvailable?SceneActionsUnavailableReason:renderable?"select annotation":usable?"show and select annotation":"re-arm placement"; private async Task Archive(Row row,bool archived){if(row.EntityId is not Guid id)return;var result=await(SetArchive?.Invoke(id,archived)??Unavailable("Archive"));message=result.Message;if(result.Status==V2CheckCommandStatus.Committed)await(RefreshApplied?.Invoke()??Task.CompletedTask);} private static bool Usable(double? x,double? y)=>x is double a&&y is double b&&double.IsFinite(a)&&double.IsFinite(b);
  private Task RequestDelete(Row row) => row.EntityId is Guid id ? DeleteConfirmationRequested?.Invoke(new(V2DeleteConfirmationKind.Check,id)) ?? Task.CompletedTask : Task.CompletedTask;
    [JSInvokable] public async Task<bool> NavigateCheckAsync(string clientRowId,string field,string direction,string? value=null){try{if(!Guid.TryParse(clientRowId,out var id)||!fields.Contains(field)||direction is not("left" or "right" or "up" or "down"))return false;var row=active.Concat(archived).SingleOrDefault(x=>x.ClientDraftId==id);if(row is null)return false;await InstallTextValue(row,field,value);if(Target(row,field,direction) is not { } target)return false;if(row.State==RowState.Saving){Advance(row,direction);return true;}if(row.EntityId is not null){pendingFocus=target;if(Changed(row))await Commit(row,field);else await InvokeAsync(StateHasChanged);return true;}if(!Meaningful(row)){if(target.ClientRowId==latentSuccessorId){row.Interaction.PromoteClientRowId(latentSuccessorId);latentSuccessorId=Guid.NewGuid();}pendingFocus=target.ClientRowId==latentSuccessorId?new(row.ClientDraftId,target.Field!):target;await InvokeAsync(StateHasChanged);return true;}pendingFocus=target;pendingTailPromotionId=target.ClientRowId==latentSuccessorId?target.ClientRowId:null;await Commit(row,field);return true;}catch{return false;}}
    [JSInvokable] public async Task<bool> BlurCheckAsync(string clientRowId,string field,string? tabTargetId,string? value=null){if(!Guid.TryParse(clientRowId,out var id)||!fields.Contains(field))return true;var row=active.Concat(archived).SingleOrDefault(x=>x.ClientDraftId==id);if(row is null)return true;await InstallTextValue(row,field,value);if(row.State==RowState.Saving||!Meaningful(row)||(row.EntityId is not null&&!Changed(row)))return row.State!=RowState.Failed;if(row.EntityId is null&&!string.IsNullOrEmpty(tabTargetId)){pendingFocus=ChildTableFocusTarget.Element(tabTargetId);tabFocusAwaitingRefresh=true;}await Commit(row,field);return row.State!=RowState.Failed;}
    private async Task InstallTextValue(Row row,string field,string? value){if(value is null)return;var edited=field switch{"name"=>row.Draft.FriendlyName!=value,"subroom"=>row.Draft.SubroomReferenceText!=value,"requirements"=>row.Draft.Requirements!=value,"notes"=>row.Draft.Notes!=value,_=>false};if(edited){row.Draft=field switch{"name"=>row.Draft with{FriendlyName=value},"subroom"=>row.Draft with{SubroomReferenceText=value},"requirements"=>row.Draft with{Requirements=value},"notes"=>row.Draft with{Notes=value},_=>row.Draft};row.Interaction.BeginRetryFromEdit();}await Notify();}
  [JSInvokable] public async Task ControlCheckAsync(string clientRowId,string field,string? value){var row=active.Concat(archived).SingleOrDefault(x=>x.ClientDraftId.ToString()==clientRowId);if(row is null)return;if(field=="todo")row.Draft=row.Draft with{IsTodo=string.Equals(value,"true",StringComparison.OrdinalIgnoreCase)};else if(field=="type")row.Draft=row.Draft with{LocationType=string.IsNullOrEmpty(value)?null:value};else if(field=="verification")row.Draft=row.Draft with{IsVerified=value switch{"true"=>true,"false"=>false,_=>null}};else return;row.Interaction.BeginRetryFromEdit();await Commit(row,field);}
 [JSInvokable] public async Task ChildActionCheckAsync(string action,string entityId){if(!Guid.TryParse(entityId,out var id))return;var intent=new V2DeleteConfirmationIntent(V2DeleteConfirmationKind.Check,id);if(action=="open-delete"){await(DeleteConfirmationRequested?.Invoke(intent)??Task.CompletedTask);return;}if(action=="cancel-delete"){await(DeleteConfirmationCancelled?.Invoke(intent)??Task.CompletedTask);return;}if(action=="delete"){await(DeleteConfirmationConfirmed?.Invoke(intent)??Task.CompletedTask);return;}var archivedValue=action=="archive";var result=await(SetArchive?.Invoke(id,archivedValue)??Unavailable("Archive"));message=result.Message;if(result.Status==V2CheckCommandStatus.Committed)await(RefreshApplied?.Invoke()??Task.CompletedTask);}
 private void Advance(Row row,string direction){if(pendingFocus is not { } x)return;var i=fields.IndexOf(x.Field!);if(direction=="left"&&i>0)pendingFocus=new(x.ClientRowId!.Value,fields[i-1]);else if(direction=="right"&&i<fields.Length-1)pendingFocus=new(x.ClientRowId!.Value,fields[i+1]);else if(direction=="down"){pendingFocus=new(latentSuccessorId,x.Field!);pendingTailPromotionId=latentSuccessorId;latentSuccessorId=Guid.NewGuid();}else if(direction=="up")pendingFocus=new(row.ClientDraftId,x.Field!);} private ChildTableFocusTarget? Target(Row row,string field,string direction){var rows=row.IsArchived?archived:active;return ChildTableInteractionPrimitives.Target(fields,row.ClientDraftId,rows.IndexOf(row),rows.Count,row.IsArchived,row.EntityId is null,latentSuccessorId,field,direction,index=>rows[index].ClientDraftId);}
