@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<h2 id="v2-page-modal-title">set up inverse?</h2><p id="v2-page-modal-description"><strong>@View.SourceFriendlyName</strong> proposes an inverse for <strong>@View.TargetFriendlyName</strong>. @if (View.FillsDestinationRoomReference || View.FillsDestinationAlias) { <span>The blank target field@(View.FillsDestinationRoomReference && View.FillsDestinationAlias ? "s" : "") will receive @if (View.FillsDestinationRoomReference) { <code>@View.SourceRoomReferenceId</code> } @if (View.FillsDestinationRoomReference && View.FillsDestinationAlias) { <span> and </span> } @if (View.FillsDestinationAlias) { <code>@View.SourceAlias</code> }.</span> }</p><div class="v2-modal-footer"><div><button class="compact-control" type="button" @onclick="Revert" disabled="@Disabled">revert change</button></div><div><button class="compact-control" type="button" @onclick="DoNotUpdate" disabled="@Disabled">do not update inverse</button><button class="compact-control" type="button" @onclick="Update" disabled="@Disabled">update inverse</button></div></div>
@code { [Parameter, EditorRequired] public V2InverseSetupProposalView View { get; set; } = null!; [Parameter] public EventCallback Revert { get; set; } [Parameter] public EventCallback DoNotUpdate { get; set; } [Parameter] public EventCallback Update { get; set; } [Parameter] public bool Disabled { get; set; } }
