@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<section class="document-section transition-table-presentation"><h2>room transitions</h2>
<table class="logic-table transition-table" data-v2-transition-table="active" data-v2-child-count="@active.Count(x=>x.EntityId is not null)"><colgroup><col class="reorder-column"/><col class="transition-alias-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="transition-destination-alias-column"/><col class="transition-inverse-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="checkbox-column"/><col class="verification-column"/><col class="actions-column"/></colgroup><thead><tr><th></th><th>alias</th><th>name</th><th>from subroom</th><th>destination room</th><th>destination alias</th><th>inverse</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th></th></tr></thead><tbody>@for(var n=0;n<active.Count;n++){var r=active[n];<tr @key="r.ClientDraftId" class="@RowClass(r)" data-v2-transition-row="@r.EntityId" data-v2-child-index="@(r.EntityId is null?null:active.Take(n).Count(x=>x.EntityId is not null))" data-v2-transition-tail="@(r.EntityId is null?"true":null)"><td class="reorder-cell">@Grip(r)</td>@Cells(r)<td class="row-actions">@ActiveActions(r)</td></tr>}</tbody></table>
<datalist id="v2-transition-room-references">@foreach(var x in View.RoomReferenceSuggestions){<option value="@x"/>}</datalist><datalist id="v2-transition-subroom-references">@foreach(var x in View.SubroomReferenceSuggestions){<option value="@x"/>}</datalist>@foreach(var x in View.DestinationAliasSuggestionsByTransitionId){<datalist id="v2-transition-aliases-@x.Key">@foreach(var v in x.Value){<option value="@v"/>}</datalist>}
@if(ShowArchivedChildren&&View.ArchivedRows.Count>0){<div class="archived-table-label">[archived]</div><table class="logic-table transition-table" data-v2-transition-table="archived" data-v2-child-count="@archived.Count"><colgroup><col class="reorder-column"/><col class="transition-alias-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="transition-destination-alias-column"/><col class="transition-inverse-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="checkbox-column"/><col class="verification-column"/><col class="actions-column"/></colgroup><thead><tr><th></th><th>alias</th><th>name</th><th>from subroom</th><th>destination room</th><th>destination alias</th><th>inverse</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th></th></tr></thead><tbody>@for(var n=0;n<archived.Count;n++){var r=archived[n];<tr @key="r.ClientDraftId" data-v2-transition-row="@r.EntityId" data-v2-child-index="@n"><td class="reorder-cell"></td>@Cells(r)<td class="row-actions"><span class="action-slot"></span><span class="action-slot"><button type="button" title="restore" aria-label="restore" @onclick="()=>ArchiveRow(r,false)"><i class="fa-solid fa-rotate-left"/></button></span><span class="action-slot"><button id="v2-transition-delete-@r.EntityId" type="button" title="delete permanently" aria-label="delete permanently" @onclick="()=>DeleteRow(r)"><i class="fa-solid fa-trash"/></button></span></td></tr>}</tbody></table>}
@if(message is not null){<p class="warning" role="status">@message</p>}
</section>
