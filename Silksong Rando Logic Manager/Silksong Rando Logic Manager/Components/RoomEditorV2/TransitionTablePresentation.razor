@using Microsoft.JSInterop
@implements IDisposable
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<section class="document-section transition-table-presentation"><h2>room transitions</h2>
<table class="logic-table transition-table" data-v2-transition-table="active" data-v2-child-count="@active.Count(x=>x.EntityId is not null)"><colgroup><col class="reorder-column"/><col class="transition-alias-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="transition-destination-alias-column"/><col class="transition-inverse-column"/><col class="checkbox-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="checkbox-column"/><col class="verification-column"/><col class="actions-column"/></colgroup><thead><tr><th></th><th>alias</th><th>name</th><th>from subroom</th><th>destination room</th><th>destination alias</th><th>inverse</th><th title="@UnsafeArrivalLabel" aria-label="@UnsafeArrivalLabel">unsafe arrival</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th></th></tr></thead><tbody>@for(var n=0;n<active.Count;n++){var r=active[n];<tr @key="r.ClientDraftId" data-v2-row-annotation-kind="exit" data-v2-row-annotation-id="@r.EntityId" class="@RowClass(r)" data-v2-transition-row="@r.EntityId" data-v2-child-index="@(r.EntityId is null?null:active.Take(n).Count(x=>x.EntityId is not null))" data-v2-transition-tail="@(r.EntityId is null?"true":null)"><td class="reorder-cell">@Grip(r)</td>@Cells(r)<td class="row-actions">@ActiveActions(r)</td></tr>}</tbody></table>
<datalist id="v2-transition-room-references">@foreach(var x in View.RoomReferenceSuggestions){<option value="@x"/>}</datalist><datalist id="v2-transition-subroom-references">@foreach(var x in View.SubroomReferenceSuggestions){<option value="@x"/>}</datalist>@foreach(var x in View.DestinationAliasSuggestionsByTransitionId){<datalist id="v2-transition-aliases-@x.Key">@foreach(var v in x.Value){<option value="@v"/>}</datalist>}
@if(ShowArchivedChildren&&View.ArchivedRows.Count>0){<div class="archived-table-label">[archived]</div><table class="logic-table transition-table" data-v2-transition-table="archived" data-v2-child-count="@archived.Count"><colgroup><col class="reorder-column"/><col class="transition-alias-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="transition-destination-alias-column"/><col class="transition-inverse-column"/><col class="checkbox-column"/><col class="transition-text-column"/><col class="transition-text-column"/><col class="checkbox-column"/><col class="verification-column"/><col class="actions-column"/></colgroup><thead><tr><th></th><th>alias</th><th>name</th><th>from subroom</th><th>destination room</th><th>destination alias</th><th>inverse</th><th title="@UnsafeArrivalLabel" aria-label="@UnsafeArrivalLabel">unsafe arrival</th><th>requirements</th><th>notes</th><th>todo</th><th>verify</th><th></th></tr></thead><tbody>@for(var n=0;n<archived.Count;n++){var r=archived[n];<tr @key="r.ClientDraftId" data-v2-transition-row="@r.EntityId" data-v2-child-index="@n"><td class="reorder-cell"></td>@Cells(r)<td class="row-actions"><span class="action-slot"></span><span class="action-slot"><button type="button" title="restore" aria-label="restore" @onclick="()=>ArchiveRow(r,false)"><i class="fa-solid fa-rotate-left"/></button></span><span class="action-slot"><button id="v2-transition-delete-@r.EntityId" type="button" title="delete permanently" aria-label="delete permanently" @onclick="()=>DeleteRow(r)"><i class="fa-solid fa-trash"/></button></span></td></tr>}</tbody></table>}
@if(message is not null){<p class="warning" role="status">@message</p>}
</section>
@code {
    private const string UnsafeArrivalLabel = "Arrival here may cause collisions or other problems.";
    [Parameter,EditorRequired] public long OwnerGeneration {get;set;}
    [Parameter,EditorRequired] public Func<bool> OwnerIsCurrent {get;set;}=null!;
    private long renderedOwnerGeneration=-1;
    private bool PageOwned=>!disposed&&OwnerIsCurrent?.Invoke()==true;
  [Parameter,EditorRequired] public TransitionTableView View {get;set;}=null!; [Parameter] public Guid RoomId {get;set;} [Parameter] public bool ShowArchivedChildren {get;set;} [Parameter] public bool SceneActionsAvailable {get;set;} [Parameter] public string SceneActionsUnavailableReason {get;set;}="Scene annotation actions are unavailable."; [Parameter] public Func<Guid,string,Task>? FocusRequested {get;set;} [Parameter] public Func<TransitionDurableBaseline,TransitionDraft,string,string?,Task<V2TransitionCommandOutcome>>? Save {get;set;} [Parameter] public Func<TransitionDraft,string,string?,Task<V2TransitionCommandOutcome>>? Create {get;set;} [Parameter] public Func<Guid,int,Task<V2TransitionCommandOutcome>>? Reorder {get;set;} [Parameter] public Func<Guid,bool,Task<V2TransitionCommandOutcome>>? SetArchive {get;set;} [Parameter] public Func<Guid,string,Task<V2TransitionCommandOutcome>>? PermanentDeleteRequested {get;set;} [Parameter] public Func<TransitionDurableBaseline,string,Task<V2TransitionCommandOutcome>>? EditInGameDataRequested {get;set;} [Parameter] public Func<TransitionDurableBaseline,TransitionDraft,string,Task<V2TransitionCommandOutcome>>? InverseStatusActionRequested {get;set;} [Parameter] public Func<Guid,Task<bool>>? InverseRoomNavigationRequested {get;set;} [Parameter] public Func<TransitionDurableBaseline,string,Task>? AnnotationRequested {get;set;} [Parameter] public Func<TransitionDurableBaseline,string,Task>? PlaceAnnotationRequested {get;set;} [Parameter] public Func<bool,Task>? DraftStateChanged {get;set;} [Parameter] public Func<Task>? RefreshApplied {get;set;} [Parameter] public Func<Task>? ClearDragFeedback {get;set;}
 private static readonly string[] fields=["alias","name","source","destination-room","destination-alias","requirements","notes"]; private readonly List<Row> active=[]; private readonly List<Row> archived=[]; private readonly Dictionary<Guid,TransitionDraft> retainedDrafts=[]; private readonly ChildTableInteractionController interaction=new(); private Guid? room; private string? message; private bool clear;
    private bool disposed; private long routeGeneration;
    private TransitionTableView? pendingView, appliedView;
    private readonly Dictionary<Row,ChildTableBoundaryOwnership<TransitionDurableBaseline,TransitionDraft>> boundaries=[];
    private ChildTableBoundaryOwnership<TransitionDurableBaseline,TransitionDraft> Boundary(Row row)=>boundaries.TryGetValue(row,out var owner)?owner:boundaries[row]=new(row.Interaction,ChildTableDraftAdapters.TransitionBoundaries);
    private bool Owns(Guid source,long generation)=>!disposed&&PageOwned&&RoomId==source&&routeGeneration==generation;
    private readonly ChildTableEventCompletionGuard eventCompletion=new();
    private Task Event(Func<Task> action){var source=RoomId;var generation=routeGeneration;return eventCompletion.RunAsync(action,()=>Owns(source,generation));}
    protected override bool ShouldRender()=>eventCompletion.ShouldRender(!disposed&&PageOwned);
    private void Reset(){routeGeneration++;foreach(var owner in boundaries.Values)owner.Reset();boundaries.Clear();interaction.ResetForRoute(active.Concat(archived));active.Clear();archived.Clear();retainedDrafts.Clear();pendingView=appliedView=null;}
    public void Dispose(){disposed=true;Reset();}
    protected override void OnParametersSet(){if((room is Guid old&&old!=RoomId)||(renderedOwnerGeneration>=0&&renderedOwnerGeneration!=OwnerGeneration)){Reset();clear=true;}room=RoomId;renderedOwnerGeneration=OwnerGeneration;ApplyFreshView(RoomId,View);}
    public void ApplyFreshView(Guid source,TransitionTableView fresh){if(disposed||source!=RoomId)return;pendingView=fresh;Reconcile();}
    private void Reconcile()
    {
        if(disposed||pendingView is not { } fresh||ReferenceEquals(appliedView,fresh)||boundaries.Values.Any(owner=>owner.HoldsPresentation))return;
        var localDrafts=active.Where(row=>row.EntityId is not null&&row.State==ChildTableRowLifecycle.Persisted).ToDictionary(row=>row.EntityId!.Value,row=>(row.Baseline,row.Draft));
        ChildTableRowReconciliation.Reconcile(active,archived,fresh.ActiveRows,fresh.ArchivedRows,x=>x.EntityId,x=>x.EntityId,Row.From,(r,x)=>r.Load(x),Row.Empty,interaction);
        foreach(var row in active)if(row.EntityId is Guid id&&localDrafts.TryGetValue(id,out var local)&&local.Baseline==row.Baseline)row.Draft=local.Draft;
        appliedView=fresh;pendingView=null;
        foreach(var removed in boundaries.Keys.Where(row=>!active.Contains(row)&&!archived.Contains(row)).ToArray()){boundaries[removed].Reset();boundaries.Remove(removed);}
        _=Notify();
    }
    protected override async Task OnAfterRenderAsync(bool first){if(disposed)return;if(clear){clear=false;await(ClearDragFeedback?.Invoke()??Task.CompletedTask);}if(!boundaries.Values.Any(owner=>owner.HoldsPresentation)&&interaction.TakePendingFocus() is { } target)await(FocusRequested?.Invoke(RoomId,target.ElementId)??Task.CompletedTask);}
    public Task ResumeAfterRoomReloadAsync(TransitionTableView fresh){foreach(var owner in boundaries.Values)owner.ResumeAfterReload();ApplyFreshView(RoomId,fresh);return Notify();}
    private RenderFragment Cells(Row r) => @<text>
        <td class="@Severity(r, r.AliasSeverity, "alias")"><input @attributes='FieldAttributes(r, ChildTableField.Alias, "Transition alias")' class="alias-editor" autocomplete="off" value="@r.Draft.Alias" readonly="@r.IsArchived" /></td>
        <td class="@Severity(r, r.NameSeverity, "name")"><input @attributes='FieldAttributes(r, ChildTableField.Name, "Transition friendly name")' class="text-editor focus-muted" autocomplete="off" value="@r.Draft.FriendlyName" readonly="@r.IsArchived" /></td>
        <td class="@Severity(r, r.SourceSeverity, "source")"><input @attributes='FieldAttributes(r, ChildTableField.Source, "Transition source subroom reference")' class="text-editor" list="v2-transition-subroom-references" value="@(r.Draft.SourceSubroomReferenceText ?? "")" readonly="@r.IsArchived" /></td>
        <td class="@Severity(r, r.DestinationRoomSeverity, "destination-room")"><input @attributes='FieldAttributes(r, ChildTableField.DestinationRoom, "Transition destination room reference")' class="text-editor focus-muted" list="v2-transition-room-references" value="@(r.Draft.DestinationRoomReferenceText ?? "")" readonly="@r.IsArchived" /></td>
        <td class="@Severity(r, r.DestinationAliasSeverity, "destination-alias")"><input @attributes='FieldAttributes(r, ChildTableField.DestinationAlias, "Transition destination alias")' class="alias-editor focus-muted" list="@(r.EntityId is Guid id ? $"v2-transition-aliases-{id}" : null)" autocomplete="@(r.EntityId is null ? "off" : null)" value="@(r.Draft.DestinationTransitionAliasText ?? "")" readonly="@r.IsArchived" /></td>
        <td class="transition-inverse-state">@if (!r.IsArchived && r.EntityId is not null) { @Inverse(r) }</td>
        <td class="checkbox-cell transition-unsafe-arrival-cell" title="@UnsafeArrivalLabel"><label class="transition-unsafe-arrival-target" for="@ChildTableInteractionPrimitives.FieldId(r.ClientDraftId, ChildTableField.UnsafeArrival.Wire())"><input @attributes='FieldAttributes(r, ChildTableField.UnsafeArrival, UnsafeArrivalLabel)' type="checkbox" checked="@r.Draft.IsUnsafeArrival" disabled="@r.IsArchived" @onchange="e => UnsafeArrival(r, e)" /></label></td>
        <td class="@Severity(r, AppliedRequirementsSeverity(r), "requirements")">
            @if (r.IsArchived)
            {
                <div class="requirements-preview" data-v2-requirements-highlight="">@r.Draft.Requirements</div>
            }
            else
            {
                <div class="requirements-editor-layer requirements-inline-layer">
                    <div data-v2-requirements-highlight="">@r.Draft.Requirements</div>
                    <textarea @attributes='FieldAttributes(r, ChildTableField.Requirements, "Transition requirements")' class="detail-editor requirements-editor" data-v2-requirements-editor="" data-v2-requirements-room="@RoomId" rows="1" value="@r.Draft.Requirements"></textarea>
                </div>
            }
        </td>
        <td><textarea @attributes='FieldAttributes(r, ChildTableField.Notes, "Transition notes")' class="detail-editor" autocomplete="off" rows="1" value="@r.Draft.Notes" readonly="@r.IsArchived"></textarea></td>
        <td class="checkbox-cell @(!r.IsArchived && r.Draft.IsTodo ? "todo" : null)"><input @attributes='FieldAttributes(r, ChildTableField.Todo, "Transition is TODO")' type="checkbox" checked="@r.Draft.IsTodo" disabled="@r.IsArchived" @onchange="e => Toggle(r, e)" /></td>
        <td class="verification-cell @(r.IsArchived || r.EntityId is null ? null : r.Draft.IsVerified == true ? "verification-success" : r.Draft.IsVerified == false ? "verification-danger" : "verification-warning")">
            <select @attributes='FieldAttributes(r, ChildTableField.Verification, "Transition verification")' value="@Verify(r.Draft.IsVerified)" disabled="@r.IsArchived" @onchange="e => Select(r, e)">
                <option value="false">not verified</option><option value="">unknown</option><option value="true">verified</option>
            </select>
        </td>
    </text>;
    private Dictionary<string, object> FieldAttributes(Row row, ChildTableField field, string label)
    {
        var facts=ChildTableBrowserFacts.FieldAttributes("transition",row.ClientDraftId,field,label,Changed(row),interaction.LatentSuccessorId,direction=>Target(row,field.Wire(),direction.Wire()));
        if(Boundary(row).ReconcileNative&&ChildTableDraftAdapters.NativeValue(row.Draft,field) is { } native)
        {
            facts["data-v2-child-reconcile-value"]=native;
            facts["data-v2-child-reconcile-exclusive"]=Boundary(row).ProposalExclusive?"true":"false";
        }
        return facts;
    }
    private RenderFragment Grip(Row r) => @<text>
        @if (!r.IsArchived && r.EntityId is Guid && r.State == ChildTableRowLifecycle.Persisted && !Boundary(r).HoldsPresentation)
        {
            <button class="reorder-handle" type="button" draggable="true" data-v2-transition-grip="true" title="Reorder transition" aria-label="@($"Reorder transition: {r.Draft.FriendlyName}")"><i class="fa-solid fa-grip-vertical" aria-hidden="true"></i></button>
        }
        else if (!r.IsArchived && (r.State == ChildTableRowLifecycle.Saving || Boundary(r).InFlight))
        {
            <i class="fa-solid fa-spinner fa-spin" role="img" aria-label="Saving transition"></i>
        }
        else if (!r.IsArchived && r.State == ChildTableRowLifecycle.Failed)
        {
            <i class="fa-solid fa-circle-xmark danger" role="img" aria-label="Save failed; edit a field to try again."></i>
        }
    </text>;
    private RenderFragment ActiveActions(Row r) => @<text>
        @if (r.EntityId is Guid id)
        {
            var usable = Usable(r.Baseline?.AnnotationSceneUnitX, r.Baseline?.AnnotationSceneUnitY);
            var renderable = r.Baseline?.EnableAnnotation == true && usable;
            var annotationText = AnnotationActionText(renderable, usable);
            <span class="action-slot"><button id="v2-transition-metadata-@id" type="button" title="edit in-game data" aria-label="edit in-game data" disabled="@(r.State != ChildTableRowLifecycle.Persisted)" @onclick="() => EditInGameData(r)"><i class="fa-solid fa-pen"></i></button></span>
            <span class="action-slot"><button id="@($"v2-transition-{(renderable ? "select" : usable ? "show" : "place")}-{id}")" type="button" title="@annotationText" aria-label="@annotationText" disabled="@(r.State != ChildTableRowLifecycle.Persisted || !SceneActionsAvailable)" @onclick="() => Annotation(r)"><span class="annotation-crosshairs @(renderable ? null : "annotation-crosshairs-warning")" aria-hidden="true"><i class="fa-solid fa-crosshairs"></i></span></button></span>
            <span class="action-slot"><button type="button" title="archive" aria-label="archive" disabled="@(r.State != ChildTableRowLifecycle.Persisted)" @onclick="() => ArchiveRow(r, true)"><i class="fa-solid fa-box-archive"></i></button></span>
        }
    </text>;
    private Task Toggle(Row r, ChangeEventArgs e) => Event(()=>Control(r, ChildTableField.Todo, e.Value is bool enabled && enabled ? "true" : "false"));
    private Task UnsafeArrival(Row r, ChangeEventArgs e) => Event(()=>Control(r, ChildTableField.UnsafeArrival, e.Value is bool enabled && enabled ? "true" : "false"));
    private Task Select(Row r, ChangeEventArgs e) => Event(()=>Control(r, ChildTableField.Verification, e.Value?.ToString()));
    private Task Commit(Row row,string correction,string? pending)
    {
        var source=RoomId;var generation=routeGeneration;var create=Create;var save=Save;var publish=RefreshApplied;
        var field=ChildTableBrowserFacts.TryField(correction,out var typed)?typed:ChildTableField.Name;
        return Boundary(row).SubmitAsync(field,interaction,Meaningful(row),Changed(row),
            async(baseline,draft,initiator,target)=>ChildTableDraftAdapters.Completion(baseline is null
                ?await(create?.Invoke(draft,ChildTableInteractionPrimitives.FieldId(row.ClientDraftId,initiator.Wire()),target?.ElementId)??Unavailable("Creation"))
                :await(save?.Invoke(baseline,draft,ChildTableInteractionPrimitives.FieldId(row.ClientDraftId,initiator.Wire()),target?.ElementId)??Unavailable("Saving"))),
            ()=>Owns(source,generation),Notify,
            async()=>{await(publish?.Invoke()??Task.CompletedTask);if(Owns(source,generation)){Reconcile();await InvokeAsync(StateHasChanged);}},value=>message=value);
    }
    public bool FollowBlocked => !PageOwned || active.Concat(archived).Any(row => Boundary(row).HoldsPresentation || row.State == ChildTableRowLifecycle.Failed || row.Interaction.HasRetainedCorrection || row.EntityId is null && Meaningful(row));
    public bool AdmitsFollowBoundary(ArchipelagoFollowBoundary native)
    {
        if (FollowBlocked || !Guid.TryParse(native.Client, out var id) || !ChildTableBrowserFacts.TryField(native.Field, out var field) || !fields.Contains(native.Field) && field is not (ChildTableField.Todo or ChildTableField.Verification or ChildTableField.UnsafeArrival)) return false;
        var row = active.SingleOrDefault(row => row.ClientDraftId == id);
        return row is not null && (row.EntityId is not null || (ChildTableDraftAdapters.IsText(field) ? native.Value.Length == 0 : native.Value == ChildTableDraftAdapters.NativeValue(row.Draft, field)));
    }
    private void Fail(Row row, string correction, string? failure, TransitionDurableBaseline? freshBaseline)
    {
        if (row.Baseline is { } previous && freshBaseline is { } fresh) row.Draft = ChildTableDraftAdapters.Rebase(previous, row.Draft, ChildTableDraftAdapters.From(fresh, row.ClientDraftId));
        row.Interaction.Fail(failure ?? "Save failed; edit a field to try again.", freshBaseline, retainCorrection: true);
        if (correction == "requirements") { interaction.TakePendingFocus(); interaction.SetPendingFocus(new(row.ClientDraftId, "requirements")); }
    }
    [JSInvokable] public Task<bool> NavigateTransitionAsync(string client, string field, string direction, string? value=null)
    {
        if (!Guid.TryParse(client, out var id) || !ChildTableBrowserFacts.TryField(field, out var typedField) || !fields.Contains(field) || !ChildTableBrowserFacts.TryDirection(direction, out var typedDirection)) return Task.FromResult(false);
        var row = active.Concat(archived).SingleOrDefault(x => x.ClientDraftId == id);
        return row is null ? Task.FromResult(false) : Navigate(row, typedField, typedDirection, value);
    }
    private async Task<bool> Navigate(Row row, ChildTableField field, ChildTableDirection direction, string? value)
    {
        if(disposed||!PageOwned||Boundary(row).ProposalExclusive)return false;
        InstallTextValue(row,field,value);if(Boundary(row).RequiresReload)return false;
        var rows = row.IsArchived ? archived : active;
        var decision = ChildTableInteractionPrimitives.Navigate(row.Interaction, interaction, fields, rows.Select(x => x.ClientDraftId).ToArray(), Meaningful(row), Changed(row), Boundary(row).InFlight,
            field, direction, (index, current, next) => Target(rows[index], current, next.Wire()), (draft, promoted) => draft with { ClientDraftId = promoted });
        if (decision == ChildTableNavigationDecision.SubmitBoundary) await Commit(row, field.Wire(), interaction.PendingFocus?.ElementId);
        else if (decision == ChildTableNavigationDecision.Focus) {await Notify();await InvokeAsync(StateHasChanged);}
        return decision != ChildTableNavigationDecision.Rejected;
    }
    [JSInvokable] public Task<bool> BlurTransitionAsync(string client, string field, string? tab, string? value=null)
    {
        if (!Guid.TryParse(client, out var id) || !ChildTableBrowserFacts.TryField(field, out var typedField) || !ChildTableDraftAdapters.IsText(typedField) || !fields.Contains(field)) return Task.FromResult(true);
        var row = active.SingleOrDefault(x => x.ClientDraftId == id);
        return row is null ? Task.FromResult(true) : TextBlur(row, typedField, tab, value);
    }
    private async Task<bool> TextBlur(Row row, ChildTableField field, string? tab, string? value)
    {
        if(disposed||!PageOwned||Boundary(row).ProposalExclusive)return true;
        InstallTextValue(row,field,value);
        if (row.State == ChildTableRowLifecycle.Failed) return false;
        if(Boundary(row).RequiresReload)return false;
        if (!Boundary(row).InFlight&&((row.EntityId is null&&!Meaningful(row)) || (row.EntityId is not null&&!Changed(row)))) {await Notify();return true;}
        if (tab is not null&&(row.EntityId is null||Boundary(row).InFlight||row.Interaction.HasRetainedCorrection)) interaction.SetPendingFocus(ChildTableFocusTarget.Element(tab));
        await Commit(row, field.Wire(), tab); return row.State != ChildTableRowLifecycle.Failed;
    }
    private void InstallTextValue(Row row, ChildTableField field, string? value)
    {
        if(ChildTableDraftAdapters.InstallGenuineEdit(row.Interaction,ChildTableDraftAdapters.Install(row.Draft,field,value)))Boundary(row).GenuineEdit();
    }
    [JSInvokable] public Task ControlTransitionAsync(string client, string field, string? value)
    {
        if (!Guid.TryParse(client, out var id) || !ChildTableBrowserFacts.TryField(field, out var typedField) || typedField is not (ChildTableField.Todo or ChildTableField.Verification or ChildTableField.UnsafeArrival)) return Task.CompletedTask;
        var row = active.SingleOrDefault(x => x.ClientDraftId == id);
        return row is null ? Task.CompletedTask : Control(row, typedField, value);
    }
    private Task Control(Row row, ChildTableField field, string? value)
    {
        if(disposed||!PageOwned||Boundary(row).ProposalExclusive||!ChildTableDraftAdapters.InstallGenuineEdit(row.Interaction,ChildTableDraftAdapters.Install(row.Draft,field,value)))return Task.CompletedTask;
        Boundary(row).GenuineEdit();if(Boundary(row).InFlight)interaction.PendingFocus=new(row.ClientDraftId,field.Wire());
        return Commit(row,field.Wire(),null);
    }
    [JSInvokable] public async Task DropTransitionAsync(string entity,string partition,int target)
    {
        if(!PageOwned||!Guid.TryParse(entity,out var id)||!ChildTableBrowserFacts.TryPartition(partition,out var typedPartition)||typedPartition!=ChildTablePartition.Active)return;
        var row=active.FirstOrDefault(x=>x.EntityId==id);
        if(row?.State!=ChildTableRowLifecycle.Persisted||Boundary(row).HoldsPresentation)return;
        var source=RoomId;var generation=routeGeneration;
        var result=await(Reorder?.Invoke(id,target)??Unavailable("Reorder"));
        if(!Owns(source,generation)||result.Status==V2TransitionCommandStatus.Committed&&(!result.PresentationRefreshed||result.RequiresRoomReload))return;
        message=result.Message;if(result.Status==V2TransitionCommandStatus.Committed)await(RefreshApplied?.Invoke()??Task.CompletedTask);
    }
    private Task EditInGameData(Row row)=>Event(async()=>
    {
        if(!PageOwned||Boundary(row).HoldsPresentation||row.Baseline is not { } baseline||row.EntityId is not Guid id)return;
        var source=RoomId;var generation=routeGeneration;
        var result=await(EditInGameDataRequested?.Invoke(baseline,$"v2-transition-metadata-{id}")??Unavailable("Metadata editing"));
        if(Owns(source,generation))message=result.Message;
    });
    private Task Annotation(Row row)=>Event(()=>!PageOwned||Boundary(row).HoldsPresentation?Task.CompletedTask:row.Baseline is { } baseline&&row.EntityId is Guid id
        ?((AnnotationRequested??PlaceAnnotationRequested)?.Invoke(baseline,$"v2-transition-{(baseline.EnableAnnotation&&Usable(baseline.AnnotationSceneUnitX,baseline.AnnotationSceneUnitY)?"select":Usable(baseline.AnnotationSceneUnitX,baseline.AnnotationSceneUnitY)?"show":"place")}-{id}")??Task.CompletedTask):Task.CompletedTask);
    private string AnnotationActionText(bool renderable,bool usable)=>!SceneActionsAvailable?SceneActionsUnavailableReason:renderable?"select annotation":usable?"show and select annotation":"re-arm placement";
    private static bool Usable(double? x,double? y)=>x is double a&&y is double b&&double.IsFinite(a)&&double.IsFinite(b);
    private Task ArchiveRow(Row row,bool value)=>Event(async()=>
    {
        if(!PageOwned||Boundary(row).HoldsPresentation||row.EntityId is not Guid id)return;
        var source=RoomId;var generation=routeGeneration;
        var result=await(SetArchive?.Invoke(id,value)??Unavailable("Archive"));
        if(!Owns(source,generation)||result.Status==V2TransitionCommandStatus.Committed&&(!result.PresentationRefreshed||result.RequiresRoomReload))return;
        message=result.Message;if(result.Status==V2TransitionCommandStatus.Committed)await(RefreshApplied?.Invoke()??Task.CompletedTask);
    });
    private Task DeleteRow(Row row)=>Event(()=>!PageOwned||Boundary(row).HoldsPresentation?Task.CompletedTask:row.EntityId is Guid id
        ?PermanentDeleteRequested?.Invoke(id,$"v2-transition-delete-{id}")??Task.CompletedTask:Task.CompletedTask);
    private Task RequestInverseStatusAction(Row row)=>Event(async()=>
    {
        if(!PageOwned||row.Baseline is not { } baseline||row.EntityId is not Guid id||!row.CanExplicitInverseSetup||Boundary(row).HoldsPresentation)return;
        var source=RoomId;var generation=routeGeneration;var captured=row.Draft;
        Boundary(row).BeginExplicitProposal();
        var result=await(InverseStatusActionRequested?.Invoke(baseline,captured,$"v2-transition-inverse-{id}")??Unavailable("Inverse setup"));
        if(!Owns(source,generation))return;
        if(result.Status!=V2TransitionCommandStatus.Proposal)Boundary(row).ReleaseProposal(baseline,captured);
        message=result.Message;await Notify();
    });
