@using System.Globalization
@using Silksong_Rando_Logic_Manager.Components.RoomEditorV2.Contracts
<h2 id="v2-page-modal-title">edit in-game data</h2><p id="v2-page-modal-description">check metadata</p><div class="in-game-coordinate-grid"><label class="@SeverityClass(View.InGameIdSeverity)">game ID<input aria-label="game ID" autocomplete="off" value="@Draft.InGameId" disabled="@Disabled" @oninput="ChangeText" /></label>@Number("in-game X",nameof(Draft.InGamePositionX),Draft.InGamePositionX)@Number("in-game Y",nameof(Draft.InGamePositionY),Draft.InGamePositionY)@Number("in-game Z",nameof(Draft.InGamePositionZ),Draft.InGamePositionZ)@Number("local X",nameof(Draft.LocalPositionX),Draft.LocalPositionX)@Number("local Y",nameof(Draft.LocalPositionY),Draft.LocalPositionY)@Number("local Z",nameof(Draft.LocalPositionZ),Draft.LocalPositionZ)@Number("annotation scene X",nameof(Draft.AnnotationSceneUnitX),Draft.AnnotationSceneUnitX)@Number("annotation scene Y",nameof(Draft.AnnotationSceneUnitY),Draft.AnnotationSceneUnitY)</div><div class="v2-modal-footer"><div><button class="compact-control" type="button" disabled="@Disabled" @onclick="RevertAnnotation">revert annotation to game position</button></div><div><button class="compact-control" type="button" disabled="@Disabled" @onclick="Cancel">Cancel</button><button class="compact-control" type="button" disabled="@Disabled" @onclick="Apply">Apply</button></div></div>
@code {
 [Parameter,EditorRequired] public V2InGameMetadataDialogView View {get;set;}=null!; [Parameter,EditorRequired] public CheckInGameMetadataDraft Draft {get;set;}=null!; [Parameter] public bool Disabled {get;set;} [Parameter] public EventCallback<CheckInGameMetadataDraft> DraftChanged {get;set;} [Parameter] public EventCallback Cancel {get;set;} [Parameter] public EventCallback Apply {get;set;}
 private RenderFragment Number(string label,string field,double? value)=>@<label>@label<input aria-label="@label" autocomplete="off" type="number" value="@value" disabled="@Disabled" @oninput="e=>ChangeNumber(field,e)" /></label>;
 private Task ChangeText(ChangeEventArgs e)=>DraftChanged.InvokeAsync(Draft with {InGameId=e.Value?.ToString()});
 private Task ChangeNumber(string field,ChangeEventArgs e){var text=e.Value?.ToString();double? value=string.IsNullOrWhiteSpace(text)?null:double.Parse(text!,CultureInfo.InvariantCulture);var next=field switch {nameof(Draft.InGamePositionX)=>Draft with{InGamePositionX=value},nameof(Draft.InGamePositionY)=>Draft with{InGamePositionY=value},nameof(Draft.InGamePositionZ)=>Draft with{InGamePositionZ=value},nameof(Draft.LocalPositionX)=>Draft with{LocalPositionX=value},nameof(Draft.LocalPositionY)=>Draft with{LocalPositionY=value},nameof(Draft.LocalPositionZ)=>Draft with{LocalPositionZ=value},nameof(Draft.AnnotationSceneUnitX)=>Draft with{AnnotationSceneUnitX=value},_=>Draft with{AnnotationSceneUnitY=value}};return DraftChanged.InvokeAsync(next);}
 private Task RevertAnnotation()=>DraftChanged.InvokeAsync(Draft with {AnnotationSceneUnitX=null,AnnotationSceneUnitY=null});
 private static string? SeverityClass(V2Severity severity)=>severity==V2Severity.Danger?"danger":severity==V2Severity.Warning?"warning":null;
}
