@page "/tools/publishing"
@layout ToolsLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Silksong_Rando_Logic_Manager.Services.Publishing
@using Silksong_Rando_Logic_Manager.Authentication
@implements IAsyncDisposable
@inject DocumentationPublishingService Publishing
@inject PublishingActivityService Activity
@inject Silksong_Rando_Logic_Manager.Authentication.LiveAccess Access
@inject DiagnosticState Diagnostics
@inject ILogger<DocumentationPublishing> Logger
@inject IJSRuntime JS

<PageTitle>Documentation publishing | Silksong Logic Manager</PageTitle>
<main @ref="reviewHost" class="publishing-tool tools-body @(ShowReview ? "publishing-wide" : null)" data-review-navigation="@ReviewNavigation">
    <h1 class="tool-title">documentation publishing</h1>
    @if (view is null && Diagnostics.ErrorDetails is { } initialError)
    {
        <div class="diagnostic-boundary-fallback" role="alert"><pre>@initialError</pre></div>
    }
    @if (view is not null)
    {
        var awaitingMapDecision = view.MapPreflight?.AwaitingDecision == true;
        var destination = Uri.TryCreate(view.Repository, UriKind.Absolute, out var repository) ? repository : null;
        var repositoryName = destination?.AbsolutePath.TrimStart('/') ?? view.Repository;
        if (destination is not null && repositoryName.EndsWith(".git", StringComparison.OrdinalIgnoreCase))
        {
            repositoryName = repositoryName[..^4];
        }
        var destinationUrl = destination is null ? null : $"https://github.com/{repositoryName}/tree/{Uri.EscapeDataString(view.Branch)}";
        <p class="publishing-context tool-metadata">
            @if (destinationUrl is not null)
            {
                <a href="@destinationUrl" target="_blank" rel="noopener noreferrer">@repositoryName</a><text> · @view.Branch</text>
            }
            else { @repositoryName }
        </p>
        <div class="publishing-activity">
            <div>
                <span class="publishing-activity-label">Last room edit</span>
                <div class="publishing-activity-value">
                    <div>
                        @(latestActivity is null ? "Loading…" : !latestActivity.Available ? "History unavailable." : latestActivity.RecordedUtc is { } last ? (latestLocalTime ?? ActivityUtcTime(last)) : "No recorded room edits.")
                        @if (!reviewNavigationDenied && latestActivity?.User is { } editor) { <div>@editor</div> }
                    </div>
                    <button @ref="recentLauncher" class="publishing-text-action" type="button" aria-haspopup="dialog" @onclick="OpenRecentEdits">Recent edits</button>
                </div>
            </div>
            @if (!reviewNavigationDenied && view.LatestPreparation is { } preparation)
            {
                var active = view.Busy && view.Progress?.Operation == "Preparation";
                var highlight = preparation.IsOtherAccount && (active || DateTime.UtcNow < preparation.RecordedUtc.Add(PreparationNoticeWindow));
                <div class="publishing-preparation-activity @(highlight ? "publishing-notice" : null)">
                    <span class="publishing-activity-label">
                        @if (highlight) { <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> }
                        @(highlight ? "Last prep · another account" : "Last prep")
                    </span>
                    @(preparationLocalTime.At == preparation.RecordedUtc && preparationLocalTime.Label is { } local ? local : ActivityUtcTime(preparation.RecordedUtc))
                    <div>@preparation.User</div>
                </div>
            }
        </div>
        <div class="publishing-workspace @(!ShowReview ? "publishing-compact" : null)">
            <ol class="publishing-stages" role="list" aria-label="Publishing stages">
                <li aria-current="@(CurrentStage == WizardStage.Prepare ? "step" : null)"><span class="publishing-stage-number" aria-hidden="true">1</span> Prepare</li>
                <li aria-current="@(CurrentStage == WizardStage.Review ? "step" : null)"><span class="publishing-stage-number" aria-hidden="true">2</span> Review changes</li>
                <li aria-current="@(CurrentStage == WizardStage.Publish ? "step" : null)"><span class="publishing-stage-number" aria-hidden="true">3</span> Publish</li>
            </ol>
        @if (checksOrigin is not null && CanReview)
        {
            <section class="publishing-card publishing-compact">
                 <h2 class="tool-section-title">preparation report</h2>
                 <button class="publishing-text-action" type="button" @onclick="ReturnFromChecks">@(checksOrigin == WizardStage.Publish ? "Back to publish form" : "Back to change review")</button>
                @if (view.MapPreflight is null) { <p role="status">Preparation checks are unavailable for this retained candidate.</p> }
            </section>
        }
        @if (checksOrigin is null && !CanReview && !awaitingMapDecision && (EffectiveBusy || view.Stage != "Not prepared" || CurrentStage == WizardStage.Publish))
        {
            <section class="publishing-card publishing-compact" aria-label="Operation status">
            @if (CurrentStage == WizardStage.Publish)
            {
                <h2 class="tool-section-title">publish</h2>
            }
            <p class="tool-progress" role="status" aria-live="polite">
                @if (EffectiveBusy && (!view.Busy || view.Progress is null))
                {
                    <span><span class="publishing-progress-dots" aria-hidden="true"><span></span><span></span><span></span></span> @(view.Phase == "Restoring" ? "Restoring publishing review." : view.Busy ? "Publishing operation in progress." : AdmissionStatus)</span><br />
                }
                @if (view.Progress is { } progress)
                {
                    @if (view.Busy)
                    {
                        <small class="publishing-task-detail">Task @progress.Step of @progress.Steps <span class="publishing-progress-dots" aria-hidden="true"><span></span><span></span><span></span></span></small>
                        <span>@ProgressActivity(progress)…</span>
                    }
                    else
                    {
                        <span>@view.Stage</span>
                        <small class="publishing-task-detail">Last task (@progress.Step of @progress.Steps): @ProgressActivity(progress)</small>
                    }
                    @if (progress.RoomsCompleted is { } completed && progress.RoomsTotal is { } total)
                    {
                        <br /><span>Rooms completed: @completed of @total</span>
                    }
                    @if (progress.CurrentRoom is { } room) { <br /><span>Current room: @room</span> }
                    @if (progress.Detail is { } detail)
                    {
                        <br /><span>@(detail == "Write README, MASTER and documentation indexes." ? "Writing README, MASTER and documentation indexes…" : detail)</span>
                    }
                }
                else { @(view.Phase == "Interrupted" ? "Preparation was interrupted." : view.Stage) }
            </p>
            @if (view.Commit is not null)
            {
                <p>Update saved on server. Delivery not verified.</p>
                <p>Exact commit: <code>@view.Commit</code></p>
                <button class="tool-action" type="button" disabled="@(EffectiveBusy || view.Phase != "PendingPush")" aria-busy="@((ActiveCommand == PublishingCommand.Retry).ToString().ToLowerInvariant())" @onclick="Retry"><i class="@CommandIcon(PublishingCommand.Retry, "fa-rotate-right")" aria-hidden="true"></i> Retry publishing</button>
            }
            @if (view.PublishedUrl is not null)
            {
                <p>Published to @view.Branch</p>
                <p><a class="tool-action" href="@view.PublishedUrl" target="_blank" rel="noopener noreferrer">View on GitHub</a></p>
                <button class="tool-action" type="button" disabled="@(!CanPrepare)" @onclick="Prepare"><i class="@CommandIcon(PublishingCommand.Prepare, "fa-file-export")" aria-hidden="true"></i> Prepare</button>
            }
            </section>
        }
        @if (checksOrigin is null && view.Error is not null) { <p class="publishing-error publishing-compact" role="alert">@view.Error</p> }
        @if (checksOrigin is null && view.Validation.Count > 0) { <ul class="publishing-error publishing-compact">@foreach (var issue in view.Validation) { <li>@issue</li> }</ul> }
        @if (checksOrigin is null && CurrentStage == WizardStage.Prepare && !EffectiveBusy)
        {
            <div class="publishing-actions">
                <button class="tool-action" type="button" disabled="@(!CanPrepare)" @onclick="Prepare"><i class="fa-solid fa-file-export" aria-hidden="true"></i> @(view.Phase is "Interrupted" or "Failed" ? "Retry preparation" : "Prepare")</button>
            </div>
        }
        @if (view.MapPreflight is { } map)
            {
                <section @key="view.MapPreparation" class="publishing-map" aria-label="Preparation checks" hidden="@(!ShowChecks)">
                    @if (checksOrigin is null && map.Finished && map.Checks.Any(row => row.Status == MapCheckStatus.Fail))
                    {
                        var blocked = map.Checks.Any(row => row.Group == "Graph integrity" && row.Report is { Count: > 0 });
                        var reviewable = map.AwaitingDecision || map.Checks.Any(row => row.Report is { Count: > 0 });
                        <div role="status" class="publishing-notice @(blocked ? "publishing-notice-blocked" : reviewable ? null : "publishing-notice-incomplete")">
                            <i class="fa-solid @(blocked ? "fa-circle-exclamation" : reviewable ? "fa-triangle-exclamation" : "fa-circle-info")" aria-hidden="true"></i>
                            @if (blocked) { <strong>Preparation blocked:</strong> }
                            else if (map.AwaitingDecision) { <strong>Preparation paused · </strong> }
                            else if (!reviewable) { <strong>Preparation checks incomplete:</strong> }
                            <strong>@MapSummary(map, reviewable && !blocked)</strong>
                        </div>
                    }
                     @if (checksOrigin is null && !map.AwaitingDecision && map.Outcome is { } outcome) { <p role="status">@outcome</p> }
                    @if (checksOrigin is null && map.AwaitingDecision)
                    {
                        @if (view.MapDecision is { } decision)
                        {
                            <div class="publishing-actions publishing-map-actions">
                                 <button class="tool-action primary" type="button" disabled="@(sendingMapDecision == decision)" @onclick="() => DecideMap(decision, true)"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i> Continue generation</button>
                                 <button class="tool-action" type="button" disabled="@(sendingMapDecision == decision)" @onclick="() => DecideMap(decision, false)"><i class="fa-solid fa-stop" aria-hidden="true"></i> Cancel preparation</button>
                            </div>
                        }
                    }
                    @if (checksOrigin is null && mapDecisionError is { } decisionError && decisionError.Decision == view.MapDecision)
                    {
                        <p class="publishing-error" role="alert">@decisionError.Message</p>
                    }
                     <div class="publishing-map-report">
                     @foreach (var group in map.Checks.GroupBy(row => row.Group))
                    {
                        <h4 class="publishing-map-category">@group.Key</h4>
                        <ul class="publishing-map-rows">
                            @foreach (var row in group)
                            {
                                <li @key="(row.Group, row.Name)">
                                    <div class="publishing-map-status" role="status">
                                        <span><i class="@MapCheckIcon(row.Status) @MapCheckTone(row.Status)" aria-hidden="true"></i> @row.Name</span>
                                        <strong class="@MapCheckTone(row.Status)">@row.Status.ToString().ToUpperInvariant()</strong>
                                    </div>
                                    <p class="publishing-map-description">@row.Description</p>
                                    @if (row.Status == MapCheckStatus.Fail)
                                    {
                                        <div class="publishing-map-evidence">
                                            @if (row.NotRun is { } reason) { <p>Could not run: @reason</p> }
                                            @if (row.Report is { } report)
                                            {
                                                <PublishingMapFindings Report="report" />
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    </div>
                </section>
            }
        @if (previewError is not null) { <p class="publishing-error" role="alert">@previewError</p> }
        @if (CanReview)
        {
            <section class="publishing-card publishing-compact" hidden="@(checksOrigin is not null || CurrentStage != WizardStage.Publish)" aria-label="Publish decision">
                <h2 class="tool-section-title publishing-context">Publish to @repositoryName · @view.Branch</h2>
                <p>@ChangeSummary</p>
                <div class="publishing-back-actions" role="group" aria-label="Back to earlier views">
                    <button class="publishing-text-action" type="button" @onclick="BackToReview">Back to change review</button>
                    <span class="publishing-back-divider" aria-hidden="true"></span>
                    <button class="publishing-text-action" type="button" @onclick="ViewChecks">Back to preparation report</button>
                </div>
                <label class="tool-label" for="publishing-message">Commit message</label>
                <textarea class="tool-control" id="publishing-message" @bind="message" disabled="@EffectiveBusy" rows="3"></textarea>
                <div class="publishing-actions">
                    <button class="tool-action primary" type="button" disabled="@(EffectiveBusy || !view.CredentialsReady || string.IsNullOrWhiteSpace(message))" aria-busy="@((ActiveCommand == PublishingCommand.Commit).ToString().ToLowerInvariant())" @onclick="Commit"><i class="@CommandIcon(PublishingCommand.Commit, "fa-upload")" aria-hidden="true"></i> Commit and push</button>
                    <button class="tool-action" type="button" disabled="@(!CanPrepare)" @onclick="Prepare">Cancel and start over</button>
                </div>
            </section>
            <section class="publishing-card" hidden="@(!ShowReview)" aria-label="Candidate review">
                <h2 class="tool-section-title">review changes</h2>
                <p>@ChangeSummary</p>
                <div class="publishing-actions">
                    <button class="tool-action primary" type="button" @onclick="ContinueToPublish">Continue to publish <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    <button class="tool-action" type="button" disabled="@(!CanPrepare)" @onclick="Prepare"><i class="@CommandIcon(PublishingCommand.Prepare, "fa-file-export")" aria-hidden="true"></i> Start Over</button>
                    <button class="publishing-text-action" type="button" @onclick="ViewChecks">Back to preparation report</button>
                </div>
                @if (!EffectiveBusy && view.Review is { } review)
                {
                    var epoch = view.ReviewEpoch;
                    var layout = ReviewLayout(review, epoch);
                    <div @key="(review.Generation, epoch)" class="publishing-review-group" data-review-root="@layoutRevision"
                         data-review-total="@(layout.Total)"
                         data-review-width-owners="@(string.Join(' ', openRooms.Values.Where(x => x.Room is not null).Select(x => x.WidthOwner)))">
                        @if (layout.Banded)
                        {
                            <div class="publishing-review-band" data-review-band-limit="@PublishingReviewLayout.BandHeight" style="height:@(initialBandHeight)px">
                                @if (bandWindow is { } window)
                                {
                                    <div class="publishing-review-window" data-review-origin="@window.Origin" data-review-first-y="@window.First" data-review-last-y="@window.Last">
                                        @foreach (var slice in window.Slices)
                                        {
                                            <div @key="slice.Span.Key" class="publishing-review-slice" style="top:@(slice.Start - window.Origin)px"
                                                 data-review-span="@slice.Span.Key" data-review-start="@slice.Start" data-review-first="@slice.First"
                                                 data-review-measure="@(slice.Span.Rows is null ? slice.Span.Key : null)">
                                                @slice.Body
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div hidden class="publishing-review-scrollbar publishing-review-scrollbar-y" role="scrollbar" aria-label="Publication review position"
                                 aria-controls="publishing-scroll-surface" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" tabindex="0"><span></span></div>
                        }
                        else
                        {
                            @foreach (var zone in review.Zones)
                            {
                                <div @key="zone.Name" class="publishing-review-zone">
                                    @ZoneToggle(review, epoch, zone)
                                    @if (openZones.Contains(zone.Name))
                                    {
                                        @foreach (var room in zone.Rooms) { @RoomDisclosure(review, epoch, room, layout) }
                                    }
                                </div>
                            }
                            @if (review.Publication is { } publication) { @RoomDisclosure(review, epoch, publication, layout) }
                            @if (review.Unmapped is { } unmapped) { @RoomDisclosure(review, epoch, unmapped, layout) }
                        }
                    </div>
                }
                else if (!EffectiveBusy && view.ReviewError is { } problem)
                {
                    <p class="publishing-error" role="alert">@problem</p>
                    <ul class="publishing-review-inventory">
                    @foreach (var change in view.Changes)
                    {
                        <li>@change.Change · @change.Path</li>
                    }
                    </ul>
                }
            </section>
        }
        </div>
    }
    <dialog @ref="recentDialog" class="confirmation-modal publishing-activity-modal" aria-labelledby="publishing-activity-title">
        <h2 id="publishing-activity-title">recent edits</h2>
        @if (loadingActivity) { <p role="status">Loading recorded room edits…</p> }
        else if (recentActivity is not { Available: true }) { <p role="status">History unavailable.</p> }
        else if (recentActivity.Rows.Count == 0) { <p role="status">No recorded room edits in the last 24 hours.</p> }
        else
        {
            <table class="publishing-activity-table">
                <thead><tr><th scope="col">User</th><th scope="col">Room name</th><th scope="col">Timestamp</th></tr></thead>
                <tbody>
                    @for (var index = 0; index < recentActivity.Rows.Count; index++)
                    {
                        var row = recentActivity.Rows[index];
                        <tr class="@(row.WithinLastHour ? "publishing-activity-hour" : null)"><td>@row.User</td><td>@row.RoomName</td><td>@(recentLocalTimes?[index] ?? ActivityUtcTime(row.RecordedUtc))</td></tr>
                    }
                </tbody>
            </table>
        }
        <form method="dialog" class="publishing-activity-close"><button class="tool-action" type="submit" autofocus>close</button></form>
    </dialog>
</main>
<DiagnosticModal />

@code {
    private PublishingView? view;
    private enum WizardStage { Prepare, Review, Publish }
    private WizardStage laterStage = WizardStage.Review;
    private WizardStage? checksOrigin;
    private string? navigationCandidate;
    private long navigationEpoch;
    private bool resumeReviewPending;
    private bool navigatingWizard;
    private bool reviewNavigationDenied;
    private bool CanReview => !reviewNavigationDenied && !EffectiveBusy && view is { Phase: "Prepared", CandidateId: not null, Changes.Count: > 0 };
    private bool CanPrepare => !reviewNavigationDenied && view is { Enabled: true } && !EffectiveBusy
        && view.Phase is "Idle" or "Prepared" or "Interrupted" or "Failed";
    private WizardStage CurrentStage => CanReview ? laterStage
        : view?.Commit is not null || view?.PublishedUrl is not null
        || view?.Phase is "PendingPush" or "Replacing" or "Advancing" or "Published"
        || ActiveCommand is PublishingCommand.Commit or PublishingCommand.Retry
        || view?.Progress?.Operation is "Commit and push" or "Retry push"
            ? WizardStage.Publish : WizardStage.Prepare;
    private bool ShowReview => CanReview && checksOrigin is null && CurrentStage == WizardStage.Review;
    private bool ShowChecks => checksOrigin is not null && CanReview
        || CurrentStage == WizardStage.Prepare && view?.MapPreflight is { } map && view.Phase != "Prepared"
            && (map.AwaitingDecision || !map.Finished || view.Busy == false);
    private string ChangeSummary => $"{view!.Changes.Count} changed files · {view.Changes.Count(x => x.Kind == "Image")} images · {view.Changes.Count(x => x.Change == "Removed")} removals";
    private string ReviewNavigation => $"{view?.CandidateId}/{view?.ReviewEpoch}";

    private void ReconcileWizard()
    {
        if (!CanReview || navigationCandidate != view!.CandidateId || navigationEpoch != view.ReviewEpoch)
        {
            checksOrigin = null;
            laterStage = WizardStage.Review;
            resumeReviewPending = false;
            if (navigationCandidate != view?.CandidateId) message = "";
        }
        navigationCandidate = CanReview ? view!.CandidateId : null;
        navigationEpoch = view?.ReviewEpoch ?? 0;
    }
    private async Task NavigateWizard(WizardStage destination, bool inspect = false)
    {
        if (!CanReview || navigatingWizard) return;
        navigatingWizard = true;
        try
        {
            var candidate = view!.CandidateId;
            var epoch = view.ReviewEpoch;
            var origin = laterStage;
            var identity = ReviewNavigation;
            var wasReview = ShowReview;
            if (wasReview)
            {
                await ObserveReviewTrack();
                if (trackObserver is null)
                    throw new InvalidOperationException("The publication review position owner is unavailable.");
                suspendedAnchorLayout = reviewLayout is null ? null : (indexedRevision, reviewLayout);
                if (!await trackObserver.InvokeAsync<bool>("suspend", identity)) return;
            }
            if (!CanReview || view.CandidateId != candidate || view.ReviewEpoch != epoch) return;
            checksOrigin = inspect ? origin : null;
            if (!inspect) laterStage = destination;
            resumeReviewPending = ShowReview;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Saving publication review position failed.");
            Diagnostics.Show($"Saving publication review position failed.\n{exception}");
        }
        finally { navigatingWizard = false; }
    }
    private Task ViewChecks() => NavigateWizard(laterStage, inspect: true);
    private Task ReturnFromChecks() => NavigateWizard(checksOrigin ?? WizardStage.Review);
    private Task ContinueToPublish() => NavigateWizard(WizardStage.Publish);
    private Task BackToReview() => NavigateWizard(WizardStage.Review);
    private PublishingLatestActivity? latestActivity;
    private PublishingRecentActivity? recentActivity;
    private bool loadingActivity, openActivityPending, initializingActivityDialog;
    private long activityRead;
    private readonly CancellationTokenSource activityLifetime = new();
    private ElementReference recentDialog, recentLauncher;
    private IJSObjectReference? activityModule, activityDialogOwner;
    private Task<IJSObjectReference?>? activityModuleImport;
    private string? latestLocalTime;
    private (DateTime At, string? Label) preparationLocalTime;
    private DateTime? preparationTimeRequested;
    private static readonly TimeSpan PreparationNoticeWindow = TimeSpan.FromMinutes(15);
    private string?[]? recentLocalTimes;
    private bool latestTimeRequested;
    private long recentTimeRequested;
    private static string ActivityUtcTime(DateTime utc) => utc.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture);
    private static long ActivityUnixMilliseconds(DateTime utc) => new DateTimeOffset(utc.Ticks, TimeSpan.Zero).ToUnixTimeMilliseconds();

    private async Task<IJSObjectReference?> GetActivityModule()
    {
        if (disposed || activityModule is not null) return activityModule;
        var pending = activityModuleImport ??= ImportActivityModule();
        try { return await pending; }
        finally { if (ReferenceEquals(activityModuleImport, pending)) activityModuleImport = null; }
    }

    private async Task<IJSObjectReference?> ImportActivityModule()
    {
        var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./publishing-activity.js");
        if (disposed) { await imported.DisposeAsync(); return null; }
        return activityModule = imported;
    }

    private async Task LocalizeActivityTimesAfterRender()
    {
        if (disposed || view is null) return;
        DateTime? latest = !latestTimeRequested && latestActivity is { Available: true } ? latestActivity.RecordedUtc : null;
        var preparation = view.LatestPreparation;
        DateTime? prepared = preparation?.RecordedUtc != preparationTimeRequested ? preparation?.RecordedUtc : null;
        var read = activityRead;
        var rows = read != recentTimeRequested && recentActivity is { Available: true } ? recentActivity.Rows : null;
        if (latest is null && prepared is null && (rows is null || rows.Count == 0)) return;

        var instants = new List<long>();
        if (latest is { } last)
        {
            latestTimeRequested = true;
            instants.Add(ActivityUnixMilliseconds(last));
        }
        if (prepared is { } started)
        {
            preparationTimeRequested = started;
            instants.Add(ActivityUnixMilliseconds(started));
            if (preparation?.IsOtherAccount == true)
                _ = UpdatePreparationNoticeAtExpiry(started.Add(PreparationNoticeWindow));
        }
        var inlineCount = instants.Count;
        if (rows is { Count: > 0 })
        {
            recentTimeRequested = read;
            foreach (var row in rows) instants.Add(ActivityUnixMilliseconds(row.RecordedUtc));
        }
        try
        {
            var module = await GetActivityModule();
            if (disposed || module is null) return;
            var labels = await module.InvokeAsync<string?[]>("formatTimes", activityLifetime.Token, (object)instants, inlineCount);
            if (disposed || labels?.Length != instants.Count) return;

            var changed = false;
            if (latest is not null && labels[0] is { } label)
            {
                latestLocalTime = label;
                changed = true;
            }
            if (prepared is { } attempt && view?.LatestPreparation?.RecordedUtc == attempt)
            {
                preparationLocalTime = (attempt, labels[inlineCount - 1]);
                changed = true;
            }
            // Rows are in read order. Never apply labels from a closed, superseded open to a new read.
            if (rows is { Count: > 0 } && read == activityRead)
            {
                recentLocalTimes = labels[inlineCount..];
                changed = true;
            }
            if (changed) StateHasChanged();
        }
        catch (OperationCanceledException) when (activityLifetime.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (Exception exception)
        {
            try { Logger.LogWarning(exception, "Browser publisher activity time formatting unavailable; using UTC."); } catch { }
        }
    }

    private async Task UpdatePreparationNoticeAtExpiry(DateTime expiresAt)
    {
        var remaining = expiresAt - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return;
        try
        {
            await Task.Delay(remaining, activityLifetime.Token);
            if (!disposed && view?.LatestPreparation?.RecordedUtc.Add(PreparationNoticeWindow) == expiresAt)
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (activityLifetime.IsCancellationRequested) { }
    }

    private async Task LoadLatestActivity()
    {
        try
        {
            var next = await Activity.ReadLatestAsync(activityLifetime.Token);
            if (!disposed) { latestActivity = next; StateHasChanged(); }
        }
        catch (OperationCanceledException) when (activityLifetime.IsCancellationRequested) { }
    }

    private async Task OpenRecentEdits()
    {
        if (disposed || loadingActivity || openActivityPending || initializingActivityDialog) return;
        var read = ++activityRead;
        recentActivity = null; recentLocalTimes = null; loadingActivity = true; openActivityPending = true;
        StateHasChanged();
        try
        {
            // Let the loading dialog render before synchronous SQLite work starts.
            // Each real open still gets a fresh read; no result cache or polling.
            await Task.Yield();
            if (disposed) return;
            var next = await Activity.ReadRecentAsync(activityLifetime.Token);
            if (!disposed && read == activityRead) recentActivity = next;
        }
        catch (OperationCanceledException) when (activityLifetime.IsCancellationRequested) { }
        finally { if (!disposed && read == activityRead) { loadingActivity = false; StateHasChanged(); } }
    }

    private async Task OpenActivityDialogAfterRender()
