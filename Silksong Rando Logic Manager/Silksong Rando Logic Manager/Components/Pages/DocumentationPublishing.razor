    private readonly Dictionary<int, RoomDisclosureState> openRooms = [];
    private readonly HashSet<string> openZones = new(StringComparer.Ordinal);
    private readonly Dictionary<string, object> openingZones = new(StringComparer.Ordinal);
    private async Task ToggleZone(PublishingRoomReview review, long epoch, PublishingReviewZone zone)
    {
        bool Current() => !disposed && !EffectiveBusy && ReferenceEquals(review, view?.Review) && view?.ReviewEpoch == epoch;
        if (!Current()) return;
        if (openZones.Remove(zone.Name))
        {
            foreach (var room in zone.Rooms) openRooms.Remove(room.Id);
            ReviewChanged();
            return;
        }
        var opening = new object();
        if (!openingZones.TryAdd(zone.Name, opening)) return;
        try
        {
            if (!await Publishing.CheckReviewAsync(Access, review.Generation, epoch)) { if (Current()) await Refresh(); return; }
            if (Current() && ReferenceEquals(openingZones.GetValueOrDefault(zone.Name), opening)) { openZones.Add(zone.Name); ReviewChanged(); }
        }
        catch (Silksong_Rando_Logic_Manager.Authentication.AccessDeniedException denied)
        {
            if (Current()) DenyReview(denied.Message);
        }
        catch (Exception exception)
        {
            if (!Current()) return;
            Logger.LogError(exception, "Opening publishing review zone failed.");
            Diagnostics.Show($"Opening publishing review zone failed.\n{exception}");
        }
        finally { if (ReferenceEquals(openingZones.GetValueOrDefault(zone.Name), opening)) openingZones.Remove(zone.Name); }
    }

    private void RetireReview()
    {
        checksOrigin = null;
        laterStage = WizardStage.Review;
        resumeReviewPending = false;
        openRooms.Clear(); openZones.Clear(); openingZones.Clear();
        reviewLayout = null;
        anchorLayouts.Clear();
        suspendedAnchorLayout = null;
        ReviewChanged();
    }
    private void DenyReview(string message)
    {
        RetireReview();
        RetireMapAccess(view?.MapPreparation);
        view = view! with { Review = null, ReviewError = null };
        previewError = message;
    }
