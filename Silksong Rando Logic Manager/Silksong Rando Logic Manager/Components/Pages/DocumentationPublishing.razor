    private bool drainingTimings, initializingTimings;
    private Guid? deliveredOperation;
    private long deliveredSequence;
    private IReadOnlyList<PublishingTiming> pendingTimings = [];
    private readonly Queue<IReadOnlyList<PublishingTiming>> pendingPreviewTimings = new();
    protected override Task OnAfterRenderAsync(bool firstRender) =>
        Task.WhenAll(RunPublishingAfterRender(), LocalizeActivityTimesAfterRender(), UpdateReviewTrack(firstRender));
    private async Task UpdateReviewTrack(bool firstRender)
    {
        if (firstRender) await ObserveReviewTrack();
        if (disposed || !resumeReviewPending || !ShowReview || trackObserver is null) return;
        resumeReviewPending = false;
        try { await trackObserver.InvokeVoidAsync("resume", ReviewNavigation); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Restoring publication review position failed.");
            Diagnostics.Show($"Restoring publication review position failed.\n{exception}");
        }
    }

    private async Task RunPublishingAfterRender()
    {
        await OpenActivityDialogAfterRender();
        if (disposed || initializingTimings) return;
        initializingTimings = true;
        try
        {
            if (timingConsole is null)
            {
                if (timingModule is null)
                {
                    var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./publishing-console.js");
                    if (disposed) { await imported.DisposeAsync(); return; }
                    timingModule = imported;
                }
                if (disposed) return;
                var created = await timingModule.InvokeAsync<IJSObjectReference>("create");
                if (disposed) { await created.DisposeAsync(); return; }
                timingConsole = created;
            }
            await DrainTimings();
        }
        catch (Exception exception) { ReportConsoleFailure(exception); }
        finally { initializingTimings = false; }
    }
    private void ReportConsoleFailure(Exception exception)
    {
        // Console delivery has no authority over the operation or its existing modal.
        try { Logger.LogWarning(exception, "Publishing console delivery unavailable; retained timings can drain on the next authorized refresh/render."); } catch { }
    }
    private async Task DrainTimings()
    {
        if (disposed || timingConsole is null || drainingTimings) return;
        drainingTimings = true;
        try
        {
            while (!disposed)
            {
                var preview = pendingPreviewTimings.Count > 0;
                var batch = preview ? pendingPreviewTimings.Peek() : pendingTimings
                    .Where(x => x.Operation != deliveredOperation || x.Sequence > deliveredSequence).ToArray();
                if (batch.Count == 0) break;
                var start = System.Diagnostics.Stopwatch.GetTimestamp();
                if (!await timingConsole.InvokeAsync<bool>("write", batch, preview) || disposed) break;
                var roundtrip = System.Diagnostics.Stopwatch.GetElapsedTime(start).TotalMilliseconds;
                if (preview) pendingPreviewTimings.Dequeue();
                else
                {
                    deliveredOperation = batch[^1].Operation;
                    deliveredSequence = batch[^1].Sequence;
                    if (pendingTimings.Count > 0 && pendingTimings[0].Operation == deliveredOperation)
                        pendingTimings = pendingTimings.Where(x => x.Sequence > deliveredSequence).ToArray();
                }
                // Cursor success is independent of this optional delivery-only diagnostic.
                try { await timingConsole.InvokeVoidAsync("delivery", roundtrip); }
                catch (Exception exception) { ReportConsoleFailure(exception); }
            }
        }
        catch (Exception exception) { ReportConsoleFailure(exception); }
        finally { drainingTimings = false; }
    }
    private async Task PreviewBrowserStart(PublishingTimings timings)
    {
        if (disposed || timingConsole is null) return;
        try { await timingConsole.InvokeVoidAsync("previewStart", timings.Operation); }
        catch (Exception exception) { ReportConsoleFailure(exception); }
    }
    private async Task DeliverPreviewTimings(PublishingTimings timings)
    {
        if (disposed) return;
        try
        {
            pendingPreviewTimings.Enqueue(timings.Read());
            await DrainTimings();
        }
        catch (Exception exception) { ReportConsoleFailure(exception); }
    }
    protected override async Task OnInitializedAsync()
    {
        // Subscribe first: a mounting transition either appears in the initial read
        // or requests another pass through the same renderer-owned drain.
        subscription = Publishing.Subscribe(PublishingChanged);
        await Task.WhenAll(Refresh(), LoadLatestActivity());
    }
    private async Task Refresh()
    {
        if (disposed) return;
        refreshPending = true;
        if (refreshing) { await refreshCompletion!.Task; return; }
        refreshing = true;
        var completion = refreshCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        try
        {
            while (refreshPending && !disposed)
            {
                refreshPending = false;
                try
                {
                    var next = await Publishing.ReadAsync(Access, page, deliveredOperation, deliveredSequence);
                    if (disposed) return;
                    var filtered = await FilterMapAccess(next);
                    if (disposed) return;
                    next = filtered.View;
                    observedMapPreparation = next.MapPreparation;
                    if (!ReferenceEquals(next.Review, view?.Review) || next.ReviewEpoch != view?.ReviewEpoch) RetireReview();
                    if (filtered.Proof is { } proof)
                    {
                        if (next.MapPreparation != proof.Preparation || !ReferenceEquals(mapAccessDenial, proof.Denial) ||
                            !Access.TryUseCircuitObservation(proof.Revision, () =>
                            {
                                mapAccessDenial = null;
                                reviewNavigationDenied = false;
                                view = next;
                            }))
                            view = WithoutMapEvidence(next);
                    }
                    else view = next;
                    ReconcileWizard();
                    if (mapDecisionError is { } prior && prior.Decision != view?.MapDecision) mapDecisionError = null;
                    // Identity comes from actual running service work, not a local
                    // click that another page's admission may have beaten.
                    serviceCommand = !next.Busy ? null : next.Progress?.Operation switch
                    {
                        "Preparation" => PublishingCommand.Prepare,
                        "Commit and push" => PublishingCommand.Commit,
                        "Retry push" => PublishingCommand.Retry,
                        _ => next.Stage switch
                        {
                            "Discarding prepared changes" or "Discarded" => PublishingCommand.Discard,
                            "Ready for review; not yet published" or "No changes; nothing to publish" => PublishingCommand.Prepare,
                            _ => null
                        }
                    };
                    pendingTimings = next.Timings;
                    if (next.Failure is { } failure && shownFailure != failure.Id)
                    {
                        shownFailure = failure.Id;
                        Diagnostics.Show($"Documentation publishing failed.\n{failure.Details}");
                    }
                    StateHasChanged();
                }
                catch (Exception exception)
                {
                    // One failed drain, not one modal per overlapping request.
                    refreshPending = false;
                    if (disposed) return;
                    RetireReview();
                    if (view is not null) view = view with { Review = null, ReviewError = null };
                    observedMapPreparation = null;
                    if (exception is AccessDeniedException)
                        RetireMapAccess(mapAccessDenial is { } denial ? denial.Preparation : view?.MapPreparation);
                    Logger.LogError(exception, "Refreshing documentation publishing failed.");
                    Diagnostics.Show($"Refreshing documentation publishing failed.\n{exception}");
                    StateHasChanged();
                }
            }
        }
        finally { refreshing = false; completion.TrySetResult(); }
    }
    private async Task PublishingChanged()
    {
        if (disposed) return;
        try
        {
            await InvokeAsync(Refresh);
        }
        catch (Exception exception)
        {
            if (!disposed)
            {
                Logger.LogError(exception, "Refreshing documentation publishing failed.");
                // A retired renderer may reject dispatch; observe that failure too,
                // without making a process-owned publishing operation depend on it.
                try { await InvokeAsync(() => { if (!disposed) Diagnostics.Show($"Refreshing documentation publishing failed.\n{exception}"); }); }
                catch (Exception dispatchException) { Logger.LogError(dispatchException, "Dispatching publishing refresh diagnostic failed."); }
            }
        }
    }
    private Guid? sendingMapDecision;
    private (Guid Decision, string Message)? mapDecisionError;
    private sealed class MapAccessDenial(Guid? preparation)
    {
        internal Guid? Preparation { get; } = preparation;
        internal (Guid Preparation, long Revision)? Probed { get; set; }
    }
    private sealed record MapAccessProof(MapAccessDenial Denial, Guid Preparation, long Revision);
    private MapAccessDenial? mapAccessDenial;
    private Guid? observedMapPreparation;

    private MapAccessDenial RetireMapAccess(Guid? preparation, bool decisionReply = false)
    {
        reviewNavigationDenied = true;
        checksOrigin = null;
        laterStage = WizardStage.Review;
        resumeReviewPending = false;
        var retiresCurrentControls = !decisionReply || view?.MapPreparation == preparation;
        if (view is not null) view = WithoutMapEvidence(view);
        if (retiresCurrentControls)
        {
            mapDecisionError = null;
            sendingMapDecision = null;
        }
        return mapAccessDenial = new(preparation);
    }

    private static PublishingView WithoutMapEvidence(PublishingView status) => status with { MapPreflight = null, MapDecision = null };

    private async Task<(PublishingView View, MapAccessProof? Proof)> FilterMapAccess(PublishingView status)
    {
        if (mapAccessDenial is not { } denial) return (status, null);
        var masked = (WithoutMapEvidence(status), (MapAccessProof?)null);
        if (status.MapPreparation is not { } later || later == denial.Preparation) return masked;

        // A later admission can restore activity before any checks exist.
        // An authorized status read alone does not prove the credential/stamp
        // rejected by a command.
        LiveAccess.CircuitPrincipalObservation proofInput;
        try
        {
            if (Access.CaptureCircuitPrincipalObservation(AccessPolicies.PublishDocumentation) is not { } observed ||
                denial.Probed == (later, observed.Revision)) return masked;
            proofInput = observed;
            denial.Probed = (later, observed.Revision);
            await Publishing.ConfirmMapAccessAsync(observed);
        }
        catch (AccessDeniedException) { return masked; }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Verifying access to a later map preparation failed.");
            return masked;
        }
        if (disposed || !ReferenceEquals(mapAccessDenial, denial) || !Access.TryUseCircuitObservation(proofInput.Revision)) return masked;

        // Re-read after the proof, then carry it to the guarded view assignment.
        // An auth/job change does not schedule a retry; the next ordinary refresh
        // can try again for a different preparation or observation.
        var confirmed = await Publishing.ReadAsync(Access, page, deliveredOperation, deliveredSequence);
        return confirmed.MapPreparation == later
            ? (confirmed, new(denial, later, proofInput.Revision))
            : (WithoutMapEvidence(confirmed), null);
    }
    private static string MapSummary(MapPreflightView map, bool toReview)
    {
        var total = 0;
        var incomplete = 0;
        foreach (var row in map.Checks)
        {
            if (row.Status != MapCheckStatus.Fail) continue;
            if (row.NotRun is not null) incomplete++;
            total += row.Report?.Count ?? 0;
        }
        var counts = new List<string>(2);
        if (total > 0)
        {
            var findings = total == 1 ? "1 finding" : $"{total} findings";
            counts.Add(toReview ? $"{findings} to review" : findings);
        }
        if (incomplete > 0) counts.Add(incomplete == 1 ? "1 check not fully run" : $"{incomplete} checks not fully run");
        return string.Join(", ", counts) + ".";
    }

    private static string MapCheckTone(MapCheckStatus status) => status switch
    {
        MapCheckStatus.Pass => "publishing-map-pass", MapCheckStatus.Fail => "publishing-error", _ => ""
    };
    private static string MapCheckIcon(MapCheckStatus status) => status switch
    {
        MapCheckStatus.Checking => "fa-solid fa-spinner fa-spin", MapCheckStatus.Pass => "fa-solid fa-check",
        MapCheckStatus.Fail => "fa-solid fa-xmark", _ => "fa-regular fa-square"
    };
    private async Task DecideMap(Guid decision, bool proceed)
    {
        if (disposed || sendingMapDecision == decision || view?.MapDecision != decision || view.MapPreparation is not { } preparation) return;
        sendingMapDecision = decision;
        mapDecisionError = null;
        try { await Publishing.DecideMapAsync(Access, new(decision, proceed)); await Refresh(); }
        catch (PublishingBlock exception)
        {
            if (disposed || view?.MapDecision != decision) return;
            await Refresh();
            if (!disposed && view?.MapDecision == decision) mapDecisionError = (decision, exception.Message);
        }
        catch (AccessDeniedException exception)
        {
            if (disposed) return;
            Logger.LogError(exception, "Submitting map preflight decision failed.");
            var denial = RetireMapAccess(preparation, decisionReply: true);
            StateHasChanged();
            await Refresh();
            // Both the running prompt and its terminal result have the same job
            // identity. Do not replay an old command error over a later job (or
            // after discard); a current status denial uses Refresh's own error.
            if (!disposed && ReferenceEquals(mapAccessDenial, denial) && observedMapPreparation == preparation)
                Diagnostics.Show($"Submitting map preflight decision failed.\n{exception}");
        }
        catch (Exception exception)
        {
            if (!disposed)
            {
                Logger.LogError(exception, "Submitting map preflight decision failed.");
                if (view?.MapDecision == decision)
                    Diagnostics.Show($"Submitting map preflight decision failed.\n{exception}");
            }
        }
        finally { if (sendingMapDecision == decision) sendingMapDecision = null; }
    }
    private Task Prepare()
    {
        mapDecisionError = null;
        var expected = view?.CandidateId;
        var epoch = view?.ReviewEpoch ?? 0;
        return RunCommand(PublishingCommand.Prepare, () => Publishing.PrepareAsync(Access, new(page, expected, epoch)), "Preparing documentation");
    }
    private Task Discard() => RunCommand(PublishingCommand.Discard, () => Publishing.DiscardAsync(Access, new(page, view?.CandidateId)), "Discarding prepared changes");
    private Task Commit() => view?.CandidateId is { } id
        ? RunCommand(PublishingCommand.Commit, () => Publishing.CommitAndPushAsync(Access, new(page, id, message)), "Committing documentation") : Task.CompletedTask;
    private Task Retry() => view?.Commit is { } id
        ? RunCommand(PublishingCommand.Retry, () => Publishing.RetryPushAsync(Access, new(page, id)), "Retrying documentation push") : Task.CompletedTask;
    private async Task RunCommand(PublishingCommand command, Func<Task> action, string context)
    {
        if (disposed || EffectiveBusy) return;
        pendingCommand = command;
        RetireReview();
        try
        {
            previewError = null;
            // Queue feedback before admission can do synchronous work, too.
            StateHasChanged();
            await Task.Yield();
            if (disposed) return;
            await action();
            await Refresh();
        }
        catch (PublishingBlock exception) { if (!disposed) previewError = exception.Message; }
        catch (Exception exception)
        {
            if (disposed) return;
            Logger.LogError(exception, "{PublishingAction} failed.", context);
            Diagnostics.Show($"{context} failed.\n{exception}");
        }
        finally
        {
            pendingCommand = null;
            if (!disposed) StateHasChanged();
        }
    }
    private bool CurrentRoom(Guid generation, long epoch, int room, RoomDisclosureState state) => !disposed && !EffectiveBusy
        && view?.Review?.Generation == generation && view.ReviewEpoch == epoch && ReferenceEquals(openRooms.GetValueOrDefault(room), state);

    private async Task ToggleRoom(Guid generation, long epoch, int room)
    {
        if (disposed || EffectiveBusy || view?.Review?.Generation != generation || view.ReviewEpoch != epoch) return;
        if (openRooms.Remove(room)) { ReviewChanged(); return; }
        var state = new RoomDisclosureState();
        openRooms.Add(room, state);
        ReviewChanged();
        var timings = Publishing.CreatePreviewTimings();
        using var caller = timings.Begin("Room open to admitted review payload (server)");
        var browserTiming = PreviewBrowserStart(timings);
        try
        {
            var payload = await Publishing.ReadReviewRoomAsync(Access, generation, epoch, room, timings);
            if (!CurrentRoom(generation, epoch, room, state)) return;
            if (payload is null) { openRooms.Remove(room); ReviewChanged(); await Refresh(); return; }
            state.Room = payload;
            ReviewChanged();
            caller.Complete();
        }
        catch (Exception exception) { HandleReviewError(generation, epoch, room, state, exception); }
        finally
        {
            caller.Dispose();
            if (!disposed) StateHasChanged();
            await browserTiming;
            await DeliverPreviewTimings(timings);
        }
    }

    private async Task<bool> AdmitWindow(Guid generation, long epoch, int room, RoomDisclosureState state)
    {
        if (!CurrentRoom(generation, epoch, room, state)) return false;
        try
        {
            var admitted = await Publishing.CheckReviewAsync(Access, generation, epoch);
            if (admitted) return CurrentRoom(generation, epoch, room, state);
            if (CurrentRoom(generation, epoch, room, state)) { openRooms.Remove(room); ReviewChanged(); await Refresh(); }
        }
        catch (Exception exception)
        {
            HandleReviewError(generation, epoch, room, state, exception);
            if (!disposed) StateHasChanged();
        }
        return false;
    }

    private void HandleReviewError(Guid generation, long epoch, int room, RoomDisclosureState state, Exception exception)
    {
        if (!CurrentRoom(generation, epoch, room, state)) return;
        if (exception is Silksong_Rando_Logic_Manager.Authentication.AccessDeniedException denied)
        {
            DenyReview(denied.Message);
            return;
        }
        state.Room = null;
        ReviewChanged();
        if (exception is PublishingBlock expected) { state.Error = expected.Message; return; }
        state.Error = "The prepared room review could not be opened. See the error details.";
        Logger.LogError(exception, "Opening publishing room review failed.");
        Diagnostics.Show($"Opening publishing room review failed.\n{exception}");
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        RetireReview();
        await DisposeReviewTrack();
        activityLifetime.Cancel();
        if (activityDialogOwner is not null)
        {
            try { await activityDialogOwner.InvokeVoidAsync("dispose"); await activityDialogOwner.DisposeAsync(); }
            catch (Exception exception) { try { Logger.LogWarning(exception, "Retiring publisher activity dialog failed."); } catch { } }
        }
        if (activityModule is not null)
        {
            try { await activityModule.DisposeAsync(); }
            catch (Exception exception) { try { Logger.LogWarning(exception, "Retiring publisher activity module failed."); } catch { } }
        }
        subscription?.Dispose(); subscription = null;
        refreshPending = false;
        pendingTimings = []; pendingPreviewTimings.Clear();
        if (timingConsole is not null)
        {
            try { await timingConsole.InvokeVoidAsync("dispose"); await timingConsole.DisposeAsync(); }
            catch (Exception exception) { ReportConsoleFailure(exception); }
        }
        if (timingModule is not null)
        {
            try { await timingModule.DisposeAsync(); }
            catch (Exception exception) { ReportConsoleFailure(exception); }
        }
        // Only this mounted view retires. Process-owned work continues independently.
    }
}
