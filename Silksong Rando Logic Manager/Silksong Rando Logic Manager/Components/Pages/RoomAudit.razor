@page "/rooms/{RoomId:guid}/audit"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject RoomAuditSnapshotService Loader
@inject IJSRuntime JS
@inject ILogger<RoomAudit> Logger
@using System.Text.Json
@using Microsoft.JSInterop
@using Silksong_Rando_Logic_Manager.Components.RoomAudit

<PageTitle>Room audit</PageTitle>
<article class="room-audit" aria-label="Read-only room audit">
    <header>
        <h1>@(snapshot is null ? "Room audit" : $"{snapshot.Name} — room audit")</h1>
        <a class="audit-action" href="@($"/rooms/{RoomId:D}")"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> back to editor</a>
    </header>
    @if (loading) { <p role="status">Loading fresh room data…</p> }
    else if (failure is not null)
    {
        <p role="alert">@failure</p>
        <button class="audit-action" type="button" @onclick="ReloadAsync">retry</button>
    }
    else if (snapshot is null) { <p role="status">Room unavailable: it is missing or archived.</p> }
    else if (evaluator is not null && evaluation is not null)
    {
        var scenarioOwner = generation;
        @if (notice is not null) { <p class="audit-notice" role="status">@notice</p> }
        <nav class="audit-task-tabs" aria-label="Audit task">
            <button type="button" aria-pressed="@(!reachTask)" @onclick="@(() => reachTask = false)">Explore</button>
            <button type="button" aria-pressed="@reachTask" @onclick="@(() => reachTask = true)">Reach a target</button>
        </nav>
        @if (reachTask) { <button type="button" class="audit-action" @onclick="@(() => scenarioCollapsed = !scenarioCollapsed)">@(scenarioCollapsed ? "Show scenario" : "Hide scenario")</button> }
        <div @key="generation" class="audit-workspace @(reachTask && scenarioCollapsed ? "audit-scenario-collapsed" : "")">
            <section class="audit-controls" hidden="@(reachTask && scenarioCollapsed)" aria-label="Scenario inputs">
                <fieldset disabled="@restoring">
                    <legend>Scenario inputs</legend>
                    <button class="audit-action" type="button" @onclick="@(() => OwnedInputAsync(scenarioOwner, ResetAsync))">reset scenario</button>
                    <section class="audit-scenario-section" aria-label="Movement"><h2>Movement <small>@SelectedSummary("Movement")</small></h2>
                    <table class="audit-movement">
                        <thead><tr><th scope="col">Capability</th><th scope="col">Available</th><th scope="col">All</th></tr></thead>
                        <tbody>
                            @foreach (var movement in RoomAuditEvaluator.Movement)
                            {
                                <tr><th scope="row">@movement.Label</th><td>
                                    @if (movement.Directions.Length == 0)
                                    {
                                        var key = $"move:{movement.Key}";
                                        <input id="@AuditExpressionView.ControlId(key)" type="checkbox" aria-label="@movement.Label" checked="@scenario.Has(key)" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => FactChangedAsync(key, e)))" />
                                    }
                                    @foreach (var direction in movement.Directions)
                                    {
                                        var key = $"move:{movement.Key}:{direction}";
                                        <label><input id="@AuditExpressionView.ControlId(key)" type="checkbox" checked="@scenario.Has(key)" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => FactChangedAsync(key, e)))" /> @RoomAuditEvaluator.Friendly(direction)</label>
                                    }
                                </td><td>@if (movement.Directions.Length > 0) { <input type="checkbox" aria-label="@($"All {movement.Label} directions")" checked="@movement.Directions.All(d => scenario.Has($"move:{movement.Key}:{d}"))" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => AllChangedAsync(movement.Key, movement.Directions, e)))" /> }</td></tr>
                            }
                        </tbody>
                    </table>
                    </section>
                    <section class="audit-scenario-section" aria-label="Crests"><h2>Crests <small>@SelectedSummary("Crests")</small></h2>
                    <table><thead><tr><th scope="col">Owned</th><th scope="col">Shared difficulty</th></tr></thead><tbody>
                        @foreach (var crest in snapshot.Crests)
                        {
                            var owned = RoomAuditEvaluator.ValueKey("crest", crest);
                            var level = RoomAuditEvaluator.ValueKey("crest-level", crest);
                            <tr><td><label><input id="@AuditExpressionView.ControlId(owned)" type="checkbox" checked="@scenario.Has(owned)" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => FactChangedAsync(owned, e)))" /> @crest.Name</label></td>
                                <td><select id="@AuditExpressionView.ControlId(level)" aria-label="@($"{crest.Name} shared difficulty")" value="@scenario.Level(level)" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => LevelChangedAsync(level, e)))">
                                    @for (var i = 0; i < RoomAuditEvaluator.DifficultyNames.Length; i++) { <option value="@i">@RoomAuditEvaluator.DifficultyNames[i]</option> }
                                </select></td></tr>
                        }
                    </tbody></table></section>
                    @foreach (var groupName in new[] { "Tools / spells / kit", "Technique difficulty", "World and settings", "Souls", "External dependencies", "Other prerequisites" })
                    {
                        var group = evaluator.Controls.Where(x => x.Group == groupName).ToArray();
                        @if (group.Length == 0 && groupName is not "Souls" and not "World and settings") { continue; }
                        <section class="audit-scenario-section" aria-label="@groupName"><h2>@groupName <small>@SelectedSummary(groupName)</small></h2>
                            @if (groupName == "World and settings")
                            {
                                <label>Act <select id="@AuditExpressionView.ControlId("act")" value="@scenario.Act" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => ActChangedAsync(e)))"><option value="1">I</option><option value="2">II</option><option value="3">III</option></select></label>
                                @foreach (var control in evaluator.Controls.Where(x => x.Group == "Settings"))
                                {
                                    <fieldset id="@AuditExpressionView.ControlId(control.Key)" class="audit-radio"><legend>@control.Label</legend>
                                        <label><input type="radio" name="@control.Key" checked="@(!scenario.Has(control.Key))" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, false)))" /> Off</label>
                                        <label><input type="radio" name="@control.Key" checked="@scenario.Has(control.Key)" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, true)))" /> On</label>
                                    </fieldset>
                                }
                            }
                            @if (groupName == "Souls")
                            {
                                <fieldset id="@AuditExpressionView.ControlId("soul-mode")" class="audit-radio"><legend>Soul Randomizer</legend>
                                    <label><input type="radio" name="audit-souls" checked="@(!scenario.SoulRandomizer)" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SoulModeChangedAsync(false)))" /> Off</label>
                                    <label><input type="radio" name="audit-souls" checked="@scenario.SoulRandomizer" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SoulModeChangedAsync(true)))" /> On</label>
                                </fieldset>
                                @if (group.Length == 0) { <p class="audit-help">No named Souls required in this room.</p> }
                            }
                            @foreach (var control in group)
                            {
                                if (control.Difficulty)
                                {
                                    <label class="audit-control" id="@AuditExpressionView.ControlId(control.Key)">@control.Label
                                        <select value="@scenario.Level(control.Key)" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => LevelChangedAsync(control.Key, e)))">
                                            @for (var i = 0; i < RoomAuditEvaluator.DifficultyNames.Length; i++) { <option value="@i">@RoomAuditEvaluator.DifficultyNames[i]</option> }
                                        </select>
                                    </label>
                                }
                                else
                                {
                                    <label class="audit-control" id="@AuditExpressionView.ControlId(control.Key)"><input type="checkbox" checked="@scenario.Has(control.Key)" disabled="@(groupName == "Souls" && !scenario.SoulRandomizer)" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => FactChangedAsync(control.Key, e)))" /> @control.Label
                                        @if (groupName == "Other prerequisites") { <span class="audit-manual-tag">Manual</span> }
                                    </label>
                                }
                            }
                        </section>
                    }
                </fieldset>
            </section>
            <section class="audit-output" aria-label="Room reachability and authored results">
                @if (reachTask) { <button type="button" @onclick="@(() => showRouteMap = !showRouteMap)">@(showRouteMap ? "Hide map context" : "Show map context")</button> }
                <AuditScene @key="generation" Snapshot="snapshot" Evaluator="evaluator" Evaluation="evaluation" Scenario="scenario" Owner="generation" Origin="@scenario.Start" PickOrigin="pickOrigin" Selected="selectedTarget" Route="routeHighlight" HideMap="@(reachTask && !showRouteMap)" ControlFocus="controlFocus" ControlFocusRevision="controlFocusRevision" Intent="SceneIntentAsync">
                    <OriginControls>
                        <label class="audit-origin-control">Origin
                            <select disabled="@restoring" value="@scenario.Start" @onchange="@(e => OwnedInputAsync(scenarioOwner, () => StartChangedAsync(e)))">
                                <option value="">Select origin…</option>
                                @foreach (var start in evaluator.Starts)
                                { <option value="@start.Key" disabled="@(!start.Valid)">@start.Label</option> }
                            </select>
                        </label>
                        <button disabled="@restoring" class="audit-action" type="button" aria-pressed="@pickOrigin" @onclick="@(() => OwnedInputAsync(scenarioOwner, TogglePickAsync))">@(pickOrigin ? "Cancel scene pick (Esc)" : "Pick on scene")</button>
                    </OriginControls>
                </AuditScene>
                <section hidden="@reachTask" class="audit-room-state" aria-label="Room state">
                    <h2>Room state</h2>
                    <label>Find target <input type="search" value="@targetSearch" @oninput="SearchTargets" /></label>
                    <p>@FilteredTargets().Count() matching / @Targets().Count() total points · ✓ Met · ✕ Missing · ? Unresolved</p>
                    <div class="audit-state-rows" role="list" aria-label="Room points">
                        @foreach (var item in FilteredTargets())
                        {
                            var row = snapshot.Rows.FirstOrDefault(x => x.Kind == item.Target.Kind && x.Id == item.Target.Id);
                            var control = item.Target.Kind == "check" ? evaluator.Controls.FirstOrDefault(x => x.LocalCheckId == item.Target.Id) : null;
                            var start = evaluator.StartFor(item.Target);
                            <section @key="item.Target" id="@PointId(item.Target)" role="listitem" class="audit-state-row @(selectedTarget == item.Target ? "audit-target-selected" : "")" aria-label="@item.Name">
                                <div class="audit-state-point">
                                    <h3><button type="button" disabled="@pickOrigin" aria-pressed="@(selectedTarget == item.Target)" @onclick="@(() => SelectTarget(scenarioOwner, item.Target))">@item.Name</button></h3>
                                    <span>@(item.Target.Kind == "exit" ? "Entrance / exit" : RoomAuditEvaluator.Friendly(item.Target.Kind))</span>
                                    @if (row is not null && row.Kind != "connection") { <span>Source: @evaluator.NodeName(evaluator.SourceNode(row))</span> }
                                    @if (selectedTarget == item.Target) { <span class="audit-selection-tag">Selected target</span> }
                                    @if (start is not null && scenario.Start == start) { <span class="audit-origin-tag">Origin</span> }
                                </div>
                                <div class="audit-state-controls">
                                    @if (control is not null)
                                    {
                                        <fieldset id="@AuditExpressionView.ControlId(control.Key)" class="audit-activation" disabled="@restoring">
                                            <legend>@item.Name · Already activated <span class="audit-manual-tag">Manual</span></legend>
                                            <label><input type="radio" name="@control.Key" checked="@(!scenario.Has(control.Key))" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, false)))" /> Off</label>
                                            <label><input type="radio" name="@control.Key" checked="@scenario.Has(control.Key)" @onchange="@(() => OwnedInputAsync(scenarioOwner, () => SetFactAsync(control.Key, true)))" /> On</label>
                                        </fieldset>
                                    }
                                    @if (start is not null)
                                    { <button type="button" disabled="@(restoring || pickOrigin)" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SelectOriginAsync(start)))">Start here</button> }
                                </div>
                                <AuditPointState Target="item.Target" Evaluator="evaluator" Evaluation="evaluation" Scenario="scenario" ShowActivation="false" />
                                <div class="audit-state-requirements" aria-label="Requirements">
                                    @if (row is not null)
                                    { <AuditAuthoredBadges Expression="row.Requirement.Expression" Requirement="row.Requirement" Results="evaluation.Rows[(row.Kind, row.Id)].Leaves" /> }
                                    else { <span>No own gate</span> }
                                </div>
                                <div class="audit-state-actions">
                                    <button type="button" disabled="@pickOrigin" @onclick="@(() => Investigate(scenarioOwner, item.Target, false))">@(row?.Kind == "check" ? "Ways to activate" : "Ways to reach")</button>
                                    @if (row is not null) { <button type="button" disabled="@pickOrigin" @onclick="@(() => Investigate(scenarioOwner, item.Target, true))">Inspect condition</button> }
                                </div>
                            </section>
                        }
                    </div>
                </section>
                @if (reachTask)
                {
                    <label>To <select disabled="@pickOrigin" value="@TargetKey(selectedTarget)" @onchange="@(e => DestinationChanged(scenarioOwner, e))"><option value="">Select destination…</option>
                        @foreach (var item in Targets()) { <option value="@TargetKey(item.Target)">@(item.Target.Kind == "exit" ? "Entrance / exit" : RoomAuditEvaluator.Friendly(item.Target.Kind)): @item.Name</option> }
                    </select></label>
                }
                else if (selectedTarget is { } target)
                {
                    <section class="audit-selection" inert="@(pickOrigin ? "" : null)">
                        <h2>@TargetName(target) · @TargetStatus(target)</h2>
                        <button type="button" @onclick="@(() => ReachTarget(false))">Explore ways to reach it</button>
                        @if (evaluator.StartFor(target) is { } start)
                        { <button type="button" @onclick="@(() => OwnedInputAsync(scenarioOwner, () => SelectOriginAsync(start)))">Start here</button> }
                        @if (target.Kind == "connection") { <button type="button" @onclick="@(() => ReachTarget(true))">Inspect condition</button> }
                        @if (target.Kind == "connection" && snapshot.Rows.FirstOrDefault(x => x.Kind == target.Kind && x.Id == target.Id) is { } connection)
                        {
                            @foreach (var direction in snapshot.Rows.Where(x => x.Kind == "connection" && x.Id != connection.Id && string.Equals(x.Alias?.Trim(), connection.Alias?.Trim(), StringComparison.OrdinalIgnoreCase)))
                            { <button type="button" @onclick="@(() => SelectTarget(scenarioOwner, new("connection", direction.Id)))">@evaluator.RowName(direction)</button> }
                        }
                    </section>
                }
                <div hidden="@(!reachTask)">
                    <AuditTargetInspector @key="generation" Target="selectedTarget" Selection="targetSelection" Active="reachTask" Disabled="pickOrigin" Direct="directInspection" OriginLabel="@(evaluator.Starts.FirstOrDefault(x => x.Key == scenario.Start)?.Label ?? "Select origin…")" Scenario="scenario" Evaluator="evaluator" Evaluation="evaluation" HighlightChanged="@(highlight => SetHighlight(scenarioOwner, highlight))" ControlRequested="@(key => RevealControl(scenarioOwner, key))" RoomStateRequested="@(target => RevealPoint(scenarioOwner, target))" SceneStep="sceneStep" SceneStepSelection="sceneStepSelection" />
                </div>
            </section>
        </div>
    }
</article>

@code {
    [Parameter] public Guid RoomId { get; set; }
    private RoomAuditSnapshot? snapshot;
    private RoomAuditEvaluator? evaluator;
    private AuditScenario scenario = new();
    private AuditEvaluation? evaluation;
    private CancellationTokenSource? loadCancellation;
    private IJSObjectReference? storage;
    private long generation;
    private bool disposed, loading, restoring, restoreInFlight;
    private string? failure, notice;
    private bool pickOrigin;
    private AuditTarget? selectedTarget, sceneStep;
    private AuditRouteHighlight routeHighlight = new([], null);
    private bool reachTask, scenarioCollapsed, showRouteMap, directInspection;
    private string targetSearch = "";
    private string? controlFocus;
    private long controlFocusRevision, sceneStepSelection;
    private long targetSelection;
    private string StorageKey => $"silksong-room-audit:inputs:{RoomId:D}";

    protected override Task OnParametersSetAsync() => ReloadAsync();
    private async Task ReloadAsync()
    {
        var owner = ++generation;
        loadCancellation?.Cancel(); loadCancellation?.Dispose();
        loadCancellation = new(); var token = loadCancellation.Token;
        snapshot = null; evaluator = null; evaluation = null; failure = null; notice = null;
        pickOrigin = false; selectedTarget = null; sceneStep = null; routeHighlight = new([], null);
        reachTask = false; scenarioCollapsed = false; showRouteMap = false; directInspection = false; targetSearch = "";
        controlFocus = null; controlFocusRevision++; sceneStepSelection++;
        loading = true; restoring = false; restoreInFlight = false;
        try
        {
            var loaded = await Loader.LoadAsync(RoomId, token);
            if (disposed || generation != owner) return;
            snapshot = loaded;
            if (loaded is not null)
            {
                evaluator = new(loaded); scenario = evaluator.Reconcile(null);
                evaluation = evaluator.Evaluate(scenario); restoring = true;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Room audit load failed for {RoomId}", RoomId);
            if (!disposed && owner == generation) failure = "Room audit could not load. Retry to read fresh data.";
        }
        finally { if (!disposed && owner == generation) loading = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!restoring || restoreInFlight || evaluator is null || disposed) return;
        restoreInFlight = true;
        var owner = generation; var key = StorageKey; var current = evaluator;
        try
        {
            if (storage is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./room-audit-storage.js");
                if (disposed || owner != generation) { await module.DisposeAsync(); return; }
                storage = module;
            }
            var retained = await storage.InvokeAsync<StorageRead>("read", key);
            if (disposed || owner != generation) return;
            AuditScenario? restored = null;
            if (retained.Value is not null)
            {
                restored = JsonSerializer.Deserialize<AuditScenario>(retained.Value);
                if (restored is null || restored.Start is null || restored.Facts is null || restored.Levels is null ||
                    restored.Act is < 1 or > 3 || restored.Levels.Values.Any(level => level is < 0 or > 4))
                    throw new JsonException("Invalid retained scenario inputs.");
            }
            scenario = current.Reconcile(restored);
            notice = retained.Notice;
        }
        catch (Exception exception) when (exception is JSException or JsonException)
        {
            if (disposed || owner != generation) return;
            scenario = current.Reconcile(null);
            notice = "Scenario storage is unavailable or corrupt; defaults are in use. Authored data is unaffected.";
        }
        if (disposed || owner != generation) return;
        evaluation = current.Evaluate(scenario);
        restoring = false; restoreInFlight = false;
        await InvokeAsync(StateHasChanged);
    }
    private Task StartChangedAsync(ChangeEventArgs e) => SelectOriginAsync(e.Value?.ToString() ?? "");
    private Task SelectOriginAsync(string start)
    { scenario.Start = evaluator!.Starts.Any(x => x.Valid && x.Key == start) ? start : ""; return ChangedAsync(); }
    private Task TogglePickAsync() { pickOrigin = !pickOrigin; if (pickOrigin) showRouteMap = true; return Task.CompletedTask; }
    private void SelectTarget(long owner, AuditTarget target)
    {
        if (disposed || owner != generation || loading || pickOrigin || evaluator is null || evaluation is null || !Targets().Any(x => x.Target == target)) return;
        selectedTarget = target;
        targetSelection++;
        routeHighlight = new([], null); directInspection = false; sceneStep = null;
    }
    private void SetHighlight(long owner, AuditRouteHighlight highlight) { if (!disposed && owner == generation) routeHighlight = highlight; }
    private void ReachTarget(bool direct) { directInspection = direct; targetSelection++; reachTask = true; }
    private void RevealControl(long owner, string key)
    {
        if (disposed || owner != generation || evaluator is null) return;
        if (evaluator.Controls.FirstOrDefault(x => x.Key == key)?.LocalCheckId is { } check)
            RevealPoint(owner, new("check", check));
        else { scenarioCollapsed = false; controlFocus = AuditExpressionView.ControlId(key); controlFocusRevision++; }
    }
    private static string PointId(AuditTarget target) => $"audit-point-{target.Kind}-{target.Id:D}";
    private void RevealPoint(long owner, AuditTarget target)
    {
        if (disposed || owner != generation || evaluator is null || !Targets().Any(x => x.Target == target)) return;
        reachTask = false;
        if (!FilteredTargets().Any(x => x.Target == target)) targetSearch = "";
        var control = target.Kind == "check" ? evaluator.Controls.FirstOrDefault(x => x.LocalCheckId == target.Id) : null;
        controlFocus = control is null ? PointId(target) : AuditExpressionView.ControlId(control.Key);
        controlFocusRevision++;
    }
    private void Investigate(long owner, AuditTarget target, bool direct)
    {
        SelectTarget(owner, target);
        if (selectedTarget == target && !pickOrigin && owner == generation && !disposed) ReachTarget(direct);
    }
    private string SelectedSummary(string group)
    {
        if (group == "Crests") return $"{snapshot!.Crests.Count(x => scenario.Has(RoomAuditEvaluator.ValueKey("crest", x)))} owned";
        if (group == "Movement") return $"{RoomAuditEvaluator.Movement.Sum(x => x.Directions.Length == 0 ? (scenario.Has($"move:{x.Key}") ? 1 : 0) : x.Directions.Count(d => scenario.Has($"move:{x.Key}:{d}")))} selected";
        if (group == "World and settings") return $"Act {scenario.Act} · {evaluator!.Controls.Count(x => x.Group == "Settings" && scenario.Has(x.Key))} On";
        if (group == "Souls") return $"Randomizer {(scenario.SoulRandomizer ? "On" : "Off")} · {evaluator!.Controls.Count(x => x.Group == group && scenario.Has(x.Key))} selected";
        return $"{evaluator!.Controls.Count(x => x.Group == group && (x.Difficulty ? scenario.Level(x.Key) > 0 : scenario.Has(x.Key)))} selected";
    }
    private static string TargetKey(AuditTarget? target) => target is null ? "" : $"{target.Kind}:{target.Id:D}";
    private string TargetName(AuditTarget target) => Targets().FirstOrDefault(x => x.Target == target).Name ?? "Destination";
    private void DestinationChanged(long owner, ChangeEventArgs e)
    {
        if (disposed || owner != generation || pickOrigin || loading) return;
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value)) { selectedTarget = null; targetSelection++; routeHighlight = new([], null); directInspection = false; }
        else if (Targets().FirstOrDefault(x => TargetKey(x.Target) == value).Target is { } target) SelectTarget(owner, target);
    }
    private void SearchTargets(ChangeEventArgs e) { targetSearch = e.Value?.ToString() ?? ""; }
    private IEnumerable<(AuditTarget Target, string Name)> FilteredTargets() => Targets().Where(x => x.Name.Contains(targetSearch, StringComparison.OrdinalIgnoreCase));
    private Task SceneIntentAsync(AuditSceneIntent intent)
    {
        if (disposed || loading || intent.Owner != generation || evaluator is null) return Task.CompletedTask;
        if (intent.Kind == "cancel") { pickOrigin = false; return Task.CompletedTask; }
        var target = new AuditTarget(intent.Kind, intent.Id);
        if (!Targets().Any(x => x.Target == target)) return Task.CompletedTask;
        if (pickOrigin)
        {
            if (!intent.PickOrigin || evaluator.StartFor(target) is not { } start || restoring) return Task.CompletedTask;
            pickOrigin = false; return SelectOriginAsync(start);
        }
        if (!intent.PickOrigin)
        {
            if (reachTask && target.Kind == "connection" && routeHighlight.Connections.Contains(target.Id))
            { sceneStep = target; sceneStepSelection++; }
            else SelectTarget(intent.Owner, target);
        }
        return Task.CompletedTask;
    }
    private IEnumerable<(AuditTarget Target, string Name)> Targets()
    {
        if (snapshot is null || evaluator is null) yield break;
        if (snapshot.Subrooms.Count == 0) yield return (new("room", snapshot.RoomId), "Implicit room");
        foreach (var subroom in snapshot.Subrooms) yield return (new("subroom", subroom.Id), subroom.Name);
        foreach (var row in snapshot.Rows) yield return (new(row.Kind, row.Id), evaluator.RowName(row));
    }
    private string TargetStatus(AuditTarget target)
        => evaluator!.TargetStatus(target, evaluation!);
    private Task OwnedInputAsync(long owner, Func<Task> action) => !disposed && owner == generation && !loading && !restoring ? action() : Task.CompletedTask;
    private Task ActChangedAsync(ChangeEventArgs e) { scenario.Act = int.TryParse(e.Value?.ToString(), out var act) && act is >= 1 and <= 3 ? act : 1; return ChangedAsync(); }
    private Task SoulModeChangedAsync(bool on) { scenario.SoulRandomizer = on; return ChangedAsync(); }
    private Task FactChangedAsync(string key, ChangeEventArgs e) => SetFactAsync(key, e.Value is true);
    private Task SetFactAsync(string key, bool value) { RoomAuditEvaluator.SetFact(scenario, key, value); return ChangedAsync(); }
    private Task AllChangedAsync(string movement, string[] directions, ChangeEventArgs e)
    { foreach (var direction in directions) RoomAuditEvaluator.SetFact(scenario, $"move:{movement}:{direction}", e.Value is true); return ChangedAsync(); }
    private Task LevelChangedAsync(string key, ChangeEventArgs e)
    { scenario.Levels[key] = int.TryParse(e.Value?.ToString(), out var level) && level is >= 0 and <= 4 ? level : 0; return ChangedAsync(); }
    private Task ResetAsync() { scenario = evaluator!.Reconcile(null); return ChangedAsync(); }
    private async Task ChangedAsync()
    {
        if (disposed || evaluator is null) return;
        evaluation = evaluator.Evaluate(scenario);
        var owner = generation;
        if (storage is null) { notice = "Scenario storage is unavailable; inputs last only while this page stays open."; return; }
        try
        {
            var saved = await storage.InvokeAsync<bool>("write", StorageKey, JsonSerializer.Serialize(scenario));
            if (!saved && owner == generation && !disposed) notice = "Scenario storage is unavailable; inputs last only while this page stays open.";
        }
        catch (JSException) { if (owner == generation && !disposed) notice = "Scenario storage is unavailable; inputs last only while this page stays open."; }
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true; generation++; loadCancellation?.Cancel(); loadCancellation?.Dispose();
        if (storage is not null) try { await storage.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    private sealed record StorageRead(string? Value, string? Notice);
}
