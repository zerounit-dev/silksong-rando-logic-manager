@inject DebugDiagnosticSwitches Switches
@using Silksong_Rando_Logic_Manager.Services

            <p id="debug-controls-description">These settings apply across this server and reset when the application restarts.</p>
            <label class="sidebar-export-map-option tool-label"><input type="checkbox" checked="@Switches.CircuitTimingEnabled" @onchange="SetCircuitTiming" /> circuit timing</label>
            <label class="sidebar-export-map-option tool-label"><input type="checkbox" checked="@Switches.EfContextSummariesEnabled" @onchange="SetContextSummaries" /> EF context summaries</label>
            <label class="sidebar-export-map-option tool-label"><input type="checkbox" checked="@Switches.EfCommandSqlEnabled" @onchange="SetCommandSql" /> ordinary EF command SQL</label>

@code {
    private void SetCircuitTiming(ChangeEventArgs args) => Switches.CircuitTimingEnabled = AsBoolean(args);
    private void SetContextSummaries(ChangeEventArgs args) => Switches.EfContextSummariesEnabled = AsBoolean(args);
    private void SetCommandSql(ChangeEventArgs args) => Switches.EfCommandSqlEnabled = AsBoolean(args);
    private static bool AsBoolean(ChangeEventArgs args) => args.Value is true || bool.TryParse(args.Value?.ToString(), out var value) && value;
}
