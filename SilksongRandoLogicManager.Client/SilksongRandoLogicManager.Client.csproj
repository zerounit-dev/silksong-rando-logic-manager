<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared root assets remain server-owned; the client does not use its
         template favicon or Bootstrap. Avoid duplicate root asset endpoints. -->
    <Content Remove="wwwroot\favicon.png;wwwroot\lib\bootstrap\**" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/client</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SilksongRandoLogicManager.Audit\SilksongRandoLogicManager.Audit.csproj" />
    <ProjectReference Include="..\SilksongRandoLogicManager.Contracts\SilksongRandoLogicManager.Contracts.csproj" />
    <ProjectReference Include="..\SilksongRandoLogicManager.SceneProcessing\SilksongRandoLogicManager.SceneProcessing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <RazorComponent Include="..\Silksong Rando Logic Manager\Silksong Rando Logic Manager\Components\SceneWorkbench.razor" Link="Components\SceneWorkbench.razor" />
    <RazorComponent Include="..\Silksong Rando Logic Manager\Silksong Rando Logic Manager\Components\SceneReviewExplore.razor" Link="Components\SceneReviewExplore.razor" />
    <RazorComponent Include="..\Silksong Rando Logic Manager\Silksong Rando Logic Manager\Components\RoomEditorV2\SceneContextPanePresentation.razor" Link="Components\RoomEditorV2\SceneContextPanePresentation.razor" />
    <RazorComponent Include="..\Silksong Rando Logic Manager\Silksong Rando Logic Manager\Components\RequirementCatalogue\RequirementSyntaxGuideContent.razor" Link="Components\RequirementCatalogue\RequirementSyntaxGuideContent.razor" />
    <RazorComponent Include="..\Silksong Rando Logic Manager\Silksong Rando Logic Manager\Components\RequirementCatalogue\RequirementSyntaxGuideModal.razor" Link="Components\RequirementCatalogue\RequirementSyntaxGuideModal.razor" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <!-- SDK 10.0.401 initializes this transient item only in its build instance,
       whose transform replaces source HTML with a Build-only asset. Referenced
       publication has different globals: discover only current owning HTML when
       absent, never promote the Build result. Keep native transformation and
       registration intact; revisit when the SDK initializes publish HTML itself. -->
  <Target Name="InitializeLogicPublishHtmlInputs"
          BeforeTargets="GenerateHtmlAssetPlaceholdersPublishStaticWebAssets"
          DependsOnTargets="ResolveHtmlAssetPlaceholdersPublishConfiguration"
          Condition="'$(OverrideHtmlAssetPlaceholders)' == 'true' And '@(_HtmlStaticWebAssets)' == ''">
    <ItemGroup>
      <_HtmlStaticWebAssets Include="@(StaticWebAsset)"
                           Condition="'%(StaticWebAsset.SourceId)' == '$(PackageId)' And '%(StaticWebAsset.AssetKind)' != 'Build' And '%(StaticWebAsset.Extension)' == '.html'" />
      <_LogicPublishHtmlContent Include="@(Content)"
                                Condition="'@(_HtmlStaticWebAssets)' == '' And '%(Content.Extension)' == '.html' And '%(Content.CopyToPublishDirectory)' != 'Never'" />
    </ItemGroup>
    <DefineStaticWebAssets Condition="'@(_HtmlStaticWebAssets)' == ''"
                           CandidateAssets="@(_LogicPublishHtmlContent->Distinct())"
                           FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
                           FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
                           RelativePathPattern="wwwroot/**"
                           SourceType="Discovered" SourceId="$(PackageId)"
                           ContentRoot="$(MSBuildProjectDirectory)\wwwroot\"
                           BasePath="$(StaticWebAssetBasePath)"
                           AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="_HtmlStaticWebAssets" />
    </DefineStaticWebAssets>
    <Error Condition="'@(_HtmlStaticWebAssets)' == ''"
           Text="No current client HTML input was available for native publish transformation." />
  </Target>
</Project>
