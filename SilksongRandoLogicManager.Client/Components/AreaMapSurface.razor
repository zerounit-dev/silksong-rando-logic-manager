@implements IAsyncDisposable
@using System.Globalization
@inject IJSRuntime JS
@inject ConfirmedCatalogue Catalogue

<div class="area-map-surface @(Compact ? "area-map-surface-compact" : "area-map-surface-full")">
    <svg id="@Surface.Context.SvgId" @key="Surface.Context.SvgId" @ref="svgElement" class="map-wireframe @(Compact ? "room-context-wireframe" : "")"
         viewBox="@InitialViewBox" data-base-viewbox="@NavigationBoundsViewBox" data-initial-viewbox="@InitialViewBox"
         data-map-view-version="@(Surface.Context.IsRoomContext ? "3" : null)" data-map-key="@Surface.Context.ViewportKey"
         data-has-overlay="@((Surface.Decoration.Overlay is not null).ToString().ToLowerInvariant())"
         data-map-keyboard="@(KeyboardActivation ? "true" : null)"
         role="img" aria-label="@(Compact ? "Room zone map" : "Imported map wireframe")">
        @if (Surface.Decoration.Overlay is { } overlay)
        {
            <image class="map-overlay-image" href="@overlay.ImageUrl" x="@Number(overlay.Placement.X)" y="@Number(overlay.Placement.Y)"
                   width="@Number(overlay.Placement.Width)" height="@Number(overlay.Placement.Height)" preserveAspectRatio="none" />
        }
        <g transform="@MapUnitToSvgTransform">
            @foreach (var owner in Surface.Geometry.Owners)
            {
                var decoration = Decoration(owner);
                if (decoration is not null)
                {
                    var linked = owner.ActiveResolvedRoomId is not null;
                    <path @key="(owner.ActiveResolvedRoomId, owner.UnlinkedChunkId)" class="chunk-frame @(linked ? "linked-owner" : "unlinked")"
                          data-map-status="@(linked ? CanonicalStatus(owner.ActiveResolvedRoomId!.Value) : null)"
                          data-map-owner="@(linked ? "linked" : "unlinked")" d="@owner.SvgPathData" tabindex="0"
                          aria-label="@decoration.Label" @onclick="() => ActivateAsync(owner.ActiveResolvedRoomId)"
                          @oncontextmenu:preventDefault="true" @oncontextmenu="() => EditAsync(owner.ActiveResolvedRoomId, decoration.MapSceneId)">
                        <title>@decoration.Label</title>
                    </path>
                }
            }
            @if (Surface.Context.CurrentRoomId is { } currentRoomId)
            {
                @foreach (var owner in Surface.Geometry.Owners.Where(x => x.ActiveResolvedRoomId == currentRoomId))
                {
                    <path class="current-room-frame" d="@owner.SvgPathData" aria-hidden="true" />
                }
            }
        </g>
    </svg>
    <area-map-prepaint @key="PrepaintMarkerKey" hidden aria-hidden="true"></area-map-prepaint>
    @if (Compact)
    {
        <div class="room-map-context-map-actions">
            <div><button type="button" @onclick="() => EditAsync(null, null)"><i class="fa-solid fa-link" aria-hidden="true"></i> edit map links</button></div>
            <div>
                @if (Surface.Decoration.Overlay is not null)
                {
                    <button type="button" class="map-image-toggle-compact" data-map-command="image" title="hide map image" aria-label="hide map image" aria-pressed="true"><i class="fa-solid fa-image" aria-hidden="true"></i></button>
                }
                <button type="button" data-map-command="linked"><i class="fa-solid fa-eye" aria-hidden="true"></i> linked</button>
                <button type="button" data-map-command="unlinked"><i class="fa-solid fa-eye" aria-hidden="true"></i> unlinked</button>
                <button type="button" data-map-command="reset"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> reset view</button>
            </div>
        </div>
    }
    else
    {
        <div class="map-manifest-upload">
            <div class="map-controls-start">@LeadingControls</div>
            <div class="map-controls-end">
                @if (Surface.Decoration.Overlay is not null) { <button type="button" class="map-manifest-picker" data-map-command="image"><i class="fa-solid fa-image" aria-hidden="true"></i> image</button> }
                <button type="button" class="map-manifest-picker" data-map-command="linked"><i class="fa-solid fa-eye" aria-hidden="true"></i> linked</button>
                <button type="button" class="map-manifest-picker" data-map-command="unlinked"><i class="fa-solid fa-eye" aria-hidden="true"></i> unlinked</button>
                <button type="button" class="map-manifest-picker" data-map-command="reset"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> reset view</button>
                @TrailingControls
            </div>
            @ControlStatus
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public AreaMapSurfaceView View { get; set; } = null!;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool KeyboardActivation { get; set; }
    [Parameter] public EventCallback<LinkedMapRoomIntent> LinkedRoomActivated { get; set; }
    [Parameter] public long HostGeneration { get; set; }
    [Parameter] public EventCallback<MapLinkContextIntent> MapLinkRequested { get; set; }
    [Parameter] public RenderFragment? LeadingControls { get; set; }
    [Parameter] public RenderFragment? TrailingControls { get; set; }
    [Parameter] public RenderFragment? ControlStatus { get; set; }

    private AreaMapSurfaceView Surface = null!;
    private AreaMapSurfaceView? lastParentView;
    private ElementReference svgElement;
    private bool disposed, presentationRetired, browserDirty = true;
    private readonly List<Task> initializationFlights = [];
    private Task? retirementFlight;
    private bool browserInitialized, browserInitializationAttempted;
    private string NavigationBoundsViewBox => Bounds(Surface.Geometry.MapBounds);
    private string InitialViewBox => Bounds(Surface.Context.InitialBounds);
    private string PrepaintMarkerKey => $"area-map-prepaint:{Surface.Context.SvgId}";
    private string MapUnitToSvgTransform => $"translate(0 {Number(Surface.Geometry.MapBounds.Y * 2 + Surface.Geometry.MapBounds.Height)}) scale(1 -1)";

    protected override void OnInitialized() => Catalogue.Changed += CatalogueChanged;
    protected override void OnParametersSet()
    {
        var parentChanged = !ReferenceEquals(lastParentView, View);
        lastParentView = View;
        // An unchanged parent may be pinned while this child has already admitted
        // newer truth. Only a genuinely new parent input replaces that baseline.
        ReconcileSurface(parentChanged ? View : Surface ?? View);
    }
    private void ReconcileSurface(AreaMapSurfaceView baseline)
    {
        if (disposed || presentationRetired) return;
        var next = Catalogue.CurrentMapSurface(baseline);
        browserDirty |= Surface is null || !ReferenceEquals(Surface.Geometry, next.Geometry)
            || Surface.Context != next.Context || Compact != lastCompact || KeyboardActivation != lastKeyboard
            || (Surface.Decoration.Overlay is null) != (next.Decoration.Overlay is null);
        lastCompact = Compact; lastKeyboard = KeyboardActivation;
        Surface = next;
    }
    private bool lastCompact, lastKeyboard;
    private void CatalogueChanged()
    {
        if (disposed || presentationRetired) return;
        _ = InvokeAsync(() => {
            if (disposed || presentationRetired) return;
            ReconcileSurface(Surface ?? View); StateHasChanged();
        });
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!browserDirty || disposed || presentationRetired) return Task.CompletedTask;
        browserDirty = false;
        var flight = InitializeBrowserAsync();
        initializationFlights.RemoveAll(x => x.IsCompleted);
        initializationFlights.Add(flight);
        return flight;
    }
    private async Task InitializeBrowserAsync()
    {
        if (disposed || presentationRetired) return;
        var renderedSvg = svgElement;
        try
        {
            browserInitializationAttempted = true;
            await JS.InvokeVoidAsync("mapNavigation.initialize", renderedSvg);
            if (disposed || presentationRetired) { await JS.InvokeVoidAsync("mapNavigation.dispose", renderedSvg); return; }
            browserInitialized = true;
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) when (disposed || presentationRetired) { }
    }
    private AreaMapOwnerDecoration? Decoration(MapRenderProjectionOwner owner) => owner.ActiveResolvedRoomId is { } room
        ? Surface.Decoration.Linked[room] : owner.UnlinkedChunkId is { } chunk ? Surface.Decoration.Unlinked[chunk] : null;
    private string CanonicalStatus(Guid room) => Surface.Decoration.Linked[room].Status.ToString().ToLowerInvariant();
    private Task ActivateAsync(Guid? roomId) => !disposed && !presentationRetired && roomId is { } id ? LinkedRoomActivated.InvokeAsync(new(Surface.Context.CurrentRoomId, HostGeneration, id)) : Task.CompletedTask;
    private Task EditAsync(Guid? roomId, Guid? sceneId) => !disposed && !presentationRetired ? MapLinkRequested.InvokeAsync(new(roomId, sceneId)) : Task.CompletedTask;
    private static string Bounds(MapSvgBounds bounds) => $"{Number(bounds.X)} {Number(bounds.Y)} {Number(bounds.Width)} {Number(bounds.Height)}";
    private static string Number(double value) => value.ToString("G17", CultureInfo.InvariantCulture);

    public Task RetirePresentationAsync()
    {
        presentationRetired = true;
        Catalogue.Changed -= CatalogueChanged;
        return retirementFlight ??= RetireBrowserAsync();
    }
    private async Task RetireBrowserAsync()
    {
        var renderedSvg = svgElement;
        try { await Task.WhenAll(initializationFlights.ToArray()); }
        finally
        {
            if (browserInitialized || browserInitializationAttempted)
            {
                browserInitialized = browserInitializationAttempted = false;
                try { await JS.InvokeVoidAsync("mapNavigation.dispose", renderedSvg); }
                catch (JSDisconnectedException) { }
                catch (ObjectDisposedException) { }
            }
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        await RetirePresentationAsync();
    }
    public sealed record MapLinkContextIntent(Guid? ResolvedRoomId, Guid? MapSceneId);
    public sealed record LinkedMapRoomIntent(Guid? SourceRoomId, long HostGeneration, Guid TargetRoomId);
}
